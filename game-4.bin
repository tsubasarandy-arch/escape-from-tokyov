", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
 const rewards={
  6:[['ホワイトアウト',0]],
  7:[['サイレントナイフ',1]],
  8:[['アイアンハート',2]],
  9:[['阿形',3],['吽形',4]],
  10:[['懲罰棒',5]]
 };
 const prior=bossBattleScreen;
 bossBattleScreen=function(){
   const html=prior();
   if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
   const host=document.createElement('div');
   host.innerHTML=html;
   const dossier=host.querySelectorAll('section.tok-mil-dossier')[1];
   const floor=Number(dossier?.querySelector('h2')?.textContent.match(/^\s*(\d+)F\s/)?.[1]);
   if(!rewards[floor]||!dossier||dossier.querySelector('.tok-ex-unique-art'))return html;
   const item=document.createElement('div');
   item.className='item tok-ex-unique-art';
   item.innerHTML='<h3>固有装備画像</h3>'+rewards[floor].map(([name,index])=>'<figure class="tok-ex-asset-art"><img src="'+art[index]+'" alt="'+name+'" loading="lazy" decoding="async"><figcaption>'+name+'（BOSS UNIQUE）</figcaption></figure>').join('');
   dossier.appendChild(item);
   return host.innerHTML;
 };
})();
</script>

<script id="tok-normal-boss-rewards-6364">
/* Normal raid boss unique reward art, using the game's existing image registries. */
(function(){
 const original=bossBattleScreen;
 bossBattleScreen=function(){
  const html=original();
  if(html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY')||selectedBoss==='pursuer')return html;
  const id=selectedBoss,b=BOSSES[id];if(!b)return html;
  const st=g.bosses[id]||{};
  const unlocked=!!ROAMING_BOSSES[id]||!!g.unlocked[id];
  const known=(unlocked||st.first||st.kills>0)&&(!!ROAMING_BOSSES[id]||bossKnown(id));
  if(!known)return html;
  const label=id==='police'?'指揮官のヘッドセット・城塞のライオットシールド・猟犬のバックパック':(BOSS_REWARD_LABEL[id]||W[b.gear]?.n||A[b.gear]?.n||H[b.gear]?.n||'');
  const names=label.split(/[・／、]/).map(x=>x.trim()).filter(Boolean);
  const catalogs=[['weapon',W],['armor',A],['helmet',H],['bag',B],['accessory',typeof TOK_ACCESSORIES==='undefined'?{}:TOK_ACCESSORIES]];
  const ids=[];
  for(const name of names){
   for(const [type,db] of catalogs){
    const key=Object.keys(db||{}).find(k=>db[k]?.n===name);
    if(key&&!ids.some(x=>x[0]===type&&x[1]===key)){ids.push([type,key]);break;}
   }
  }
  if(!['park','police','forest'].includes(id)&&b.gear&&!ids.some(x=>x[1]===b.gear)){
   const match=catalogs.find(([type,db])=>db?.[b.gear]);if(match)ids.push([match[0],b.gear]);
  }
  const figures=ids.map(([type,key])=>{
   if(type==='weapon')return typeof tokWeaponImage==='function'?tokWeaponImage(key):'';
   if(type==='accessory')return typeof tokAccessoryImage==='function'?tokAccessoryImage(key):'';
   return typeof tokEquipmentImage==='function'?tokEquipmentImage(key,type):'';
  }).filter(Boolean);
  if(!figures.length)return html;
  const host=document.createElement('div');host.innerHTML=html;
  const target=[...host.querySelectorAll('.item')].find(el=>el.textContent.includes('固有装備：')&&el.textContent.includes('初回報酬：'));
  if(!target)return html;
  const box=document.createElement('div');box.className='tok-normal-boss-rewards';
  box.innerHTML='<h3>固有ドロップ装備画像</h3>'+figures.join('');
  const lines=[...target.querySelectorAll('p')];
  const anchor=lines.find(el=>el.textContent.includes('固有装備：'));
  if(anchor)anchor.insertAdjacentElement('afterend',box);else target.appendChild(box);
  return host.innerHTML;
 };
})();
</script>

<script id="tok-normal-reward-stats-6365">
(function(){
 const previous=bossBattleScreen;
 bossBattleScreen=function(){
  const html=previous();
  if(html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY')||selectedBoss==='pursuer')return html;
  const id=selectedBoss,b=BOSSES[id];if(!b)return html;
  const st=g.bosses[id]||{};
  const unlocked=!!ROAMING_BOSSES[id]||!!g.unlocked[id];
  if(!((unlocked||st.first||st.kills>0)&&(!!ROAMING_BOSSES[id]||bossKnown(id))))return html;
  const host=document.createElement('div');host.innerHTML=html;
  const rewardBox=host.querySelector('.tok-normal-boss-rewards');
  if(!rewardBox)return html;
  const label=id==='police'?'指揮官のヘッドセット・城塞のライオットシールド・猟犬のバックパック':(BOSS_REWARD_LABEL[id]||W[b.gear]?.n||A[b.gear]?.n||H[b.gear]?.n||'');
  const names=label.split(/[・／、]/).map(x=>x.trim()).filter(Boolean);
  const catalogs=[['weapon',W],['armor',A],['helmet',H],['bag',B],['accessory',typeof TOK_ACCESSORIES==='undefined'?{}:TOK_ACCESSORIES]];
  const entries=[];
  for(const name of names){
   for(const [type,db] of catalogs){
    const key=Object.keys(db||{}).find(k=>db[k]?.n===name);
    if(key&&!entries.some(e=>e.key===key&&e.type===type)){entries.push({key,type,v:db[key]});break;}
   }
  }
  if(!['park','police','forest'].includes(id)&&b.gear&&!entries.some(e=>e.key===b.gear)){
   const c=catalogs.find(([type,db])=>db?.[b.gear]);
   if(c)entries.push({key:b.gear,type:c[0],v:c[1][b.gear]});
  }
  const esc=x=>escapeHTML(String(x));
  const signed=n=>(Number(n)>0?'+':'')+n;
  const details=entries.map(({type,v,key})=>{
   const bits=[];
   if(type==='weapon'){
    if(v.d!=null)bits.push('攻撃力 '+v.d);
    if(v.a!=null)bits.push('命中補正 '+signed(v.a)+'pt');
    if(v.p!=null)bits.push('貫通 '+v.p);
    if(v.shots!=null)bits.push('連射 '+v.shots);
    if(v.max!=null)bits.push('耐久 '+v.max);
    if(v.ammo&&typeof AM!=='undefined')bits.push('弾薬 '+(AM[v.ammo]?.n||v.ammo));
   }else{
    if(v.def!=null)bits.push('防御力 '+v.def);
    if(v.max!=null)bits.push('最大耐久 '+v.max);
    if(v.kg!=null)bits.push('容量 '+v.kg);
   }
   for(const [key,label] of [['accuracy','命中率'],['evasion','回避率'],['attack','攻撃力'],['encounterReduction','敵遭遇率軽減'],['reloadBonus','リロード回数補正'],['poisonResist','毒耐性']]){
    if(v[key]!=null)bits.push(label+' '+signed(v[key])+(key==='encounterReduction'?'': 'pt'));
   }
   if(v.special&&typeof v.special==='string')bits.push('固有効果 '+v.special+(v.specialValue!=null?' ('+v.specialValue+')':''));
   if(v.description)bits.push(String(v.description));
   if(v.effect)bits.push(String(v.effect));
   if(typeof BOSS_FIXED!=='undefined'&&BOSS_FIXED[key])bits.push('固有効果：'+BOSS_FIXED[key]);
   if(key==='bombbag'&&v.grenadeAccuracy!=null&&!bits.some(x=>x.includes('グレネード命中')))bits.push('全グレネード命中率 +'+v.grenadeAccuracy+'pt');
   return '<div class="item" style="margin:8px 0"><b>'+esc(v.n)+'</b><p style="margin:6px 0;line-height:1.65">'+esc(bits.join(' ／ ')||'固有効果の設定を確認してください')+'</p></div>';
  }).join('');
  const dossier=typeof BOSS_DOSSIER_V1!=='undefined'?BOSS_DOSSIER_V1[id]:null;
  const supplemental=dossier?.weaponDetail?'<p class="muted" style="margin:8px 0">固有装備の詳細：'+esc(dossier.weaponDetail)+'</p>':'';
  if(details||supplemental){
   const panel=document.createElement('div');panel.className='tok-normal-boss-reward-performance';
   panel.innerHTML='<h3>固有ドロップ装備の性能</h3>'+details+supplemental;
   rewardBox.appendChild(panel);
  }
  return host.innerHTML;
 };
})();
</script>

<script id="tok-military-reward-performance-6368">
/* Single equipment-data-driven dossier; no boss names treated as equipment. */
(function(){
 const prior=bossBattleScreen;
 const rewards={
  1:[['helmet','ex_bastion']],2:[['bag','ex_hive']],3:[['weapon','ex_berserker']],
  4:[['accessory','ex_bombers_eye']],5:[['armor','ex_bison_rig']],
  6:[['helmet','ex_whiteout']],7:[['weapon','ex_silent_knife']],8:[['accessory','ex_ironheart']],
  9:[['weapon','ex_agyo'],['weapon','ex_ungyo']],10:[['weapon','ex_punishment']],
  11:[['weapon','ex_tesla_railgun']],12:[['armor','ex_ghost_cloak']],
  13:[['accessory','ex_chrono_watch']],14:[['attachment','ex_old_scope']],
  15:[['accessory','ex_brothers_tags']]
 };
 const types={weapon:()=>W,armor:()=>A,helmet:()=>H,bag:()=>B,accessory:()=>TOK_ACCESSORIES,attachment:()=>ATTACH};
 const esc=v=>escapeHTML(String(v==null?'':v));
 const num=v=>(Number(v)>0?'+':'')+Number(v);
 function itemDetails(type,id){
  const v=types[type]?.()?.[id];if(!v)return null;
  const lines=[];
  if(type==='weapon'){
   if(v.d!=null)lines.push('攻撃力 '+v.d);
   if(v.a!=null)lines.push('命中補正 '+num(v.a)+'pt');
   if(v.p!=null)lines.push('貫通力 '+v.p);
   if(v.shots!=null)lines.push('連射 '+v.shots);
   if(v.max!=null)lines.push('最大耐久 '+v.max);
  }else if(type==='armor'||type==='helmet'){
   if(v.def!=null)lines.push('防御力 '+v.def);
   if(v.max!=null)lines.push('最大耐久 '+v.max);
  }else if(type==='bag'){
   if(v.kg!=null)lines.push('容量 '+v.kg);
   if(v.max!=null)lines.push('最大耐久 '+v.max);
  }
  if(type==='attachment'){
   const effect=typeof ATT_EFFECT!=='undefined'?ATT_EFFECT[id]:null;
   if(Array.isArray(effect)&&effect.length&&effect.every(x=>x===effect[0]))lines.push('命中率 '+num(effect[0])+'pt');
   else if(effect!=null)lines.push('装着補正 '+esc(JSON.stringify(effect)));
   lines.push('対応武器：狙撃銃（SVDなど）');
  }
  const extra={
   ex_bastion:'回避率 '+num(v.evasion||0)+'pt／ヘッドショット被ダメージ追加軽減 '+Math.round((v.headshotExtraReduction||0)*100)+'%',
   ex_hive:'ドローン制御装置内蔵',
   ex_bombers_eye:'グレネード命中率 '+num(v.grenadeAccuracy||0)+'pt',
   ex_bison_rig:'リロードまでの攻撃回数 '+num(v.reloadBonus||0),
   ex_whiteout:'煙幕の命中率低下を無効化。煙幕中、命中率＋10pt',
   ex_ironheart:'最大HP＋30／防御力＋10',
   ex_agyo:'固有効果：命中率＋10pt',
   ex_ungyo:'固有効果：回避率＋10pt',
   ex_chrono_watch:'回避率＋10pt',
   ex_brothers_tags:'攻撃力＋15／回避率＋15pt'
  };
  if(extra[id])lines.push(extra[id]);
  if(typeof BOSS_FIXED!=='undefined'&&BOSS_FIXED[id]&&!extra[id])lines.push('固有効果：'+BOSS_FIXED[id]);
  if(id==='ex_ghost_cloak')lines.push('回避率＋15pt');
  return {name:v.n,lines};
 }
 bossBattleScreen=function(){
  const html=prior();
  if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
  const host=document.createElement('div');host.innerHTML=html;
  const dossier=host.querySelectorAll('section.tok-mil-dossier')[1];
  const floor=Number(dossier?.querySelector('h2')?.textContent.match(/^\s*(\d+)F/)?.[1]);
  if(!dossier||!rewards[floor])return html;
  dossier.querySelectorAll('.tok-military-reward-performance').forEach(el=>el.remove());
  const box=document.createElement('div');box.className='item tok-military-reward-performance';
  const rows=rewards[floor].map(([type,id])=>{
   const info=itemDetails(type,id);
   if(!info)return '<div class="item"><b>'+esc(id)+'</b><p>装備定義を確認できません</p></div>';
   return '<div class="item" style="margin:10px 0"><b>'+esc(info.name)+'</b><p style="margin:6px 0;line-height:1.7">'+info.lines.map(esc).join(' ／ ')+'</p></div>';
  });
  box.innerHTML='<h3>固有ドロップ装備の性能（プレイヤー装備時）</h3>'+rows.join('');
  const art=dossier.querySelector('.tok-ex-unique-art');
  if(art)art.insertAdjacentElement('afterend',box);else dossier.appendChild(box);
  return host.innerHTML;
 };
})();
</script>

<script>
/* v3.6.69 — Ex Military 16–20F: approved boss designs, battle flow and rewards. */
(function(){
 const specs={
 16:['フロストバイト',220,25,35,80,15,40,'ex_cryo','ex_cryo','weapon'],
 17:['オーバードーズ',200,25,25,85,20,35,'pps43','ex_adrenaline','accessory'],
 18:['キャプテンブレイカー',240,35,40,90,30,45,'ex_gloves','ex_gloves','weapon'],
 19:['ジャガーノート',300,40,65,75,5,55,'ex_rockets','ex_rockets','weapon'],
 20:['マーシャル',350,40,50,90,25,60,'ex_last_order','ex_last_order','weapon']
 };
 const rewards={16:'クライオブラスター',17:'アドレナリンポンプ',18:'強化コンバットグローブ',19:'連装ロケットランチャー',20:'ラストオーダー'};
 const details={
 16:'武器固有「凍傷」：命中時30%で3ターン、回避−15pt・毎ターン10ダメージ。ボス固有「冷却装甲」：通常被ダメ−20%、火傷中は逆に被ダメ＋20%。',
 17:'ボス固有「段階的ドーピング」：HP75%・50%・25%で攻撃＋10・命中＋10pt・回避＋10pt（累積）。各投与時5%で中毒死。中毒死でも通常撃破報酬。',
 18:'ボス固有「カウンター」：近距離で攻撃を回避すると30%で威力50%の反撃。武器固有「連撃」：命中時30%で威力50%の追加攻撃。',
 19:'ボス固有「装甲破損」：HP50%以下で攻撃＋20・防御−30・命中＋10pt。肩部連装ロケットは2発独立判定、発射後2ターン再装填。近距離命中−30pt。',
 20:'ボス固有「戦術切替」：開始時ランダム、3ターンごとに直前以外の態勢へ変更。攻撃態勢：攻＋20・防−20／防御態勢：防＋30・攻−15／精密射撃：命中＋10pt・貫通＋20。武器固有「戦術適応」：近距離攻＋10／中距離命中＋10pt／遠距離貫通＋20。'
 };
 for(const [k,s] of Object.entries(specs)){
  const f=Number(k);TOK_MIL_FLOORS[f-1].splice(1,8,...s.slice(0,8));EX_NAMES[f-1]=s[0];
 }
 W.ex_cryo={n:'クライオブラスター',d:25,a:0,p:40,price:220000,shots:1,ammoFree:true,fixed:true,max:110};
 W.ex_gloves={n:'強化コンバットグローブ',d:35,a:0,p:45,price:230000,shots:1,ammoFree:true,melee:true,fixed:true,max:120};
 W.ex_rockets={n:'連装ロケットランチャー',d:50,a:0,p:70,price:300000,shots:2,ammoFree:true,fixed:true,max:150};
 W.ex_last_order={n:'ラストオーダー',d:40,a:0,p:60,price:350000,shots:2,ammo:'762x51',fixed:true,max:150};
 TOK_ACCESSORIES.ex_adrenaline={n:'アドレナリンポンプ',price:220000};
 Object.assign(BOSS_FIXED,{
  ex_cryo:'攻撃25／貫通40／耐久110／リロードなし。中距離命中−20pt、遠距離攻撃不可。命中時30%で凍傷（3ターン、回避−15pt・毎ターン10ダメージ）',
  ex_adrenaline:'HP50%以下で1レイド1回発動。攻撃＋10／命中＋10pt／回避＋10pt、レイド終了まで持続。副作用なし',
  ex_gloves:'攻撃35／貫通45／耐久120／近距離のみ／リロードなし。命中時30%で威力50%の連撃',
  ex_rockets:'1発攻撃50／貫通70／耐久150／2発独立判定。近距離命中−30pt、発射後2ターン再装填',
  ex_last_order:'攻撃40／貫通60／耐久150／2連射／3回攻撃後リロード。近距離攻撃＋10、中距離命中＋10pt、遠距離貫通＋20'
 });
 const ids=new Set(['ex_cryo','ex_adrenaline','ex_gloves','ex_rockets','ex_last_order']);
 const priorOnly=isBossOnlyGear;
 isBossOnlyGear=function(type,id){return ids.has(id)||priorOnly(type,id)};
 for(const item of (g?.gear||[]))if(ids.has(item.base))item.rarity='boss';
 const oldAccessory=tokAccessoryValue;
 tokAccessoryValue=function(item,key){
  if(item?.base==='ex_adrenaline'&&g?.raid&&g.raid.hp>0){
   const r=g.raid;if(r.hp<=maxRaidHp(r)*.5)r._exAdrenalineActive=true;
   if(r._exAdrenalineActive&&['attack','accuracy','evasion'].includes(key))return 10;
  }
  return oldAccessory(item,key);
 };
 const oldDrop=tokMilEquipmentDrop;
 tokMilEquipmentDrop=function(r,f){
  if(f<16||f>20)return oldDrop(r,f);
  const s=specs[f],x=makeGear(r,s[9],s[8],'boss');x.affixes=[];x.sourceBoss='military-'+f;
  if(s[9]==='weapon')x.dur=W[s[8]].max;
  return x;
 };
 // Player-owned special weapons use the existing hit/damage/equipment engine.
 const oldPlayerAttack=playerAttack;
 playerAttack=function(r,e,hp){
  const id=r.weapon,dist=Number.isInteger(r.combatDistance)?r.combatDistance:1;
  if(!['ex_cryo','ex_gloves','ex_rockets','ex_last_order'].includes(id))return oldPlayerAttack(r,e,hp);
  if((id==='ex_cryo'&&dist===2)||(id==='ex_gloves'&&dist!==0)){log(r,'【'+W[id].n+'】射程外');return 0}
  if(id==='ex_rockets'){
   r._exRocketCycle=(r._exRocketCycle||0)%3+1;
   if(r._exRocketCycle!==1){log(r,'【連装ロケットランチャー】再装填（攻撃休止）');return 0}
  }
  const w=W[id],origA=w.a,origD=w.d,origP=w.p;
  if(id==='ex_cryo'&&dist===1)w.a-=20;
  if(id==='ex_rockets'&&dist===0)w.a-=30;
  if(id==='ex_last_order'){
   if(dist===0)w.d+=10;else if(dist===1)w.a+=10;else w.p+=20;
  }
  let dealt=0;
  try{dealt=oldPlayerAttack(r,e,hp)}finally{w.a=origA;w.d=origD;w.p=origP}
  if(id==='ex_gloves'&&dealt>0&&roll(r,.30)){
   const extra=Math.max(1,Math.floor(dealt*.5));dealt+=extra;log(r,'【連撃】追撃：'+extra+'ダメージ');
  }
  if(id==='ex_cryo'&&dealt>0&&roll(r,.30)){
   e._exFrostTurns=3;log(r,'【凍傷】敵の回避率−15pt／3ターン、毎ターン10ダメージ');
  }
  return dealt;
 };
 const oldBattle=tokMilBossBattle;
 const modes=['攻撃態勢','防御態勢','精密射撃'];
 function setMode(r,e,previous){
  const available=modes.filter(x=>x!==previous),mode=available[Math.floor(rand(r)*available.length)];
  e._exMode=mode;log(r,'【戦術切替】'+mode);return mode;
 }
 function bossStrike(r,e,weapon,hit,damage,pen,shots){
  const w=W[weapon],orig={...w};
  try{
   w.d=damage;w.p=pen;w.a=0;w.shots=shots||1;w.ammoFree=true;
   enemyStrike(r,{...e,enemyWeapon:weapon,hit,_weaponState:e,specialShots:shots||1});
  }finally{Object.assign(w,orig)}
 }
 function bossAction(r,e,f,turn){
  const dist=Number.isInteger(r.combatDistance)?r.combatDistance:1;
  if(f===16){
   if(dist===2){if(roll(r,.70)){r.combatDistance=1;log(r,'【フロストバイト】中距離へ接近')}else log(r,'【フロストバイト】接近失敗');return}
   const before=r.hp;bossStrike(r,e,'ex_cryo',e.hit-(dist===1?20:0),25,40,1);
   if(r.hp<before&&roll(r,.30)){r._exFrostTurns=3;log(r,'【凍傷】回避率−15pt、3ターン毎ターン10ダメージ')}
  }else if(f===17){bossStrike(r,e,'pps43',e.hit,e.d,e.pen,3)}
  else if(f===18){
   if(dist!==0){if(roll(r,.70)){r.combatDistance=Math.max(0,dist-1);log(r,'【キャプテンブレイカー】接近成功')}else log(r,'【キャプテンブレイカー】接近失敗');return}
   const before=r.hp;bossStrike(r,e,'ex_gloves',e.hit,35,45,1);
   if(r.hp<before&&roll(r,.30)){const extra=Math.max(1,Math.floor((before-r.hp)*.5));r.hp=Math.max(0,r.hp-extra);log(r,'【連撃】追加攻撃：-'+extra+'HP')}
  }else if(f===19){
   if(turn%3!==1){log(r,'【連装ロケットランチャー】再装填中');return}
   bossStrike(r,e,'ex_rockets',e.hit-(dist===0?30:0),50,70,2);
  }else if(f===20){
   const d=e.d+(dist===0?10:0),hit=e.hit+(dist===1?10:0),pen=e.pen+(dist===2?20:0);
   bossStrike(r,e,'ex_last_order',hit,d,pen,2);
  }
 }
 tokMilBossBattle=function(r){
  const f=r.militaryFloor;if(f<16||f>20)return oldBattle(r);
  tokPrepareEncounterReload(r);
  const s=specs[f],e={n:s[0],kind:'boss',hp:s[1],maxHp:s[1],d:s[2],def:s[3],hit:s[4],ev:s[5],pen:s[6],enemyWeapon:s[7],actions:0,magActions:0,flashTurns:0,pursuit:15};
  r.bossEncountered=true;r.militaryBossRarity='boss';r.combatDistance=Number.isInteger(r.combatDistance)?r.combatDistance:1;
  log(r,'【Ex軍事施設 '+f+'F】'+e.n+' HP'+e.hp);
  let phase=0,mode=null;
  try{
   for(let turn=1;turn<=12;turn++){
    if(!hasCombatWeapon(r))break;
    turnCare(r);if(r.hp<=0)return 'dead';
    if(r._exFrostTurns>0){r.hp=Math.max(0,r.hp-10);r._exFrostTurns--;log(r,'【凍傷】継続ダメージ−10HP');if(r.hp<=0)return 'dead'}
    if(e._exFrostTurns>0){e.hp=Math.max(0,e.hp-10);e._exFrostTurns--;log(r,'【凍傷】敵に継続ダメージ10')}
    if(f===20&&((turn-1)%3===0)){
     mode=setMode(r,e,mode);e.d=s[2];e.def=s[3];e.hit=s[4];e.pen=s[6];
     if(mode==='攻撃態勢'){e.d+=20;e.def-=20}
     else if(mode==='防御態勢'){e.d-=15;e.def+=30}
     else{e.hit+=10;e.pen+=20}
    }
    if(f===17){
     for(const threshold of [150,100,50])if(e.hp<=threshold&&!e['_exDose'+threshold]){
      e['_exDose'+threshold]=true;
      if(roll(r,.05)){e.hp=0;log(r,'【段階的ドーピング】薬物中毒死！');break}
      e.d+=10;e.hit+=10;e.ev+=10;log(r,'【段階的ドーピング】攻撃＋10／命中＋10pt／回避＋10pt');
     }
    }
    if(f===19&&e.hp<=150&&!e._exBroken){e._exBroken=true;e.d+=20;e.def-=30;e.hit+=10;log(r,'【装甲破損】攻撃＋20／防御−30／命中＋10pt')}
    if(e.hp>0){
     const before=e.hp,originalEv=e.ev,originalDef=e.def;
     if(e._exFrostTurns>0)e.ev=Math.max(0,e.ev-15);
     if(f===16)e.def=Math.max(0,e.def);
     const hpBeforeThrow=e.hp;
     const thrown=throwGrenade(r,[e],'boss');
     if(thrown&&f===16&&e.hp<hpBeforeThrow){const raw=hpBeforeThrow-e.hp,adjusted=Math.floor(raw*(e.burnTurns>0?1.2:.8));e.hp=Math.max(0,hpBeforeThrow-adjusted);log(r,'【冷却装甲】投擲ダメージ '+raw+' → '+adjusted)}
     const logStart=r.log.length;
     let dealt=0;
     if(!thrown){
      dealt=playerAttack(r,e,e.hp);
      if(f===16)dealt=Math.max(0,Math.floor(dealt*(e.burnTurns>0?1.2:.8)));
      e.hp=Math.max(0,e.hp-dealt);
     }
     e.ev=originalEv;e.def=originalDef;
     if(f===18&&r.combatDistance===0&&!thrown&&r.log.slice(logStart).some(x=>/回避/.test(String(x))&&!/回避率|回避補正|回避低下|回避強化/.test(String(x)))&&roll(r,.30)){
      log(r,'【カウンター】回避からの反撃');bossStrike(r,e,'ex_gloves',e.hit,Math.floor(35*.5),45,1);
     }
    }
    if(f===17&&e.hp>0){
     for(const threshold of [150,100,50])if(e.hp<=threshold&&!e['_exDose'+threshold]){
      e['_exDose'+threshold]=true;
      if(roll(r,.05)){e.hp=0;log(r,'【段階的ドーピング】薬物中毒死！');break}
      e.d+=10;e.hit+=10;e.ev+=10;log(r,'【段階的ドーピング】攻撃＋10／命中＋10pt／回避＋10pt');
     }
    }
    if(f===19&&e.hp>0&&e.hp<=150&&!e._exBroken){e._exBroken=true;e.d+=20;e.def-=30;e.hit+=10;log(r,'【装甲破損】攻撃＋20／防御−30／命中＋10pt')}
    if(e.hp<=0){
     r.kills++;r.xp+=45+f*12;r.militaryBossWon=true;
     const kills=Number(tokMilState().kills[f]||0);
     if(kills===0||roll(r,.20)){
      const item=tokMilEquipmentDrop(r,f);(r.gearLoot||(r.gearLoot=[])).push(item);
      log(r,'【ボス固有ドロップ】'+rewards[f]+'を獲得');
     }else log(r,'【ボス固有ドロップ】今回はドロップなし');
     log(r,'【階層制覇】'+e.n+'を撃破！ '+f+'Fクリア');return 'won';
    }
    bossAction(r,e,f,turn);e.actions++;
    if(r.hp<=0)return 'dead';
    if(!hasCombatWeapon(r)||r.hp<=Math.max(8,Math.floor((r.maxHp||baseMaxHp())*.2)))break;
   }
   log(r,'【ボス未撃破】'+e.n+'から撤退を試みる');
   const result=escapeCombat(r,e);return result==='dead'||result==='final'?'dead':'escaped';
  }finally{delete r._exFrostTurns;delete r._exRocketCycle;delete r._exAdrenalineActive}
 };
 const previousDossier=bossBattleScreen;
 bossBattleScreen=function(){
  let html=previousDossier();if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
  const f=Number((html.match(/<h2>(\d+)F /)||[])[1]);if(f<16||f>20)return html;
  const s=specs[f],weapon=W[s[7]]?.n||s[7];
  const section='<div class="item"><h3>ボス固有能力・武器固有能力</h3><p>'+escapeHTML(details[f])+'</p></div>'+
   '<div class="item"><h3>固有報酬</h3><p>'+escapeHTML(rewards[f])+'（BOSS UNIQUE）</p><p>'+escapeHTML(BOSS_FIXED[s[8]])+'</p><p class="muted">初回確定、以降20%抽選。</p></div>';
  return html.replace(/<div class="item"><h3>階層情報<\/h3>[\s\S]*?<\/div>/,section)
   .replace(/<div class="item"><h3>使用武器<\/h3><p>[\s\S]*?<\/p><\/div>/,'<div class="item"><h3>使用武器</h3><p>'+escapeHTML(weapon)+'</p></div>');
 };
})();

</script>

<script id="tok-ex-16-20-artwork-6370">
/* v3.6.70 — user-supplied boss portraits and unique equipment art, floors 16–20. */
(function(){
 const portraits=["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
 const drops=["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
 const rewardNames=['クライオブラスター','アドレナリンポンプ','強化コンバットグローブ','連装ロケットランチャー','ラストオーダー'];
 const rewardKeys=['ex_cryo','ex_adrenaline','ex_gloves','ex_rockets','ex_last_order'];
 for(let i=0;i<5;i++)TOK_EX_BOSS_PORTRAITS[15+i]=portraits[i];
 for(let i=0;i<5;i++){
   if(i===1)TOK_ACCESSORY_IMAGES[rewardKeys[i]]=drops[i];
   else TOK_WEAPON_IMAGES[rewardKeys[i]]=drops[i];
 }
 function portrait(f,compact){
   const name=EX_NAMES[f-1],src=portraits[f-16];
   return '<figure class="tok-ex-boss-photo'+(compact?' compact':'')+'"><img loading="lazy" decoding="async" src="'+src+'" alt="'+escapeHTML(name)+'"><figcaption>'+f+'F '+escapeHTML(name)+'</figcaption></figure>';
 }
 const oldBossScreen=bossBattleScreen;
 bossBattleScreen=function(){
   const html=oldBossScreen();
   if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
   const host=document.createElement('div');host.innerHTML=html;
   const dossier=host.querySelectorAll('section.tok-mil-dossier')[1];
   const f=Number(dossier?.querySelector('h2')?.textContent.match(/^\s*(\d+)F\s/)?.[1]);
   if(f<16||f>20||!dossier)return html;
   const idx=f-16,heading=dossier.querySelector('h2');
   // Match floors 1-15: show boss portraits without requiring a prior defeat.
   if(!dossier.querySelector('.tok-ex-boss-photo'))heading.insertAdjacentHTML('afterend',portrait(f,false));
   if(!dossier.querySelector('.tok-ex-unique-art')){
     const item=document.createElement('div');item.className='item tok-ex-unique-art';
     item.innerHTML='<h3>固有装備画像</h3><figure class="tok-ex-asset-art"><img loading="lazy" decoding="async" src="'+drops[idx]+'" alt="'+rewardNames[idx]+'"><figcaption>'+rewardNames[idx]+'（BOSS UNIQUE）</figcaption></figure>';
     const perf=dossier.querySelector('.tok-military-reward-performance');
     if(perf)perf.insertAdjacentElement('beforebegin',item);else dossier.appendChild(item);
   }
   return host.innerHTML;
 };
 const oldFloorPanel=tokMilFloorPanel;
 tokMilFloorPanel=function(){
   const html=oldFloorPanel(),m=tokMilState(),f=Number(m.floor);
   if(m.mode!=='military'||f<16||f>20)return html;
   const host=document.createElement('div');host.innerHTML=html;
   const list=host.querySelector('.tok-mil-floor-list');
   if(list&&!host.querySelector('.tok-ex-boss-photo'))list.insertAdjacentHTML('afterend',portrait(f,true));
   return host.innerHTML;
 };
 const oldRaidView=raidView;
 raidView=function(){
   const html=oldRaidView(),r=g.raid,f=Number(r?.militaryFloor);
   if(!r?.exVersion||f<16||f>20)return html;
   const host=document.createElement('div');host.innerHTML=html;
   const heading=host.querySelector('section.panel h2');
   if(heading&&!host.querySelector('.tok-ex-boss-photo'))heading.insertAdjacentHTML('afterend',portrait(f,true));
   return host.innerHTML;
 };
})();
</script>

<script>/* v3.6.72: Boss weapon registry alignment (source-of-truth: confirmed boss encounter loadouts). */
(function(){
 const loadouts={
  1:['ハリネズミ','ex_hedgehog'],2:['ベルゼバブ','tt'],3:['ハリケーン','ex_berserker'],4:['トラッパー','pm'],5:['バイソン','ex_pkp_boss'],
  6:['ホワイトホット','glock17'],7:['サイレント','ex_silent_knife'],8:['クラッシャー','ex_crusher_arm'],9:['ツインファング','ex_agyo'],10:['教官','m4a1'],
  11:['テスラ','ex_tesla_railgun'],12:['実験体28号','aug'],13:['クロノス','mp5'],14:['オールドワン','mosin'],15:['ブラッドブラザーズ','scarh'],
  16:['フロストバイト','ex_cryo'],17:['オーバードーズ','pps43'],18:['キャプテンブレイカー','ex_gloves'],19:['ジャガーノート','ex_rockets'],20:['マーシャル','ex_last_order']
 };
 for(const [floor,entry] of Object.entries(loadouts)){
  const i=Number(floor)-1,record=TOK_MIL_FLOORS[i];if(!record)continue;
  record[1]=entry[0];record[8]=entry[1];EX_NAMES[i]=entry[0];
 }
 // Multi-weapon bosses retain their encounter-specific attack routines:
 // 9F 阿形 + 吽形, 10F M4A1 + 懲罰棒, 15F VPO-136 + SCAR-H.
})();</script>
