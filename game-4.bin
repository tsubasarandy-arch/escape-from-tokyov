.tok-manual{line-height:1.85;overflow-wrap:anywhere}.tok-manual h3{font-size:18px;margin:23px 0 9px;color:var(--tok-accent,#b4c8a2)}.tok-manual h4{margin:17px 0 7px}.tok-manual p{margin:9px 0}.tok-manual-table{overflow-x:auto;margin:12px 0}.tok-manual table{width:100%;border-collapse:collapse;font-size:13px}.tok-manual td,.tok-manual th{padding:9px;border:1px solid #52645b;text-align:left;vertical-align:top}.tok-manual th{background:#283b34}.tok-manual-index{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:7px}.tok-manual-index a{padding:8px;border:1px solid var(--tok-accent,#708b73);border-radius:8px;color:inherit;text-decoration:none}.tok-theme-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px}.tok-theme-option{display:flex;align-items:center;gap:10px;min-height:60px;text-align:left}.tok-theme-swatch{width:35px;height:35px;flex:none;border-radius:50%;border:2px solid #ffffff66}.tok-theme-option[aria-pressed="true"]{outline:3px solid var(--tok-accent,#8cab88)}
body[data-tok-theme="forest"]{--tok-accent:#a4cb9a;--panel:#192a23;--line:#49634d;--green:#a4cb9a}
body[data-tok-theme="ocean"]{--tok-accent:#7bc9e0;--panel:#152b36;--line:#386778;--green:#7bc9e0}
body[data-tok-theme="sand"]{--tok-accent:#e2c68e;--panel:#30291f;--line:#79684a;--green:#e2c68e}
body[data-tok-theme="violet"]{--tok-accent:#c7a6ed;--panel:#292338;--line:#66527d;--green:#c7a6ed}
body[data-tok-theme="mono"]{--tok-accent:#e2e6e8;--panel:#23272a;--line:#687078;--green:#e2e6e8}
body[data-tok-theme] {background:var(--tok-page-bg,#0d1614)!important;color:#e9f0ec!important}
body[data-tok-theme="forest"]{--tok-page-bg:#0c1712;--tok-panel-bg:#192a23;--tok-border:#49634d;--tok-button:#2d443a;--tok-primary:#597b62}
body[data-tok-theme="ocean"]{--tok-page-bg:#0b1923;--tok-panel-bg:#152b36;--tok-border:#386778;--tok-button:#244554;--tok-primary:#356c81}
body[data-tok-theme="sand"]{--tok-page-bg:#211b15;--tok-panel-bg:#30291f;--tok-border:#79684a;--tok-button:#4b3d2c;--tok-primary:#826a43}
body[data-tok-theme="violet"]{--tok-page-bg:#181422;--tok-panel-bg:#292338;--tok-border:#66527d;--tok-button:#403551;--tok-primary:#73568c}
body[data-tok-theme="mono"]{--tok-page-bg:#141719;--tok-panel-bg:#23272a;--tok-border:#687078;--tok-button:#343a3e;--tok-primary:#657079}
body[data-tok-theme] .panel,body[data-tok-theme] .hero,body[data-tok-theme] .item,body[data-tok-theme] .stat{background:var(--tok-panel-bg)!important;border-color:var(--tok-border)!important}
body[data-tok-theme] button:not(.danger),body[data-tok-theme] .v3-subnav button{background:var(--tok-button)!important;border-color:var(--tok-border)!important;color:#f4f6f4!important}
body[data-tok-theme] button.primary,body[data-tok-theme] button.on,body[data-tok-theme] .v3-subnav button.on,body[data-tok-theme] .tabs button.on{background:var(--tok-primary)!important}
body[data-tok-theme] header,body[data-tok-theme] .tabs{background:var(--tok-page-bg)!important;border-color:var(--tok-border)!important}
body[data-tok-theme] input,body[data-tok-theme] select,body[data-tok-theme] textarea{background:var(--tok-page-bg)!important;border-color:var(--tok-border)!important;color:#fff!important}
</style>
<script id="tok-manual-theme-script">
(function(){
 const manualHTML="<h2>Escape from Tokyov<\/h2><p>初心者向けプレイマニュアル<\/p><p>対象：Webゲーム版 v3.6.99 ／ 初めて遊ぶ方から、各種システムを理解したい方まで<\/p><p>本書はゲームHTMLに表示される説明・設定・一部の実装を参照し、これまでに確認された正式仕様を反映したガイドです。旧仕様「重要任務品3種の収集でクリア」は廃止されているため採用しません。<\/p><h3>最初の5分で覚えること<\/h3><p>・ゲームの目的は最終ボス「ゼロ」の討伐です。<\/p><p>・出撃前に武器・防具・バッグ・弾薬・医療品・グレネードを準備します。<\/p><p>・通常レイドは「探索イベント」と「戦闘ラウンド」が別です。最大12ラウンドは一度の戦闘の制限であり、探索の制限ではありません。<\/p><p>・戦利品は生きて帰ることが重要です。探索を欲張りすぎないことが基本です。<\/p><p>・敗北時は必ず詳細ログを読み、命中・ジャム・リロード・ヘッドショット・状態異常を確認します。<\/p><h3>1　ゲームの始め方と保存<\/h3><p>タイトル画面には NEW GAME、CONTINUE、LOAD、設定などがあります。新規開始は NEW GAME、保存済みの進行を再開するときは CONTINUE を使用します。LOAD は保存データの読み込みに用います。ゲームデータは端末側に保存され、オフラインで動作します。<\/p><p>重要：端末のデータ削除やブラウザー環境の変更で進行を失う可能性があります。設定画面からバックアップを作り、別の場所にも保管してください。<\/p><h3>2　3つの出撃モード<\/h3><p>初心者は通常レイドで装備と戦闘の基礎を学び、資源が必要なら長期探索、装備と資金が整ったら軍事施設へ挑戦するのがおすすめです。<\/p><h3>3　通常レイド：探索と脱出<\/h3><p>出撃準備ではマップ、探索目標、探索方針、詳細設定を選びます。探索目標は5～30イベントの範囲です。戦闘が発生すると戦闘ラウンドへ移行しますが、これは探索イベント数とは別に数えます。<\/p><p>足の骨折がある場合は原則+2イベント、ナイファーの条件を満たす場合は−1イベント（最低1）です。探索を長くするほど回収機会は増えますが、帰還までに遭遇する危険も増えます。<\/p><p>探索方針には生存重視、通常、換金品重視、装備重視、容量重視などがあります。まずは生存重視または通常で短い探索を試しましょう。<\/p><h3>4　出撃前の装備チェック<\/h3><p>□ メイン武器・サブ武器：対応する弾薬と射程、攻撃回数を確認。<\/p><p>□ 頭・胴の防具：防御値だけでなく耐久度も確認。<\/p><p>□ バッグ：予備弾薬、医療品、グレネード、戦利品のための容量を確保。<\/p><p>□ 予備弾薬：口径ごとに携行数を設定。同口径の銃は弾薬を共有。<\/p><p>□ 医療品：包帯、解毒薬、救急キット、高級医療キット、副木、火傷治療薬などを必要に応じて携行。<\/p><p>□ グレネード：専用スロットと使用条件を設定。<\/p><p>□ アタッチメント：武器に対応する部位へ装着。<\/p><p>□ 戦闘スタイル：装備と目的に合う設定か確認。<\/p><h3>5　弾薬とバッグ容量<\/h3><p>携行弾薬は口径別に管理します。原則の初期設定は30発。装填済み分を除く予備弾薬は30発ごとにバッグ1枠を使います。医療品は種類により1～2枠を使用します。グレネードにも携行設定があります。<\/p><p>バッグ容量を全部戦利品に使う計画は危険です。戦闘が続いた場合の予備弾薬と、帰還中に使う医療品のための余裕を残しましょう。<\/p><h3>6　戦闘の基本<\/h3><p>敵と遭遇すると自動戦闘が始まります。命中、回避、貫通、防御、戦闘距離、連射、リロードなどが結果を左右します。戦闘は最初の6ラウンドで決着しなければ離脱を試み、離脱できない場合はさらに最大6ラウンド戦います。最大12ラウンドは一度の戦闘の上限です。<\/p><p>近距離・中距離・遠距離で武器の相性や命中補正が変わります。敵の特殊能力や接近行動もログで確認できます。<\/p><h3>7　ヘッドショットと一撃死<\/h3><p>ヘッドショットは頭部への命中です。通常攻撃とは異なるダメージ計算が行われ、ヘルメットの性能が重要になります。実装上、敵からの通常ヘッドショット率15%、基本威力補正1.75倍の処理があります。ただしボス固有能力などで例外があります。<\/p><p>ヘッドショットには一撃死判定が関係する場合があります。HPが十分に見えても安全とは限りません。頭防具の耐久、敵の貫通力、戦闘ログの一撃死表示に注意してください。<\/p><h3>8　ジャム・リロード・連射<\/h3><p>ジャムは銃の作動不良で、その射撃が失敗します。追加のジャム解除ターンはありませんが、攻撃機会を失います。強敵に挑む前は武器の耐久率を75%超に保つと安心です。<\/p><p>武器ごとにリロードまでの攻撃回数が異なります。連射は弾ごとに命中判定があり、連射減衰や弾薬消費が発生します。戦闘ログにリロードが多ければ、拡張マガジンや武器構成を検討してください。<\/p><h3>9　アタッチメント<\/h3><p>武器によって装着可能な部位が異なります。拠点で装着・交換・取り外しができます。命中率だけでなく、敵との距離や連射方式に合う構成を選びましょう。<\/p><h3>10　戦闘スタイル<\/h3><p>アキンボは対応ハンドガンを両手に装備する特殊スタイルで、二丁が独立して攻撃します。ナイファーは特定の軽装・武器構成で成立し、回避+10pt、脱出イベント−1の利点があります。<\/p><h3>11　グレネードの設定<\/h3><p>フラグ、フラッシュ、モロトフ、ガス、スモークの5種類があり、最大6個を専用スロットに設定できます。<\/p><p>投擲タイミング：戦闘開始時／毎ターン／2ターンごと／3ターンごと／ランダム30%／HP70%未満／40%未満／20%未満。使用方針：ボス戦のみ／複数敵優先／強敵優先／無差別使用。条件を満たした際に自動投擲され、1回の攻撃機会につき最大1個です。<\/p><p>初心者は高価なグレネードを雑魚戦で使い切らないよう、「ボス戦のみ」などの設定を確認してください。<\/p><h3>12　医療品・負傷・状態異常<\/h3><p>携行できる医療品には包帯、解毒薬、救急キット、高級医療キット、副木、火傷治療薬があります。出血、毒、火傷、腕・足の骨折など、症状によって必要な対策が異なります。<\/p><p>負傷中は命中、回避、脱出などにも不利が生じます。HPが残っていても状態異常が重なれば危険です。医療品の自動使用設定と携行数を確認しましょう。<\/p><h3>13　防具・バッグ・セットボーナス<\/h3><p>頭・胴・バッグの組み合わせにより、同一シリーズまたは重量規格の2部位以上でセットボーナスが発動し、3部位で強化されます。シリーズにはゴースト、タートル、ゴリラ、フォックス、フェニックス、オクトパス、重量規格にはライト、タクティカル、ヘビーがあります。<\/p><p>シリーズ効果と重量規格の効果は同時発動可能です。例えばゴーストは命中、タートルは最大HP、ゴリラは攻撃、フォックスは希少品、フェニックスは状態異常耐性に関係します。装備単体の性能だけでなく組み合わせも確認してください。<\/p><h3>14　装備耐久・修理・倉庫<\/h3><p>装備には現在耐久と最大耐久があります。通常修理は現在耐久を戻すための操作です。完全修理は素材と費用を使い、初期最大耐久の15%分を復元する別の処理です。<\/p><p>バッグ耐久が0になると、修理するまで再出撃できません。倉庫には容量上限があるため、不要品は売却・整理し、貴重な固有装備や優秀なランダム能力付き装備を誤って処分しないよう注意してください。<\/p><h3>15　レアリティと装備の個体差<\/h3><p>同じ名称の武器・防具でも、レアリティやランダム能力によって性能が異なる場合があります。装備比較機能で現在装備との違いを確認しましょう。ボス固有装備は通常のマーケット商品とは区別されます。<\/p><h3>16　ショップ・マーケット・物々交換<\/h3><p>ショップでは必要な弾薬、医療品、装備などを補充します。マーケットには通常マーケットと物々交換があります。通常マーケットでは装備12件が並び、生還10回ごとに商品と相場が更新されます。購入済み商品は更新まで売り切れです。<\/p><p>長期探索用の食料・飲料水もマーケットで購入できます。出撃前に補給を忘れないようにしましょう。<\/p><h3>17　レベルとキャラクター成長<\/h3><p>キャラクターは経験値（XP）を得て成長します。レベル、次のレベルまでの経験値、最大HPなどはキャラクター画面で確認します。装備だけでなくプレイヤー自身の成長も攻略に影響します。<\/p><h3>18　地区・ボス・情報室<\/h3><p>地区ごとに敵遭遇率、戦利品傾向、ボスが異なります。情報室ではボス情報の解析、敵勢力調査、物資調査、徘徊型ボスの追跡などができます。<\/p><p>敵勢力調査や物資調査は対象地区の次回通常レイドで発動する予約方式です。徘徊型ボス追跡は次回の長期探索で発動します。予約を取り消しても素材は返却されません。<\/p><p>ボスの情報解析ではINTELを蓄積し、専用討伐レイドの解放や特殊能力の情報公開につなげます。初回討伐の固有報酬と、再討伐時の抽選報酬は区別されます。<\/p><h3>19　ゲームの目的とクリア条件<\/h3><p>正式な最終目標は最終ボス「ゼロ」の討伐です。特殊アクセスキー・暗号化記憶装置・希少研究資料を3種類そろえる旧クリア条件は廃止されており、プレイ目標として扱いません。<\/p><p>注意：旧条件に関連するコードがHTMLに残存している可能性がありますが、本マニュアルは確定した正式仕様を優先しています。<\/p><h3>20　長期探索の詳しい使い方<\/h3><p>長期探索は15分単位の探索と一時帰還を繰り返します。出撃先は解放済み地区から毎回ランダムに選択されます。探索時間に応じて食料と飲料水を各1時間あたり1個消費します。<\/p><p>帰還時には弾薬50%補給、装備耐久20%修復が行われます。治療方式は「節約探索（無料・最大10分）」または「効率探索（病院料金×1.25・即時）」から選択します。HPと状態異常の治療は並行し、治療時間は探索時間に含まれます。資金不足時は自然回復に切り替わります。<\/p><p>緊急離脱すると未完了区間の戦利品は失われますが、確保済みの戦利品は保持されます。食料・飲料水は返却されません。終了後は区間ごとの詳細ログを確認できます。<\/p><h3>21　Ex軍事施設の攻略<\/h3><p>軍事施設は1F～20Fを攻略する高難度モードです。各階層で探索し、階層終了後に進軍か帰還を判断します。階層ボスの遭遇判定は50%で、出現しなくても階層クリアは可能です。<\/p><p>5F・10F・15F・20Fはチェックポイント階層です。階層クリア時には獲得品1個を安全転送でき、転送した品はその後に死亡しても保護されます。連続進軍時はHP20%、弾薬25%が補給されますが、その他の消耗は引き継がれます。<\/p><p>20Fクリアで称号「Call of Duty」、全20階層のボスを累積で各1回以上撃破すると「One Man Army」を獲得します。<\/p><h3>22　秘密の部屋・収集品・称号<\/h3><p>秘密の部屋には対応する鍵が必要です。特殊な収集品やボス固有装備の記録、討伐バッジ、称号などは、攻略の長期的な目標になります。ゲームクリアに必須のものと、やり込み要素は区別して考えましょう。<\/p><h3>23　敗北したら必ずログを読む<\/h3><p>戦闘ログは「なぜ負けたか」を知るための最重要資料です。通常レイドの結果画面にある「詳細ログ」、過去のレイド履歴、長期探索の区間別ログ、軍事施設の履歴を活用しましょう。<\/p><p>おすすめの読み方：①自分の攻撃が当たっていたか、②敵から何を受けたか、③どの時点でHPや状況が悪化したか、④次回の装備・探索時間・設定で何を変えるか、の順に追います。<\/p><h3>24　初心者向け実践例<\/h3><p>STEP　最初は低危険度の地区で、探索目標を短めに設定する。<\/p><p>STEP　武器の耐久を確認し、予備弾薬・包帯・救急キットを用意する。<\/p><p>STEP　戦闘スタイルはスタンダードから始め、ログで命中や被弾の傾向を知る。<\/p><p>STEP　帰還できたら戦利品を整理し、修理・補給・バックアップを行う。<\/p><p>STEP　装備が整ったら探索を延長し、情報室でボスの能力を調べる。<\/p><p>STEP　長期探索で資源を確保し、軍事施設では無理な連続進軍を避ける。<\/p><h3>25　よくある質問<\/h3><h4>Q. 12ラウンドで探索が終わるのですか？<\/h4><p>いいえ。12ラウンドは一度の戦闘の上限です。探索は設定したイベント数と脱出工程に従います。<\/p><h4>Q. なぜバッグに戦利品が入らないのですか？<\/h4><p>予備弾薬・医療品・グレネードなどの携行品も容量を使用するためです。<\/p><h4>Q. HPが残っていたのに突然負けました。<\/h4><p>ヘッドショットや一撃死、複数回攻撃、状態異常などが考えられます。まず詳細ログを確認してください。<\/p><h4>Q. なぜ銃が撃てないことがあるのですか？<\/h4><p>ジャム、リロード、弾薬不足、特殊な状態異常などをログで確認してください。<\/p><h4>Q. 長期探索を途中終了するとどうなりますか？<\/h4><p>完了済み区間の確保品は保持されますが、未完了区間の戦利品は失われ、食料・水は返却されません。<\/p><h4>Q. 3つの重要任務品を集める必要がありますか？<\/h4><p>ありません。正式なゲームクリア条件はゼロの討伐です。<\/p><p>―― 制作注記 ――<\/p><p>このマニュアルは初心者の操作・判断を優先した版です。各武器・各ボスの全数値一覧、すべての例外判定、HTMLに残存する旧仕様の除去までは保証しません。画面表示と本書に食い違いがある場合は、実装と正式仕様を照合してください。<\/p><div class=\"tok-manual-table\"><table><tr><th>項目<\/th><th>通常レイド<\/th><th>長期探索<\/th><th>Ex軍事施設<\/th><\/tr><tr><td>目的<\/td><td>地区探索・戦利品回収・ボス攻略<\/td><td>時間を使った継続的な物資収集<\/td><td>1～20Fの階層攻略<\/td><\/tr><tr><td>進行単位<\/td><td>探索イベント<\/td><td>15分ごとの探索区間<\/td><td>各階層の探索<\/td><\/tr><tr><td>時間<\/td><td>探索目標5～30イベント<\/td><td>選択した実時間<\/td><td>階層ごとに進軍判断<\/td><\/tr><tr><td>帰還<\/td><td>探索後に脱出工程<\/td><td>区間ごとの帰還・治療を自動処理<\/td><td>階層終了後に帰還か継続<\/td><\/tr><tr><td>報酬<\/td><td>地区の物資・装備・ボス報酬<\/td><td>複数区間の累積戦利品<\/td><td>階層報酬・固有装備・称号<\/td><\/tr><\/table><\/div><div class=\"tok-manual-table\"><table><tr><th>探索済みイベント数<\/th><th>通常の脱出必要イベント<\/th><\/tr><tr><td>1～5<\/td><td>1<\/td><\/tr><tr><td>6～12<\/td><td>2<\/td><\/tr><tr><td>13～21<\/td><td>3<\/td><\/tr><tr><td>22～30<\/td><td>4<\/td><\/tr><\/table><\/div><div class=\"tok-manual-table\"><table><tr><th>武器の残り耐久率<\/th><th>ジャム率<\/th><\/tr><tr><td>75%超<\/td><td>0%<\/td><\/tr><tr><td>50%超～75%<\/td><td>5%<\/td><\/tr><tr><td>25%超～50%<\/td><td>10%<\/td><\/tr><tr><td>10%超～25%<\/td><td>15%<\/td><\/tr><tr><td>0%超～10%<\/td><td>25%<\/td><\/tr><tr><td>0%<\/td><td>100%<\/td><\/tr><\/table><\/div><div class=\"tok-manual-table\"><table><tr><th>種類<\/th><th>主な役割<\/th><\/tr><tr><td>サプレッサー<\/td><td>戦闘後の次回敵遭遇率を低下<\/td><\/tr><tr><td>マズルブレーキ<\/td><td>連射による命中低下を軽減<\/td><\/tr><tr><td>レッドドットサイト<\/td><td>命中補助<\/td><\/tr><tr><td>ホロサイト<\/td><td>命中補助・連射減衰軽減<\/td><\/tr><tr><td>スコープ<\/td><td>命中補助・近距離ペナルティに注意<\/td><\/tr><tr><td>サーマルスコープ<\/td><td>特殊照準補助<\/td><\/tr><tr><td>拡張マガジン<\/td><td>リロードまでの攻撃可能回数を増加<\/td><\/tr><tr><td>グリップ<\/td><td>命中補助<\/td><\/tr><tr><td>ストック<\/td><td>回避補助<\/td><\/tr><\/table><\/div><div class=\"tok-manual-table\"><table><tr><th>スタイル<\/th><th>特徴<\/th><\/tr><tr><td>スタンダード<\/td><td>補正なし<\/td><\/tr><tr><td>マークスマン<\/td><td>命中+10pt、回避−10pt<\/td><\/tr><tr><td>ディフェンダー<\/td><td>命中−10pt、回避+10pt<\/td><\/tr><tr><td>アサルト<\/td><td>攻撃+15%、回避−10pt<\/td><\/tr><tr><td>スカーミッシャー<\/td><td>回避+15pt、攻撃−15%<\/td><\/tr><tr><td>ブリーチャー<\/td><td>貫通+10、命中−10pt<\/td><\/tr><tr><td>トリガーハッピー<\/td><td>命中−5pt、弾幕型の特殊処理<\/td><\/tr><\/table><\/div><div class=\"tok-manual-table\"><table><tr><th>ログの注目点<\/th><th>考えられる原因<\/th><th>次の対策<\/th><\/tr><tr><td>ジャム<\/td><td>武器耐久の低下<\/td><td>修理・武器交換<\/td><\/tr><tr><td>攻撃が外れる<\/td><td>命中不足・距離相性<\/td><td>スタイル・照準・武器変更<\/td><\/tr><tr><td>ヘッドショット<\/td><td>頭部防御不足<\/td><td>ヘルメット強化<\/td><\/tr><tr><td>一撃死<\/td><td>致命的な頭部被弾<\/td><td>敵貫通と防具を見直す<\/td><\/tr><tr><td>リロードが多い<\/td><td>攻撃機会の減少<\/td><td>武器・アタッチメント再検討<\/td><\/tr><tr><td>毒・出血・火傷<\/td><td>治療手段不足<\/td><td>対応医療品を携行<\/td><\/tr><tr><td>脱出失敗<\/td><td>探索しすぎ・負傷<\/td><td>短めの探索と足の治療<\/td><\/tr><\/table><\/div>";
 const themes=[['forest','フォレスト','#597b62'],['ocean','オーシャン','#356c81'],['sand','サンド','#826a43'],['violet','バイオレット','#73568c'],['mono','モノクロ','#657079']];
 const key='tokyov_ui_theme_v1';
 function applyTheme(id){if(!themes.some(t=>t[0]===id))id='forest';document.body.dataset.tokTheme=id;try{localStorage.setItem(key,id)}catch(e){} }
 let current='forest';try{current=localStorage.getItem(key)||'forest'}catch(e){}applyTheme(current);
 if(typeof V3_SECTIONS==='undefined'||typeof v3SectionView!=='function')return;
 V3_SECTIONS.settings=[['character','キャラクター変更'],['backup','バックアップ'],['display','画面設定'],['manual','マニュアル'],['prologue','プロローグ']];
 if(v3Section.settings==='game'||v3Section.settings==='restore')v3Section.settings='backup';
 V3_DEFAULT.settings='backup';
 function displayView(){const active=document.body.dataset.tokTheme;return `<section class="panel"><h2>画面設定・カラーリング</h2><p class="muted">テーマを選ぶと画面の配色が切り替わります。選択はこの端末に保存されます。</p><div class="tok-theme-options">${themes.map(([id,name,color])=>`<button type="button" class="tok-theme-option" data-tok-theme-choice="${id}" aria-pressed="${active===id}"><span class="tok-theme-swatch" style="background:${color}"></span><span>${name}${active===id?' ✓':''}</span></button>`).join('')}</div><p class="muted">初期配色に戻す場合は「フォレスト」を選んでください。</p></section>`}
 function manualView(){return `<section class="panel"><h2>プレイマニュアル</h2><p class="muted">初心者向けガイド／全25章。通信不要で閲覧できます。</p><p>困ったときは「戦闘ログの読み方と敗因分析」の章もご覧ください。</p><div class="tok-manual">${manualHTML}</div></section>`}
 const original=v3SectionView;
 v3SectionView=function(group){if(group!=='settings')return original(group);const selected=v3Section.settings; if(selected!=='display'&&selected!=='manual')return original(group);let html=original(group);const old=selected==='display'?settingsView():settingsView();const replacement=selected==='display'?displayView():manualView();return html.replace(old,replacement)};
 document.addEventListener('click',function(ev){const b=ev.target.closest('[data-tok-theme-choice]');if(!b)return;applyTheme(b.dataset.tokThemeChoice);if(typeof render==='function')render();});
})();
</script>

<script>
/* v3.6.100: Show the existing 11F-15F boss portraits on the live military floor and raid screens. */
(function(){
  function tokMidBossPortrait(f, compact){
    if(f<11 || f>15 || !Array.isArray(TOK_EX_BOSS_PORTRAITS)) return '';
    const src=TOK_EX_BOSS_PORTRAITS[f-1];
    if(typeof src!=='string' || !src.startsWith('data:image/')) return '';
    const name=EX_NAMES[f-1]||('ボス '+f+'F');
    return '<figure class="tok-ex-boss-photo'+(compact?' compact':'')+'"><img src="'+src+'" alt="Ex軍事施設 '+f+'F '+escapeHTML(name)+'" loading="lazy" decoding="async"><figcaption>'+f+'F '+escapeHTML(name)+'</figcaption></figure>';
  }
  const previousFloorPanel=tokMilFloorPanel;
  tokMilFloorPanel=function(){
    const html=previousFloorPanel();
    const state=tokMilState(),f=Number(state?.floor);
    if(state?.mode!=='military'||f<11||f>15) return html;
    const host=document.createElement('div');host.innerHTML=html;
    if(host.querySelector('.tok-ex-boss-photo'))return html;
    const list=host.querySelector('.tok-mil-floor-list');
    if(list)list.insertAdjacentHTML('afterend',tokMidBossPortrait(f,true));
    return host.innerHTML;
  };
  const previousRaidView=raidView;
  raidView=function(){
    const html=previousRaidView(),r=g.raid,f=Number(r?.militaryFloor);
    if(!r?.exVersion||f<11||f>15)return html;
    const host=document.createElement('div');host.innerHTML=html;
    if(host.querySelector('.tok-ex-boss-photo'))return html;
    const heading=host.querySelector('section.panel h2');
    if(heading)heading.insertAdjacentHTML('afterend',tokMidBossPortrait(f,true));
    return host.innerHTML;
  };
})();
</script>
<script>(()=>{if(!('serviceWorker' in navigator)||!isSecureContext)return;const el=document.createElement('button');el.textContent='オフライン準備中';el.style.cssText='position:fixed;right:8px;bottom:calc(8px + env(safe-area-inset-bottom));z-index:9999;font-size:11px;padding:6px;opacity:.9';document.body.append(el);let ready=false;el.onclick=()=>alert(ready?'オフライン保存済みです。更新はオンラインでゲームを再起動してください。':'初回保存には時間がかかります。通信を維持してください。');navigator.serviceWorker.register('./sw.js').then(async reg=>{const active=await navigator.serviceWorker.ready;ready=true;el.textContent='オフライン準備完了';setTimeout(()=>{if(el.textContent==='オフライン準備完了')el.hidden=true},3000);reg.addEventListener('updatefound',()=>{const w=reg.installing;if(w)w.addEventListener('statechange',()=>{if(w.state==='installed'&&navigator.serviceWorker.controller){el.hidden=false;el.textContent='更新準備完了・再起動で反映';}});});}).catch(()=>{el.textContent='オフライン保存失敗';});})();</script></body></html>