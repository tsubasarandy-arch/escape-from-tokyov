<script>
/* v3.6.90 — ensure military floor confirmation is handled before legacy click interceptors. */
(function(){
 window.addEventListener('click',function(event){
  const button=event.target && event.target.closest && event.target.closest('[data-ex-action="finishfloor"]');
  if(!button)return;
  event.preventDefault();
  event.stopImmediatePropagation();
  const raid=g && g.raid;
  if(!raid || !raid.exVersion || !raid.exAwaitingChoice || !raid.exSelected)return;
  // A completed floor with no boss is a legitimate clear, not a failed boss fight.
  if(!raid.militaryBossWon && !raid.exBossSkipped)raid.exBossSkipped=true;
  if(raid._finishCommitted)return;
  finishRaid(true);
  save();
  render();
 },true);
})();
</script>
<script>
/* v3.6.91: military consecutive advance selection and between-floor preparations */
(function(){
 const previousLaunch=exLaunchHtml;
 const oldUnlocked=exUnlocked;
 exUnlocked=function(m,f){return oldUnlocked(m,f)||!!m.cleared?.includes(f-1)||!!(m.exRun&&m.exRun.lastFloor+1===f);};
 const nextFloor=m=>m.exRun&&m.exRun.lastFloor<20?m.exRun.lastFloor+1:null;
 const gearSlots=['weapon','secondary','melee','armor','helmet','bag','accessory'];
 const slotNames={weapon:'メイン武器',secondary:'サブ武器',melee:'近接武器',armor:'胴装備',helmet:'頭装備',bag:'バッグ',accessory:'アクセサリー'};
 function owned(slot){return (g.gear||[]).filter(x=>x.type===(slot==='secondary'?'weapon':slot==='melee'?'weapon':slot)&&!((slot==='weapon'||slot==='secondary')&&W[x.base]?.melee)&&!(slot==='melee'&&!W[x.base]?.melee));}
 function prepPanel(m){const run=m.exRun;if(!run)return '';const next=nextFloor(m);const max=Math.max(1,baseMaxHp()+ (run.equipment?.armor?gearVal(run.equipment.armor,'maxhp'):0));const hp=Math.max(0,Number(run.hp)||0),need=Math.max(0,max-hp),healAmount=Math.min(20,need),price=healAmount*tokHpRate();
 const supplies=Object.entries(ITEMS).filter(([id])=>!TOK_GRENADES.includes(id)).map(([id,o])=>`<div class="item"><b>${escapeHTML(o.n)}</b>　携行 ${run.supplies?.[id]||0} ／ 倉庫 ${g.bank.supplies?.[id]||0} <button type="button" data-ex-prep="supply:${id}" ${(g.bank.supplies?.[id]||0)<1?'disabled':''}>1個補充</button></div>`).join('');
 const repairSlots=['weapon','secondary','melee','armor','helmet','bag'];
 const seenRepair=new Set();
 const repairRows=repairSlots.map(slot=>{const x=run.equipment?.[slot];if(!x||seenRepair.has(x.id)||!['weapon','armor','helmet','bag'].includes(x.type))return '';seenRepair.add(x.id);const maximum=repairMax(x),current=Math.max(0,Number(x.dur??maximum)),cost=repairPrice(x),canRepair=repairAvailable(x)&&current<maximum;return `<div class="item"><b>${escapeHTML(gearName(x))}</b><p>耐久 ${current}/${maximum} ／ 修理費 ${fmt(cost)}₽${canRepair?' ／ 修理後最大耐久 '+repairNextMax(x):' ／ 修理不可または修理不要'}</p><button type="button" data-ex-prep="repair:${escapeHTML(String(x.id))}" ${!canRepair||g.money<cost?'disabled':''}>この装備を修理</button></div>`}).filter(Boolean).join('');
 const gear=gearSlots.map(slot=>{const current=run.equipment?.[slot];const options=owned(slot).map(x=>`<option value="${escapeHTML(String(x.id))}" ${current?.id===x.id?'selected':''}>${escapeHTML(gearName(x))}（耐久${x.dur??'-'}）</option>`).join('');return `<label style="display:block;margin:12px 0">${slotNames[slot]}<select data-ex-prep-gear="${slot}" style="display:block;width:100%;max-width:100%;padding:10px"><option value="">変更なし・未装備</option>${options}</select></label>`}).join('');
 return `<section class="panel tok-ex-prep"><h2>階層間の出撃準備</h2><p>次の階層：<b>${next?next+'F':'最終階層クリア'}</b> ／ 現在HP <b>${hp}/${max}</b></p><p>この画面で回復・装備変更・医療品補充をしてから進軍できます。残った戦利品は撤退時に確保されます。</p><div class="item"><h3>回復</h3><p>所持金 ${fmt(g.money)}₽ ／ 今回の回復量 +${healAmount}HP ／ 費用 ${fmt(price)}₽（${tokHpRate()}₽/HP）</p><button type="button" data-ex-prep="heal" ${!need||g.money<price?'disabled':''}>HPを最大20回復（繰り返し可能）</button></div><div class="item"><h3>装備品の修理</h3><p>拠点の通常修理と同じく、修理すると最大耐久値が減少します。</p>${repairRows||"修理対象の装備はありません"}</div><div class="item"><h3>装備変更</h3>${gear}<button type="button" data-ex-prep="gear">装備変更を確定</button></div><div class="item"><h3>医療品・携行品補充</h3>${supplies}</div>${next?`<button type="button" data-ex-action="advance">準備を終えて${next}Fへ進軍</button>`:''}</section>`;
 }
 exLaunchHtml=function(m){let html=previousLaunch(m);const next=nextFloor(m)||((m.cleared||[]).includes(m.floor)&&m.floor<20?m.floor+1:null);if(!next)return m.exRun?html+prepPanel(m):html;
 // Unlock the immediate next floor only while a continuous run exists.
 html=html.replace(new RegExp('(<button[^>]*data-mil-floor="'+next+'"[^>]*)( disabled)([^>]*>)'),'$1$3');
 html=html.replace(new RegExp('(<button[^>]*data-mil-floor="'+next+'"[^>]*>)[^<]*'+next+'F</button>'),'$1◆ '+next+'F</button>');
 return html+prepPanel(m);
 };
 window.addEventListener('click',function(e){const btn=e.target?.closest?.('[data-ex-prep]');if(!btn)return; e.preventDefault();e.stopImmediatePropagation();const m=tokMilState(),run=m.exRun;if(!run)return;const action=btn.dataset.exPrep;
 if(action==='heal'){const max=Math.max(1,baseMaxHp()+(run.equipment?.armor?gearVal(run.equipment.armor,'maxhp'):0));const missing=Math.max(0,max-(Number(run.hp)||0));const amount=Math.min(20,missing),cost=amount*tokHpRate();if(amount>0&&g.money>=cost){g.money-=cost;run.hp=Math.min(max,(Number(run.hp)||0)+amount);g.notice=`軍事施設：HPを${amount}回復（${fmt(cost)}₽）`;}}
 else if(action.startsWith('repair:')){const id=action.slice(7);const slots=['weapon','secondary','melee','armor','helmet','bag'];const x=slots.map(slot=>run.equipment?.[slot]).find(x=>x&&String(x.id)===id);if(!x||!['weapon','armor','helmet','bag'].includes(x.type))return;const maximum=repairMax(x);if(!repairAvailable(x)||(x.dur??maximum)>=maximum)return;const cost=repairPrice(x);if(g.money<cost)return;const next=repairNextMax(x);g.money-=cost;x.maxDur=next;x.dur=next;const ownedItem=findGear(x.id);if(ownedItem&&ownedItem!==x){ownedItem.maxDur=next;ownedItem.dur=next;}if(x.type==='armor')run.dur=next;if(x.type==='helmet')run.helmetDur=next;g.notice=`軍事施設：${gearName(x)}を修理（${fmt(cost)}₽）`;}
 else if(action.startsWith('supply:')){const id=action.slice(7);if(!ITEMS[id]||TOK_GRENADES.includes(id)||!(g.bank.supplies?.[id]>0))return;g.bank.supplies[id]--;run.supplies=run.supplies||{};run.supplies[id]=(run.supplies[id]||0)+1;}
 else if(action==='gear'){const panel=btn.closest('.tok-ex-prep');run.equipment=run.equipment||{};for(const select of panel.querySelectorAll('[data-ex-prep-gear]')){const slot=select.dataset.exPrepGear,id=select.value;if(!id)continue;const item=owned(slot).find(x=>String(x.id)===id);if(!item)continue;run.equipment[slot]=structuredCloneSafe(item);if(slot==='armor')run.dur=item.dur;if(slot==='helmet')run.helmetDur=item.dur;if(slot==='weapon')run.weapon=item.base;} }
 save();render();
 },true);
 // Select next floor without breaking the existing checkpoint rule for other floors.
 window.addEventListener('click',function(e){const btn=e.target?.closest?.('[data-mil-floor]');if(!btn)return;const m=tokMilState(),next=nextFloor(m)||((m.cleared||[]).includes(m.floor)&&m.floor<20?m.floor+1:null);if(!next||Number(btn.dataset.milFloor)!==next)return;e.preventDefault();e.stopImmediatePropagation();m.floor=next;save();render();},true);
 // Before advancing, synchronize equipped slots with the selected carried equipment.
 window.addEventListener('click',function(e){const btn=e.target?.closest?.('[data-ex-action="advance"]');if(!btn)return;const m=tokMilState(),run=m.exRun;if(!run)return;for(const slot of gearSlots){const x=run.equipment?.[slot];if(x&&findGear(x.id))g.eqIds[slot]=x.id;}g.hp=Math.max(1,Math.min(baseMaxHp(),Number(run.hp)||1));save();},true);
})();
</script>
<script>
/* v3.6.93 — distinguish safe military combat escape from death in result screens. */
(function(){
 const priorReport=reportView;
 reportView=function(){
  const html=priorReport(),h=g.history?.[0];
  if(!h?.safeRetreat)return html;
  return html.replace(/戦死/g,'敗走').replace(/生還/g,'敗走').replace(/出撃装備・携行弾薬・拾得装備を喪失/g,'装備は保持・未確保の戦利品は放棄');
 };
})();
</script>
<script>
/* v3.6.95: Encounter fairness adjustment (normal raids and military). */
(function(){
 'use strict';
 // Keep all district identities while lowering extreme ELITE/RAIDER pressure.
 for(const map of Object.values(MAP)){
  if(!Array.isArray(map?.mix)||map.mix.length<3)continue;
  const [scav,raider,elite]=map.mix;
  const eliteNew=Math.min(elite,0.25);
  const raiderNew=Math.min(raider,0.40);
  map.mix=[Math.max(0,1-raiderNew-eliteNew),raiderNew,eliteNew];
 }
 const previousDraw=drawEnemy;
 drawEnemy=function(r){
  if(!r?.militaryFloor)return previousDraw(r);
  const floor=Math.max(1,Math.min(20,Math.floor(Number(r.militaryFloor)||1)));
  const elite=Math.round(5+(floor-1)*20/19)/100;
  const raider=Math.round(10+(floor-1)*20/19)/100;
  let scav=1-elite-raider;
  const previous=r.lastNormalEnemyKind;
  if(previous==='elite'){
   scav+=elite+raider*.5;raider*=.5;
   const rollValue=rand(r),kind=rollValue<scav?'scav':'raider';
   r.lastNormalEnemyKind=kind;return kind;
  }
  if(previous==='raider'){
   scav+=(elite+raider)*.5;elite*=.5;raider*=.5;
  }
  if(r.investigation?.kind==='enemy'){
   scav+=(elite+raider)*.2;elite*=.8;raider*=.8;
  }
  const rollValue=rand(r);
  const kind=rollValue<scav?'scav':rollValue<scav+raider?'raider':'elite';
  r.lastNormalEnemyKind=kind;
  return kind;
 };
})();
</script>
<script>

/* v3.6.97 — independent, persistent military raid history (up to 100). */
function tokMilitaryHistory(){
 const m=tokMilState();
 if(!Array.isArray(m.raidHistory))m.raidHistory=[];
 // Import older military reports still present in the ordinary 30-record history.
 for(const h of (g.history||[])){
  if(!h||!Number(h.militaryFloor))continue;
  if(!m.raidHistory.some(x=>String(x.id)===String(h.id))){m.raidHistory.push(structuredCloneSafe(h));}
 }
 m.raidHistory.sort((a,b)=>(Number(b.at)||0)-(Number(a.at)||0));
 if(m.raidHistory.length>100)m.raidHistory.length=100;
 return m.raidHistory;
}
const tok97Finish=finishRaidCore;
finishRaidCore=function(win){
 const r=g.raid, military=!!r?.militaryFloor;
 const floor=military?Number(r.militaryFloor):0;
 const raidId=military?r.id:null;
 const bossWon=military?!!r.militaryBossWon:false;
 const bossSkipped=military?!!r.exBossSkipped:false;
 const result=tok97Finish(win);
 if(military){
  const h=(g.history||[]).find(x=>String(x.id)===String(raidId));
  if(h){
   h.militaryFloor=floor;
   h.raidType='military';
   h.militaryBossWon=bossWon;
   h.militaryBossSkipped=bossSkipped;
   h.militaryCleared=!!win&&(bossWon||bossSkipped);
   const history=tokMilitaryHistory();
   const index=history.findIndex(x=>String(x.id)===String(raidId));
   if(index>=0)history.splice(index,1);
   history.unshift(structuredCloneSafe(h));
   if(history.length>100)history.length=100;
  }
 }
 return result;
};
let tok97SelectedHistory=null;
const tok97OldHistoryView=historyView;
historyView=function(){
 const old=tok97OldHistoryView();
 const entries=tokMilitaryHistory();
 const selected=entries.find(h=>String(h.id)===String(tok97SelectedHistory));
 const safe=x=>escapeHTML(String(x??''));
 const label=h=>h.militaryCleared?'✓ 階層クリア':h.win?'✓ 生還・撤退':'× 敗北';
 const cards=entries.map(h=>`<div class="item"><b>${safe(label(h))} ／ 軍事施設 ${safe(h.militaryFloor)}F ／ #${safe(h.id)}</b><p class="muted">${Number.isFinite(Number(h.at))?new Date(h.at).toLocaleString('ja-JP'):'日時不明'} ／ 敵撃破 ${fmt(h.kills||0)}体 ／ +${fmt(h.xp||0)} XP</p><button type="button" data-tok97-history="${safe(h.id)}">詳細を見る</button></div>`).join('')||'<p class="muted">軍事施設の履歴はまだありません。以前の記録は、通常履歴に残っているものだけ取り込めます。</p>';
 const detail=selected?`<div class="item" id="tok97-military-detail"><h3>軍事施設 ${safe(selected.militaryFloor)}F — ${safe(label(selected))}</h3><p>日時：${Number.isFinite(Number(selected.at))?new Date(selected.at).toLocaleString('ja-JP'):'不明'} ／ 探索：${fmt(selected.explore||0)}回 ／ 敵撃破：${fmt(selected.kills||0)}体 ／ XP：${fmt(selected.xp||0)}</p><p>ボス撃破：${selected.militaryBossWon||selected.bossKilled?'あり':'なし'}</p><h4>獲得アイテム</h4>${Object.entries(selected.loot||{}).map(([id,n])=>`<p>${safe(L[id]?.n||id)} ×${fmt(n)}</p>`).join('')||'<p class="muted">なし・記録なし</p>'}<h4>獲得装備</h4>${(selected.gearLoot||[]).map(x=>`<p>${safe(gearName(x))}</p>`).join('')||'<p class="muted">なし・記録なし</p>'}<h4>戦闘・探索ログ</h4><div class="log">${(selected.log||[]).map(tokCombatLogHTML).join('')||'ログなし'}</div><button type="button" data-tok97-history-close>詳細を閉じる</button></div>`:'';
 return old+`<section class="panel" id="tok97-military-history"><h2>軍事施設の過去のレイド（直近100件）</h2><p class="muted">通常レイドとは別に保存します。階層ごとのクリア・生還・敗北、戦闘ログを確認できます。</p>${cards}${detail}</section>`;
};
window.addEventListener('click',function(ev){
 const button=ev.target?.closest?.('[data-tok97-history],[data-tok97-history-close]');
 if(!button)return;
 ev.preventDefault();ev.stopImmediatePropagation();
 tok97SelectedHistory=button.hasAttribute('data-tok97-history-close')?null:button.dataset.tok97History;
 render();
 document.getElementById('tok97-military-detail')?.scrollIntoView({block:'start'});
},true);
// Ensure older military reports are migrated into the persistent archive on load.
try{if(g)tokMilitaryHistory()}catch(err){console.warn('Military history migration postponed',err)}

</script>
<script>
/* v3.6.98 — Military combat escape must never be settled as death.
   Covers both ordinary encounters and mid-boss combat (previously omitted). */
(function(){
 const previousFinishRaid=finishRaid;
 finishRaid=function(win){
  const r=g.raid;
  if(r&&r.exVersion&&r.militaryFloor&&!r._finishCommitted&&Number(r.hp)>0){
   const lines=Array.isArray(r.log)?r.log:[];
   // Only an explicit successful escape from the CURRENT encounter qualifies.
   // Check the recent combat tail; no false rescue on real death or failed escape.
   const tail=lines.slice(-12).map(x=>typeof x==='string'?x:String(x?.text||x?.message||''));
   const escaped=tail.some(x=>/敵から離脱成功/.test(x));
   const newerDeath=tail.some(x=>/離脱に3回失敗|【戦死】|HPが0/.test(x));
   if((r.exBattleRetreated||(!win&&escaped&&!newerDeath))){
    r.exBattleRetreated=true;
    r.exBossSkipped=false;
    r.militaryBossWon=false;
    r.bossKilled=false;
    r.loot={};r.gearLoot=[];
    log(r,'【敗走】離脱成功。装備を保持し、階層クリアせず帰還');
    return previousFinishRaid(true);
   }
  }
  return previousFinishRaid(win);
 };
})();
</script>
<script>
/* v3.6.99: Show valid weapon images for later-added boss unique weapons.
   Keep all save and IndexedDB behavior unchanged. */
(function(){
  const previous=tokWeaponImage;
  tokWeaponImage=function(id){
    const existing=previous(id);
    if(existing)return existing;
    if(!Object.prototype.hasOwnProperty.call(TOK_WEAPON_IMAGES,id))return '';
    const src=TOK_WEAPON_IMAGES[id];
    if(typeof src!=='string'||!src.startsWith('data:image/'))return '';
    const name=String(W[id]?.n||id).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
    return '<figure class="tok-weapon-figure" data-weapon-id="'+id+'" style="margin:10px 0"><img src="'+src+'" alt="'+name+'" data-weapon-image-id="'+id+'" decoding="async" loading="lazy" style="display:block;width:100%;max-width:650px;aspect-ratio:2.4/1;object-fit:contain;background:#141414;border-radius:9px"><figcaption style="font-size:11px;color:#8b9d99;text-align:right;padding:2px 5px">'+name+'</figcaption></figure>';
  };
})();

</script>
