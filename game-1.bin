function bossIntel(r,points,reason){const st=g.bosses[r.map];st.intel=Math.min(BOSSES[r.map].full,st.intel+points);if(points>1)st.seen=true;log(r,`ボス情報 +${points}（${reason}）：${st.intel}/${BOSSES[r.map].full}`)}
function bossGear(r,id){const b=BOSSES[id]||{gear:id},base=b.gear,type=W[base]?'weapon':H[base]?'helmet':'armor';if(type==='armor'&&!A[base])throw new Error('未登録のボス装備: '+base);const pool=Object.keys(BOSS_POOL[type]||{});const count=Math.min(pool.length,1+Math.floor(rand(r)*3)),affixes=[];for(let i=0;i<count;i++){const k=pool.splice(Math.floor(rand(r)*pool.length),1)[0],spec=BOSS_POOL[type][k];affixes.push({type:k,value:spec[1]+Math.floor(rand(r)*(spec[2]-spec[1]+1))})}return {id:'gear-'+g.nextGearId++,type,base,rarity:'boss',affixes,favorite:false,dur:type==='armor'?A[base].max+gearVal({affixes},'durability'):type==='helmet'?H[base].max:type==='weapon'?(W[base].max||100):null}}
