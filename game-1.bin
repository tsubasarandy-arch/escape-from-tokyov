  if(target.id!=='beta'&&guard.hp>0&&roll(r,.30)){target=guard;log(r,'【身代わり防御】β重装兵が攻撃をかばった');}
  const grenadeAction=throwGrenade(r,units,'boss');
  if(!grenadeAction){
   const effective={...target};
   if(target.id==='alpha'){effective.ev+=0;}
   if(target.id==='gamma')effective.ev+=5;
   const amount=playerAttack(r,effective,target.hp);
   const shield=target.id==='beta'&&amount>0&&roll(r,.20);
   const actual=shield?Math.max(1,Math.floor(amount*.75)):amount;
   if(shield)log(r,'城塞のライオットシールド：被ダメージ25%軽減');
   target.hp=Math.max(0,target.hp-actual);
   target.armorDur=effective.armorDur;target.helmetDur=effective.helmetDur;
   target.poisonTurns=effective.poisonTurns||target.poisonTurns;target._chainPending=effective._chainPending||target._chainPending;target._chainBound=effective._chainBound||target._chainBound;target.bleed=effective.bleed||target.bleed;
   if(target.hp<=0)log(r,`${target.n}撃破！`);
  }
  if(units.every(u=>u.hp<=0))return 'won';
  const alive=units.filter(u=>u.hp>0);
  // Random uniform selection without replacement, random order as agreed.
  for(let j=alive.length-1;j>0;j--){const k=Math.floor(rand(r)*(j+1));[alive[j],alive[k]]=[alive[k],alive[j]];}
  const attackers=alive.slice(0,2);
  log(r,`【ケルベロス3】攻撃担当：${attackers.map(u=>u.n).join(' → ')}`);
  for(const attacker of attackers){
   if(r.hp<=0)break;
   const assisted=supportReady&&attacker.id!=='gamma';
   if(assisted){log(r,`【援護射撃】${attacker.n} 命中+10pt`);supportReady=false;}
   strike(attacker,assisted?10:0);
   if(attacker.id==='gamma'&&units.some(u=>u.hp>0&&u.id!=='gamma'))supportReady=true;
  }
  if(units[0].hp<=0&&units[1].hp<=0)supportReady=false;
  flashAdvance(units);if(r.flashTurns>0)r.flashTurns--;
  if(r.hp<=0)return 'dead';bossDistanceTick(r,units);
  if(!final&&(r.hp<=tactic.hp||(!meleeRaidGear(r)&&totalRaidAmmo(r)<Math.ceil(bossEstimate(r)*tactic.ammo/3))))return 'retreat';
 }return final?'dead':'retreat';}
 let res=turn(12,false);
 if(res==='won'){r.bossKilled=true;r.kills+=3;r.xp+=b.xp;log(r,'【討伐】ケルベロス部隊全滅。生還で報酬確定');return 'won';}
 if(res==='dead')return 'dead';
 log(r,'ケルベロス部隊から撤退を試みる');const esc=escapeCombat(r,b);if(esc==='escaped'||esc==='dead')return esc;
 res=turn(6,true);
 if(res==='won'){r.bossKilled=true;r.kills+=3;r.xp+=b.xp;return 'won';}return 'dead';
}
function bossBattle(r){tokPrepareEncounterReload(r);try{return bossBattleCore(r)}finally{r._bossDistanceContext=false;r._bossSpecialObserved=false}}

function applyEnemyPoison(r,e){if(!e.poisonTurns)log(r,`【毒】${e.n}が毒状態`);e.poisonTurns=4;}
function applyEnemyBleed(r,e){if(!e.bleed){e.bleed=true;log(r,`【出血】${e.n}が出血状態`);}}
function enemyStatusTick(r,units){for(const e of units.filter(u=>u.hp>0)){if(tokEnemySet(e).statusImmune){e.poisonTurns=0;e.burnTurns=0;e.bleed=false;}if(e.poisonTurns>0){const n=Math.min(e.kind==='boss'?10:999,Math.max(3,Math.floor((e.maxHp||e.hp)*.05)));e.hp=Math.max(0,e.hp-n);e.poisonTurns--;log(r,`${e.n}：毒 -${n}HP`)}if(e.bleed&&!tokEnemySet(e).bleedImmune){e.hp=Math.max(0,e.hp-3);log(r,`${e.n}：出血 -3HP`)}tokTickBurn(r,e)}}
function tokBunnyGrenade(r,type,foe){
 const chance=({gas:.60,frag:.70})[type]+(foe.bagId==='bombbag'?.15:0);
 if(!roll(r,chance)){log(r,`${foe.n}：グレネード回避`);return;}
 if(type==='gas'){
  if(tokSetBonuses(r).statusImmune){log(r,'フェニックス3セット：毒を無効化');return;}
  const helmet=raidGear(r,'helmet');if(helmet?.base==='bunny_mask'&&roll(r,.30)){log(r,'バニーマスク：毒付与を防止');return;}
  r.poisonTurns=4;r.poisonDamageMultiplier=1.5;log(r,'Mr.バニー：猛毒ガス命中（毒4R、毒ダメージ1.5倍）');
 }else{
  const raw=40+Math.floor(rand(r)*36),def=armorDef(r.armor,r.dur,raidGear(r,'armor'));
  const damage=Math.max(1,Math.floor(dmg(raw,def,35,r)*(r.poisonTurns>0?1.25:1)));
  r.hp=Math.max(0,r.hp-damage);log(r,`Mrs.バニー：フラグ命中 -${damage}HP${r.poisonTurns>0?'（爆発追撃+25%）':''}`);
 }
}
function tokButcherSaw(r,foe){
 log(r,'【正体不明の怪物】チェーンソー2連撃');
 for(let i=0;i<2&&r.hp>0;i++){
  const chance=clamp(foe.hit-flashPenalty(foe)-(foe.armBroken?15:0)-(foe.burnTurns>0?10:0),5,95);
  const dodge=clamp(baseDodgeChance()+tokArmorMobility(r).dodge+tokPmcStyleDodge(r)+extBonus(r).dodge/100+tokAccessoryBonus(r,'evasion')/100-tokInjuryDebuff(r)/100,0,.80);
  if(!roll(r,chance/100)||roll(r,dodge)){log(r,`正体不明の怪物：チェーンソー${i+1}/2撃目を回避`);continue;}
  const armor=raidGear(r,'armor'),def=armorDef(r.armor,r.dur,armor)+tokAccessoryBonus(r,'defense');
  let damage=dmg(35*(r.longMode?.85:1),def,40,r);
  const ext=extBonus(r);damage=Math.max(1,Math.floor(damage*(1-ext.shock/100)*(1-raidVal(r,'armor','absorb')/100)));
  r.hp=Math.max(0,r.hp-damage);if(r.armor!=='none')r.dur=Math.max(0,r.dur-Math.max(1,Math.ceil(35/5)));
  log(r,`正体不明の怪物：チェーンソー${i+1}/2撃目 -${damage}HP`);
  if(!r.bleed&&!tokSetBonuses(r).bleedImmune&&!tokSetBonuses(r).statusImmune&&roll(r,.10)){r.bleed=true;log(r,'【出血】正体不明の怪物のチェーンソーで出血');}
 }
}
function tokButcherChain(r,foe){
 log(r,'【正体不明の怪物】拘束の鎖（ダメージなし）');
 const chance=clamp(foe.hit-flashPenalty(foe)-(foe.armBroken?15:0),5,95);
 const dodge=clamp(baseDodgeChance()+tokArmorMobility(r).dodge+tokPmcStyleDodge(r)+extBonus(r).dodge/100+tokAccessoryBonus(r,'evasion')/100-tokInjuryDebuff(r)/100,0,.80);
 if(roll(r,chance/100)&&!roll(r,dodge)){r._butcherBoundNext=1;log(r,'【拘束】次ラウンドの通常攻撃が不可');}
 else log(r,'【拘束】鎖を回避');
}
function newBossBattle(r){const map=r.map,b=BOSSES[map],duo=map==='zoo'||map==='park';r.minigunCycle=0;r.encounterGrenades=0;r.grenadeActionCount=0;r.firstShotUsed=false;r.glockOpeningShotUsed=false;r.huntressTarget=null;r.bossEncountered=true;g.bosses[map].seen=true;bossIntel(r,3,'ボスを目撃');bossDistanceStart(r,map);
const units=map==='zoo'?[{n:'マダム',hp:110,def:15,d:35,hit:70,ev:15,pen:75},{n:'タイガー',hp:160,def:25,d:29,hit:65,ev:25,pen:0}]:map==='park'?[{n:'Mr.バニー',hp:115,def:40,d:17,hit:65,ev:15,pen:25},{n:'Mrs.バニー',hp:125,def:40,d:18,hit:60,ev:10,pen:40}]:map==='forest'?[{n:'正体不明の怪物',hp:250,def:20,d:35,hit:70,ev:5,pen:40}]:map==='office'?[{n:'スルーズ',hp:150,def:15,d:48,hit:75,ev:35,pen:35},{n:'ヒルド',hp:110,def:25,d:21,hit:75,ev:20,pen:40},{n:'シグルーン',hp:100,def:45,d:36,hit:75,ev:10,pen:65}]:[{n:b.n,hp:b.hp,def:b.def,d:b.d,hit:b.hit,ev:b.ev,pen:b.pen}];
for(const u of units){u.maxHp=u.hp;u.kind='boss';equipBossUnit(r,u,map,u.n);u.flashTurns=0;u.dist=1;u._defeatLogged=false}const logBossDefeats=()=>{for(const u of units){if(u.hp<=0&&!u._defeatLogged){u._defeatLogged=true;log(r,`【個別撃破】${u.n}を撃破（残存：${units.filter(x=>x.hp>0).map(x=>x.n).join('・')||'なし'}）`)}}};log(r,`【BOSS】${units.map(u=>u.n+' HP'+u.hp).join(' ＆ ')}`);const t=bossTactic(r);
// v3.5.8 audit: preserve each boss member's reload cycle across copied attack models.
function bossUnitStrike(raid,attack){
 const original=units.find(u=>u.n===attack.n);
 if(original){
  const weapon=attack.enemyWeapon||original.enemyWeapon||'unarmed';
  if(!original._weaponCycles)original._weaponCycles={};
  if(!original._weaponCycles[weapon])original._weaponCycles[weapon]={magActions:0};
  attack={...attack,_weaponState:original._weaponCycles[weapon]};
 }
 return enemyStrike(raid,attack);
}
function foeSakuraIaidoChance(u){return u._sakuraReadied?.40:.25;}
let turn=0;
function run(limit,final){for(let j=0;j<limit;j++){turn++;if(!hasCombatWeapon(r))return final?'dead':'retreat';if(!final&&r.hp<=t.hp)return 'retreat';turnCare(r);if(r.hp<=0)return 'dead';enemyStatusTick(r,units);logBossDefeats();if(units.every(u=>u.hp<=0))return 'won';const target=groupAttackPolicy(r,units);const effective={...target};if(map==='temple'){effective.kongouWeak=true;effective.def=enemyDefense(effective,false);}if(map==='power'&&target.hp>target.maxHp*.5)effective.def+=10;if(map==='school'){effective._sakuraBoss=true;effective._sakuraIaido=roll(r,foeSakuraIaidoChance(target));effective.ev=(effective._sakuraIaido?20:45)+10;}
const thrown=throwGrenade(r,units,'boss');if(r._butcherBoundNext){r._butcherBoundNext=0;if(!thrown)log(r,'【鎖の拘束】通常攻撃を1ラウンド封じられた');}else if(!thrown){log(r,`【攻撃対象】${target.n}（残HP ${target.hp}/${target.maxHp}）`);let amount=playerAttack(r,effective,target.hp);target.hp=Math.max(0,target.hp-amount);target.armorDur=effective.armorDur;target.helmetDur=effective.helmetDur;target.poisonTurns=effective.poisonTurns||target.poisonTurns;target._chainPending=effective._chainPending||target._chainPending;target._chainBound=effective._chainBound||target._chainBound;target.bleed=effective.bleed||target.bleed;target.armBroken=!!(effective.armBroken||target.armBroken);target.legBroken=!!(effective.legBroken||target.legBroken);if(map==='school'&&effective._sakuraDodged){if(!target._sakuraReadied)log(r,'サクラ：見切り発動（次の居合確率40%）');target._sakuraReadied=true;}if(target.hp>0)log(r,`【敵残HP】${target.n}：${target.hp}/${target.maxHp}`);}
logBossDefeats();if(units.every(u=>u.hp<=0))return 'won';
if(map==='zoo'){
 const madam=units[0],tiger=units[1];
 if(madam.hp>0){const special=turn%3===0;if(special)log(r,'マダム：血の追跡（命中+15pt、出血時威力+30%）');bossUnitStrike(r,{...madam,hit:madam.hit+(special?15:0),weaponPowerMultiplier:special&&r.bleed?1.3:1});}
 if(tiger.hp>0&&r.hp>0){const special=turn%2===0,before=r.hp;if(special)log(r,'タイガー：裂傷攻撃（威力+25%、出血40%）');bossUnitStrike(r,{...tiger,d:tiger.d*(special?1.25:1)});if(r.hp<before&&!r.bleed&&!tokSetBonuses(r).bleedImmune&&roll(r,special?.40:.20)){r.bleed=true;log(r,'タイガー：出血付与')}}
}
else if(map==='park'){
 const mr=units[0],mrs=units[1];
 if(mr.hp>0){if(turn%2===1){log(r,'Mr.バニー：ガスグレネード');tokBunnyGrenade(r,'gas',mr);}else bossUnitStrike(r,mr);}
 if(mrs.hp>0&&r.hp>0){if(turn%2===0){log(r,'Mrs.バニー：フラググレネード');tokBunnyGrenade(r,'frag',mrs);}else bossUnitStrike(r,mrs);}
}
else if(map==='forest'){const foe=units[0];if(foe.hp>0){if(tokChainEnemySkip(r,foe)){/* no active action */}else if(roll(r,.20))tokButcherChain(r,foe);else tokButcherSaw(r,foe);}}
 else if(map==='office'){
 const alive=units.filter(x=>x.hp>0);
 for(let i=alive.length-1;i>0;i--){const k=Math.floor(rand(r)*(i+1));[alive[i],alive[k]]=[alive[k],alive[i]];}
 const attackers=alive.slice(0,2),pair=attackers.map(x=>x.n);
 const suppression=pair.includes('スルーズ')&&pair.includes('ヒルド');
 const piercing=pair.includes('ヒルド')&&pair.includes('シグルーン');
 const focus=pair.includes('シグルーン')&&pair.includes('スルーズ');
 const effect=suppression?'制圧射撃：両者命中+10pt':piercing?'装甲突破：両者貫通+15':focus?'集中攻撃：両者ダメージ+15%':'なし';
 log(r,`【ヴァルキリーズ】${attackers.map(u=>u.n).join('・')}が攻撃／連携：${effect}`);
 for(const foe of attackers){bossUnitStrike(r,{...foe,hit:foe.hit+(suppression?10:0),weaponPenBonus:piercing?15:0,weaponPowerMultiplier:focus?1.15:1});if(r.hp<=0)break}
}
 else if(map==='nightlife'){const foe=units[0];for(const id of ['raijin','fuujin']){if(r.hp<=0)break;bossUnitStrike(r,{...foe,enemyWeapon:id,hit:foe.hit-10,weaponPowerMultiplier:foe.hp<=foe.maxHp*.5?1.2:1,enemyGear:(foe._dualEnemyGear||(foe._dualEnemyGear={}))[id]||(foe._dualEnemyGear[id]=attAutoWeapon(r,{type:'weapon',base:id,rarity:'common',affixes:[]}))});}}
 
 else if(map==='stadium'){
 // Always give Inferno an explicit attack path and an action log.
 // A reload is a valid non-damaging action and is logged by enemyWeaponAttack.
 const foe=units.find(u=>u.hp>0);
 if(foe){
  if(foe.enemyWeapon!=='hellfire'&&W.hellfire){foe.enemyWeapon='hellfire';foe.enemyGear=attAutoWeapon(r,{type:'weapon',base:'hellfire',rarity:'common',affixes:[]});}
  log(r,'【インフェルノ】ヘルファイアで攻撃');
  bossUnitStrike(r,foe);
 }
}
 else if(map==='diet'&&turn%3===0){tokBossGrenade(r,65,55,50,'ラスプーチン')}
 else{const foe=units[0];if(map==='school'){if((r.combatDistance??0)>0){const before=r.combatDistance;r.combatDistance=0;log(r,`サクラ：瞬歩（${DIST_LABEL[before]} → ${DIST_LABEL[0]}、この行動は攻撃しない）`);}else{const iaido=!!effective._sakuraIaido;const boosted=!!foe._sakuraReadied;foe._sakuraReadied=false;if(iaido)log(r,`サクラ：居合発動（桜花威力1.5倍${boosted?'・見切り連携':''}）`);bossUnitStrike(r,{...foe,weaponPowerMultiplier:iaido?1.5:1});}}else if(map==='power'){bossUnitStrike(r,{...foe,d:foe.d*(foe.hp<=foe.maxHp*.5?1.15:1)})}else bossUnitStrike(r,foe)}
if(map!=='school')bossDistanceTick(r,units);
flashAdvance(units);
if(r.flashTurns>0)r.flashTurns--;
if(r.hp<=0)return 'dead';if(!final&&(r.hp<=t.hp||(!meleeRaidGear(r)&&totalRaidAmmo(r)<Math.ceil(bossEstimate(r)*t.ammo/3))))return 'retreat';}
return final?'dead':'retreat'}
let outcome=run(12,false);if(outcome==='retreat'){log(r,'ボスから撤退を試みる（最大3回）');const esc=escapeCombat(r,b);if(esc==='dead'||esc==='escaped')return esc;outcome=run(6,true)}if(outcome==='won'){r.bossKilled=true;r.kills+=units.length;r.xp+=b.xp;log(r,'【討伐】ボス撃破。生還で報酬確定')}return outcome;}
function tokDoctorArmorRegen(r){if(raidGear(r,'armor')?.base!=='doctor'||r.doctorHealUsed||r.hp<=0||r.hp>maxRaidHp(r)*.5)return false;const gain=Math.ceil(maxRaidHp(r)*.20);r.hp=Math.min(maxRaidHp(r),r.hp+gain);r.doctorHealUsed=true;log(r,`再生の標準装甲：最大HP20%回復 +${gain}HP（1レイド1回）`);return true;} function applyPlayerPoison(r){if(tokSetBonuses(r).statusImmune){log(r,'フェニックス3セット：毒を無効化');return;}r.poisonTurns=4;r.poisonDamageMultiplier=1;log(r,'【状態異常】毒を受けた');if((r.supplies?.antidote||0)>0){r.supplies.antidote--;r.poisonTurns=0;log(r,'解毒薬を自動使用')}}
function tokCultLeaderBattle(r){
 const b=BOSSES.cinema,leader={n:'教祖',hp:100,maxHp:100,def:10,d:b.d,hit:60,ev:10,pen:b.pen,kind:'boss',enemyWeapon:'pm',actions:0};
 equipBossUnit(r,leader,'cinema');leader.enemyWeapon='pm';leader.enemyGear=attAutoWeapon(r,{type:'weapon',base:'pm',rarity:'common',affixes:[]});leader.enemyGear.attachments={};
 r.bossEncountered=true;g.bosses.cinema.seen=true;bossIntel(r,3,'教祖を目撃');bossDistanceStart(r,'cinema');log(r,'【BOSS】教祖 HP100：カルティストが教祖を護衛する');
 let cultist=null;
 const t=bossTactic(r);
 for(let turn=1;turn<=12;turn++){
  if(!hasCombatWeapon(r))return 'retreat';if(r.hp<=0)return 'dead';if(r.hp<=t.hp)return 'retreat';
  turnCare(r);if(r.hp<=0)return 'dead';
  if([1,4,7].includes(turn)){cultist={n:'カルティスト',hp:60,maxHp:60,def:10,ev:25,hit:80,pen:40,d:50,kind:'boss'};log(r,`【召喚】第${turn}R：カルティストが教祖を護衛`)}
  const target=cultist&&cultist.hp>0?cultist:leader;
  const effective={...target};
  const thrown=throwGrenade(r,[target],'boss');
  if(!thrown){const damage=playerAttack(r,effective,target.hp);target.hp=Math.max(0,target.hp-damage);target.armorDur=effective.armorDur;target.helmetDur=effective.helmetDur;log(r,`【敵残HP】${target.n} ${target.hp}/${target.maxHp}`)}
  if(leader.hp<=0){r.bossKilled=true;r.kills++;r.xp+=b.xp;log(r,'【討伐】教祖撃破。生還で教団の聖印を獲得判定');return 'won'}
  if(cultist&&cultist.hp<=0){log(r,'【護衛排除】次ラウンドから教祖を攻撃可能');cultist=null}
  if([3,6,9].includes(turn)&&cultist&&cultist.hp>0){
   log(r,'【自爆】カルティストが自爆攻撃（攻撃50／命中80／貫通40）');
   if(roll(r,.80)&&!roll(r,clamp(baseDodgeChance()+tokPmcStyleDodge(r)+tokAccessoryBonus(r,'evasion')/100,0,.80))){const armor=raidGear(r,'armor');const defense=armorDef(r.armor,r.dur,armor)+tokAccessoryBonus(r,'defense');const damage=dmg(50,defense,40,r);r.hp=Math.max(0,r.hp-damage);log(r,`カルティストの自爆命中：-${damage}HP`)}else log(r,'カルティストの自爆を回避');cultist=null;
  }
  if(r.hp<=0)return 'dead';
  if([1,4,7].includes(turn)){
   if(roll(r,.50)){r.flashTurns=3;log(r,'教祖：フラッシュグレネード命中（3ターン）')}else log(r,'教祖：フラッシュ回避');
  }else{enemyStrike(r,{...leader,enemyWeapon:'pm',enemyGear:leader.enemyGear,_weaponState:leader});}
  if(r.hp<=0)return 'dead';flashAdvance([leader]);if(r.flashTurns>0)r.flashTurns--;
  bossDistanceTick(r,[leader]);
 }
 return 'retreat';
}
// v3.6.26: Gunslinger boss fanning shot. One round per shot, including opening and bonus shots.
function tokGunslingerVolley(r,b,state){
 if((state.gunslingerRounds||0)>=5){
  state.gunslingerRounds=0;
  log(r,'ガンスリンガー：5発を撃ち切り再装填（攻撃休止）');
  return;
 }
 let bonusShot=false;
 do{
  const round=++state.gunslingerRounds;
  const deadeye=round===2||round===4;
  const extraAccuracy=bonusShot?-15:0;
  if(deadeye)log(r,'デッドアイ：命中+15pt・貫通+20・威力+25%');
  if(bonusShot)log(r,'【ファニングショット】追加射撃（命中-15pt・弾薬1発消費）');
  const hpBefore=r.hp;
  enemyStrike(r,{...b,enemyWeapon:state.enemyWeapon,enemyGear:state.enemyGear,
   _weaponState:state,hit:b.hit+(deadeye?15:0)+extraAccuracy,
   weaponPenBonus:deadeye?20:0,weaponPowerMultiplier:deadeye?1.25:1,flashTurns:0});
  // Only a damaging hit can trigger another shot. Never fire past the five-round cylinder.
  bonusShot=r.hp<hpBefore&&r.hp>0&&state.gunslingerRounds<5&&roll(r,.30);
 }while(bonusShot);
}
function bossBattleCore(r){r.firstShotUsed=false;r.glockOpeningShotUsed=false;r.huntressTarget=null;r.minigunCycle=0;r.encounterGrenades=0;r.grenadeActionCount=0;if(r.map==='police')return cerberusBattleCore(r);if(r.map==='cinema')return tokCultLeaderBattle(r);if(['zoo','park','school','temple','power','forest','office','stadium','nightlife','diet'].includes(r.map))return newBossBattle(r);const b=BOSSES[r.map],state={hp:b.hp,actions:0,heals:0,n:b.n,def:b.def,d:b.d,hit:b.hit,flashTurns:0};equipBossUnit(r,state,r.map);state.kind='boss';bossDistanceStart(r,r.map);r.bossEncountered=true;g.bosses[r.map].seen=true;bossIntel(r,3,'ボスを目撃');log(r,`【BOSS】${b.n}出現！ HP${b.hp}`);if(r.map!=='airport'&&roll(r,.10)){log(r,`【敵の強襲攻撃】${b.n}が先制！`);enemyStrike(r,{...b,enemyWeapon:state.enemyWeapon,enemyGear:state.enemyGear,_weaponState:state,hit:Math.max(5,b.hit-15)});if(r.hp<=0)return 'dead'}if(r.map==='airport'){log(r,'クイックドロー：開幕先制射撃');tokGunslingerVolley(r,b,state);state.actions=1;if(r.hp<=0)return 'dead'}const t=bossTactic(r);function fight(rounds){for(let i=0;i<rounds;i++){if(!hasCombatWeapon(r))return 'retreat';if(r.hp<=t.hp)return 'retreat';r._bossObservedThisTurn=false;r._bossSpecialObserved=false;turnCare(r);if(r.hp<=0)return 'dead';const phantomTurn=state.actions+1;const phantomEv=r.map==='metro'?Math.min(80,5+25*Math.floor((phantomTurn-1)/3)):b.ev;if(r.map==='metro'&&phantomTurn>1&&(phantomTurn-1)%3===0)log(r,phantomTurn===4?'【ファントム】攻撃パターンを読み始めた（回避30%）':phantomTurn===7?'【ファントム】動きを捉えることが難しくなってきた（回避55%）':'【ファントム】攻撃を見切りつつある（回避80%）');const target={...state,ev:r.map==='metro'?phantomEv:b.ev};let thrown=throwGrenade(r,[state],'boss');let amount=thrown?0:playerAttack(r,target,state.hp);state.hp-=amount;state.armorDur=target.armorDur;state.helmetDur=target.helmetDur;state.dodge=false;if(r.perfumeAccuracyDebuff>0)r.perfumeAccuracyDebuff--;if(r.perfumeDefenseDebuff>0)r.perfumeDefenseDebuff--;if(state.hp<=0)return 'won';if(r.map==='hospital'&&state.hp>0&&state.hp<=b.hp*.5&&state.heals<1){const gain=Math.ceil(b.hp*.20);state.hp=Math.min(b.hp,state.hp+gain);state.heals++;log(r,`再生の標準装甲：被弾後 +${gain}HP（1レイド1回）`)}bossStrike(r,b,state);flashAdvance([state]);if(r.hp<=0)return 'dead';bossDistanceTick(r,[state]);if(r.hp<=t.hp||(!meleeRaidGear(r)&&totalRaidAmmo(r)<Math.ceil(bossEstimate(r)*t.ammo/3)))return 'retreat'}return 'retreat'}let res=fight(12);if(res==='won'){r.bossKilled=true;r.kills++;r.xp+=b.xp;log(r,`【討伐】${b.n}撃破！ 脱出成功まで報酬は仮確定`);return 'won'}if(res==='dead')return 'dead';log(r,'ボスから撤退を試みる（最大3回）');const esc=escapeCombat(r,b);if(esc==='escaped'||esc==='dead')return esc;log(r,'【最終抵抗】最大6ラウンド');res=fightFinal(6);if(res==='won'){r.bossKilled=true;r.kills++;r.xp+=b.xp;log(r,`【逆転討伐】${b.n}撃破！`);return 'won'}return 'dead';function fightFinal(n){for(let i=0;i<n;i++){if(!hasCombatWeapon(r))return 'dead';r._bossObservedThisTurn=false;r._bossSpecialObserved=false;turnCare(r);if(r.hp<=0)return 'dead';let target={...state,ev:r.map==='metro'?Math.min(80,5+25*Math.floor(state.actions/3)):b.ev};const finalGrenade=throwGrenade(r,[state],'boss');if(!finalGrenade)state.hp-=playerAttack(r,target,state.hp);state.armorDur=target.armorDur;state.helmetDur=target.helmetDur;if(r.perfumeAccuracyDebuff>0)r.perfumeAccuracyDebuff--;if(r.perfumeDefenseDebuff>0)r.perfumeDefenseDebuff--;if(state.hp<=0)return 'won';if(r.map==='hospital'&&state.hp>0&&state.hp<=b.hp*.5&&state.heals<1){const gain=Math.ceil(b.hp*.20);state.hp=Math.min(b.hp,state.hp+gain);state.heals++;log(r,`再生の標準装甲：被弾後 +${gain}HP（1レイド1回）`)}bossStrike(r,b,state);flashAdvance([state]);if(r.hp<=0)return 'dead';bossDistanceTick(r,[state])}return 'dead'}}

