Object.assign(BOSS_DISTANCE_PROFILE,{machine:{preferred:0,mobility:-10},shadow:{preferred:2,mobility:-5},death:{preferred:1,mobility:10},perfume:{preferred:1,mobility:5},school:{preferred:0,mobility:15},zoo:{preferred:2,mobility:10},park:{preferred:1,mobility:0},temple:{preferred:0,mobility:-15},power:{preferred:1,mobility:10}});
// v3.6.16: Explicit preferred distance for all six new area bosses; no implicit mid-range fallback.
Object.assign(BOSS_DISTANCE_PROFILE,{cinema:{preferred:1,mobility:0},forest:{preferred:0,mobility:10},office:{preferred:1,mobility:10},stadium:{preferred:0,mobility:0},nightlife:{preferred:0,mobility:15},diet:{preferred:1,mobility:0}});

const CERBERUS_DISTANCE={alpha:0,beta:1,gamma:2};
const BOSS_LEARNING_STAGE=[0,0.30,0.60,0.90];
function normalizeBossLearning(value){
 const x=value&&typeof value==='object'?value:{};
 const stats=x.stats&&typeof x.stats==='object'?x.stats:{};
 const normalized={};
 for(let d=0;d<3;d++){
  const q=stats[d]||{};
  normalized[d]={shots:Math.max(0,Math.min(10000,Number(q.shots)||0)),hits:Math.max(0,Math.min(10000,Number(q.hits)||0)),damage:Math.max(0,Math.min(1000000,Number(q.damage)||0)),attacks:Math.max(0,Math.min(10000,Number(q.attacks)||0))};
 }
 return {observations:Math.max(0,Math.min(6,Number(x.observations)||0)),stats:normalized,seenTypes:Array.isArray(x.seenTypes)?x.seenTypes.filter(t=>['shot','burst','special','melee'].includes(t)).slice(0,4):[]};
}
function learningWeight(x){const n=x?.observations||0;return n>=6?.9:n>=3?.6:n>=1?.3:0}
function bossLearnAttack(r,e,didDamage,damage){
 if(!r._bossDistanceContext||!g.bosses?.[r.map])return;
 const record=g.bosses[r.map].learning||(g.bosses[r.map].learning=normalizeBossLearning(null));
 const dist=Math.max(0,Math.min(2,r.combatDistance??1));const s=record.stats[dist];
 s.shots=Math.min(10000,s.shots+1);s.hits=Math.min(10000,s.hits+(didDamage?1:0));
 s.damage=Math.min(1000000,s.damage+Math.max(0,damage||0));
 s.attacks=Math.min(10000,s.attacks+1);
 if(!r._bossObservedThisTurn){
  const before=record.observations;
  record.observations=Math.min(6,record.observations+1);r._bossObservedThisTurn=true;
  if([1,3,6].includes(record.observations)&&record.observations!==before){
   log(r,`【戦闘学習】${BOSSES[r.map].n}の分析が進展（${record.observations}/6・信頼度${Math.round(learningWeight(record)*100)}%）`);
  }
 }
 if(r._bossSpecialObserved&&!record.seenTypes.includes('special'))record.seenTypes.push('special');
 const type=r.map==='mall'?'burst':e.id&&CERBERUS_DISTANCE[e.id]!==undefined?'shot':'shot';
 if(!record.seenTypes.includes(type))record.seenTypes.push(type);
}
function bossDistanceStart(r,map){
 r.smokeTurns=0;
 const pref=BOSS_DISTANCE_PROFILE[map]?.preferred??1;
 const rollValue=rand(r);
 if(pref===1)r.combatDistance=rollValue<.2?0:rollValue<.8?1:2;
 else if(pref===0)r.combatDistance=rollValue<.6?0:rollValue<.9?1:2;
 else r.combatDistance=rollValue<.1?0:rollValue<.4?1:2;
 r._bossDistanceContext=true;r._bossObservedThisTurn=false;r._bossSpecialObserved=false;r.bossDistanceTurn=0;
 const edge=map==='police'?'（部隊の初期得意距離：中距離）':'';
 log(r,`【交戦距離】${DIST_LABEL[r.combatDistance]}で遭遇${edge}`);
 const bonus=bossRangeAdjustment(r.map,r.combatDistance);
 if(map!=='police')log(r,bossKnown(map)?`【戦況】${BOSSES[map].n}の距離命中補正 ${bonus>=0?'+':''}${bonus}pt`:'【戦況】敵の距離適性は調査・実戦で解析可能');
}
function bossRangeAdjustment(map,dist,unit){
 const pref=unit&&CERBERUS_DISTANCE[unit.id]!==undefined?CERBERUS_DISTANCE[unit.id]:(BOSS_DISTANCE_PROFILE[map]?.preferred??1);
 return Math.abs(dist-pref)===0?10:Math.abs(dist-pref)===1?-15:-30;
}
function bossDistanceEnemyHit(r,e){
 if(!r._bossDistanceContext)return e;
 const bonus=(r.map==='tower'||r.map==='police')&&e.enemyWeapon&&W[e.enemyWeapon]?weaponRangeBonus(e.enemyWeapon,r.combatDistance):bossRangeAdjustment(r.map,r.combatDistance,e);return {...e,hit:(e.hit||65)+bonus};
}
function bossDistancePredictedThreat(r,dist,alive){
 const b=BOSSES[r.map];const st=g.bosses[r.map];
 const known=bossFull(r.map);const learns=st.learning||normalizeBossLearning(null);
 const observed=learns.stats[dist],w=learningWeight(learns);
 // Observations are influenced by armor/headshots and debuffs; never treat the raw damage as intrinsic weapon damage.
 const priorHit=known?b.hit/100:.65,priorDamage=known?b.d:22;
 const seenP=observed.shots?(observed.hits+10*priorHit)/(observed.shots+10):priorHit;
 const seenD=observed.hits?Math.min(120,observed.damage/observed.hits):priorDamage;
 const p=observed.shots?priorHit*(1-w)+seenP*w:priorHit;
 const d=observed.hits?priorDamage*(1-w)+seenD*w:priorDamage;
 const actors=(alive||[]).filter(x=>x.hp>0);
 const count=Math.min(2,actors.length||1);
 const rate=actors.length&&r.map==='police'&&known?actors.reduce((sum,x)=>sum+Math.max(.05,Math.min(.95,(x.hit+bossRangeAdjustment(r.map,dist,x))/100)),0)/actors.length:Math.max(.05,Math.min(.95,p+(known?bossRangeAdjustment(r.map,dist)/100:0)));
 const armor=armorDef(r.armor,r.dur,raidGear(r,'armor'));
 const raw=Math.max(1,d*(1-Math.max(0,armor-(known?b.pen:35))/100));
 // Approximation only: headshot risk and multi-shot danger, without sampling the raid RNG.
 const shotCount=r.map==='mall'?4:count;
 const flash=(alive||[]).filter(x=>x.flashTurns>0);
 const flashPt=flash.length?flashPenalty(flash[0]):0;
 const shotHit=Math.max(.05,Math.min(.95,rate-flashPt/100));
 const expected=shotCount*shotHit*raw*(1+.05*.75);
 // Independent approximated lethal-hit events, incl. 5% headshot. No exponential shot-by-shot enumeration.
 let survival=0;
 let prob=[1];
 for(let i=0;i<shotCount;i++){
  const next=new Array(i+2).fill(0);
  for(let j=0;j<prob.length;j++){next[j]+=prob[j]*(1-shotHit);next[j+1]+=prob[j]*shotHit;}
  prob=next;
 }
 // Approximate multi-hit lethality; account for headshots by a modest damage multiplier.
 for(let hits=0;hits<prob.length;hits++){
  const normal=hits*raw;
  const headRisk=hits>0?1-Math.pow(.95,hits):0;
  const surviveNormal=normal<r.hp?1:0;
  const surviveHead=(normal+raw*.75)<r.hp?1:0;
  survival+=prob[hits]*((1-headRisk)*surviveNormal+headRisk*surviveHead);
 }
 // Unobserved special attacks must not be given their secret exact damage or chance.
 const specialObserved=learns.seenTypes.includes('special')||known;
 if(specialObserved){
  const specialChance=r.map==='tower'?.25:r.map==='airport'?.17:r.map==='suburban'?.33:r.map==='port'?.2:.12;
  const specialFail=flash.length?({3:.60,2:.40,1:.20}[flash[0].flashTurns]||0):0;
  const burstRisk=shotHit*specialChance*(1-specialFail);
  survival*=Math.max(0,1-burstRisk*.18);
 }
 return {expected,survival:Math.max(0,Math.min(1,survival))};
}
function bossDistancePlayerDamage(r,dist,enemy){
 const b=BOSSES[r.map];const def=bossFull(r.map)?(enemy?.def??b.def):35,ev=bossFull(r.map)?(enemy?.ev??b.ev):12;
 const candidates=[];
 for(const x of primaryAndSecondary(r)){
  const w=W[x.base];if(w.melee||(x.dur??100)<=0)continue;
  const ammo=r.ammoByCaliber?.[w.ammo]||0;if(ammo<=0)continue;
  const power=w.d*(1+gearVal(x,'damage')/100)*(1-Math.max(0,def-(w.p+gearVal(x,'penetration')))/100);
  const shots=Math.min(w.shots||1,ammo);
  let score=0;for(let k=0;k<shots;k++){
   const chance=clamp(60+w.a+gearVal(x,'accuracy')+levelAccuracyBonus()-ev+weaponRangeBonus(x.base,dist)+shotgunCloseAccuracy(x.base,dist)-k*10,5,95)/100;
   score+=Math.max(1,power)*chance*(1+.05*.75);
  }
  candidates.push(score*shotgunDamageMultiplier(x.base,dist));
 }
 const melee=meleeRaidGear(r);
 if(melee){const w=W[melee.base];const chance=clamp(62+w.a+gearVal(melee,'accuracy')+levelAccuracyBonus()-ev,8,92)/100;
  const reach=dist===0?1:dist===1?.4:.12;
  candidates.push(reach*chance*Math.max(1,w.d*(1-Math.max(0,def-w.p)/100)));
 }
 return Math.max(0,...candidates);
}
function bossDistanceScore(r,dist,alive){
 const threat=bossDistancePredictedThreat(r,dist,alive);
 const hpMax=Math.max(1,maxRaidHp(r));
 const hpRatio=r.hp/hpMax;
 const risk=hpRatio>.5?1:hpRatio>.3?1.5:2.5;
 // A usable medical item can be credited only once in a local projection, without consuming it.
 const med=r.supplies||{};
 const care=r.hp<=hpMax*.3?(med.advanced?70:med.med?30:0):(med.advanced?70:med.med&&r.hp<=hpMax*.5?30:0);
 const effectiveHp=Math.min(hpMax,r.hp+care);
 // The medicine action is before normal attacks, so limited healing can reduce near-term danger.
 const realSurvival=effectiveHp>r.hp?Math.max(threat.survival,Math.min(.99,threat.survival+(effectiveHp-r.hp)/hpMax*.20)):threat.survival;
 const viable=realSurvival>0||effectiveHp>threat.expected;
 return {value:bossDistancePlayerDamage(r,dist,alive?.find(x=>x.hp>0))-threat.expected*risk,
  survival:realSurvival,viable,care};
}
function bossDistanceTarget(r,alive){
 if(r.map!=='police')return BOSS_DISTANCE_PROFILE[r.map]?.preferred??1;
 const scores=[0,1,2].map(d=>alive.filter(u=>u.hp>0).reduce((sum,u)=>sum+bossRangeAdjustment('police',d,u),0));
 const maximum=Math.max(...scores);
 const choices=scores.map((score,i)=>score===maximum?i:-1).filter(x=>x>=0);
 return choices.includes(r.combatDistance)?r.combatDistance:choices[0]; // stable tie-break, no predictive RNG
}
function bossDistanceTick(r,alive){
 if(!r._bossDistanceContext)return;
 r.bossDistanceTurn=(r.bossDistanceTurn||0)+1;
 const turn=r.bossDistanceTurn;
 // When every surviving boss unit is unable to attack at the current distance,
 // prioritize a closing maneuver every turn instead of waiting for turns 3/6/9.
 const living=(alive||[]).filter(u=>u.hp>0);
 const dist=r.combatDistance??1;
 if(living.length&&r.hp>0&&dist>0){
  const reach=u=>{
   const w=u.enemyWeapon&&W[u.enemyWeapon];
   if(w)return w.melee?0:2;
   return r.map==='death'?1:(r.map==='hospital'||r.map==='industrial'||r.map==='temple'||r.map==='school'?0:2);
  };
  if(living.every(u=>dist>reach(u))){
   const chance=r.map==='industrial'?.75:.75;
   log(r,`【第${turn}ターン・接近】${BOSSES[r.map].n}が攻撃射程に入るため接近を試みる（成功率${Math.round(chance*100)}%）`);
   if(roll(r,chance)){
    r.combatDistance=dist-1;
    log(r,`【距離変更成功】${DIST_LABEL[dist]} → ${DIST_LABEL[r.combatDistance]}（次ターンから攻撃可能）`);
   }else log(r,`【距離変更失敗】${DIST_LABEL[dist]}を維持`);
   return;
  }
 }
 if(turn!==3&&turn!==6&&turn!==9)return;
 if(!alive.some(x=>x.hp>0)||r.hp<=0)return;
 const here=r.combatDistance??1;
 const current=bossDistanceScore(r,here,alive);
 const possible=[here-1,here+1].filter(x=>x>=0&&x<3);
 const remaining=[3,6,9].filter(t=>t>turn).length;
 const immediate=possible.map(d=>({dist:d,...bossDistanceScore(r,d,alive)}));
 // Two-step lookahead: future benefit is discounted by the probability of a second 50% maneuver.
 const candidates=immediate.map(o=>{
  let score=o.value;
  if(remaining&&o.viable){const further=[o.dist-1,o.dist+1].filter(x=>x>=0&&x<3&&x!==here);
   for(const f of further){const later=bossDistanceScore(r,f,alive);if(later.viable)score=Math.max(score,o.value*.75+later.value*.25);}
  }
  return {...o,score};
 }).sort((a,b)=>b.score-a.score);
 const desired=candidates.find(x=>x.viable&&x.score>=current.value+5);
 const bossGoal=bossDistanceTarget(r,alive);
 const bossStep=Math.sign(bossGoal-here);
 const playerStep=desired?Math.sign(desired.dist-here):0;
 if(!playerStep&&!bossStep){log(r,`【第${turn}ターン】双方が${DIST_LABEL[here]}を維持`);return;}
 const bossChance=(50+(BOSS_DISTANCE_PROFILE[r.map]?.mobility||0))/100;
 const playerChance=.50;
 let attempt=0,chance=0,actor='';
 if(playerStep&&bossStep&&playerStep===bossStep){attempt=playerStep;chance=Math.max(bossChance,playerChance);actor='双方';}
 else if(!bossStep){attempt=playerStep;chance=playerChance;actor='プレイヤー';}
 else if(!playerStep){attempt=bossStep;chance=bossChance;actor=BOSSES[r.map].n;}
 else {
  const playerDisadv=Math.abs(here-(desired?.dist??here));
  const bossDisadv=Math.abs(here-bossGoal);
  const playerLead=playerDisadv===bossDisadv?.50:playerDisadv>bossDisadv?.70:.30;
  if(roll(r,playerLead)){attempt=playerStep;chance=playerChance;actor='プレイヤー';}
  else {attempt=bossStep;chance=bossChance;actor=BOSSES[r.map].n;}
 }
 if(!attempt)return;
 const moveName=attempt<0?'接近':'後退';
 log(r,`【第${turn}ターン】${actor}が${moveName}を試みる`);
 if(roll(r,chance)){
  const before=r.combatDistance;r.combatDistance=Math.max(0,Math.min(2,before+attempt));
  log(r,`【距離変更成功】${DIST_LABEL[before]} → ${DIST_LABEL[r.combatDistance]}（次ターンから適用）`);
  if(r.map!=='police')log(r,`【戦況変化】${BOSSES[r.map].n}の命中補正 ${bossRangeAdjustment(r.map,before)>=0?'+':''}${bossRangeAdjustment(r.map,before)}pt → ${bossRangeAdjustment(r.map,r.combatDistance)>=0?'+':''}${bossRangeAdjustment(r.map,r.combatDistance)}pt`);
 }else log(r,`【距離変更失敗】${DIST_LABEL[here]}を維持`);
}

function ensureBossState(x){x.royalCollection=x.royalCollection||{};for(const id of ROYAL_IDS){if((x.bank?.loot?.[id]||0)>0||(x.longVault?.loot?.[id]||0)>0||(x.storage?.container?.loot?.[id]||0)>0)x.royalCollection[id]=true;}if(ROYAL_IDS.every(id=>x.royalCollection[id]))x.royalTitle=true;ensureDistrictKeys(x);x.history=(x.history||[]).slice(0,30);x.collection=x.collection||{};for(const z of (x.gear||[]))if(z.rarity==='boss'&&z.base)x.collection[z.base]=true;x.reportPending=!!x.reportPending;x.gear=(x.gear||[]).map(z=>({...z,newItem:!!z.newItem}));x.bosses=x.bosses||{};for(const id of Object.keys(BOSSES)){const b=x.bosses[id]||{};x.bosses[id]={intel:Math.max(0,b.intel||0),seen:!!b.seen,first:!!b.first,kills:b.kills||0,attempts:b.attempts||0,portraitUnlocked:!!b.portraitUnlocked||!!b.first||!!b.kills,learning:normalizeBossLearning(b.learning)};}x.unlocked=x.unlocked||{suburban:true};x.unlocked.suburban=true;ensureDistrictKeys(x);x.bank.supplies=x.bank.supplies||{};x.bank.helmets=x.bank.helmets||{};x.carry=x.carry||{};x.ammoCarry=x.ammoCarry&&typeof x.ammoCarry==='object'?x.ammoCarry:{};x.settings.grenadePolicy=x.settings.grenadePolicy||'groups';x.settings.grenadeTiming=x.settings.grenadeTiming||'start';tokSlots(x);x.armBroken=!!x.armBroken;x.legBroken=!!x.legBroken;x.burnTurns=Math.max(0,x.burnTurns||0);x.settings.raidType=x.settings.raidType||'normal';x.settings.bossPolicy=x.settings.bossPolicy||'fight';x.settings.bossTactic=x.settings.bossTactic||'normal';x.settings.cerberusPriority=x.settings.cerberusPriority||'commander';x.settings.targetPriority=({commander:'threat',firepower:'threat',armor:'lowhp'}[x.settings.targetPriority]||x.settings.targetPriority||'lowhp');x.eqIds=x.eqIds||{};x.eqIds.helmet=x.eqIds.helmet||null;x.eqIds.secondary=x.eqIds.secondary||null;x.eqIds.melee=x.eqIds.melee||null;if(x.eqIds.melee&&!x.gear.some(z=>z.id===x.eqIds.melee&&W[z.base]?.melee))x.eqIds.melee=null;if(x.eqIds.secondary===x.eqIds.weapon)x.eqIds.secondary=null;if(x.raid&&x.raid.am