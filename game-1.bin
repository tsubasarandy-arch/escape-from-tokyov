const TOK_WEAPON_MAP={
 suburban:[['hg','sg'],['smg','melee'],['sr','lmg']],industrial:[['smg','sg'],['ar','melee'],['sr','dmr']],metro:[['smg','melee'],['hg','sg'],['sr','dmr']],school:[['hg','melee'],['smg','sg'],['lmg','sr']],hospital:[['smg','ar'],['hg','sg'],['sr','lmg']],mall:[['hg','smg'],['sg','melee'],['sr','lmg']],zoo:[['sg','dmr'],['ar','sr'],['lmg','smg']],park:[['hg','smg'],['sg','melee'],['sr','lmg']],temple:[['melee','dmr'],['hg','sr'],['lmg','smg']],airport:[['ar','dmr'],['sr','lmg'],['melee','hg']],port:[['ar','lmg'],['smg','sg'],['melee','hg']],tower:[['dmr','sr'],['ar','smg'],['sg','melee']],police:[['ar','sg'],['smg','lmg'],['melee','sr']],power:[['ar','lmg'],['smg','dmr'],['hg','melee']],lab:[['ar','smg'],['dmr','lmg'],['melee','hg']],nightlife:[['hg','melee'],['smg','sg'],['sr','lmg']],stadium:[['ar','lmg'],['smg','dmr'],['sr','melee']],forest:[['sr','dmr'],['sg','melee'],['smg','lmg']],office:[['ar','sr'],['dmr','smg'],['sg','melee']],cinema:[['hg','sg'],['smg','melee'],['sr','lmg']],diet:[['ar','dmr'],['sr','lmg'],['melee','hg']]
