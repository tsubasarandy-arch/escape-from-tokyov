function bossStrike(r,b,state){b={...b,kind:'boss',enemyWeapon:state.enemyWeapon,enemyGear:state.enemyGear,_weaponState:state,magActions:state.magActions,armorId:state.armorId,helmetId:state.helmetId,armorDur:state.armorDur,helmetDur:state.helmetDur};state.actions++;const special=(r.map==='airport'&&state.actions%6===4)||(r.map==='suburban'&&state.actions%3===0)||(r.map==='mall'&&state.actions%5!==0)||(r.map==='port'&&state.actions===1);if(special&&state.flashTurns>0&&roll(r,({3:.60,2:.40,1:.20}[state.flashTurns]||0))){log(r,'【妨害】ボスの特殊攻撃が失敗');return;}r._bossSpecialObserved=!!special;let power=b.d,hit=b.hit-flashPenalty(state);
