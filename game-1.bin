function bossRewardList(r,map,first){if(map==='forest')return [['weapon','chainsaw'],['accessory','binding_chain']].filter(()=>first||roll(r,.20)).map(([type,id])=>type==='weapon'?bossGear(r,id):makeGear(r,'accessory',id,'boss'));if(map==='cinema')return first||roll(r,.20)?[makeGear(r,'accessory','cult_seal','boss')]:[];if(['forest','office','nightlife'].includes(map)){const ids={forest:['execution_axe','guardian_swordshield'],office:['mjolnir','gungnir','valhalla'],nightlife:['raijin','fuujin']}[map];return ids.filter(()=>first||roll(r,.20)).map(id=>bossGear(r,id));}if(map==='police')return [['helmet','commander_headset'],['armor','fortress_shield'],['bag','hound_backpack']].filter(()=>first||roll(r,.20)).map(([type,id])=>specialBossGear(r,type,id));const specs=map==='hospital'?[['weapon','poison_scalpel'],['armor','doctor']]:map==='industrial'?[['armor','bulldozer'],['weapon','bulldozer_hammer']]:map==='zoo'?[['weapon','huntress'],['helmet','tiger_helmet']]:map==='park'?[['helmet','bunny_mask'],['bag','bombbag']]:map==='temple'?[['weapon','kongou'],['armor','kongou_robe']]:null;if(!specs)return first||roll(r,.20)?[bossGear(r,map)]:[];return specs.filter(()=>first||roll(r,.20)).map(([type,id])=>specialBossGear(r,type,id))}
function bossEstimate(r){const st=g.bosses[r.map],b=BOSSES[r.map],w=W[r.weapon];const intel=st.intel;const hp=intel>=b.full?b.hp:intel>=b.intel?Math.round(b.hp*1.2):Math.round(b.hp*1.25);const def=intel>=b.full?b.def:intel>=b.intel?Math.round(b.def*.85):Math.round(b.def*.9);const damage=Math.max(1,Math.floor(w.d*(1-Math.max(0,def-w.p)/100)));const hit=clamp((60+w.a+levelAccuracyBonus()-(intel>=b.full?b.ev:15))/100,.05,.95);return Math.ceil(hp/Math.max(1,damage*hit))}
