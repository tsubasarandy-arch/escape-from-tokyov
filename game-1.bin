const DISTRICT_CLUES={"cinema":["映画館の警備記録","映写室の入退室記録","地下搬入口の図面"],"forest":["森林公園の巡回記録","管理事務所の鍵台帳","封鎖区域の案内図"],"office":["オフィスビルの入館記録","通信端末の記録","非常階段の見取り図"],"stadium":["スタジアムの警備日誌","設備管理記録","地下通路の配置図"],"nightlife":["歓楽街の監視記録","地下搬入口の記録","警備網の配置図"],"diet":["議事堂の警備記録","特別入館記録","地下通路の設計図"],"hospital": ["隔離病棟の搬入記録", "救急搬送車の走行履歴", "病院封鎖命令の写し"], "mall": ["閉鎖前の警備巡回表", "搬入口の入退館記録", "商業施設の非常電源図"], "zoo": ["飼育員の巡回日誌", "獣舎の施錠管理簿", "地下飼料庫の搬入伝票"], "park": ["運行停止した遊具の点検表", "従業員通路の配置図", "閉園当夜の警備無線"], "temple": ["参道に残された巡礼者の記録", "僧坊の古い見取り図", "本堂地下の封印記録"], "airport": ["貨物ターミナルの積荷一覧", "管制塔の最終交信記録", "滑走路封鎖指令"], "port": ["コンテナ積荷の照合票", "港湾警備隊の交代表", "埠頭の密輸航路メモ"], "tower": ["通信中継設備の保守記録", "アンテナ施設の入館履歴", "途切れた暗号通信の断片"], "police": ["押収品保管庫の台帳", "特別部隊の出動記録", "警察本部の緊急退避指令"], "power": ["送電系統の異常報告書", "発電炉の保守作業記録", "中央制御室の認証手順"], "lab": ["研究員の移送記録", "機密実験の搬入台帳", "地下研究施設の最終アクセス記録"]};const DISTRICT_KEY_NAMES={"cinema":"映画館の管理キー","forest":"森林公園管理キー","office":"オフィス街通行証","stadium":"スタジアム保安キー","nightlife":"歓楽街アクセスキー","diet":"国会議事堂特別入館証","hospital": "隔離病棟セキュリティカード", "mall": "商業施設バックヤード通行証", "zoo": "動物園管理棟マスターキー", "park": "遊園地保守ゲートキー", "temple": "寺院奥院の鉄鍵", "airport": "空港貨物区画アクセスカード", "port": "港湾保安ゲート認証票", "tower": "通信施設の保守認証キー", "police": "警察本部特別入館証", "power": "発電所中央制御室キー", "lab": "地下研究施設の最高機密認証キー"};
const TOK_MAP_EDGES=[["airport", "diet"], ["airport", "lab"], ["airport", "port"], ["cinema", "hospital"], ["cinema", "office"], ["cinema", "temple"], ["diet", "airport"], ["diet", "lab"], ["diet", "police"], ["forest", "park"], ["forest", "zoo"], ["hospital", "park"], ["hospital", "power"], ["hospital", "tower"], ["industrial", "cinema"], ["industrial", "mall"], ["industrial", "office"], ["industrial", "temple"], ["mall", "hospital"], ["mall", "park"], ["mall", "stadium"], ["metro", "forest"], ["metro", "mall"], ["metro", "office"], ["metro", "temple"], ["nightlife", "airport"], ["nightlife", "port"], ["nightlife", "power"], ["office", "cinema"], ["office", "hospital"], ["office", "park"], ["office", "zoo"], ["park", "hospital"], ["park", "nightlife"], ["park", "power"], ["park", "zoo"], ["police", "diet"], ["police", "lab"], ["port", "airport"], ["port", "lab"], ["power", "airport"], ["power", "nightlife"], ["power", "port"], ["power", "tower"], ["school", "cinema"], ["school", "forest"], ["school", "hospital"], ["school", "office"], ["stadium", "diet"], ["stadium", "police"], ["stadium", "tower"], ["suburban", "cinema"], ["suburban", "hospital"], ["suburban", "office"], ["temple", "cinema"], ["temple", "hospital"], ["temple", "stadium"], ["temple", "tower"], ["tower", "diet"], ["tower", "police"], ["tower", "power"], ["tower", "stadium"], ["zoo", "nightlife"], ["zoo", "park"], ["zoo", "power"]]; function keyTargets(id){const tier=DISTRICT_TIERS.findIndex(group=>group.includes(id));return tier>=0&&tier<5?DISTRICT_TIERS[tier+1].slice():[]}
function districtTier(id){return DISTRICT_TIERS.findIndex(group=>group.includes(id))}
function districtTierReady(x,tier){if(tier<=0)return true;if(tier===5)return !!(x.districtKeys?.lab||x.unlocked?.lab);return DISTRICT_TIERS[tier].filter(id=>x.districtKeys?.[id]||x.unlocked?.[id]).length>=2}
function syncTierUnlocks(x){x.districtKeys=x.districtKeys||{};x.unlocked=x.unlocked||{};for(const id of DISTRICT_TIERS[0])x.unlocked[id]=true;for(let tier=1;tier<6;tier++){if(!districtTierReady(x,tier))continue;for(const id of DISTRICT_TIERS[tier])if(x.districtKeys[id])x.unlocked[id]=true}}

