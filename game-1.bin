<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#111922"><title>Escape from Tokyov v3.4.0 タイトルメニュー</title><!-- Combat and enemy loadout v3.4.58 --><style>
:root{color-scheme:dark;--bg:#0c1219;--panel:#16212b;--panel2:#1c2b36;--line:#30414c;--text:#e7e9e7;--muted:#a0afb8;--green:#9bcd95;--amber:#e9c27b;--red:#ec8c87}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#20303b,#0c1219 55%);font:15px/1.55 -apple-system,BlinkMacSystemFont,'Hiragino Kaku Gothic ProN',Meiryo,sans-serif;color:var(--text)}button,select,input{font:inherit}button{background:#293b47;color:var(--text);border:1px solid #465c69;border-radius:10px;padding:11px 13px;cursor:pointer}button:active{transform:scale(.985)}button:disabled{opacity:.4;cursor:default}button.primary{background:#416b51;border-color:#70a77d;font-weight:700}button.danger{background:#613a3c;border-color:#986265}button.small{padding:6px 9px;font-size:12px}input,select{background:#0e1922;border:1px solid #405460;border-radius:8px;color:var(--text);padding:9px;max-width:100%}header{max-width:1080px;margin:auto;padding:20px 16px 12px}h1{font-size:24px;margin:0;letter-spacing:.09em}h2{font-size:18px;margin:0 0 12px}h3{font-size:15px;margin:0 0 8px}p{margin:7px 0}small,.muted{color:var(--muted)}.tag{color:var(--green);font-size:12px;letter-spacing:.15em}.shell{max-width:1080px;margin:auto;padding:0 12px 40px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:10px 0}.stat{padding:12px;background:#172530;border:1px solid var(--line);border-radius:12px}.stat b{display:block;font-size:18px}.stat span{color:var(--muted);font-size:11px}.tabs{display:flex;overflow-x:auto;gap:6px;padding:7px 0 12px;position:sticky;top:0;z-index:4;background:#0d151ddd}.tabs button{white-space:nowrap;padding:9px 12px}.tabs button.on{background:#466c59;border-color:#81b394}.panel{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:15px;margin:0 0 12px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.flex{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}.item{padding:11px 0;border-bottom:1px solid #2b3a44}.item:last-child{border-bottom:0}.item-title{font-weight:650}.btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.pill{display:inline-block;font-size:11px;border:1px solid #526371;padding:2px 7px;border-radius:20px;color:#bbced6}.ok{color:var(--green)}.warn{color:var(--amber)}.bad{color:var(--red)}.progress{height:10px;background:#0a151d;border-radius:20px;overflow:hidden;border:1px solid #344751;margin:9px 0}.progress>div{height:100%;background:linear-gradient(90deg,#628c73,#b5d99e);transition:width .3s}.log{max-height:430px;overflow:auto;font-size:13px}.log p{padding:5px 0;border-bottom:1px solid #293944}.choice{display:flex;flex-direction:column;gap:6px;padding:10px 0}.choice label{display:flex;align-items:center;gap:8px}.choice input{accent-color:#8dc395}.notice{padding:10px 12px;border-left:3px solid var(--amber);background:#332f26;border-radius:6px;margin:9px 0}.hero{padding:18px;background:linear-gradient(120deg,#263f37,#1a2b38);border:1px solid #517465;border-radius:14px;margin-bottom:12px}.hero strong{font-size:19px}.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}.footer{font-size:12px;color:var(--muted);padding:16px 2px}.hidden{display:none!important}textarea{width:100%;min-height:140px;background:#0d1922;color:#dbe5e9;border:1px solid #52636d;border-radius:8px;padding:8px} @media(max-width:650px){.stats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}.shell{padding:0 9px 30px}h1{font-size:21px}.panel{padding:12px}.stat b{font-size:17px}}
.rarity{font-size:11px;font-weight:750;letter-spacing:.05em}.rarity.common{color:#b9c1c6}.rarity.rare{color:#69b6ff}.rarity.epic{color:#c39bff}.rarity.legendary{color:#f0bf64}.rarity.boss{color:#ff9d69} .item .btns button{padding:7px 9px} .ammo-guide{display:block;color:#9bcd95;margin:5px 0;font-size:13px}
/* v1.5 tactical dark visual refresh */
body{background:radial-gradient(ellipse at 85% 0%,#25332b 0%,#101714 45%,#0b1110 100%)!important;color:#e3e8e2!important;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN",sans-serif!important}
header{background:linear-gradient(110deg,#17221e,#253127)!important;border-bottom:1px solid #58634c!important}h1{letter-spacing:.10em!important} .panel,.hero,.item{border-color:#39483d!important;background-color:#18231f!important} .hero{background:linear-gradient(120deg,#223229,#151e1a)!important}button.primary{background:#6d7857!important;color:#fff!important}button{border-color:#58634c!important} .pill{background:#293a31!important} .warn{color:#e9b76b!important}.bad{color:#e38a83!important}.ok{color:#9bc99a!important}select,input{background:#111c18!important;color:#f0f3ed!important;border-color:#52604f!important}.progress{background:#0d1612!important}.progress>div{background:linear-gradient(90deg,#758767,#b0b58c)!important}.tag{color:#c4b58a!important}

/* Boss battle presentation v1.5 — offline, responsive, no remote assets */
.boss-hud{position:relative;overflow:hidden;border:1px solid #63705b;border-radius:16px;background:radial-gradient(ellipse at 70% 26%,#37483c 0%,#18251f 42%,#0a1110 100%);box-shadow:inset 0 0 55px #060a0980,0 12px 28px #0005;margin:0 0 14px}
.boss-hud:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.14;background:repeating-linear-gradient(0deg,transparent 0 4px,#a0b7a0 5px 6px)}
.boss-hud-top{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 15px;border-bottom:1px solid #77806c55;font-size:11px;letter-spacing:.12em;color:#c7d0bf;position:relative}
.boss-live{color:#e9b67b;font-weight:800}.boss-live:before{content:"● ";color:#e38a83}
.boss-scene{position:relative;min-height:265px;display:flex;align-items:flex-end;justify-content:center;overflow:hidden;background:linear-gradient(0deg,#101a16 0%,transparent 60%)}
.boss-scene:before{content:"";position:absolute;left:-10%;right:-10%;bottom:0;height:46%;background:repeating-linear-gradient(90deg,#52655730 0 3px,transparent 3px 17%),linear-gradient(0deg,#334639,#192a22);clip-path:polygon(0 100%,0 52%,13% 52%,13% 19%,28% 19%,28% 44%,48% 44%,48% 7%,66% 7%,66% 39%,83% 39%,83% 22%,100% 22%,100% 100%);opacity:.65}
.boss-reticle{position:absolute;width:185px;height:185px;border:1px solid #b4c6a24f;border-radius:50%;top:23px;left:50%;transform:translateX(-50%);box-shadow:0 0 0 30px #b4c6a208,0 0 0 65px #b4c6a205}.boss-reticle:after{content:"+";position:absolute;inset:0;display:grid;place-items:center;color:#d4d6b56e;font-size:34px;font-weight:200}
.boss-silhouette{position:relative;z-index:1;width:140px;height:220px;margin-bottom:-8px;filter:drop-shadow(0 0 24px #050909);opacity:.95}
.boss-silhouette .head{position:absolute;top:14px;left:52px;width:42px;height:46px;border-radius:43% 43% 40% 40%;background:linear-gradient(100deg,#33443d,#0c1412)}
.boss-silhouette .body{position:absolute;top:59px;left:22px;width:105px;height:160px;clip-path:polygon(28% 0,72% 0,100% 24%,85% 100%,15% 100%,0 24%);background:linear-gradient(100deg,#27382f,#111b17 56%,#39473b)}
.boss-silhouette .weapon{position:absolute;top:92px;left:105px;width:80px;height:15px;transform:rotate(-16deg);background:linear-gradient(#56675a,#18241e);border-radius:3px;box-shadow:0 4px 0 #111c16}
.boss-silhouette.airport .weapon{width:48px;height:20px;top:90px}.boss-silhouette.mall .weapon{width:100px;height:26px;top:96px}.boss-silhouette.tower .weapon,.boss-silhouette.port .weapon{width:125px;height:9px;top:101px}
.boss-silhouette.police{width:220px}.boss-silhouette.police .body{left:57px;width:105px}.boss-silhouette.police .head{left:91px}.boss-silhouette.police .weapon{left:140px}.boss-silhouette.police:before,.boss-silhouette.police:after{content:"";position:absolute;bottom:0;width:65px;height:155px;background:linear-gradient(100deg,#17241d,#3b4b40);clip-path:polygon(35% 0,70% 0,100% 30%,83% 100%,15% 100%,0 30%)}.boss-silhouette.police:before{left:0}.boss-silhouette.police:after{right:0}
.boss-scene-label{position:absolute;z-index:2;left:15px;bottom:15px;right:15px;text-shadow:0 2px 8px #000;pointer-events:none}.boss-scene-label strong{font-size:clamp(24px,6vw,39px);letter-spacing:.06em;display:block;line-height:1.2}.boss-scene-label small{color:#d0b78b;letter-spacing:.15em}
.boss-readout{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px;position:relative}.boss-metric{background:#0b1410b8;border:1px solid #52605275;border-radius:9px;padding:9px}.boss-metric span{display:block;font-size:11px;color:#aebfb0}.boss-metric b{font-size:17px}.boss-bar{height:7px;background:#3a2725;border-radius:6px;overflow:hidden;margin-top:6px}.boss-bar>div{height:100%;background:linear-gradient(90deg,#b75d53,#e19b78)}
.boss-panel-title{color:#d5b987;font-size:12px;letter-spacing:.14em;font-weight:800}.boss-targets{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;margin:10px 0 14px}.boss-targets button{padding:9px 3px;font-size:11px;line-height:1.3;border-radius:7px;white-space:normal;min-height:48px}.boss-targets button.selected{border-color:#d5b987!important;background:#3b4938!important;color:#fff}.boss-status{display:inline-block;border:1px solid #77876a;border-radius:4px;padding:3px 7px;color:#c9d8c4;font-size:11px}.boss-status.locked{border-color:#777;color:#a0a9a2}.boss-brief{display:grid;grid-template-columns:1fr 1fr;gap:8px}.boss-brief>div{padding:10px;border:1px solid #3d5145;background:#111c17;border-radius:8px}.boss-brief small{display:block;font-size:11px;color:#9eafa4}.boss-brief b{font-size:14px}.boss-combat-strip{border:1px solid #63705b;border-radius:12px;background:linear-gradient(110deg,#263a2d,#101a15);padding:14px;margin:0 0 12px}.boss-combat-strip .line{height:4px;background:linear-gradient(90deg,#a76e53,#e0b887);margin:10px 0}.boss-combat-strip strong{font-size:20px;letter-spacing:.05em}
@media(max-width:520px){.boss-scene{min-height:245px}.boss-targets{grid-template-columns:repeat(3,minmax(0,1fr))}.boss-readout{gap:7px;padding:10px}.boss-scene-label strong{font-size:27px}.boss-silhouette{transform:scale(.93);transform-origin:bottom}}
@media(prefers-reduced-motion:reduce){.boss-hud *{animation:none!important;transition:none!important}}

/* Boss character silhouettes and responsive three-person encounter */
.boss-portrait{position:relative;z-index:1;display:block;width:min(100%,440px);height:275px;max-height:100%;filter:drop-shadow(0 7px 14px #000a);pointer-events:none}
.boss-scene{min-height:300px}.boss-scene-label{background:linear-gradient(0deg,#0b1514ed,#0b1514b8 65%,transparent);padding:30px 8px 9px;bottom:0;left:7px;right:7px}
.boss-portrait g{transform-box:fill-box}
@media(max-width:520px){.boss-portrait{height:240px}.boss-scene{min-height:265px}}


/* v1.5 integrated usability update */
.raid-art,.boss-art{display:block;width:100%;height:auto;max-height:390px;object-fit:contain;background:#0b1210;border:1px solid #46574b;border-radius:10px;margin:8px 0 13px}
.raid-art{aspect-ratio:16/9;object-fit:cover;max-height:260px}.intel-portrait{position:relative;overflow:hidden;background:#101b16;border-radius:12px}.intel-portrait img{display:block;width:100%;max-height:390px;object-fit:contain}.intel-portrait.locked img{visibility:hidden}.intel-portrait.stage1 img{filter:brightness(0) contrast(1)}.intel-portrait.stage2 img{filter:brightness(.2) blur(13px)}.intel-portrait.stage3 img{filter:brightness(.58) blur(6px)}.intel-portrait.stage4 img{filter:brightness(.85) blur(2px)}.intel-portrait .veil{position:absolute;bottom:0;left:0;right:0;background:#09130bba;color:#d4d6c9;text-align:center;padding:8px;font-weight:700;font-size:13px}
.gear-card{border-left:5px solid #abb6ad!important;padding-left:11px!important}.gear-card.rare{border-left-color:#69b6ff!important}.gear-card.epic{border-left-color:#bd9bff!important}.gear-card.legendary,.gear-card.boss{border-left-color:#e3bb69!important}.new-mark{font-size:11px;color:#b3ddbc;border:1px solid #6d9f7a;padding:1px 5px;border-radius:4px;margin-left:5px}.toolbar{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin:12px 0}.toolbar select{min-width:130px}.raid-pane{display:flex;gap:8px;margin:0 0 12px}.raid-pane button{flex:1}.record-unread{border-left:3px solid #e2be74;padding:10px;background:#333025}.notice-top{position:sticky;top:51px;z-index:3}.danger-panel{background:#352526;border:1px solid #92595b;border-radius:9px;padding:12px;margin:10px 0}
.weapon-perk{margin:9px 0 7px;padding:10px 12px;border:1px solid #526c51;background:#18291f;border-radius:8px;color:#d7f2ce;line-height:1.55}.weapon-perk>b{display:block;font-size:12px;color:#a9e1a4;margin-bottom:3px}.weapon-perk small{display:block;color:#a9b7ad;font-size:11px;margin-top:4px}.weapon-shop-more{margin:7px 0 10px;padding:8px 10px;border:1px solid var(--line);border-radius:7px}.weapon-shop-more summary{cursor:pointer;color:#b8d6ed;font-weight:600}.weapon-stat{line-height:1.7;font-size:13px;margin:6px 0}.weapon-shop-more .muted{font-size:12px;margin:5px 0} 

/* Boss dossier navigation v2.3.3: readable, stage-grouped list */
.boss-targets{display:flex!important;flex-direction:column;gap:12px;margin:14px 0 0}
.boss-tier{border:1px solid #41564b;border-radius:11px;overflow:hidden;background:#111b18}
.boss-tier-heading{display:flex;align-items:center;gap:12px;padding:10px 13px;background:#22312c;color:#e6e7dc}
.boss-tier-heading span{font-size:10px;letter-spacing:1.8px;color:#d4bb8a;font-weight:700}
.boss-tier-heading strong{font-size:14px}
.boss-tier-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:9px}
.boss-targets .boss-target-row{display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;align-items:center;gap:4px 8px;text-align:left;min-height:70px;padding:11px!important;border:1px solid #4d6557;border-radius:8px;background:#26372f;color:#f2f4ee;font-size:13px;white-space:normal}
.boss-targets .boss-target-row.selected{background:#41553c!important;border:2px solid #e3c48d!important;padding:10px!important}
.boss-target-row.is-locked{opacity:.68;background:#1b2623}
.boss-target-name{grid-column:1;grid-row:1;font-weight:700;font-size:14px;line-height:1.35;overflow-wrap:anywhere}
.boss-target-place{grid-column:1;grid-row:2;font-size:11px;color:#c3cbc6;line-height:1.3}
.boss-target-state{grid-column:2;grid-row:1/3;font-size:10px;white-space:nowrap;padding:5px 7px;border:1px solid #657669;border-radius:5px;color:#e4dfcb}
@media(max-width:540px){.boss-tier-list{grid-template-columns:1fr}.boss-targets .boss-target-row{min-height:58px}.boss-target-name{font-size:15px}}
.boss-badge-name{display:inline-flex;align-items:center;gap:9px;min-width:0;flex-wrap:wrap}.boss-earned-badge{width:52px;height:52px;object-fit:contain;border-radius:10px;flex:none;vertical-align:middle;background:#0b0c10;box-shadow:0 0 0 1px #b4934a}@media(max-width:430px){.boss-earned-badge{width:46px;height:46px}}\n.v3-subnav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.v3-subnav button{min-height:48px;font-size:15px;font-weight:700}.v3-subnav button.on{background:#496b55;border-color:#a3c99e}@media(min-width:700px){.v3-subnav{grid-template-columns:repeat(3,minmax(0,1fr))}}
/* bunker image (embedded, offline) */
.base-hero{background-image:url("data:image/webp;base64,")!important;background-size:cover!important;background-position:center!important;}
.base-hero:before,.base-hero:after,.base-hero-title{display:none!important;}

.v3-facility-image{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border:1px solid #48584c;border-radius:12px;margin:0 0 14px;background:#111b17}
.v3-section-image{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:12px;border:1px solid #46554b;margin:8px 0 14px;background:#101a16}@media(max-width:600px){.v3-section-image{aspect-ratio:16/9}}
body.v3-hide-overview #stats{display:none!important}body.v3-hide-overview header{display:none!important}

/* v3.2.9: equipment picker rarity and visible bonus breakdown */
.v3-picker-card{border-left:4px solid #8b999d;padding-left:12px}
.v3-picker-card.rare{border-left-color:#69b6ff}.v3-picker-card.epic{border-left-color:#c39bff}.v3-picker-card.legendary{border-left-color:#f0bf64}.v3-picker-card.boss{border-left-color:#ff9d69}
.v3-picker-heading{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:7px}
.v3-rarity-badge{display:inline-flex;align-items:center;padding:4px 9px;border-radius:6px;font-size:12px;font-weight:800;letter-spacing:.03em;background:#45505a;color:#fff}
.v3-rarity-badge.rare{background:#194c75;color:#b9e2ff}.v3-rarity-badge.epic{background:#523375;color:#f1d8ff}.v3-rarity-badge.legendary{background:#76531a;color:#ffe5a0}.v3-rarity-badge.boss{background:#7b3c25;color:#ffe0c9}
.v3-bonus-area{margin:9px 0 12px;padding:10px;background:#10221d;border:1px solid #385748;border-radius:9px}
.v3-bonus-caption{display:block;color:#b6c9bb;font-weight:700;margin-bottom:7px}.v3-bonus-list{display:flex;flex-wrap:wrap;gap:6px}
.v3-bonus-chip{display:inline-block;border:1px solid #538a68;background:#244a36;color:#aef0bf;border-radius:7px;padding:5px 9px;font-size:13px;font-weight:800}
.v3-base-only{color:#aab8b2;font-size:13px}.v3-fixed-ability{color:#f5d899;font-size:13px;margin-top:7px;overflow-wrap:anywhere}

/* Opening splash — independent of game state */
#tokOpening{position:fixed;inset:0;z-index:2147483640;background:#0b141a;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
#tokOpening[hidden]{display:none!important}
#tokOpening .tokOpeningArt{position:absolute;inset:0;background-image:linear-gradient(to bottom,rgba(5,10,13,.05) 20%,rgba(5,10,13,.15) 55%,rgba(5,10,13,.93) 100%),url("data:image/jpeg;base64,");background-size:contain;background-position:center center}
#tokOpening .tokOpeningControls{position:absolute;bottom:max(7vh,calc(env(safe-area-inset-bottom) + 30px));left:16px;right:16px;display:flex;align-items:center;flex-direction:column;gap:12px}
#tokOpening .tokOpeningEnter{width:min(440px,100%);padding:17px 24px;border:1px solid #b5a16c;border-radius:7px;background:rgba(36,58,48,.92);font-size:clamp(19px,5vw,25px);font-weight:800;letter-spacing:.12em;color:#f5f2e8;box-shadow:0 6px 25px #0009}
#tokOpening .tokOpeningHint{font-size:12px;color:#d3d4d0;text-shadow:0 1px 4px #000;letter-spacing:.06em}
@media(min-width:800px){#tokOpening .tokOpeningArt{background-position:center center}}
@media(prefers-reduced-motion:no-preference){#tokOpening.tokOpeningClosing{opacity:0;transition:opacity .35s ease}}

#tokOpening .tokOpeningArt{background-size:contain!important;background-position:center top!important;background-repeat:no-repeat!important;background-color:#0b141a!important}
#tokOpening .tokOpeningControls{bottom:max(12px,env(safe-area-inset-bottom));gap:7px;background:linear-gradient(0deg,#0b141a 85%,transparent);padding:20px 12px 4px;left:0;right:0}
#tokOpening .tokTitleBtn{padding:11px 18px!important;font-size:clamp(16px,4.5vw,20px)!important}
#tokOpening .tokOpeningHint{font-size:11px!important}
@media(max-height:700px){#tokOpening .tokTitleBtn{padding:7px 12px!important}#tokOpening .tokOpeningControls{gap:4px}}
.raid-preflight{margin:14px 0;padding:12px 14px;border:1px solid #60735d;border-radius:10px;background:#17251e}.raid-preflight p{margin:5px 0}.raid-preflight-blocked{border-color:#a7655d;background:#30211e}.raid-preflight-warning{border-color:#c7a565;background:#2b281c}.raid-preflight strong{display:block;margin-bottom:6px}
.att-custom .att-slot{padding:11px;margin:8px 0;border:1px solid #526052;border-radius:9px;background:#19251e}.att-custom .att-slot .rarity{font-weight:800}.att-custom .btns button{font-size:12px}.att-custom .att-slot strong{color:#c9d8c3}  .tok-att-shop-item .tok-attachment-figure{max-width:240px;margin:6px 0!important}.tok-att-shop-item .tok-attachment-figure img{max-height:125px!important;width:100%!important;object-fit:contain!important} .tok-trophy-badge-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(105px,1fr));gap:12px;margin:14px 0}.tok-trophy-badge-item{text-align:center;padding:12px 6px;border:1px solid #506354;border-radius:12px;background:#203128;font-size:13px;overflow-wrap:anywhere}.tok-trophy-badge-item .boss-earned-badge{width:80px;height:80px;max-width:100%;display:block;margin:0 auto 8px} 
/* v3.5.70: readable combat logs, preserving event order */
.log p.tok-log-line{padding:7px 10px;margin:3px 0;border-left:3px solid #667685;border-bottom:0;border-radius:5px;background:#202b35;line-height:1.6;overflow-wrap:anywhere}
.log p.tok-log-player{border-left-color:#65b9f2;background:#142c40;color:#c6eaff}
.log p.tok-log-enemy{border-left-color:#f08c8c;background:#39252b;color:#ffd3d3}
.log p.tok-log-status{border-left-color:#e7bb67;background:#373021;color:#ffe0a3}
.log p.tok-log-heal{border-left-color:#69c99b;background:#19372f;color:#b7f0d1}
.log p.tok-log-system{border-left-color:#8795a5;background:#242d37;color:#d0d7e1}
.log p.tok-log-stalker{border-left-color:#e2a46d;background:#392b26;color:#ffd4ad}
.log p.tok-log-round{background:#303b48;border:1px solid #53677a;color:#f1f5fa;text-align:center;font-weight:700;margin-top:12px}
.tok-log-label{display:inline-block;font-size:11px;font-weight:700;margin-right:8px;opacity:.95}
</style><style id="bag-slot-visual-style">
.bag-slots-wrap{margin:10px 0 16px;padding:12px;border:1px solid rgba(150,170,190,.28);border-radius:10px;background:rgba(0,0,0,.13)}
.bag-slots{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px;max-width:390px;margin-bottom:8px}
.bag-slot{aspect-ratio:1;display:block;border:1px solid #8f9dab;border-radius:3px;box-sizing:border-box}
.bag-slot.occupied{background:#7fb9cf;border-color:#a6d6e8}
.bag-slot.empty{background:transparent;border-color:#85939e}
@media(max-width:420px){.bag-slots{gap:4px}}
</style>
<style id="v3-base-layout">body{padding-bottom:calc(112px + env(safe-area-inset-bottom))}#tabs{position:fixed!important;bottom:0!important;top:auto!important;left:0;right:0;z-index:100;background:#101b16!important;display:grid!important;grid-template-columns:repeat(6,minmax(0,1fr));gap:2px;padding:8px 4px max(9px,env(safe-area-inset-bottom));border-top:1px solid #62735f;overflow:visible!important}#tabs [role="button"]{min-width:0;min-height:88px;padding:14px 1px;font-size:10px;white-space:normal;border-radius:6px;display:flex;align-items:center;justify-content:center;line-height:1.35;touch-action:manipulation}.hide-base-header #stats{display:none}.hide-base-header header{display:none}.base-hero{height:min(30vh,260px);min-height:170px;border:1px solid #52634e;border-radius:12px;position:relative;overflow:hidden;background:linear-gradient(165deg,#1d2b24,#101713 70%)}.base-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 0 14%,#52634a55 14% 16%,transparent 16% 35%,#4c5d4755 35% 37%,transparent 37%),linear-gradient(0deg,#2b352b 0 23%,transparent 23%);opacity:.7}.base-hero:after{content:"▥  ▤  ▥";position:absolute;right:7%;bottom:18%;font-size:48px;letter-spacing:10px;color:#78856a77}.base-hero-title{position:absolute;z-index:1;left:16px;top:16px;text-shadow:0 2px 5px #000}.base-hero-title strong{font-size:19px;letter-spacing:.08em}.base-hero-title small{display:block}.base-quick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.base-quick .stat b{font-size:16px}.base-launch{width:100%;font-size:18px;padding:16px}.base-bottom-spacer{height:15px}@media(max-width:390px){#tabs [role="button"]{font-size:9px;padding:14px 0;min-height:88px}.base-quick .stat{padding:9px 5px}}
</style><style id="v3-menu-grid-override">
/* Six persistent navigation buttons, two rows of three. */
body{padding-bottom:calc(172px + env(safe-area-inset-bottom))!important}
#tabs{grid-template-columns:repeat(3,minmax(0,1fr))!important;grid-template-rows:repeat(2,68px)!important;gap:7px!important;padding:8px 9px max(9px,env(safe-area-inset-bottom))!important}
#tabs [role="button"]{height:68px!important;min-height:68px!important;padding:8px 4px!important;font-size:17px!important;font-weight:700!important;line-height:1.2!important;letter-spacing:.02em!important;white-space:nowrap!important}
@media(max-width:390px){#tabs [role="button"]{font-size:16px!important}}
</style><style id="v3-equipment-style">
.v3-pmc-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:12px}.v3-pmc-summary>div{background:#172630;border:1px solid #405449;border-radius:9px;padding:9px;min-width:0}.v3-pmc-summary small{display:block;color:#b5c3ba;font-size:11px}.v3-pmc-summary b{font-size:15px;overflow-wrap:anywhere}.v3-pmc-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(100px,1fr) minmax(0,1fr);gap:7px;align-items:center}.v3-pmc-figure{display:block;width:100%;height:290px;max-height:100%;object-fit:contain;object-position:center;background:transparent;pointer-events:none;min-width:0}.v3-slot{width:100%;min-height:91px;padding:8px 5px;border-radius:9px;text-align:center;background:#24372e;border:1px solid #64775e;white-space:normal;overflow-wrap:anywhere}.v3-slot small{display:block;color:#c3cfc4;font-size:11px}.v3-slot strong{display:block;font-size:12px;line-height:1.35}.v3-slot em{display:block;font-size:10px;color:#d7c391;font-style:normal}.v3-slot.selected{border:2px solid #e2c587;background:#3b4d37}.v3-slot-column{display:grid;gap:7px}.v3-gear-picker{margin-top:12px}.v3-gear-picker .item{padding:10px 0}@media(max-width:390px){.v3-pmc-layout{grid-template-columns:minmax(0,1fr) 100px minmax(0,1fr)}.v3-slot{min-height:90px;padding:5px 3px}.v3-slot strong{font-size:11px}.v3-pmc-summary b{font-size:13px}}
.tok-grenade-category{margin-top:12px}.tok-grenade-category-button{width:100%;min-height:68px;text-align:left;padding:12px 16px}.tok-grenade-category-button strong{font-size:16px}.tok-grenade-category-button em{font-size:12px}</style><style>.raid-setup-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:14px 0}.raid-setup-tabs button{padding:14px 5px;font-size:16px;font-weight:800;border-radius:9px;border:1px solid #607364;background:#293d49;color:#f3f5f1}.raid-setup-tabs button.active{background:#4b725f}.raid-setup-body{padding:12px 0;min-height:130px}.raid-setup-body select{max-width:100%;width:100%;margin:8px 0 14px}.raid-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.raid-choice{padding:17px 10px;border:1px solid #617364;border-radius:10px;background:#263b45;display:flex;align-items:center;flex-direction:column;gap:5px;text-align:center;cursor:pointer}.raid-choice.chosen{background:#476f5a;border-color:#91ae8f}.raid-choice input{position:absolute;opacity:0;pointer-events:none}.raid-choice small{color:#c5cecb}.raid-summary{margin:16px 0;padding:14px;background:#10221e;border:1px solid #4c6158;border-radius:10px}.raid-summary p{margin:7px 0}.raid-launch button{width:100%;font-size:22px;padding:18px} .raid-map-grid .raid-choice{min-height:85px;justify-content:center}.raid-setup{scroll-margin-top:12px}</style><style>
.v3-picker-card.v3-current-equipped{border:3px solid #7fcaa4!important;box-shadow:inset 0 0 0 2px #284e3d,0 0 0 1px #7fcaa455;background:#1c332b!important;padding:14px!important;border-radius:12px}
.v3-equipped-label{display:inline-flex;align-items:center;justify-content:center;border:3px solid #a4e5bd;background:#315b46;color:#f0fff5;border-radius:9px;padding:8px 13px;font-weight:900;font-size:1.05em;letter-spacing:.03em;line-height:1.3}
</style>
<style> .tok-raid-result .tok-result-hero{text-align:center;padding:30px 14px}.tok-result-word{font-size:clamp(48px,12vw,82px);font-weight:900;letter-spacing:.12em;margin:14px 0}.tok-survived .tok-result-word{color:#8de3a8}.tok-kia .tok-result-word{color:#ff8888}.tok-result-row{display:flex;justify-content:space-between;gap:12px;align-items:baseline;padding:12px 2px;border-bottom:1px solid #405149}.tok-result-row span{min-width:0;overflow-wrap:anywhere}.tok-result-row b{text-align:right}.tok-result-actions{display:flex;flex-wrap:wrap;gap:10px}.tok-result-actions button{flex:1 1 150px;min-height:48px}.tok-raid-result h3{margin-top:20px}</style><style>
/* v3.3.7: larger, legible raid result on narrow phones */
.tok-raid-result .tok-result-hero{padding:32px 16px}
.tok-raid-result .tok-result-hero > div:last-child{font-size:clamp(25px,6vw,35px);font-weight:850;margin-top:14px;line-height:1.4}
.tok-raid-result .tok-result-hero .muted{font-size:clamp(16px,4vw,21px);font-weight:750}
.tok-raid-result .tok-result-row{font-size:clamp(17px,4.4vw,23px);line-height:1.5;padding:16px 2px;align-items:center}
.tok-raid-result .tok-result-row span{flex:1 1 52%}
.tok-raid-result .tok-result-row b{flex:0 1 48%;font-size:1.05em}
.tok-raid-result h2{font-size:clamp(23px,6vw,30px)}
.tok-raid-result h3{font-size:clamp(20px,5vw,26px)}
html,body,#app,.shell{overflow-anchor:none} html{scroll-behavior:auto!important}</style><style id="tok-persistent-nav-style">#tabs .new-mark[hidden]{display:none!important}</style><style id="tok-loot-feature-style">
.tok-loot-feature{margin:18px 0 22px;border:2px solid #907242;border-radius:14px;background:linear-gradient(130deg,#302b20,#1b2521);box-shadow:0 0 0 1px #302d21 inset}
.tok-loot-feature.has-loot{border-color:#d6a54e;box-shadow:0 0 18px #a7792c24}
.tok-loot-feature-button{display:block;width:100%;padding:18px 16px;text-align:left;background:transparent;border:0;color:#f5e7ca;cursor:pointer}
.tok-loot-feature-top{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.tok-loot-feature-top strong{font-size:1.35em}
.tok-loot-feature-badge{background:#54432b;color:#f9df9d;border-radius:100px;padding:5px 10px;font-size:.78em}
.tok-loot-feature-count{display:block;margin:14px 0 12px;color:#eadfcb}
.tok-loot-feature-link{display:block;border-radius:8px;padding:10px;background:#7c5b2d;color:white;text-align:center;font-weight:700}
.tok-warehouse-label{margin:22px 0 12px;font-size:1em;color:#d3d8d4}
</style><style id="tok-v3426-touch-isolation">#tabs [role="button"][data-action^="tab:"]{touch-action:none!important;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}</style>
<style id="tok-independent-scroll-style">
/* v3.4.28: Safari document-scroll isolation test */
html,body{height:100%!important;overflow:hidden!important;overscroll-behavior:none!important}
#tok-scroll-surface{position:fixed;inset:0;overflow-x:hidden;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior-y:contain;scroll-behavior:auto!important;z-index:0;padding-bottom:0}
#tok-scroll-surface>.shell{min-height:100%;padding-bottom:190px}
body>#tabs{position:fixed!important;z-index:100!important}
</style><style id="tok-nav-border-restore">
/* v3.4.31: restore the button visuals after navigation changed to divs. */
#tabs [role="button"][data-action^="tab:"]{background:#293b47;color:var(--text);border:1px solid #58634c;border-radius:10px;cursor:pointer;appearance:none;-webkit-appearance:none}
#tabs [role="button"][data-action^="tab:"].on{background:#466c59;border-color:#81b394}
#tabs [role="button"][data-action^="tab:"]:active{filter:brightness(1.12)}
</style><style id="pmc-character-styles">.pmc-character-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.pmc-character-choice{display:flex;flex-direction:column;gap:6px;min-width:0;padding:7px;background:#233740;border:2px solid #4c5d57;border-radius:11px;color:#fff;font-size:14px;font-weight:700;text-align:center;overflow:hidden}.pmc-character-choice.selected{background:#436e5d;border-color:#c4bd86}.pmc-character-choice img{display:block;width:100%;aspect-ratio:3/4;object-fit:cover;object-position:center top;border-radius:7px}.pmc-character-choice span{padding:4px 0}@media(min-width:650px){.pmc-character-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}</style><style>/* v3.4.49 equipment weapon previews */
.v3-slot .tok-weapon-figure{margin:6px 0!important;width:100%;pointer-events:none}
.v3-slot .tok-weapon-figure img{width:100%!important;max-width:100%!important;aspect-ratio:2.4/1!important;object-fit:contain!important;height:auto!important}
.v3-slot .tok-weapon-figure figcaption{display:none}
.v3-picker-card .tok-weapon-figure{margin:10px 0!important}
.v3-picker-card .tok-weapon-figure img{max-width:100%!important}
</style>
<script>
const TOK_EQUIPMENT_IMAGES={'armor:light':'data:image/jpeg;base64,','armor:standard':'data:image/jpeg;base64,','armor:heavy':'data:image/jpeg;base64,','armor:ext_armor_01':'data:image/jpeg;base64,','armor:ext_armor_02':'data:image/jpeg;base64,','armor:ext_armor_03':'data:image/jpeg;base64,','armor:ext_armor_04':'data:image/jpeg;base64,','armor:ext_armor_05':'data:image/jpeg;base64,','armor:ext_armor_06':'data:image/jpeg;base64,','armor:ext_armor_07':'data:image/jpeg;base64,','armor:ext_armor_08':'data:image/jpeg;base64,','armor:ext_armor_09':'data:image/jpeg;base64,','armor:ext_armor_10':'data:image/jpeg;base64,','armor:ext_armor_11':'data:image/jpeg;base64,','armor:ext_armor_12':'data:image/jpeg;base64,','armor:ext_armor_13':'data:image/jpeg;base64,','armor:ext_armor_14':'data:image/jpeg;base64,','armor:ext_armor_15':'data:image/jpeg;base64,','armor:ext_armor_16':'data:image/jpeg;base64,','armor:ext_armor_17':'data:image/jpeg;base64,','armor:ext_armor_18':'data:image/jpeg;base64,','armor:kongou_robe':'data:image/jpeg;base64,','armor:bulldozer':'data:image/jpeg;base64,','armor:beta':'data:image/jpeg;base64,','armor:doctor':'data:image/jpeg;base64,','helmet:light':'data:image/jpeg;base64,','helmet:combat':'data:image/jpeg;base64,','helmet:heavy':'data:image/jpeg;base64,','helmet:ext_helmet_01':'data:image/jpeg;base64,','helmet:ext_helmet_02':'data:image/jpeg;base64,','helmet:ext_helmet_03':'data:image/jpeg;base64,','helmet:ext_helmet_04':'data:image/jpeg;base64,','helmet:ext_helmet_05':'data:image/jpeg;base64,','helmet:ext_helmet_06':'data:image/jpeg;base64,','helmet:ext_helmet_07':'data:image/jpeg;base64,','helmet:ext_helmet_08':'data:image/jpeg;base64,','helmet:ext_helmet_09':'data:image/jpeg;base64,','helmet:ext_helmet_10':'data:image/jpeg;base64,','helmet:ext_helmet_11':'data:image/jpeg;base64,','helmet:ext_helmet_12':'data:image/jpeg;base64,','helmet:ext_helmet_13':'data:image/jpeg;base64,','helmet:ext_helmet_14':'data:image/jpeg;base64,','helmet:ext_helmet_15':'data:image/jpeg;base64,','helmet:ext_helmet_16':'data:image/jpeg;base64,','helmet:ext_helmet_17':'data:image/jpeg;base64,','helmet:ext_helmet_18':'data:image/jpeg;base64,','helmet:tiger_helmet':'data:image/jpeg;base64,','bag:small':'data:image/jpeg;base64,','bag:medium':'data:image/jpeg;base64,','bag:large':'data:image/jpeg;base64,','bag:ext_bag_01':'data:image/jpeg;base64,','bag:ext_bag_02':'data:image/jpeg;base64,','bag:ext_bag_03':'data:image/jpeg;base64,','bag:ext_bag_04':'data:image/jpeg;base64,','bag:ext_bag_05':'data:image/jpeg;base64,','bag:ext_bag_06':'data:image/jpeg;base64,','bag:ext_bag_07':'data:image/jpeg;base64,','bag:ext_bag_08':'data:image/jpeg;base64,','bag:ext_bag_09':'data:image/jpeg;base64,','bag:ext_bag_10':'data:image/jpeg;base64,','bag:ext_bag_11':'data:image/jpeg;base64,','bag:ext_bag_12':'data:image/jpeg;base64,','bag:ext_bag_13':'data:image/jpeg;base64,','bag:ext_bag_14':'data:image/jpeg;base64,','bag:ext_bag_15':'data:image/jpeg;base64,','bag:ext_bag_16':'data:image/jpeg;base64,','bag:ext_bag_17':'data:image/jpeg;base64,','bag:ext_bag_18':'data:image/jpeg;base64,','bag:bombbag':'data:image/jpeg;base64,'};
TOK_EQUIPMENT_IMAGES['helmet:thermal_goggles']='data:image/jpeg;base64,';
function tokEquipmentImage(id,type){
 const aliases={armors:'armor',helmets:'helmet',bags:'bag'};
 const t=aliases[type]||type;
 let key=t?`${t}:${id}`:null;
 if(!key||!TOK_EQUIPMENT_IMAGES[key]){
  for(const kind of ['armor','helmet','bag']){
   if(TOK_EQUIPMENT_IMAGES[`${kind}:${id}`]&&((kind==='armor'&&typeof A!=='undefined'&&A[id])||(kind==='helmet'&&typeof H!=='undefined'&&H[id])||(kind==='bag'&&typeof B!=='undefined'&&B[id]))){key=`${kind}:${id}`;break;}
  }
 }
 const src=TOK_EQUIPMENT_IMAGES[key];if(!src)return '';
 const name=(t==='armor'?A[id]?.n:t==='helmet'?H[id]?.n:t==='bag'?B[id]?.n:null)||A[id]?.n||H[id]?.n||B[id]?.n||id;
 return `<figure class="tok-weapon-figure" style="margin:10px 0"><img src="${src}" alt="${name}" loading="lazy" decoding="async" style="display:block;width:100%;max-width:480px;max-height:360px;object-fit:contain;background:#080808;border-radius:9px"><figcaption style="font-size:11px;color:#8b9d99;text-align:right">${name}</figcaption></figure>`;
}
</script>
<style id="tok-pmc-grenade-style">
.tok-pmc-grenades{margin-top:18px;padding:14px;border:1px solid #526453;border-radius:12px;background:#142019}
.tok-pmc-grenades-head{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.tok-pmc-grenades-head small{color:#bdc9c0}
.tok-pmc-grenade-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}
.tok-pmc-grenade-card{position:relative;min-width:0;background:#1e2b25;border:1px solid #526453;border-radius:8px;padding:6px 4px;text-align:center}
.tok-pmc-grenade-number{display:block;font-size:11px;color:#e0e9dc;font-weight:bold}
.tok-pmc-grenade-art{height:76px;display:flex;justify-content:center;align-items:center;overflow:hidden}
.tok-pmc-grenade-art img{display:block!important;max-width:100%!important;max-height:72px!important;width:auto!important;height:auto!important;object-fit:contain!important;margin:0!important}
.tok-pmc-grenade-empty{font-size:28px;color:#82988b}
.tok-pmc-grenade-card select{width:100%;min-width:0;max-width:100%;font-size:11px;padding:5px 1px;box-sizing:border-box;background:#26372e;color:#fff}
@media(max-width:600px){.tok-pmc-grenade-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.tok-pmc-grenade-art{height:86px}.tok-pmc-grenade-art img{max-height:82px!important}.tok-pmc-grenade-card select{font-size:12px}}
</style>
<style>.att-candidate{border:1px solid #64716c;border-radius:8px;padding:8px;margin:8px 0}.att-candidate.common{border-left:5px solid #aab0b5}.att-candidate.rare{border-left:5px solid #4eabff}.att-candidate.epic{border-left:5px solid #b280fa}.att-candidate.legendary{border-left:5px solid #efbd53}.att-candidate .tok-attachment-figure{max-width:260px}.att-slot .tok-attachment-figure{max-width:300px}</style><style id="tok-v3482-att-details">.tok-equipped-weapons .tok-equipped-entry{margin:14px 0 20px;padding:12px;border:1px solid #52665a;border-radius:12px}.tok-equipped-weapons .tok-weapon-figure img{max-height:190px;object-fit:contain}.tok-equipped-weapons .att-custom{margin-top:14px;padding:12px;background:#14261f;border:1px solid #607767;border-radius:12px}.tok-att-summary{margin:12px 0;padding:12px;background:#10251e;border:1px solid #587360;border-radius:10px}.tok-att-effect{padding:10px;margin:8px 0;border-left:5px solid #aab0b5;background:#203129;border-radius:6px}.tok-att-effect.rare{border-left-color:#4eabff}.tok-att-effect.epic{border-left-color:#b280fa}.tok-att-effect.legendary{border-left-color:#efbd53}.tok-att-effect .rarity{font-size:.85em}.tok-att-effect.rare .rarity{color:#70baff}.tok-att-effect.epic .rarity{color:#c69cff}.tok-att-effect.legendary .rarity{color:#f1c96e}.tok-att-summary .muted{font-size:.85em}.tok-equipped-weapons .att-slot{margin:10px 0}.tok-equipped-weapons .tok-attachment-figure{max-width:240px}</style><style id="tok-v3485-smaller-attachment-images">
/* Attachment artwork at roughly half its previous display size. */
.tok-attachment-figure{width:50%!important;max-width:260px!important}
.tok-attachment-figure img{width:100%!important;max-width:260px!important;max-height:145px!important;object-fit:contain!important}
</style><style>
.tok-district-thumb{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:7px;display:block;margin-bottom:5px;box-shadow:0 2px 9px #0006}
.tok-district-detail-image{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:9px;margin:0 0 12px;border:1px solid #496575}
.raid-map-grid .raid-choice{overflow:hidden;padding:8px;min-width:0}
</style>
<style id="tok-gunsmith-style">.tok-gunsmith-weapons{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px;margin:12px 0 20px}.tok-gunsmith-choice{display:flex;flex-direction:column;align-items:stretch;gap:7px;text-align:left;padding:12px;background:#20302a;color:#e5f0e9;border:1px solid #5a6c61;border-radius:12px;min-width:0}.tok-gunsmith-choice.chosen{border:3px solid #91d4ae;background:#254638}.tok-gunsmith-choice img{max-width:100%;height:90px;object-fit:contain}.tok-gunsmith-choice small{color:#b8c7c0}.tok-gunsmith .att-candidate{margin:8px 0;padding:8px;border:1px solid #53675c;border-radius:8px}.tok-gunsmith .att-candidate img{max-width:200px;max-height:100px;object-fit:contain}<style id="tok-gunsmith-rarity-style">.tok-gunsmith-choice-head{display:flex;flex-wrap:wrap;align-items:center;gap:6px}.tok-gunsmith-rarity{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.4px;border-radius:7px;padding:4px 7px;background:#425047;color:#fff}.tok-gunsmith-rarity.rare{background:#225981;color:#d5efff}.tok-gunsmith-rarity.epic{background:#653c92;color:#f2e3ff}.tok-gunsmith-rarity.legendary{background:#986623;color:#fff0c7}.tok-gunsmith-rarity.boss{background:#8e3434;color:#ffe2e2}</style></style><style id="tok-barter-market-tabs-style">
.tok-market-switch{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 16px;padding:5px;border-radius:12px;background:#17251f;border:1px solid #466153}
.tok-market-switch button{padding:12px 7px;border-radius:9px;border:1px solid transparent;background:transparent;color:#c7d4cd;font-size:15px;font-weight:800;cursor:pointer}
.tok-market-switch button.selected{background:#335c47;color:#fff;border-color:#79ac8b;box-shadow:inset 0 -2px 0 #86bd9a}
.v3-rarity-badge.common{background:#45505a;color:#fff}
.tok-barter-rare{color:#8dd0ff}.tok-barter-epic{color:#e3aaff}.tok-barter-legendary{color:#ffd47e}
</style>
<style id="pursuer-revive-style">.pursuer-revive-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:5px;margin:12px 0}.pursuer-revive-cell{display:flex;justify-content:center;align-items:center;min-height:34px;border-radius:5px;border:1px solid #647b72;font-weight:700;font-size:12px}.pursuer-revive-cell.done{background:#477665;color:white}.pursuer-revive-cell.pending{background:#172a25;color:#a7b8af}.pursuer-boss-image{width:100%;max-width:360px;max-height:390px;object-fit:cover;object-position:top;border-radius:9px;display:block;margin:0 auto 12px}@media(max-width:480px){.pursuer-revive-grid{gap:3px}.pursuer-revive-cell{min-height:27px;font-size:10px}}</style>
<style id="tok-world-tier-v90">.tok-map-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.tok-map-card{grid-template-columns:1fr!important;min-height:110px!important;gap:5px!important;padding:12px!important}.tok-map-number{grid-row:auto!important;font-size:23px!important;width:43px;height:36px!important}.tok-map-name{font-size:clamp(17px,4.6vw,23px)!important}.tok-map-risk{font-size:13px!important}.tok-map-locked{opacity:.57;filter:grayscale(.5)}.tok-tier-arrow{text-align:center;color:#9ed8ed;font-size:36px;line-height:1;margin:-10px 0 8px}.tok-map-tier-group h3 small{font-size:13px;font-weight:500;color:#a9c7d5;margin-left:8px}.tok-map-tier-6{--tok-tier-color:#e4c36a}@media(min-width:700px){.tok-map-card-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}}@media(max-width:400px){.tok-map-name{font-size:17px!important}}</style><style id="tok-world-card-images-v91">
.tok-map-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
.tok-map-card{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:6px!important;padding:7px!important;min-width:0!important;min-height:0!important;overflow:hidden!important}
.tok-map-image{display:block;position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:9px;background:#0c1b24}
.tok-map-image img{display:block;width:100%;height:100%;object-fit:cover}
.tok-map-image-missing{display:grid;place-items:center;width:100%;height:100%;color:#a8bac7;font-size:12px}
.tok-map-image .tok-map-number{position:absolute;left:6px;top:6px;display:grid!important;place-items:center;width:34px!important;height:34px!important;font-size:20px!important;border:1px solid currentColor;background:#0b1c29e8;border-radius:8px;grid-row:auto!important}
.tok-map-name{font-size:clamp(15px,4.3vw,21px)!important;line-height:1.3!important;min-height:2.6em;overflow-wrap:anywhere}
.tok-map-risk{font-size:12px!important;line-height:1.35}
.tok-map-locked{opacity:1!important;filter:none!important}
.tok-map-locked .tok-map-image img{filter:grayscale(.65) brightness(.48)}
@media(min-width:900px){.tok-map-card-grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}}
</style><style>
.royal-relic-item{display:flex;align-items:center;gap:14px}.royal-relic-art{width:100px;height:140px;object-fit:contain;background:#050505;border:1px solid #65563c;border-radius:9px;flex:none}.royal-relic-item strong{font-size:16px}.royal-relic-item p{margin-top:9px}@media(max-width:420px){.royal-relic-art{width:80px;height:112px}}
</style><style id="boss-info-uniform-v3633">.boss-stats-inline{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:12px 0}.boss-stats-inline>div{padding:10px;border:1px solid rgba(150,170,155,.28);border-radius:10px;background:rgba(15,30,25,.55)}.boss-stats-inline small{display:block;opacity:.8;margin-bottom:5px}.boss-stats-inline b{font-size:1.15em}.boss-readout .boss-metric{min-width:0}.boss-readout .boss-metric b{overflow-wrap:anywhere}</style><style id="pmc-record-style">.pmc-record-nav{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0}.pmc-record-nav button{border:1px solid #526a5c;border-radius:8px;background:#172820;color:#e5efe7;padding:10px 12px;flex:1 1 auto;min-width:90px;font-weight:700}.pmc-record-nav button.on{background:#436e59;border-color:#8cb39a}.pmc-record-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}.pmc-record-stat{padding:12px;border:1px solid #395346;border-radius:12px;background:#14251e;min-width:0}.pmc-record-stat small{display:block;opacity:.75;margin-bottom:7px}.pmc-record-stat strong{display:block;font-size:1.35em;overflow-wrap:anywhere}.pmc-rank{display:flex;justify-content:space-between;gap:12px;padding:12px 6px;border-bottom:1px solid #395346}.pmc-rank b{text-align:right;white-space:normal}.pmc-record-screen h3{margin-top:24px}</style><link rel="manifest" href="./manifest.webmanifest"><link rel="apple-touch-icon" href="./icon-192.png"><meta name="apple-mobile-web-app-capable" content="yes"></head><body><header><div class="tag">OFFLINE EXTRACTION RPG · v1.6 TACTICAL COMBAT</div><h1>ESCAPE FROM TOKYOV</h1><small>探索する。持ち帰る。失えば、また始める。</small></header><main class="shell"><div id="stats" class="stats"></div><nav class="tabs" id="tabs"></nav><div id="app"></div><div class="footer">端末内に自動保存 · 外部通信なし · ブラウザのデータ削除に備えて設定からバックアップしてください。<br>この作品は非公式のオリジナルゲームです。</div></main><input id="importfile" type="file" accept=".json,application/json,.txt" style="position:fixed;left:-10000px;top:0" aria-label="バックアップファイルを選択"><script id="tok-independent-scroll-setup">
(function(){
  const header=document.querySelector('body > header');
  const shell=document.querySelector('body > main.shell');
  const nav=document.getElementById('tabs');
  const surface=document.createElement('div');
  surface.id='tok-scroll-surface';
  document.body.insertBefore(surface,header||shell);
  if(header)surface.appendChild(header);
  if(shell)surface.appendChild(shell);
  if(nav)document.body.appendChild(nav);
  window.tokScrollSurface=surface;
})();
</script><script>
