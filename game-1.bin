const ROAMING_AREAS={machine:['industrial','port','airport','power','stadium'],shadow:['metro','hospital','tower','police','office'],death:['school','zoo','park','temple','forest'],perfume:['suburban','mall','nightlife','cinema','diet']};
// v3.5.65: persistent pursuer and long-expedition roaming bosses.
W.nemesis={n:'ネメシス',d:24,a:5,p:45,price:190000,shots:4,ammo:'545'};
A.immortal_armor={n:'不滅の装甲',def:55,max:150,price:175000,repair:280};
const PURSUER={n:'追跡者',hp:1000,def:55,d:20,hit:65,ev:5,pen:30};
const LONG_ROAM_CHANCE={1:.03,2:.04,3:.06,6:.10,12:.15,24:.20};
function pursuerState(){if(!g.pursuer||typeof g.pursuer!=='object')g.pursuer={hp:1000,revive:0,kills:0,encounteredEver:false};g.pursuer.hp=Math.max(0,Math.min(1000,Number(g.pursuer.hp)||0));g.pursuer.revive=Math.max(0,Math.floor(g.pursuer.revive||0));return g.pursuer;}
function pursuerOdds(depth){
 const base=depth<=5?0:depth<=10?.005:depth<=15?.01:depth<=20?.015:depth<=25?.025:.04;
 const hp=pursuerState().hp;
 const multiplier=hp<=250?4:hp<=500?3:hp<=750?2:1;
 return Math.min(1,base*multiplier*(pursuerState().encounteredEver?2:1));
}
function pursuerEligible(r){return !r.longMode&&r.raidType==='normal'&&!r.military&&!r.militaryFloor&&!r._military&&!r.tokMilitary&&pursuerState().hp>0&&(r.pursuerEncounters||0)<3;}
function pursuerBattle(r,ambush=false){
 tokPrepareEncounterReload(r);
 const p=pursuerState();if(!pursuerEligible(r))return 'none';
 r.pursuerEncounters=(r.pursuerEncounters||0)+1;r.pursuerMet=true;p.encounteredEver=true;r.pursuerCooldown=3;
 const start=p.hp,canRepel=start>250,limit=canRepel?Math.ceil(start*.25):null,e={...PURSUER,kind:'boss',actions:0,flashTurns:0};
 r.firstShotUsed=false;r.glockOpeningShotUsed=false;r.encounterGrenades=0;r.grenadeActionCount=0;
 log(r,`【追跡者】${ambush?'脱出時の襲撃！':'遭遇！'} 残HP ${start}/1000（${canRepel?`撃退条件 ${limit}ダメージ`:'HP250以下・撃退判定なし／HP0で討伐'}）`);
 let dealt=0,outcome='withdraw';
 for(let round=1;round<=8;round++){
  if(r.hp<=0){outcome='dead';break;}
  turnCare(r);if(r.hp<=0){outcome='dead';break;}
  const thrown=throwGrenade(r,[e],'boss');const hit=thrown?0:Math.max(0,playerAttack(r,e,p.hp));
  p.hp=Math.max(0,p.hp-hit);dealt+=hit;
  if(p.hp<=0){outcome='killed';break;}
  if(canRepel&&dealt>=limit){outcome='repelled';break;}
  // Pursuer LMG: three independently resolved shots, -5 accuracy points per shot.
  log(r,'【追跡者】ライトマシンガンで3連射！');
  for(let shot=0;shot<3&&r.hp>0;shot++){
   log(r,`【追跡者】${shot+1}発目（基本命中率 ${65-shot*5}%）`);
   enemyStrike(r,{...e,hit:65-shot*5});
  }
  if(r.hp<=0){outcome='dead';break;}
  flashAdvance([e]);
 }
 if(outcome==='killed'){p.hp=0;p.revive=10;p.kills++;r.pursuerKilled=true;r.kills++;r.xp+=500;log(r,'【追跡者完全討伐】追跡者を撃破。復活まで10レイド');pursuerReward(r,true);}
 else if(outcome==='repelled'){log(r,`【追跡者撃退】${dealt}ダメージを与えた。残HP ${p.hp}`);pursuerReward(r,false);}
 else if(outcome==='withdraw')log(r,`【追跡者】8ラウンド経過。自動撤退（残HP ${p.hp}）`);
 else log(r,`【追跡者】戦闘不能。追跡者の残HP ${p.hp}`);
 return outcome;
}
function pursuerReward(r,full){
 if(!full){
  const x=rand(r),category=x<.35?'ammo':x<.70?'medical':x<.90?'repair':'other';
  const target=5000+Math.floor(rand(r)*5001);
  r.pursuerSupplyReward=r.pursuerSupplyReward||{supplies:{},ammo:{},loot:{}};
  const reward=r.pursuerSupplyReward;
  if(category==='ammo'){
   const calibers=Object.keys(AM).filter(id=>AM[id]?.price>0);const cal=pick(r,calibers);
   const qty=Math.max(1,Math.floor(target/AM[cal].price));reward.ammo[cal]=(reward.ammo[cal]||0)+qty;
   log(r,`【撃退報酬】${AM[cal].n} ×${qty}（生還時に獲得）`);
  }else if(category==='medical'||category==='other'){
   const ids=category==='medical'?['antidote','bandage','med','advanced','splint','burnmed']:['frag','flash','molotov','gas','smoke'];    const options=ids.filter(id=>ITEMS[id]?.price<=target);const id=pick(r,options.length?options:ids);
   const qty=Math.max(1,Math.floor(target/ITEMS[id].price));reward.supplies[id]=(reward.supplies[id]||0)+qty;
   log(r,`【撃退報酬】${ITEMS[id].n} ×${qty}（生還時に獲得）`);
  }else{
   const ids=Object.keys(L).filter(id=>L[id]?.repairMaterial||L[id]?.repairTool);
   const options=ids.filter(id=>L[id]?.price>0&&L[id].price<=target);
   if(options.length){const id=pick(r,options);const qty=Math.max(1,Math.floor(target/L[id].price));reward.loot[id]=(reward.loot[id]||0)+qty;log(r,`【撃退報酬】${L[id].n} ×${qty}（生還時に獲得）`);}
   else {const id='med';const qty=Math.max(1,Math.floor(target/ITEMS[id].price));reward.supplies[id]=(reward.supplies[id]||0)+qty;log(r,`【撃退報酬】${ITEMS[id].n} ×${qty}（修理用品が未登録のため代替）`);}
  }
  return;
 }
 const candidates=Object.entries(L).filter(([id,v])=>v&&Number(v.price)>0&&!v.royal&&!v.regionalMap&&!['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id));
 let budget=20000+Math.floor(rand(r)*10001);
 for(let i=0;i<16&&budget>0&&candidates.length;i++){
  const affordable=candidates.filter(([,v])=>v.price<=budget);if(!affordable.length)break;
  const [id,v]=pick(r,affordable);r.loot[id]=(r.loot[id]||0)+1;r.lootAcquired=true;budget-=v.price;
 }
 const rares=candidates.filter(([,v])=>v.t==='rare'||v.price>=12000);
 for(let i=0,n=1+Math.floor(rand(r)*2);i<n&&rares.length;i++){const [id]=pick(r,rares);r.loot[id]=(r.loot[id]||0)+1;}
 log(r,'【完全討伐報酬】20,000〜30,000₽相当＋RARE以上1〜2個');
}
function pursuerStep(r){
 if(!pursuerEligible(r))return null;
 if(r.pursuerCooldown>0){r.pursuerCooldown--;if(r.pursuerMet&&r.pursuerCooldown===0)log(r,'【追跡の気配】遠くから重い足音が聞こえる……');return null;}
 if(r.pursuerMet&&roll(r,.20))log(r,'【追跡の気配】背後で金属が擦れる音が響いた……');
 return roll(r,pursuerOdds(r.explore+1))?pursuerBattle(r):null;
}
function pursuerEndRaid(r){if(r.longMode||r.raidType!=='normal'||r.military||r.militaryFloor||r._military)return;const p=pursuerState();if(r.pursuerKilled)return;if(p.hp<=0){if(p.revive>0){p.revive--;if(p.revive===0){p.hp=1000;log(r,'【追跡者】復活条件を満たした。次のレイドから再出現');}}}else p.hp=Math.min(1000,p.hp+50);}

function roamingEncounter(r){
 const run=g.longRun;
 if(!r.longMode||!run?.active||run.roamerEncountered||run.roamerChecked)return null;
 const reservation=g.investigation?.pending;
 if(reservation?.kind==='roaming'){
  const boss=reservation.boss;
  if((ROAMING_AREAS[boss]||[]).includes(r.map)){
   run.roamerChecked=true;r.paidRoamingEncounter=true;r.investigation=structuredCloneSafe(reservation);return boss;
  }
  return null;
 }
 const boss=Object.keys(ROAMING_AREAS).find(id=>ROAMING_AREAS[id].includes(r.map));
 if(!boss)return null;
 // Roll once per long expedition, not once per 15-minute segment.
 run.roamerChecked=true;
 return roll(r,LONG_ROAM_CHANCE[run.hours]||0)?boss:null;
}
function roamingBossBattle(r,id){const origin=r.map;r.roamingBoss=id;r.map=id;
 try{return bossBattle(r)}finally{r.map=origin;}}
