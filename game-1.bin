const ROYAL_RELICS={key_heart:'queen_heart',key_club:'king_club',key_diamond:'queen_diamond',key_spade:'king_spade'};
const ROYAL_IDS=Object.values(ROYAL_RELICS);
function royalOwned(id){return !!(g?.royalCollection?.[id]||(g?.bank?.loot?.[id]||0)>0||(g?.longVault?.loot?.[id]||0)>0||(g?.storage?.container?.loot?.[id]||0)>0||(g?.raid?.loot?.[id]||0)>0)}
function ensureRoyalCollection(){if(!g.royalCollection||typeof g.royalCollection!=='object')g.royalCollection={};for(const id of ROYAL_IDS)if(royalOwned(id))g.royalCollection[id]=true;if(ROYAL_IDS.every(id=>g.royalCollection[id]))g.royalTitle=true;}
const ROYAL_ART={king_spade:'data:image/webp;base64,',king_club:'data:image/webp;base64,',queen_heart:'data:image/webp;base64,',queen_diamond:'data:image/webp;base64,'};
function royalCollectionView(){ensureRoyalCollection();const count=ROYAL_IDS.filter(id=>g.royalCollection[id]).length;return `<section class="panel"><h2>秘密の部屋・王室収集品 ${count}/4</h2><p class="muted">対応する鍵で秘密の部屋に入り、収集品を持ち帰ると永久記録に登録されます。収集品は売却できません。</p>${ROYAL_IDS.map(id=>`<div class="item royal-relic-item"><img class="royal-relic-art" src="${ROYAL_ART[id]}" alt="${escapeHTML(L[id].n)}" loading="lazy"><div><strong>${g.royalCollection[id]?'✓':'🔒'} ${escapeHTML(L[id].n)}</strong><p><span class="pill">${g.royalCollection[id]?'獲得済み':'未獲得'}</span></p></div></div>`).join('')}</section>`}
const L={queen_heart:{n:'ハートの女王',g:0,price:0,t:'royal'},king_club:{n:'クラブの王',g:0,price:0,t:'royal'},queen_diamond:{n:'ダイヤの女王',g:0,price:0,t:'royal'},king_spade:{n:'スペードの王',g:0,price:0,t:'royal'},key_heart:{n:'ハートの鍵',g:100,price:0,t:'rare'},key_club:{n:'クラブの鍵',g:100,price:0,t:'rare'},key_diamond:{n:'ダイヤの鍵',g:100,price:0,t:'rare'},key_spade:{n:'スペードの鍵',g:100,price:0,t:'rare'},secretkey:{n:'秘密の部屋の鍵',g:100,price:0,t:'rare'},can:{n:'食料',g:500,price:800,t:'common'},water:{n:'飲料水',g:500,price:600,t:'common'},bandage:{n:'包帯',g:200,price:1200,t:'common'},tools:{n:'工具',g:1000,price:2000,t:'common'},battery:{n:'電池',g:300,price:1500,t:'common'},electronics:{n:'電子部品',g:400,price:4000,t:'mid'},medkit:{n:'医療キット',g:1000,price:5000,t:'mid'},parts:{n:'武器部品',g:1500,price:3000,t:'mid'},watch:{n:'高級腕時計',g:200,price:12000,t:'rare'},board:{n:'精密電子基板',g:500,price:18000,t:'rare'},memory:{n:'暗号化記憶装置',g:200,price:30000,t:'rare'},research:{n:'希少研究資料',g:500,price:50000,t:'rare'},goldbar:{n:'精錬金インゴット',g:1000,price:65000,t:'rare'},prototype:{n:'試作光学ユニット',g:700,price:85000,t:'rare'},diamond:{n:'工業用ダイヤモンド',g:200,price:110000,t:'rare'},data:{n:'機密設計データ',g:100,price:135000,t:'rare'},artifact:{n:'希少合金サンプル',g:900,price:95000,t:'rare'}};
