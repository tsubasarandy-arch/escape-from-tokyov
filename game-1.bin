 suburban:{preferred:0,mobility:0},industrial:{preferred:0,mobility:-15},metro:{preferred:0,mobility:15},
 hospital:{preferred:0,mobility:0},port:{preferred:2,mobility:0},airport:{preferred:0,mobility:15},
 mall:{preferred:1,mobility:-15},tower:{preferred:2,mobility:15},police:{preferred:1,mobility:0},lab:{preferred:1,mobility:15}
};
