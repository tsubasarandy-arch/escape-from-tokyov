const TOK_WEAPON_IDS={melee:['knife','hatchet','machete'],hg:['pm','tt'],smg:['pp19','pps43','kedr','mp5','p90'],sg:['mp133','mp153','saiga12'],ar:['aks','ak','ak105','m4a1','aug','vpo136'],dmr:['sks','adar','scarh'],sr:['mosin','svd'],lmg:['rpk74']};
function tokEnemyWeaponCategory(r,kind){const base=TOK_WEAPON_BASE[kind]||TOK_WEAPON_BASE.scav,config=TOK_WEAPON_MAP[r.map]||[[],[],[]];const weights=TOK_WEAPON_CATS.map((cat,i)=>base[i]*(config[0].includes(cat)?2:config[1].includes(cat)?1.3:config[2].includes(cat)?.5:1));let n=rand(r)*weights.reduce((a,b)=>a+b,0);for(let i=0;i<weights.length;i++){n-=weights[i];if(n<0)return TOK_WEAPON_CATS[i]}return 'ar'}
function tokEnemyWeaponPick(r,cat){const ids=(TOK_WEAPON_IDS[cat]||TOK_WEAPON_IDS.ar).filter(id=>W[id]);const tier=MAP[r.map]?.tier||[.7,.25,.05];const rollTier=rand(r),target=rollTier<tier[2]?2:rollTier<tier[2]+tier[1]?1:0;const group=ids.filter(id=>(W[id].price>=42000?2:W[id].price>=23000?1:0)===target);return pick(r,group.length?group:ids)}
function ensureDistrictKeys(x){x.districtClues=x.districtClues||{};x.districtKeys=x.districtKeys||{};x.unlocked=x.unlocked||{};for(const id of Object.keys(MAP)){if(x.unlocked[id])x.districtKeys[id]=true;x.districtClues[id]=Array.isArray(x.districtClues[id])?x.districtClues[id].filter(v=>Number.isInteger(v)&&v>=0&&v<3).filter((v,i,a)=>a.indexOf(v)===i):[]}if(x.cleared===true||x.status==='cleared'||(x.bosses?.lab?.first===true)||(Number(x.bosses?.lab?.kills)||0)>0){for(const id of Object.keys(MAP)){x.districtKeys[id]=true;x.unlocked[id]=true}}syncTierUnlocks(x);return x}

function keyDiscoveryChance(target){const clues=g.districtClues[target]?.length||0;const sourceBoss=Object.keys(BOSSES).find(id=>id===target);return Math.min(.15,.03+[0,.02,.04,.07][clues]+(sourceBoss&&g.bosses[sourceBoss]?.first?.05:0))}
function districtExplore(r){const targets=keyTargets(r.map).filter(id=>!g.districtKeys?.[id]&&!g.unlocked[id]&&!r.foundDistrictKeys?.includes(id));if(!targets.length)return;r.foundDistrictKeys=r.foundDistrictKeys||[];const target=targets[Math.floor(rand(r)*targets.length)];r.foundDistrictClues=r.foundDistrictClues||{};const saved=g.districtClues[target]||[];const pending=r.foundDistrictClues[target]||[];const clues=[...new Set([...saved,...pending])];if(clues.length<3&&roll(r,.06)){const missing=[0,1,2].filter(v=>!clues.includes(v));const clue=missing[Math.floor(rand(r)*missing.length)];r.foundDistrictClues[target]=[...pending,clue];log(r,`【手掛かり・仮取得】${MAP[target].n}：${DISTRICT_CLUES[target][clue]}（${clues.length+1}/3）※生還時に確定`)}if(roll(r,keyDiscoveryChance(target))){r.foundDistrictKeys.push(target);log(r,`【地区アクセスキー】${DISTRICT_KEY_NAMES[target]||MAP[target].n+'のアクセスキー'}を発見。生還で${MAP[target].n}を永久解放！`)}}

B.bombbag={n:'ボムバッグ',kg:16,price:120000,grenadeAccuracy:15};const BOSS_POOL={weapon:{damage:['威力',3,10],accuracy:['命中',2,8],penetration:['貫通',3,12],durability:['最大耐久',5,20],durprotect:['耐久保護',5,15]},armor:{defense:['防御',3,12],durability:['最大耐久',5,20],durprotect:['耐久保護',5,15],maxhp:['最大HP',5,15],absorb:['衝撃吸収',2,6]}};
