if(sharedHeadKill(r,targetDef,effectivePen))d=Math.max(d,enemyHP-dealt);if(e.helmetId&&e.helmetDur>0)e.helmetDur=Math.max(0,e.helmetDur-Math.ceil(specialBase*1.75*.2));}else if(e.armorId!==undefined&&e.armorDur>0)e.armorDur=Math.max(0,e.armorDur-Math.ceil(specialBase/5));}dealt+=d;if(r.weapon==='hellfire')hellfireHit=true;if(r.weapon!=='hellfire'&&w.burnChance&&roll(r,w.burnChance*(r.longMode?.5:1))){e.burnTurns=4;log(r,`${e.n}：ヘルファイアによる火傷（4ターン）`)}tokInjury(r,e,r.weapon,headshot);tokChainOnHit(r,e);if(wg?.base==='bunny'&&roll(r,.10))applyEnemyPoison(r,e);if(raidGear(r,'helmet')?.base==='tiger_helmet'&&roll(r,.10))applyEnemyBleed(r,e);}else if(e._sakuraBoss&&sakuraShotRoll<Math.min(1,(hit+e.ev)/100)){e._sakuraDodged=true;}}if(r.weapon==='hellfire'&&hellfireHit&&roll(r,w.burnChance*(r.longMode?.5:1))){e.burnTurns=4;log(r,`${e.n}：ヘルファイアによる火傷（1アクション1回判定、4ターン）`)}if(r.ammoByCaliber&&W[r.weapon].ammo)r.ammoByCaliber[W[r.weapon].ammo]=r.ammo;if(r.weapon==='queenbee'&&shots)r.queenBeeNext=true;if(r.weapon==='viper'){
