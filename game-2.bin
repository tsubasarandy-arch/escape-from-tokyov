const TOK_ACCESSORY_IMAGES={'glasses':'data:image/jpeg;base64,','necklace':'data:image/jpeg;base64,','ring':'data:image/jpeg;base64,','gloves':'data:image/jpeg;base64,','amulet':'data:image/jpeg;base64,','keychain':'data:image/jpeg;base64,','tag':'data:image/jpeg;base64,','charm':'data:image/jpeg;base64,','cult_seal':'data:image/jpeg;base64,','binding_chain':'data:image/jpeg;base64,'};
function tokAccessoryImage(id){const src=TOK_ACCESSORY_IMAGES[id];if(!src)return '';const name=TOK_ACCESSORIES[id]?.n||id;return `<figure class="tok-weapon-figure" style="margin:10px 0"><img src="${src}" alt="${name}" loading="lazy" decoding="async" style="display:block;width:100%;max-width:480px;max-height:360px;object-fit:contain;background:#080808;border-radius:9px"><figcaption style="font-size:11px;color:#8b9d99;text-align:right">${name}</figcaption></figure>`;}
const TOK_ACCESSORY_KEYS=['attack','accuracy','evasion','defense','maxhp','loot','rare','penetration'];
const TOK_ACCESSORY_LABELS={attack:'攻撃力',accuracy:'命中率',evasion:'回避率',defense:'防御力',maxhp:'最大HP',loot:'戦利品発見率',rare:'希少品発見率',penetration:'貫通力'};
function tokAccessoryValue(item,key){if(!item||item.type!=='accessory')return 0;if(item.base==='cult_seal')return key==='loot'?5:0;if(item.base==='binding_chain')return 0;return (item.affixes||[]).filter(a=>a.type===key).reduce((sum,a)=>sum+(Number(a.value)||0),0)}
function tokAccessoryBonus(r,key){return tokAccessoryValue(r?raidGear(r,'accessory'):equippedGear('accessory'),key)}
const GEARTYPE={weapon:W,armor:A,bag:B,helmet:H,accessory:TOK_ACCESSORIES};
