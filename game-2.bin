const TOK_ATTACHMENT_IMAGES={'suppressor':'data:image/jpeg;base64,','brake':'data:image/jpeg;base64,','red_dot':'data:image/jpeg;base64,','holo':'data:image/jpeg;base64,','scope':'data:image/jpeg;base64,','extended':'data:image/jpeg;base64,','grip':'data:image/jpeg;base64,','stock':'data:image/jpeg;base64,'};
TOK_ATTACHMENT_IMAGES['thermal_scope']='data:image/jpeg;base64,';
function tokAttachmentImage(id){if(!TOK_ATTACHMENT_IMAGES[id])return '';const name=escapeHTML(ATTACH[id]?.n||id);return `<figure class="tok-attachment-figure" style="margin:9px 0"><img src="${TOK_ATTACHMENT_IMAGES[id]}" alt="${name}" loading="lazy" decoding="async" style="display:block;width:100%;max-width:260px;max-height:145px;object-fit:contain;background:#141414;border-radius:9px" /></figure>`;}
const ATT_SLOTS={muzzle:'マズル',sight:'サイト',magazine:'マガジン',grip:'グリップ',stock:'ストック'};
const ATT_RAR=['common','rare','epic','legendary'];
const ATT_MARKET_RAR=[.55,.30,.12,.03],ATT_LOOT_RAR=[.60,.28,.10,.02];
const ATT_EFFECT={suppressor:[2,4,6,8],brake:[1,2,3,4],red_dot:[3,5,7,9],holo:[2,3,4,5],scope:[5,8,11,14],thermal_scope:[0,0,0,0],extended:[1,1,2,2],grip:[1,2,3,4],stock:[1,2,3,4]};
GEARTYPE.attachment=Object.fromEntries(Object.entries(ATTACH).map(([k,v])=>[k,{n:v.n,price:v.prices[0]}]));
GC.attachment=GC.weapon;
// Explicit attachment compatibility for every standard firearm; no substring-based guessing.
const TOK_GUN_SLOTS={
 pm:['muzzle','magazine'],tt:['muzzle','magazine'],glock17:['muzzle','sight','magazine'],deserteagle:['muzzle','sight','magazine'],gunslinger:['muzzle','sight'],
 pp19:['muzzle','sight','magazine','grip','stock'],pps43:['muzzle','magazine'],kedr:['muzzle','magazine'],mp5:['muzzle','sight','magazine','grip','stock'],p90:['muzzle','sight','magazine'],
 aks:['muzzle','sight','magazine','grip','stock'],ak:['muzzle','sight','magazine','grip','stock'],ak105:['muzzle','sight','magazine','grip','stock'],m4a1:['muzzle','sight','magazine','grip','stock'],
 aug:['muzzle','sight','magazine'],adar:['muzzle','sight','magazine','grip','stock'],vpo136:['muzzle','sight','magazine','grip','stock'],scarh:['muzzle','sight','magazine','grip','stock'],
 sks:['muzzle','sight','magazine','stock'],svd:['muzzle','sight','magazine','stock'],mosin:['muzzle','sight','stock'],rpk74:['muzzle','sight','magazine','grip','stock'],
 mp133:['muzzle','sight','stock'],mp153:['muzzle','sight','stock'],saiga12:['muzzle','sight','magazine','grip','stock']
};
function attCategory(base){
 if(['pm','tt','glock17','deserteagle','gunslinger'].includes(base))return 'handgun';
 if(['pp19','pps43','kedr','mp5','p90'].includes(base))return 'smg';
 if(['mp133','mp153','saiga12'].includes(base))return 'shotgun';
 if(['rpk74'].includes(base))return 'lmg';
 if(['mosin'].includes(base))return 'sniper';
 if(['sks','svd','adar'].includes(base))return 'marksman';
 return 'ar';
}
function attSlots(base){const w=W[base];if(!w||w.melee||!w.ammo||isBossOnlyGear('weapons',base))return [];return TOK_GUN_SLOTS[base]||['muzzle','sight','magazine'];}
function attRollRarity(r,market){const weights=market?ATT_MARKET_RAR:ATT_LOOT_RAR;let z=r?rand(r):Math.random();for(let i=0;i<4;i++){z-=weights[i];if(z<0)return ATT_RAR[i]}return 'legendary'}
function attMake(r,base,rarity){const affixes=[],pool=Object.keys(GC.weapon),count=ATT_RAR.indexOf(rarity);for(let i=0;i<count;i++){const j=Math.floor((r?rand(r):Math.random())*pool.length),k=pool.splice(j,1)[0],def=GC.weapon[k];affixes.push({type:k,value:def[1]+Math.floor((r?rand(r):Math.random())*(def[2]-def[1]+1))})}return {id:'gear-'+g.nextGearId++,type:'attachment',base,rarity,affixes,favorite:false,dur:null}}
function attGenerate(r,market){const bases=Object.keys(ATTACH),base=bases[Math.floor((r?rand(r):Math.random())*bases.length)];return attMake(r,base,attRollRarity(r,market))}
function attAutoWeapon(r,x){if(x?.type!=='weapon'||!attSlots(x.base).length)return x;const z=r?rand(r):Math.random(),count=z<.70?0:z<.90?1:z<.98?2:3;const slots=attSlots(x.base).slice();x.attachments=x.attachments||{};for(let i=0;i<count&&slots.length;i++){const j=Math.floor((r?rand(r):Math.random())*slots.length),slot=slots.splice(j,1)[0],options=Object.keys(ATTACH).filter(k=>ATTACH[k].slot===slot),base=options[Math.floor((r?rand(r):Math.random())*options.length)];x.attachments[slot]=attMake(r,base,attRollRarity(r,false))}return x}
function attInstalled(x){if(x?.base==='chainsaw')return [];return x?.type==='weapon'?Object.entries(x.attachments||{}).filter(([slot,a])=>a&&attSlots(x.base).includes(slot)&&ATTACH[a.base]?.slot===slot).map(([,a])=>a):[]}
function attEffect(x,key,dist){let value=0;for(const a of attInstalled(x)){const i=Math.max(0,ATT_RAR.indexOf(a.rarity)),v=ATT_EFFECT[a.base]?.[i]||0; if(key==='accuracy')value+=a.base==='red_dot'||a.base==='holo'||a.base==='scope'||a.base==='grip'?v:0;if(key==='accuracy'&&a.base==='scope'&&dist===0)value-=5;if(key==='control')value+=(a.base==='brake'||a.base==='holo')?v:0;if(key==='dodge'&&a.base==='stock')value+=v;if(key==='magazine'&&a.base==='extended')value+=v}return value}
function attAffix(x,key){return attInstalled(x).reduce((sum,a)=>sum+(a.affixes||[]).filter(v=>v.type===key).reduce((n,v)=>n+v.value,0),0)}
function attWeaponBonus(x,key){return attAffix(x,key)}
function attPrice(x){const i=Math.max(0,ATT_RAR.indexOf(x.rarity));return ATTACH[x.base]?.prices[i]||0}
function attCustomView(){const w=equippedGear(v3SelectedGearSlot);if(!['weapon','secondary'].includes(v3SelectedGearSlot)||!w||w.type!=='weapon')return '';const slots=attSlots(w.base);if(!slots.length)return '<section class="panel"><h3>武器カスタマイズ</h3><p class="muted">この武器はアタッチメント非対応です。</p></section>';return `<section class="panel att-custom"><h3>武器カスタマイズ — ${escapeHTML(gearName(w))}</h3><p class="muted">拠点でのみ無料で装着・交換・取り外しができます。装着済みパーツは武器と一緒に保管されます。</p>${slots.map(slot=>{const a=w.attachments?.[slot],available=g.gear.filter(x=>x.type==='attachment'&&ATTACH[x.base]?.slot===slot);return `<div class="att-slot"><strong>${ATT_SLOTS[slot]}</strong><div>${a?tokAttachmentImage(a.base)+gearLabel(a)+'　'+escapeHTML(affixText(a)):'未装着'}</div><div class="btns">${a?b('取り外す',`attRemove:${w.id}:${slot}`,'small',g.status!=='base'):''}${available.map(item=>`<div class="att-candidate ${item.rarity}">${tokAttachmentImage(item.base)}${gearLabel(item)} ${b('装着する',`attEquip:${w.id}:${slot}:${item.id}`,'small',g.status!=='base')}</div>`).join('')}</div></div>`}).join('')}</section>`}

function tokAttBaseEffect(a){
 const i=Math.max(0,ATT_RAR.indexOf(a.rarity)),v=ATT_EFFECT[a.base]?.[i]||0;
 const labels={suppressor:`戦闘後の次回敵遭遇率 −${v}pt`,brake:`連射命中減衰 −${v}pt`,red_dot:`命中 +${v}pt`,holo:`命中 +${v}pt / 連射命中減衰 −${[1,2,3,4][i]}pt`,scope:`命中 +${v}pt / 近距離命中 −5pt`,extended:`リロードまでの攻撃可能ターン +${v}`,grip:`命中 +${v}pt`,stock:`回避 +${v}pt`};
 return labels[a.base]||'効果なし';
}
function tokAttDetails(w){
 if(!w||w.type!=='weapon')return '';
 const installed=Object.entries(w.attachments||{}).filter(([slot,a])=>a&&attSlots(w.base).includes(slot)&&ATTACH[a.base]?.slot===slot);
 if(!installed.length)return '<p class="muted">装着中のアタッチメント：なし</p>';
 return `<div class="tok-att-summary"><strong>装着中のアタッチメント（${installed.length}個）</strong>${installed.map(([slot,a])=>`<div class="tok-att-effect ${escapeHTML(a.rarity)}"><b>${escapeHTML(ATT_SLOTS[slot]||slot)}：${escapeHTML(ATTACH[a.base].n)} <span class="rarity">${escapeHTML(RN[a.rarity]||a.rarity)}</span></b><div>基本効果：${escapeHTML(tokAttBaseEffect(a))}</div><div>ランダム能力：${escapeHTML(affixText(a))}</div></div>`).join('')}<p class="muted">各効果は戦闘時に適用。命中・貫通等は武器本体のランダム能力と加算されます。</p></div>`;
}
let tokAttachmentOpenFor=null;
function tokSelectedEquippedPanel(grenadeVisual,grenadeSettings){
 if(v3SelectedGearSlot==='grenade')return `<section class="panel tok-equipped-weapons"><h2>装備中のグレネード</h2>${grenadeVisual}${grenadeSettings}</section>`;
 const slot=v3SelectedGearSlot;
 const names={accessory:'アクセサリー',weapon:'メイン武器',secondary:'サブ武器',melee:'近接武器',helmet:'ヘルメット',armor:'アーマー',bag:'バッグ',grenade:'グレネード'};
 const title=names[slot]||'装備';
 const x=equippedGear(slot);
 const picture=x?(x.type==='weapon'?tokWeaponImage(x.base):tokEquipmentImage(x.base,x.type)):'';
 const details=x&&x.type==='weapon'?tokAttDetails(x):'';
 const custom=x&&['weapon','secondary'].includes(slot)&&attSlots(x.base).length?tokAttCustomFor(x):'';
 return `<section class="panel tok-equipped-weapons"><h2>装備中の${title}</h2>${x?`<div class="item gear-card ${escapeHTML(x.rarity||'common')}"><strong>${escapeHTML(gearName(x))}</strong>${picture}${gearQuickStats(x)}${details}</div>`:'<p class="muted">未装備</p>'}${custom}</section>`;
}
function tokAttCustomFor(w){
 const slots=attSlots(w.base);if(!slots.length)return '';
 return `<div class="att-custom"><h3>武器カスタマイズ — ${escapeHTML(gearName(w))}</h3><p class="muted">拠点でのみ無料で装着・交換・取り外しができます。</p>${Object.entries(w.attachments||{}).filter(([slot,a])=>a&&(!slots.includes(slot)||ATTACH[a.base]?.slot!==slot)).map(([slot,a])=>`<div class="att-slot"><strong>旧設定の非対応パーツ：${escapeHTML(ATT_SLOTS[slot]||slot)}</strong><div>${gearLabel(a)}</div>${b('取り外して倉庫に戻す',`attRemove:${w.id}:${slot}`,'small',g.status!=='base')}</div>`).join('')}${slots.map(slot=>{const a=w.attachments?.[slot],available=g.gear.filter(x=>x.type==='attachment'&&ATTACH[x.base]?.slot===slot);return `<div class="att-slot"><strong>${ATT_SLOTS[slot]}</strong><div>${a?tokAttachmentImage(a.base)+gearLabel(a)+'<p>'+escapeHTML(tokAttBaseEffect(a))+'</p><p>'+escapeHTML(affixText(a))+'</p>':'未装着'}</div><div class="btns">${a?b('取り外す',`attRemove:${w.id}:${slot}`,'small',g.status!=='base'):''}${available.map(item=>`<div class="att-candidate ${item.rarity}">${tokAttachmentImage(item.base)}${gearLabel(item)}<p>${escapeHTML(tokAttBaseEffect(item))}</p>${b('装着する',`attEquip:${w.id}:${slot}:${item.id}`,'small',g.status!=='base')}</div>`).join('')}</div></div>`}).join('')}</div>`;
}
let tokGunsmithWeaponId=null;
function tokGunsmithView(){
 const weapons=g.gear.filter(x=>x.type==='weapon'&&!W[x.base]?.melee);
 const editable=weapons.filter(x=>attSlots(x.base).length);
 const selected=editable.find(x=>x.id===tokGunsmithWeaponId)||editable.find(x=>x.id===g.eqIds.weapon)||editable[0];
 if(selected)tokGunsmithWeaponId=selected.id;
 const locked=g.status!=='base'||!!g.longRun?.active;
 return `<section class="panel tok-gunsmith"><h2>ガンスミス</h2><p class="muted">倉庫にある銃を選び、所持しているアタッチメントを無料で装着・交換・取り外しできます。交換したパーツは倉庫に戻ります。</p>${locked?'<p class="warn">レイド中・長期探索中はカスタマイズできません。</p>':''}<h3>カスタマイズする武器</h3><div class="tok-gunsmith-weapons">${weapons.map(w=>`<button type="button" class="tok-gunsmith-choice ${selected?.id===w.id?'chosen':''}" data-action="gunsmithSelect:${w.id}" ${locked?'disabled':''}><span class="tok-gunsmith-choice-head"><strong>${escapeHTML(gearName(w))}</strong><span class="tok-gunsmith-rarity ${escapeHTML(w.rarity||'common')}">${escapeHTML(RN[w.rarity]||String(w.rarity||'COMMON').toUpperCase())}</span></span>${tokWeaponImage(w.base)}<small>${w.id===g.eqIds.weapon?'メイン装備中 · ':w.id===g.eqIds.secondary?'サブ装備中 · ':''}${attSlots(w.base).length?`装着 ${attInstalled(w).length} / ${attSlots(w.base).length}`:'アタッチメント非対応'}</small></button>`).join('')||'<p class="muted">倉庫に銃がありません。</p>'}</div>${selected?tokAttCustomFor(selected):'<p class="muted">アタッチメントを装着できる武器がありません。</p>'}</section>`;
}
function attEquip(wid,slot,aid){if(g.status!=='base'||g.longRun?.active)return;const w=findGear(wid),a=findGear(aid);if(!w||!a||a.type!=='attachment'||!attSlots(w.base).includes(slot)||ATTACH[a.base]?.slot!==slot)return;w.attachments=w.attachments||{};const previous=w.attachments[slot];if(previous)g.gear.push(previous);w.attachments[slot]=a;g.gear=g.gear.filter(x=>x.id!==aid);save();render()}
function attRemove(wid,slot){if(g.status!=='base'||g.longRun?.active)return;const w=findGear(wid),a=w?.attachments?.[slot];if(!a)return;g.gear.push(a);delete w.attachments[slot];save();render()}
const BANKTYPE={accessory:'accessories',weapon:'weapons',armor:'armors',bag:'bags',helmet:'helmets'};
const NEW_SHOP_UNLOCK={'kedr': null, 'pps43': null, 'mp133': null, 'vpo136': null, 'mp5': 'suburban', 'adar': 'suburban', 'mp153': 'industrial', 'ak105': 'industrial', 'm4a1': 'metro', 'rpk74': 'hospital', 'mosin': 'port', 'svd': 'port', 'scarh': 'airport', 'p90': 'mall', 'aug': 'tower', 'saiga12': 'police'};
function weaponShopUnlocked(id){return !(id in NEW_SHOP_UNLOCK)||NEW_SHOP_UNLOCK[id]===null||!!g.bosses?.[NEW_SHOP_UNLOCK[id]]?.first}
function findGear(id){return g.gear.find(x=>x.id===id)}
function gearName(x){return (GEARTYPE[x.type][x.base]?.n||x.base)+(x.emergencyIssued?'（支給品・売却価値なし）':'')}
function gearVal(x,key){const base=(x?.affixes||[]).filter(a=>a.type===key).reduce((n,a)=>n+a.value,0)+(x?.type==='weapon'?attWeaponBonus(x,key):0);const def=x&&GEARTYPE[x.type]?.[x.base];return base+(key==='accuracy'?(def?.accuracy||0):0)}
function gearPrice(x){if(x?.emergencyIssued)return 0;if(x?.type==='attachment')return Math.floor(attPrice(x)*({common:.5,rare:.7,epic:1,legendary:1.5}[x.rarity]||.5));const mult=(x.type==='weapon'&&W[x.base]?.fixed?{common:.3,rare:.42,epic:.6,legendary:.9,boss:1.6}:{common:.5,rare:.7,epic:1,legendary:1.5,boss:1.6})[x.rarity]||.5;const def=GEARTYPE[x.type][x.base];const max=['armor','helmet','weapon'].includes(x.type)?def.max||100:1;return Math.floor(def.price*mult*(['armor','helmet','weapon'].includes(x.type)?clamp((x.dur??max)/max,0,1):1))}
function gearWeight(x,r){let weight=x.type==='accessory'?1000:(GWEIGHT[x.base]||1000);if(x.type==='weapon'||x.type==='armor'||x.type==='bag'){const reduction=raidVal(r,'bag','organize');weight=Math.ceil(weight*(1-reduction/100))}return weight}
function makeGear(r,type,base,rarity){if(type==='accessory'){const count={common:1,rare:2,epic:3,legendary:4,boss:0}[rarity]||0;const affixes=Array.from({length:count},()=>({type:TOK_ACCESSORY_KEYS[Math.floor(rand(r)*8)],value:3}));return {id:'gear-'+g.nextGearId++,type,base,rarity,affixes,favorite:false,dur:null}}const count={common:0,rare:1,epic:2,legendary:3}[rarity];const pool=Object.keys(GC[type]);const affixes=[];for(let i=0;i<count;i++){const k=pool.splice(Math.floor(rand(r)*pool.length),1)[0];const [,lo,hi]=GC[type][k];affixes.push({type:k,value:lo+Math.floor(rand(r)*(hi-lo+1))})}return {id:'gear-'+g.nextGearId++,type,base,rarity,affixes,favorite:false,dur:type==='armor'?GEARTYPE[type][base].max+gearVal({affixes},'durability'):type==='weapon'?100:type==='bag'?(B[base]?.max||80):null}}
function gearLabel(x){return `<span class="rarity ${x.rarity}">${RN[x.rarity]}</span> ${escapeHTML(gearName(x))}`}
function affixText(x){const a=(x.affixes||[]).map(v=>{const n=x.type==='accessory'?TOK_ACCESSORY_LABELS[v.type]:(GC[x.type]?.[v.type]?.[0]||v.type);return n+' +'+v.value+(['damage','saving','absorb','durprotect','repair','organize'].includes(v.type)?'%':(x.type==='accessory'&&['accuracy','evasion','loot','rare'].includes(v.type))||['accuracy','escape','load','loot','detect'].includes(v.type)?'pt':v.type==='capacity'?'kg':'')});if(x.type==='accessory'&&x.base==='cult_seal')a.push('戦利品発見率 +5pt');if(x.type==='accessory'&&x.base==='binding_chain')a.push('命中時10%で次ラウンドの敵行動を拘束');if(x.type==='weapon'&&attInstalled(x).length)a.push('装着: '+attInstalled(x).map(y=>ATTACH[y.base].n+' ['+RN[y.rarity]+']').join('、'));if(x.type==='weapon'&&WEAPON_FIXED[x.base])a.unshift('◆ '+WEAPON_FIXED[x.base]);if(x.rarity==='legendary'&&SPECIAL[x.base])a.push('★ '+SPECIAL[x.base]);if(x.rarity==='boss')a.unshift('★ '+BOSS_FIXED[x.base]);const extra=extInfo(GEARTYPE[x.type]?.[x.base]);if(extra)a.unshift(extra);return a.length?a.join(' / '):'基本性能'}
function equippedGear(type){return findGear(g.eqIds[type])}
function raidGear(r,type){return r?.equipment?.[type]||(r?null:equippedGear(type))}
function raidVal(r,type,key){return gearVal(raidGear(r,type),key)}

const EXT_LABEL={dodge:'回避',pen:'耐貫通',shock:'衝撃吸収',loot:'探索発見',wear:'耐久保護',all:'汎用'};
function extInfo(o){if(!o?.special)return '';return '【'+({light:'軽装',medium:'中装',heavy:'重装'}[o.weightClass]||'')+'・'+EXT_LABEL[o.special]+'】 '+(o.special==='all'?'回避+1pt／発見+2pt':EXT_LABEL[o.special]+'+'+o.specialValue+(o.special==='dodge'||o.special==='loot'?'pt':'%'));}
function extEquipped(r){return ['armor','helmet','bag'].map(t=>({type:t,gear:r?raidGear(r,t):equippedGear(t)})).filter(v=>v.gear).map(v=>({...v,def:GEARTYPE[v.type][v.gear.base]})).filter(v=>v.def&&(!r||v.type==='bag'||(v.type==='armor'?r.dur>0:r.helmetDur>0)));}
const TOK_SET_NAMES={dodge:'ゴースト',pen:'タートル',shock:'ゴリラ',loot:'フォックス',wear:'フェニックス',all:'オクトパス'};
const TOK_WEIGHT_NAMES={light:'ライト',medium:'タクティカル',heavy:'ヘビー'};
function tokSetBonuses(r){
 const pieces=['armor','helmet','bag'].map(type=>({type,gear:r?raidGear(r,type):equippedGear(type)})).filter(x=>x.gear).map(x=>({...x,def:GEARTYPE[x.type]?.[x.gear.base]})).filter(x=>x.def&&!isBossOnlyGear(BANKTYPE[x.type],x.gear.base)&&(!r||x.type==='bag'||(x.type==='armor'?r.dur>0:r.helmetDur>0)));
 const series={},weights={};
 for(const x of pieces){const sp=x.def.special,weight=x.def.weightClass||(x.type==='armor'?(x.gear.base==='light'?'light':x.gear.base==='standard'?'medium':x.gear.base==='heavy'?'heavy':null):x.type==='helmet'?(x.gear.base==='light'?'light':x.gear.base==='combat'?'medium':x.gear.base==='heavy'?'heavy':null):x.type==='bag'?(x.gear.base==='small'?'light':x.gear.base==='medium'?'medium':x.gear.base==='large'?'heavy':null):null);if(sp&&TOK_SET_NAMES[sp])series[sp]=(series[sp]||0)+1;if(weight&&TOK_WEIGHT_NAMES[weight])weights[weight]=(weights[weight]||0)+1;}
 const lvl=n=>n>=3?3:n>=2?2:0;
 const ghost=lvl(series.dodge||0),turtle=lvl(series.pen||0),gorilla=lvl(series.shock||0),fox=lvl(series.loot||0),phoenix=lvl(series.wear||0),octopus=lvl(series.all||0);
 const light=lvl(weights.light||0),tactical=lvl(weights.medium||0),heavy=lvl(weights.heavy||0);
 return {series,weights,accuracy:(ghost===3?7:ghost===2?3:0)+(octopus===3?4:octopus===2?2:0),maxhp:(turtle===3?15:turtle===2?5:0)+(octopus===3?8:octopus===2?3:0)+(heavy===3?25:heavy===2?10:0),damage:gorilla===3?8:gorilla===2?3:0,foxRare:fox===3?10:fox===2?5:0,bleedImmune:phoenix>=2,statusImmune:phoenix===3,initiative:light===3?20:light===2?10:0,headshot:tactical===3?10:tactical===2?5:0};
}
function tokSetPanel(r){const x=tokSetBonuses(r);const entries=[];for(const [k,n] of Object.entries(x.series))if(n>=2)entries.push(`${TOK_SET_NAMES[k]} ${n}/3`);for(const [k,n] of Object.entries(x.weights))if(n>=2)entries.push(`${TOK_WEIGHT_NAMES[k]} ${n}/3`);const benefits=[];if(x.accuracy)benefits.push(`命中＋${x.accuracy}pt`);if(x.maxhp)benefits.push(`最大HP＋${x.maxhp}`);if(x.damage)benefits.push(`攻撃力＋${x.damage}%`);if(x.foxRare)benefits.push(`希少品昇格＋${x.foxRare}pt`);if(x.bleedImmune)benefits.push(x.statusImmune?'全状態異常無効':'出血無効');if(x.initiative)benefits.push(`先制＋${x.initiative}pt`);if(x.headshot)benefits.push(`ヘッドショット＋${x.headshot}pt`);return `<section class="panel"><h3>セットボーナス（シリーズ／規格）</h3><p>${entries.length?entries.join(' ／ '):'現在発動しているセットはありません'}</p><p class="ok">${benefits.length?benefits.join(' ／ '):'同じシリーズまたは規格を2部位以上そろえると発動'}</p><small>2部位・3部位の段階式。3部位では上位効果のみ適用。シリーズと規格は同時発動。破損した防具・ヘルメットはレイド中無効。</small></section>`;}
function extBonus(r){const pieces=extEquipped(r);const sum=k=>pieces.reduce((v,x)=>v+(x.def.special===k?x.def.specialValue:0),0);const all=pieces.filter(x=>x.def.special==='all').length;const light=pieces.filter(x=>x.def.weightClass==='light').length,medium=pieces.filter(x=>x.def.weightClass==='medium').length;return {dodge:Math.min(20,sum('dodge')+all)+(raidGear(r,'armor')?.base==='fortress_shield'?-10:0)+(raidGear(r,'bag')?.base==='hound_backpack'?5:0),pen:Math.min(25,sum('pen')),shock:Math.min(20,sum('shock')),loot:Math.min(20,sum('loot')+2*all),wear:Math.min(40,sum('wear')),extra:Math.min(10,3*light+medium+(light===3?1:0)),light,medium};}
function extLootExtra(r,idx){const chance=extBonus(r).extra;if(!chance||!roll(r,chance/100*.80))return;const id=drawLoot(r);if(!tokOrdinaryLootAllowed(r,id))return;const size=r.v19Legacy?L[id].g:Math.ceil(L[id].g/1000)*1000;if(bagLoad(r)+size>bagCapacity(r)){log(r,`軽装追加抽選：${L[id].n}を発見したが容量不足`);return;}if(!r.v19Legacy&&['bandage','medkit'].includes(id)){acquireSupply(r,id==='medkit'?'med':'bandage',1,`軽装追加抽選${idx}`)}else{r.loot[id]=(r.loot[id]||0)+1;r.lootAcquired=true;r.xp+=2;log(r,`軽装追加抽選：${L[id].n}を回収（+2XP）`);}}

function bagCapacity(r){return Math.round(backpackCap(r)*1000)}
function lootWeight(r){return Object.entries(r.loot).reduce((sum,[id,n])=>sum+(L[id]?.g||0)*n,0)}
function gearCarryWeight(r){return (r.gearLoot||[]).reduce((sum,x)=>sum+gearWeight(x,r),0)}
function lootValue(r){return Object.entries(r.loot).reduce((sum,[id,n])=>sum+(L[id]?.price||0)*n,0)}
function drawGear(r){const type=pick(r,['weapon','helmet','armor','bag','accessory']);const ids=Object.keys(GEARTYPE[type]).filter(x=>x!=='none'&&x!=='cult_seal'&&!isBossOnlyGear(BANKTYPE[type],x)&&(type!=='weapon'||!W[x]?.melee||Object.prototype.hasOwnProperty.call(MELEE,x)));const v=rand(r),weights=(MAP[r.map]?.lootRarity||[70,25,4.5,.5]).map(x=>x/100);const boost=depthQualityBoost(r.explore)+tokAccessoryBonus(r,'rare')/100;weights[0]=Math.max(0,weights[0]-boost);weights[2]+=boost*.65;weights[3]+=boost*.35;let cum=0,rarity='common';for(let i=0;i<weights.length;i++){cum+=weights[i];if(v<cum){rarity=RARITIES[i];break}}if(['common','rare'].includes(rarity)&&roll(r,tokSetBonuses(r).foxRare/100))rarity='rare';return attAutoWeapon(r,makeGear(r,type,pick(r,ids),rarity))}

function attEncounterChance(r,base){const head=raidGear(r,'helmet'),bag=raidGear(r,'bag');const reduction=((H[head?.base]?.encounterReduction||0)+(B[bag?.base]?.encounterReduction||0))/100;return clamp(base-(r._suppressEncounter||0)-reduction,0,1)}
// v3.5.83: ordinary equipment and valuables drop adjustment (C plan).
const TOK_DROP_EQUIPMENT_FACTOR=.50;
const TOK_DROP_VALUABLE_FACTOR=.40;
function tokOrdinaryLootAllowed(r,id){
 const item=L[id];
 if(!item)return false;
 // Keys, quest clues, collection rewards, and repair resources are exempt.
 if(['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id)
    ||item.repairMaterial||item.repairTool)return true;
 // Medical items and consumables are exempt.
 if(['bandage','medkit'].includes(id))return true;
 return roll(r,r.map==='suburban'&&!r.longMode&&item.t!=='rare'?1:TOK_DROP_VALUABLE_FACTOR);
}
function gearDropChance(r,base){/* 探索時の基本装備品発見率：通常4%、長期6%。敵撃破時の装備報酬は従来の独立判定を維持。 */const bg=raidGear(r,'bag');const bonus=Math.min(.02,Math.max(0,raidVal(r,'bag','detect')/100)*.05+(bg?.rarity==='legendary'?.01:0));return clamp((.30+bonus)*TOK_DROP_EQUIPMENT_FACTOR,0,1)}
function collectGear(r,x,source){const cap=bagCapacity(r),w=r.v19Legacy?gearWeight(x,r):Math.ceil(gearWeight(x,r)/1000)*1000;if(w>cap){log(r,`${source}：${gearName(x)}発見、バッグ容量を超えるため断念`);return}if(bagLoad(r)+w>cap){log(r,`${source}：${gearName(x)}発見、バッグ容量不足のため取得しない`);return;const options=[];for(const [id,n] of Object.entries(r.loot))for(let i=0;i<n;i++)options.push({kind:'loot',id,weight:r.v19Legacy?L[id].g:Math.ceil(L[id].g/1000)*1000,value:L[id].price});for(const y of r.gearLoot||[])options.push({kind:'gear',id:y.id,weight:r.v19Legacy?gearWeight(y,r):Math.ceil(gearWeight(y,r)/1000)*1000,value:gearPrice(y),gear:y});const priority=g.settingsGear?.priority||'gear';options.sort((a,b)=>(priority==='gear'?(a.kind==='loot'?0:1)-(b.kind==='loot'?0:1):0)||a.value/a.weight-b.value/b.weight);let freed=0,discardValue=0,discard=[];for(const o of options){if(bagLoad(r)+w-freed<=cap)break;freed+=o.weight;discardValue+=o.value;discard.push(o)}if(bagLoad(r)+w-freed>cap||(priority==='value'&&discardValue>=gearPrice(x))){log(r,`${source}：${gearName(x)}発見、容量・回収方針により断念`);return}for(const o of discard){if(o.kind==='loot'){r.loot[o.id]--;if(!r.loot[o.id])delete r.loot[o.id]}else r.gearLoot=r.gearLoot.filter(y=>y.id!==o.id)}if(discard.length)log(r,`容量確保のため戦利品${discard.length}個を破棄`)}r.gearLoot.push(x);r.lootAcquired=true;g.gearStats.found++;log(r,`【装備発見】${RN[x.rarity]} ${gearName(x)}（${affixText(x)}）`)}
function gearRoll(r,chance,source){if(roll(r,gearDropChance(r,chance)))collectGear(r,drawGear(r),source)}
// v3.4.56: 称号は討伐・生還済みの既存記録から判定。旧セーブにも自動適用。
function achievementState(){
 const defeated=id=>!!(g&&g.bosses&&g.bosses[id]&&g.bosses[id].first);
 // ボススレイヤー: ゼロ（lab）を含む異なるボス25体を討伐・生還。
 // 既存セーブの各ボス初回討伐記録を利用し、過去の達成も反映する。
 const bossIds=Object.keys(BOSSES);
 const done=bossIds.filter(defeated).length;
 const target=25;
 return {stalker:!!(g.pursuer&&g.pursuer.kills>0),survivor:defeated('lab'),slayer:defeated('lab')&&done>=target,total:target,done:Math.min(done,target)};
}
function achievementBadges(){
 const a=achievementState();
 return `${a.survivor?'<div class="hero"><strong style="color:#e7c987">★ TOKYOV SURVIVOR</strong><p>ゼロを討伐し、生還した証。</p></div>':''}${a.stalker?'<div class="hero"><strong style="color:#e7c987">★ Escape from Stalker</strong><p>追跡者を完全討伐した証。</p></div>':''}${a.slayer?'<div class="hero"><strong style="color:#e7c987">★ ボススレイヤー</strong><p>ゼロを含む25体の異なるボスを討伐・生還した証。</p></div>':''}`;
}

// v3.5.86: independent ultra-rare collection draw. Weight 50 => 0.5% per raid.
const TOK_ULTRARARE_ITEMS=[{"id": "rare_art_twilight", "name": "名画「黄昏の庭園」", "price": 60000, "weight": 7}, {"id": "rare_art_ukiyoe", "name": "幻の浮世絵「月下美人」", "price": 75000, "weight": 6}, {"id": "rare_art_kannon", "name": "純金の千手観音像", "price": 120000, "weight": 4}, {"id": "rare_art_chalice", "name": "古代王朝の黄金杯", "price": 80000, "weight": 6}, {"id": "rare_art_sculpture", "name": "名匠の大理石彫刻", "price": 150000, "weight": 3}, {"id": "rare_jewel_sapphire", "name": "蒼海のサファイアネックレス", "price": 50000, "weight": 7}, {"id": "rare_jewel_ruby", "name": "紅蓮のルビーリング", "price": 65000, "weight": 6}, {"id": "rare_jewel_emerald", "name": "皇帝のエメラルド", "price": 100000, "weight": 5}, {"id": "rare_jewel_blackdiamond", "name": "ブラックダイヤのブローチ", "price": 80000, "weight": 4}, {"id": "rare_jewel_tiara", "name": "王家のダイヤモンドティアラ", "price": 250000, "weight": 2}];

// v3.6.36: User-supplied ultra-rare collectible artwork, embedded for offline use.
const TOK_ULTRARARE_IMAGES={'rare_art_twilight':'data:image/jpeg;base64,','rare_art_ukiyoe':'data:image/jpeg;base64,','rare_art_kannon':'data:image/jpeg;base64,','rare_art_chalice':'data:image/jpeg;base64,','rare_art_sculpture':'data:image/jpeg;base64,','rare_jewel_sapphire':'data:image/jpeg;base64,','rare_jewel_ruby':'data:image/jpeg;base64,','rare_jewel_emerald':'data:image/jpeg;base64,','rare_jewel_blackdiamond':'data:image/jpeg;base64,','rare_jewel_tiara':'data:image/jpeg;base64,'};
function tokUltraRareImage(id){const src=TOK_ULTRARARE_IMAGES[id];return src?`<img src="${src}" alt="${escapeHTML(L[id]?.n||id)}" loading="lazy" decoding="async" style="display:block;width:100%;max-width:420px;max-height:350px;object-fit:contain;object-position:center;background:#0c1010;border:1px solid #46534a;border-radius:10px;margin:10px auto">`:``;}
const TOK_ULTRARARE_IDS=TOK_ULTRARARE_ITEMS.map(x=>x.id);
for(const x of TOK_ULTRARARE_ITEMS)L[x.id]={n:x.name,g:250,price:x.price,t:'rare',ultraRare:true};
const TOK_LONG_ULTRARARE_RATE={1:.005,2:.007,3:.009,6:.012,12:.016,24:.020};
function tokUltraRarePick(chance){
 const n=Math.max(0,Math.min(1,chance));
 if(Math.random()>=n)return null;
 let k=Math.floor(Math.random()*50);
 for(const item of TOK_ULTRARARE_ITEMS){k-=item.weight;if(k<0)return item.id}
 return TOK_ULTRARARE_ITEMS[9].id;
}
function tokUltraRareRegister(id){
 if(!TOK_ULTRARARE_IDS.includes(id))return;
 g.ultraRareCollection=g.ultraRareCollection||{};
 g.ultraRareCollection[id]=true;
 if(TOK_ULTRARARE_IDS.every(x=>g.ultraRareCollection[x]))g.ultraRareCollectionTitle=true;
}
function tokUltraRareCollectionView(){
 g.ultraRareCollection=g.ultraRareCollection||{};
 if(TOK_ULTRARARE_IDS.every(id=>g.ultraRareCollection[id]))g.ultraRareCollectionTitle=true;
 const count=TOK_ULTRARARE_IDS.filter(id=>g.ultraRareCollection?.[id]).length;
 return `<section class="panel"><h2>激レア収集品 ${count}/10</h2><p class="muted">全地区共通。通常レイドは1回につき0.5%、長期探索は出撃時間に応じた確率で1回だけ抽選。生還後に図鑑登録され、売却後も記録が残ります。</p>${TOK_ULTRARARE_ITEMS.map(x=>{const found=!!g.ultraRareCollection?.[x.id];return `<div class="item"><strong>${found?'✓ '+escapeHTML(x.name):'🔒 ？？？'}</strong>${found?`${tokUltraRareImage(x.id)}<p class="muted">売却価格 ${fmt(x.price)}₽</p>`:''}</div>`}).join('')}</section>`;
}
function tokRegionalCollectionView(){
 g.regionalCollection=g.regionalCollection||{};
 for(const id of TOK_REGIONAL_COLLECTION_IDS)if((g.bank?.loot?.[id]||0)>0)g.regionalCollection[id]=true;
 const count=TOK_REGIONAL_COLLECTION_IDS.filter(id=>g.regionalCollection[id]).length;
 if(count===21)g.regionalCollectionTitle=true;
 return `<section class="panel"><h2>地域収集品 ${count}/21</h2><p class="muted">各地区で1種類。生還して持ち帰ると永久登録され、売却しても記録は残ります。</p>${TOK_REGIONAL_COLLECTION_IDS.map(id=>{const item=L[id],found=!!g.regionalCollection[id];return `<div class="item"><strong>${found?"✓ "+escapeHTML(item.n):"🔒 ？？？"}</strong> <span class="pill">${escapeHTML(MAP[item.regionalMap]?.n||item.regionalMap)}</span>${found?`${tokRegionalImage(id)}<p class="muted">売却価格 ${fmt(item.price)}₽</p>`:""}</div>`}).join("")}<p class="muted">全21種類達成：称号「東京の記録者」（能力補正なし）</p></section>`;
}
function achievementBadgePanel(){
 const a=achievementState();
 return `<section class="panel"><h2>称号</h2><div class="item"><strong>${g.ultraRareCollectionTitle||TOK_ULTRARARE_IDS.every(id=>g.ultraRareCollection?.[id])?"★ コレクター（収集家）":"🔒 コレクター（収集家）"}</strong><p class="muted">激レア収集品10種類をすべて持ち帰る（${TOK_ULTRARARE_IDS.filter(id=>g.ultraRareCollection?.[id]).length}/10）。能力補正なし。</p></div><div class="item"><strong>${g.regionalCollectionTitle||TOK_REGIONAL_COLLECTION_IDS.every(id=>g.regionalCollection?.[id])?"★ 東京の記録者":"🔒 東京の記録者"}</strong><p class="muted">地域収集品を21種類すべて持ち帰る（${TOK_REGIONAL_COLLECTION_IDS.filter(id=>g.regionalCollection?.[id]).length}/21）。能力補正なし。</p></div><div class="item"><strong>${g.royalTitle?'👑 Dear majesty':'🔒 Dear majesty'}</strong> <span class="pill">${g.royalTitle?'獲得済み':'未獲得'}</span><p class="muted">王室収集品を4種類すべて持ち帰る（${ROYAL_IDS.filter(id=>g.royalCollection?.[id]).length}/4）。</p></div><div class="item"><strong>${a.survivor?'★ TOKYOV SURVIVOR':'🔒 TOKYOV SURVIVOR'}</strong> <span class="pill">${a.survivor?'獲得済み':'未獲得'}</span><p class="muted">ゼロを討伐して生還する。</p></div><div class="item"><strong>${a.stalker?'★ Escape from Stalker':'🔒 Escape from Stalker'}</strong> <span class="pill">${a.stalker?'獲得済み':'未獲得'}</span><p class="muted">追跡者を完全討伐する。</p></div><div class="item"><strong>${a.slayer?'★ ボススレイヤー':'🔒 ボススレイヤー'}</strong> <span class="pill">${a.slayer?'獲得済み':'未獲得'}</span><p class="muted">ゼロを含む異なるボス25体を討伐・生還する（${a.done}/${a.total}）。ゼロの討伐が必須。地区ボスと徘徊型ボスを含む。</p></div></section>`;
}
function maybeComplete(){if(!g.cleared&&g.bank.key&&activeCount(g.bank.loot,'memory')>0&&activeCount(g.bank.loot,'research')>0){g.cleared=true;g.notice='MISSION COMPLETE！ エンドレスモード解放。引き続き出撃できます。'}}
function activeCount(obj,id){return Math.max(0,Math.floor(obj[id]||0))}function bankHas(type,id){return activeCount(g.bank[type],id)>0}function canEquip(){const w=equippedGear('weapon'),b=equippedGear('bag'),m=findGear(g.eqIds.melee);return g.hp>=1&&!!b&&(b.dur??repairMax(b))>0&&((!!w&&(w.dur??100)>0&&(!W[w.base]?.melee||w.base==='chainsaw')&&(W[w.base].ammoFree||requestedAmmo(W[w.base].ammo)>=1))||(!!m&&(m.dur??100)>0))}
function reconcileEquipment(){if(g.eqIds.secondary===g.eqIds.weapon)g.eqIds.secondary=null;if(g.eqIds.melee===g.eqIds.weapon||g.eqIds.melee===g.eqIds.secondary)g.eqIds.melee=null;if(g.eqIds.secondary&&!findGear(g.eqIds.secondary))g.eqIds.secondary=null;if(g.eqIds.melee&&!findGear(g.eqIds.melee))g.eqIds.melee=null;for(const type of ['weapon','armor','helmet','bag','accessory']){const x=equippedGear(type);if(!x)g.eqIds[type]=null;g.equipped[type]=x?x.base:(type==='armor'?'none':null)}}

function tok111TreatCost(k){return Math.ceil((LONG_TREAT_COST[k]||0)*(Number(g.level)<5?.5:1))}
function tok111RecoverInjuries(ms){g.injuryMs=g.injuryMs||{};const active=longInjuries();for(const k of Object.keys(LONG_HEAL_MINUTES)){if(!active.includes(k)){delete g.injuryMs[k];continue}g.injuryMs[k]=(Number(g.injuryMs[k])||0)+ms;if(g.injuryMs[k]>=LONG_HEAL_MINUTES[k]*60000){longClearInjuries([k]);delete g.injuryMs[k]}}}
function tok111InjuryLeft(k){return Math.max(0,Math.ceil((LONG_HEAL_MINUTES[k]*60000-(g.injuryMs?.[k]||0))/1000))}
function recover(ms){if(g.status!=='base'||ms<=0)return;tok111RecoverInjuries(ms);const hpTotal=(Number(g.recoveryMs)||0)+ms,hpMinutes=Math.floor(hpTotal/60000);g.recoveryMs=hpTotal%60000;g.hp=Math.min(baseMaxHp(),g.hp+hpMinutes);if(g.hp===baseMaxHp())g.recoveryMs=0;if(g.money>=9040){g.incomeMs=0;return}const cashTotal=g.incomeMs+ms,mins=Math.floor(cashTotal/60000);g.money=Math.min(9040,g.money+mins*10);g.incomeMs=g.money>=9040?0:cashTotal%60000}
function advance(now=Date.now()){if(g.longRun?.active&&!longBusy){longAdvance(now);return}if(g.poisonTurns===undefined)g.poisonTurns=0;if(g.bleed===undefined)g.bleed=false;if(g.status==='base'){const elapsed=clamp(now-(g.baseAt||now),0,365*86400000);if(elapsed>=1000){recover(elapsed);g.baseAt=now;save()}return}if(g.status!=='raid'||!g.raid)return;const r=g.raid;if(r._finishCommitted){g.notice='帰還処理が中断されました。安全のためレイドを停止しました。';g.status='base';g.raid=null;g.baseAt=now;save();return}if(r.phase==='extract'&&r.required>0&&r.progress>=r.required){finishRaid(true);if(g.status!=='raid'){g.baseAt=now;save();return}}const due=clamp(Math.floor((now-r.startedAt)/STEP),0,34);let count=0;while(g.status==='raid'&&r.processed<due&&count++<40){stepRaid();r.processed++}if(g.status==='raid'){if(count)save()}else{const ended=r.startedAt+r.processed*STEP;g.baseAt=ended;recover(Math.max(0,now-ended));g.baseAt=now;save()}}
function armorDef(id,dur,gear){if(!id||id==='none')return 0;const max=A[id].max+gearVal(gear,'durability');const ratio=clamp(dur,0,max)/max;const factor=ratio>.75?1:ratio>.5?.9:ratio>.25?.75:ratio>.1?.5:ratio>0?.25:0;return Math.floor((A[id].def+gearVal(gear,'defense'))*factor)}

// v1.8: Hit-by-hit deterministic damage spread (85–115%). Without r, returns the expected value for UI/AI estimates.
function dmg(base,def,pen,r){
 const protectedBase=Math.max(1,base*(1-Math.min(50,Math.max(0,def-pen))/100));
 const rollFactor=r?(0.85+rand(r)*0.30):1;
 return Math.max(1,Math.floor(protectedBase*rollFactor));
}
const SUPPLY_WEIGHTS={bandage:20,med:17,antidote:12,advanced:8,flash:14,frag:14,molotov:7,gas:5,smoke:7,splint:2,burnmed:1};
const TOK_GRENADES=['frag','flash','molotov','gas','smoke'];
const TOK_GRENADE_TIMING=[['start','戦闘開始時'],['every','毎ターン'],['two','2ターンごと'],['three','3ターンごと'],['random','ランダム30%'],['hp70','HP70%未満'],['hp40','HP40%未満'],['hp20','HP20%未満']];
function tokSlots(x){if(!Array.isArray(x.grenadeSlots))x.grenadeSlots=Array(6).fill(null);if(x.grenadeSlots.length>6)x.grenadeSlots.length=6;while(x.grenadeSlots.length<6)x.grenadeSlots.push(null);return x.grenadeSlots}
function tokGrenadeSlotChange(i,id){if(g.status!=='base'||i<0||i>=6)return;const slots=tokSlots(g),old=slots[i];if(id!=='none'&&!TOK_GRENADES.includes(id))return;if(old===(id==='none'?null:id))return;if(id!=='none'&&activeCount(g.bank.supplies,id)-slots.filter(x=>x===id).length-(g.carry?.[id]||0)<=0){alert('倉庫の在庫が不足しています');tokKeepEquipmentScroll(()=>render());return}slots[i]=id==='none'?null:id;if(playerLoadoutSlots()>bankCarrySlots()){slots[i]=old;alert('バッグ容量が不足しています');tokKeepEquipmentScroll(()=>render());return}save();tokKeepEquipmentScroll(()=>render())}
function tokInjuryChance(id){if(['knife','hatchet','machete','sakura','death','shadow'].some(x=>id?.includes(x)))return [.20,.03,.03];if(['hammer','bulldozer'].some(x=>id?.includes(x)))return [.05,.12,.12];const w=W[id];if(!w)return [.08,.03,.03];if(smgWeapon(id))return [.05,.02,.02];if(['mosin','svd','sks','scarh','hawkeye','huntress','queenbee'].includes(id))return [.15,.06,.06];if(['mp133','mp153','saiga12','sweeper'].includes(id))return [.12,.05,.05];if(AKIMBO_HANDGUNS.has(id))return [.08,.03,.03];return [.10,.04,.04]}
function tokInjury(r,target,weapon,head){if(head)return;const chances=tokInjuryChance(weapon).map(p=>target===r&&r.longMode?p*.5:p);if(roll(r,chances[0])&&!target.bleed&&(target===r?!tokSetBonuses(r).bleedImmune:!tokEnemySet(target).bleedImmune&&!tokEnemySet(target).statusImmune)){target.bleed=true;log(r,`【出血】${target===r?'PMC':target.n}に出血発生`)}if(roll(r,chances[1])&&!target.armBroken&&(target===r||!tokEnemySet(target).statusImmune)){target.armBroken=true;log(r,`【腕骨折】${target===r?'PMC':target.n}：命中−15pt・回避−10pt`)}if(roll(r,chances[2])&&!target.legBroken&&(target===r||!tokEnemySet(target).statusImmune)){target.legBroken=true;log(r,`【足骨折】${target===r?'PMC':target.n}：回避−20pt${target===r?'・脱出＋2':''}`)}}
function tokInjuryDebuff(x){return (x?.armBroken?10:0)+(x?.legBroken?20:0)}
function tokAutoTreat(r){if(r.armBroken||r.legBroken){if((r.supplies?.splint||0)>0){r.supplies.splint--;if(r.legBroken){r.legBroken=false;if(r.phase==='extract'&&r.legExtractExtra){r.required=Math.max(r.progress,r.required-2);r.legExtractExtra=false}log(r,'【治療】副木で足骨折を治療')}else{r.armBroken=false;log(r,'【治療】副木で腕骨折を治療')}}}if(r.burnTurns>0&&(r.supplies?.burnmed||0)>0){r.supplies.burnmed--;r.burnTurns=0;log(r,'【治療】火傷治療薬を使用')}}
function tokTickBurn(r,target){if((target.burnTurns||0)>0){target.hp=Math.max(0,target.hp-2);target.burnTurns--;log(r,`【火傷】${target===r?'PMC':target.n} -2HP（残り${target.burnTurns}ターン）`)}}
function tokGrenadeTiming(r){const t=r.settings?.grenadeTiming||'start',n=r.grenadeActionCount||1;const hp=r.hp/Math.max(1,maxRaidHp(r));return t==='every'||(t==='start'&&n===1)||(t==='two'&&n%2===0)||(t==='three'&&n%3===0)||(t==='random'&&roll(r,.30))||(t==='hp70'&&hp<.70)||(t==='hp40'&&hp<.40)||(t==='hp20'&&hp<.20)}
function ammoSlots(ammo,loaded){let slots=0;for(const [cal,n] of Object.entries(ammo||{}))slots+=Math.ceil(Math.max(0,(n||0)-(loaded?.[cal]||0))/30);return slots}
function supplySlots(items){return Object.entries(items||{}).reduce((v,[id,n])=>v+(ITEMS[id]?.slots||0)*n,0)}
function bagWearPenalty(x){
 if(!x||x.type!=='bag')return 0;
 const original=repairOriginalMax(x);
 if(!original)return 0;
 const ratio=Math.max(0,Number(x.dur??repairMax(x)))/original;
 return ratio<=.2?5:ratio<=.5?3:ratio<=.8?1:0;
}
function effectiveBagCapacity(x){return x?Math.max(0,(B[x.base]?.kg||0)+gearVal(x,'capacity')-bagWearPenalty(x)):0}
function backpackCap(r){return effectiveBagCapacity(raidGear(r,'bag'))}
function bankCarrySlots(){return effectiveBagCapacity(equippedGear('bag'))}
function equippedAmmoCalibers(){return [...new Set([equippedGear('weapon'),findGear(g.eqIds.secondary)].filter(Boolean).map(x=>W[x.base]?.ammo).filter(Boolean))]}
function requestedAmmo(cal){
 // v3.6.96: one-time correction of legacy automatic 100-round carry settings.
 // A player may explicitly choose 100+ rounds again after migration.
 if(!g.ammoCarry30Migrated){
  g.ammoCarry=g.ammoCarry||{};
  for(const key of Object.keys(g.ammoCarry))if(g.ammoCarry[key]===100)g.ammoCarry[key]=30;
  g.ammoCarry30Migrated=true;
 }
 const stock=activeCount(g.bank.ammo,cal),saved=g.ammoCarry?.[cal];
 return Math.min(stock,Math.max(0,Math.floor(Number.isFinite(saved)?saved:Math.min(30,stock))));
}
function bankReservedAmmo(){let result={};for(const cal of equippedAmmoCalibers())result[cal]=requestedAmmo(cal);return result}
function tokKeepEquipmentScroll(fn){const keep=tab==='stash'&&v3Section.stash==='equipment';const y=keep?window.scrollY:0;fn();if(keep)requestAnimationFrame(()=>window.scrollTo(0,y))}
function setAmmoCarry(cal,change){if(g.status!=='base'||!AM[cal]||!equippedAmmoCalibers().includes(cal))return;const stock=activeCount(g.bank.ammo,cal);const prev=requestedAmmo(cal);const next=clamp(change==='max'?stock:change==='none'?0:prev+Number(change),0,stock);g.ammoCarry=g.ammoCarry||{};g.ammoCarry[cal]=next;if(playerLoadoutSlots()>bankCarrySlots()){g.ammoCarry[cal]=prev;alert('バッグ容量が不足しています。携行弾薬数を減らしてください。');return}save();tokKeepEquipmentScroll(()=>render())}

function playerLoadoutSlots(){const ammo=bankReservedAmmo();const loaded={};for(const cal of Object.keys(ammo))loaded[cal]=Math.min(30,ammo[cal]);return ammoSlots(ammo,loaded)+supplySlots(g.carry)+tokSlots(g).filter(Boolean).length}
function raidCarrySlots(r){const available=r.ammoByCaliber||{};const current={...available};if(W[r.weapon]?.ammo)current[W[r.weapon].ammo]=r.ammo;return ammoSlots(current,r.loadedAmmo||{})+supplySlots(r.supplies)+(r.grenadeSlots||[]).filter(Boolean).length+Math.ceil((lootWeight(r)+gearCarryWeight(r))/1000)}
function raidUsedSlots(r){return Math.ceil((lootWeight(r)+gearCarryWeight(r))/1000)+supplySlots(r.supplies)+(r.grenadeSlots||[]).filter(Boolean).length+ammoSlots(r.ammoByCaliber||{},r.loadedAmmo||{})}
function raidSlotsFree(r){return backpackCap(r)-raidUsedSlots(r)}
function medChoice(r){const it=r.supplies||{},hp=r.hp/maxRaidHp(r)*100;if(hp<=30){if(it.advanced)return 'advanced';if(it.med)return 'med';if(r.bleed&&it.bandage)return 'bandage';return null}if(r.bleed){if(it.bandage)return 'bandage';if(it.advanced)return 'advanced'}if(hp<=50){if(it.med)return 'med';if(it.advanced)return 'advanced'}return null}
function maxRaidHp(r){return baseMaxHp()+raidVal(r,'armor','maxhp')+tokSetBonuses(r).maxhp}
function useMedical(r,phase){if(r.v19Legacy)return false;const item=medChoice(r);if(!item)return false;r.supplies[item]--;if(item==='med')r.hp=Math.min(maxRaidHp(r),r.hp+30);if(item==='advanced'){r.hp=Math.min(maxRaidHp(r),r.hp+70);r.bleed=false}if(item==='bandage')r.bleed=false;log(r,`【医療】${ITEMS[item].n}を自動使用（${phase}、残HP${r.hp}）`);return true}
function outsideCare(r,phase){if(r.v19Legacy)return;tokAutoTreat(r);useMedical(r,phase);if(r.bleed&&!tokSetBonuses(r).bleedImmune){r.hp=Math.max(0,r.hp-1);log(r,`出血：-${1}HP（${phase}）`)}}
function turnCare(r){if(r.v19Legacy)return;if(r.smokeTurns>0)r.smokeTurns--;if(r.poisonTurns>0&&!tokSetBonuses(r).statusImmune){const n=Math.max(3,Math.floor(maxRaidHp(r)*.05));const applied=Math.max(1,Math.floor(n*(r.poisonDamageMultiplier||1)));r.hp=Math.max(0,r.hp-applied);r.poisonTurns--;if(r.poisonTurns<=0)r.poisonDamageMultiplier=1;log(r,`毒：-${applied}HP`)}tokTickBurn(r,r);tokAutoTreat(r);useMedical(r,'戦闘');if(r.bleed&&!tokSetBonuses(r).bleedImmune){r.hp=Math.max(0,r.hp-3);log(r,'出血：-3HP（戦闘）')}}
function enemyKind(e){return e?.id?.startsWith('scav')?'scav':e?.id?.startsWith('raider')?'raider':e?.id?.startsWith('elite')?'elite':e?.n==='SCAV'?'scav':e?.n==='RAIDER'?'raider':e?.n==='ELITE'?'elite':'boss'}
function tokSmokeDeploy(r){r.smokeTurns=3;}
function tokThermal(r,unit,isPlayer){if(isPlayer)return raidGear(r,'helmet')?.base==='thermal_goggles'||attInstalled(raidGear(r,r.activeSlot||'weapon')).some(a=>a.base==='thermal_scope');return unit?.helmetId==='thermal_goggles'||attInstalled(unit?.enemyGear).some(a=>a.base==='thermal_scope');}
function tokSmokePenalty(r,unit,isPlayer){return (r?.smokeTurns||0)>0&&!tokThermal(r,unit,isPlayer)?30:0;}
function tokFlashPenalty(r,unit,isPlayer){return flashPenalty(unit)+(flashPenalty(unit)>0&&tokThermal(r,unit,isPlayer)?40:0);}
function flashPenalty(e){const turn=e?.flashTurns||0;return turn===3?40:turn===2?25:turn===1?10:0}
function flashAdvance(units){for(const u of units)if(u.flashTurns>0)u.flashTurns--}
// Normal enemies carry at most one grenade; throwing replaces their normal attack.
const TOK_ENEMY_GRENADE={scav:{carry:.05,throw:.10,types:['frag','smoke']},raider:{carry:.20,throw:.20,types:['frag','flash','smoke']},elite:{carry:.35,throw:.30,types:['frag','flash','molotov','gas','smoke']}};
function tokEnemyAssignGrenade(r,unit){const config=TOK_ENEMY_GRENADE[unit.kind];unit.enemyGrenade=config&&roll(r,config.carry)?pick(r,config.types):null;unit.enemyGrenadeThrown=false}
function tokEnemyThrowGrenade(r,unit){const config=TOK_ENEMY_GRENADE[unit.kind];if(!config||!unit.enemyGrenade||unit.enemyGrenadeThrown||!roll(r,config.throw))return false;
 unit.enemyGrenadeThrown=true;const type=unit.enemyGrenade;log(r,`【敵グレネード】${unit.n}が${({frag:'フラグ',flash:'フラッシュ',molotov:'モロトフ',gas:'ガス',smoke:'スモーク'})[type]}を投擲（通常攻撃なし）`);
 if(type==='smoke'){tokSmokeDeploy(r);log(r,'煙幕展開：このラウンドを含め3ラウンド、敵味方命中率−30pt');return true;} const chance={frag:.70,flash:.60,molotov:.65,gas:.60}[type];if(!roll(r,chance)){log(r,'PMCはグレネードを回避した');return true}
 if(type==='frag'){const raw=40+Math.floor(rand(r)*36),damage=Math.max(1,Math.floor(dmg(raw,(A[raidGear(r,'armor')?.base]?.def||0),35,r)));r.hp=Math.max(0,r.hp-damage);log(r,`フラグ命中：-${damage}HP`)}
 if(type==='flash'){r.flashTurns=Math.max(r.flashTurns||0,3);log(r,'フラッシュ命中：3ターンの命中妨害')}
 if(type==='molotov'){r.hp=Math.max(0,r.hp-(8+Math.floor(rand(r)*8)));if(!tokSetBonuses(r).statusImmune)r.burnTurns=Math.max(r.burnTurns||0,4);log(r,'モロトフ命中：ダメージと火傷')}
 if(type==='gas'){if(!tokSetBonuses(r).statusImmune){r.poisonTurns=Math.max(r.poisonTurns||0,4);r.poisonDamageMultiplier=1;}log(r,'ガス命中：毒4ターン')}
 return true;
}
function grenadeAllowed(r,enemies,kind){const policy=r.settings?.grenadePolicy||'groups';if(policy==='save')return kind==='boss';if(policy==='groups')return enemies.length>=2||kind==='boss';if(policy==='strong')return kind!=='scav';return true}
function throwGrenade(r,units,kind){
 if(r.v19Legacy)return false;
 r.grenadeActionCount=(r.grenadeActionCount||0)+1;
 const alive=units.filter(u=>u.hp>0);
 if(!alive.length||!grenadeAllowed(r,alive,kind)||!tokGrenadeTiming(r))return false;
 const slots=r.grenadeSlots||[];let i=slots.findIndex(Boolean);if(i<0)return false;
 const id=slots[i];slots[i]=null;
 log(r,`【投擲 ${r.grenadeActionCount}回目】スロット${i+1}：${ITEMS[id].n}`);
 if(id==='smoke'){tokSmokeDeploy(r);log(r,'煙幕展開：このラウンドを含め3ラウンド、敵味方命中率−30pt');return true;}
 const hitRates={frag:[.80,.70,.60,.55],flash:[.60,.45,.35,.25],molotov:[.75,.65,.55,.50],gas:[.70,.60,.50,.45]};
 const index={scav:0,raider:1,elite:2,boss:3};
 for(const u of alive){
  let chance=hitRates[id][index[enemyKind(u)]??3];
  if(raidGear(r,'bag')?.base==='bombbag')chance+=.15;
  if(!roll(r,chance)){log(r,`${u.n}：${id==='flash'?'フラッシュ回避':'投擲回避'}`);continue}
  if(id==='frag'){const raw=40+Math.floor(rand(r)*36);const damage=Math.max(1,Math.floor(dmg(raw,u.def||0,35,r)));u.hp=Math.max(0,u.hp-damage);log(r,`${u.n}に爆発${damage}ダメージ`);if(u.hp<=0){r.kills++;r.xp+=u.xp||0;log(r,`${u.n}を爆発で撃破`)}}
  if(id==='flash'&&!tokEnemySet(u).statusImmune){u.flashTurns=3;log(r,`${u.n}：フラッシュ成功（3ターン）`)}
  if(id==='molotov'){const damage=8+Math.floor(rand(r)*8);u.hp=Math.max(0,u.hp-damage);if(!tokEnemySet(u).statusImmune)u.burnTurns=3;log(r,`${u.n}：モロトフ ${damage}ダメージ・火傷3ターン`);if(u.hp<=0){r.kills++;r.xp+=u.xp||0}}
  if(id==='gas'&&!tokEnemySet(u).statusImmune){u.poisonTurns=4;log(r,`${u.n}：毒4ターン（確定付与）`)}
 }
 return true;
}
function bonusDrop(r,kind){if(r.v19Legacy)return;const rate={explore:.28,scav:.16,raider:.24,elite:.30,boss:.45}[kind]||0;const factor=kind==='boss'?1:(r.longMode?.60:.85);if(!roll(r,rate*factor*(kind==='boss'?1:.90)))return;if(roll(r,.35)){const cal=pick(r,Object.keys(AM));const qty=5+Math.floor(rand(r)*11);acquireLootAmmo(r,cal,qty,'追加戦利品');return;}let needle=rand(r)*Object.values(SUPPLY_WEIGHTS).reduce((a,b)=>a+b,0),id='bandage';for(const [k,v] of Object.entries(SUPPLY_WEIGHTS)){needle-=v;if(needle<0){id=k;break}}
 acquireSupply(r,id,1,'追加戦利品')}
function acquireLootAmmo(r,cal,n,source){if(!AM[cal]||n<=0)return false;r.ammoByCaliber=r.ammoByCaliber||{};const primary=W[r.weapon]?.ammo===cal;const old=primary?(r.ammo||0):(r.ammoByCaliber[cal]||0);if(primary){r.ammo=old+n;r.ammoByCaliber[cal]=old+n;}else r.ammoByCaliber[cal]=old+n;if(raidUsedSlots(r)>backpackCap(r)){if(primary)r.ammo=old;r.ammoByCaliber[cal]=old;log(r,`${source}：${AM[cal].n}×${n}を発見、バッグ容量不足`);return false}r.lootAcquired=true;log(r,`${source}：${AM[cal].n}×${n}発を回収`);return true}
function acquireSupply(r,id,n,source){if(!ITEMS[id])return false;const size=ITEMS[id].slots*n;if(raidSlotsFree(r)<size){log(r,`${source}：${ITEMS[id].n}を発見、バッグ容量不足`);return false}r.supplies[id]=(r.supplies[id]||0)+n;r.lootAcquired=true;log(r,`${source}：${ITEMS[id].n}×${n}を回収`);return true}
function repairOriginalMax(x){return x.type==='weapon'?(W[x.base]?.max||100):x.type==='helmet'?H[x.base]?.max||0:x.type==='armor'?(A[x.base]?.max||0)+gearVal(x,'durability'):x.type==='bag'?(B[x.base]?.max||80):0}
function repairMax(x){const original=repairOriginalMax(x);return original?Math.max(0,Math.min(original,Number.isFinite(x.maxDur)?x.maxDur:original)):0}
const REPAIR_WEAR={common:.08,uncommon:.07,rare:.06,epic:.05,legendary:.04,boss:.04};
function repairLoss(x){return Math.max(1,Math.ceil(repairOriginalMax(x)*(REPAIR_WEAR[x.rarity]??.08)))}
function repairNextMax(x){return Math.max(0,repairMax(x)-repairLoss(x))}
function repairAvailable(x){return repairMax(x)>repairOriginalMax(x)*.2&&repairNextMax(x)>repairOriginalMax(x)*.2}

function repairPrice(x){const max=repairMax(x);if(!max||!repairAvailable(x)||((x.dur??max)>=max))return 0;return Math.max(1,Math.ceil((GEARTYPE[x.type]?.[x.base]?.price||0)*Math.max(0,max-(x.dur??max))/Math.max(1,repairOriginalMax(x))*.3))}
function weaponWear(r,slot){const item=r.equipment?.[slot];if(!item||r.v19Legacy)return;r.weaponWearCounts??={};const key=String(item.id||slot);r.weaponWearCounts[key]=(r.weaponWearCounts[key]||0)+1;if(r.weaponWearCounts[key]%2!==0)return;item.dur=Math.max(0,(item.dur??100)-1);if(item.dur===0)log(r,`【破損】${gearName(item)}が故障！ 次の行動から別の武器を使用`)}

function bagLoad(r){return r.v19Legacy?lootWeight(r)+gearCarryWeight(r):raidUsedSlots(r)*1000}
function bagPenalty(r){const frac=bagLoad(r)/Math.max(1,bagCapacity(r));return Math.max(0,(frac>.8?20:frac>.5?10:0)-raidVal(r,'bag','load'))}


// PHASE 1 — distance-based combat. Fixed distance for a single encounter, sampled from raid RNG.
const DIST_LABEL=['近距離','中距離','遠距離'];
const RANGE_RULES={
  knife:[24,-35,-55],hatchet:[20,-40,-60],machete:[22,-35,-58],
 pm:[10,-8,-26],tt:[8,-8,-24],gunslinger:[12,-7,-27],
 pp19:[15,3,-23],phantom:[16,4,-22],gamma:[16,4,-22],
 aks:[10,10,-13],ak:[2,12,3],alpha:[4,12,-4],zero:[3,12,6],
 sks:[-18,10,16],hawkeye:[-24,5,20],queenbee:[-19,9,17],
 sweeper:[20,-18,-40],viper:[12,8,-24],
  kedr:[16,0,-25],mp5:[16,5,-23],pps43:[18,-2,-28],p90:[17,3,-18],
  ak105:[14,10,-12],m4a1:[7,12,2],aug:[-8,13,17],adar:[-12,12,15],
  rpk74:[2,11,3],vpo136:[-8,13,7],scarh:[-8,12,14],mosin:[-28,-4,24],svd:[-22,8,21],
  mp133:[25,-20,-46],mp153:[23,-16,-43],saiga12:[25,-16,-42]
};
// v2.1.4 improvement 03: shotgun close-range specialization.
const SHOTGUN_IDS=new Set(['mp133','mp153','saiga12','sweeper']);
function shotgunDamageMultiplier(id,dist){return SHOTGUN_IDS.has(id)?[1.40,.90,.50][dist]||.90:1}
function shotgunCloseAccuracy(id,dist){return SHOTGUN_IDS.has(id)&&dist===0?10:0}
function weaponRangeBonus(id,dist){return (RANGE_RULES[id]||[0,0,0])[dist]||0}
function distanceRoll(r,mapId){const v=rand(r),mid=['metro','hospital','mall','police'].includes(mapId)?[.54,.37]:['port','airport','tower','lab'].includes(mapId)?[.18,.40]:[.38,.40];return v<mid[0]?0:v<mid[0]+mid[1]?1:2}
function hasCombatWeapon(r){return primaryAndSecondary(r).some(x=>(x.dur??100)>0&&(W[x.base].melee||W[x.base].ammoFree||(r.ammoByCaliber?.[W[x.base].ammo]||0)>0))||!!meleeRaidGear(r)}
function totalRaidAmmo(r){if(!r.ammoByCaliber)return Math.max(0,r.ammo||0);if(W[r.weapon]?.ammo)r.ammoByCaliber[W[r.weapon].ammo]=r.ammo;return Object.values(r.ammoByCaliber).reduce((t,n)=>t+Math.max(0,n||0),0)}
function primaryAndSecondary(r){return [r.equipment?.weapon,r.equipment?.secondary].filter(x=>x&&W[x.base])}
function meleeRaidGear(r){return r.equipment?.melee&&(r.equipment.melee.dur??100)>0&&W[r.equipment.melee.base]?.melee?r.equipment.melee:null}
function tokChainOnHit(r,e){
 if(raidGear(r,'accessory')?.base!=='binding_chain'||!e||e.hp<=0||e._chainBound||e._chainPending||!roll(r,.10))return;
 e._chainPending=1;log(r,`【拘束の鎖】${e.n}を拘束！ 次ラウンドの能動行動を封じる`);
}
function tokChainEnemySkip(r,e){
 if(e._chainBound){e._chainBound=0;log(r,`【拘束の鎖】${e.n}は拘束され行動できない`);return true;}
 if(e._chainPending){e._chainPending=0;e._chainBound=1;}
 return false;
}
function tokChainsawAttack(r,e,dist,enemyHP){
 const mg=raidGear(r,'weapon');if(!mg||mg.base!=='chainsaw'||(mg.dur??0)<=0)return 0;
 const w=W.chainsaw,closeChance=dist===0?1:dist===1?.40:.12;
 // Two independent hits; durability wear only once per attack action.
 weaponWear(r,'weapon');
 if(!roll(r,closeChance)){log(r,'チェーンソー：間合いに入れず攻撃失敗');return 0;}
 let total=0;
 for(let i=0;i<2&&total<enemyHP;i++){
  const chance=clamp(62+w.a+gearVal(mg,'accuracy')+levelAccuracyBonus()+tokSetBonuses(r).accuracy+tokAccessoryBonus(r,'accuracy')+tokPmcStyle(r).hit-(r.armBroken?15:0)-(r.burnTurns>0?10:0)-tokFlashPenalty(r,r,true)-tokSmokePenalty(r,r,true)-e.ev+tokInjuryDebuff(e),8,92);
  if(!roll(r,chance/100)){log(r,`チェーンソー ${i+1}/2撃目：回避された`);continue;}
  const raw=Math.max(1,Math.floor(w.d*(1+(gearVal(mg,'damage')+tokSetBonuses(r).damage+tokAccessoryBonus(r,'attack'))/100)*(1+tokPmcStyle(r).damage/100)));
  const amount=dmg(raw,e.def,w.p+gearVal(mg,'penetration')+tokPmcStyle(r).pen+tokAccessoryBonus(r,'penetration'),r);
  total+=amount;
  if(!e.bleed&&!tokEnemySet(e).bleedImmune&&!tokEnemySet(e).statusImmune&&roll(r,.10))applyEnemyBleed(r,e);
  tokChainOnHit(r,e);
  log(r,`チェーンソー ${i+1}/2撃目：${amount}ダメージ`);
 }
 return total;
}
function meleeAttack(r,e,dist){
 const mg=meleeRaidGear(r);if(!mg)return 0;
 const w=W[mg.base];const closeChance=dist===0?1:dist===1?.40:.12;
 if(!roll(r,closeChance)){log(r,`${w.n}：間合いに入れず攻撃失敗（${DIST_LABEL[dist]}）`);return 0}
 const chance=clamp(62+w.a+gearVal(mg,'accuracy')+levelAccuracyBonus()+tokSetBonuses(r).accuracy+tokAccessoryBonus(r,'accuracy')+tokPmcStyle(r).hit-(r.armBroken?15:0)-(r.burnTurns>0?10:0)-tokFlashPenalty(r,r,true)-tokSmokePenalty(r,r,true)-e.ev+tokInjuryDebuff(e),8,92);
 const meleeRoll=rand(r);if(meleeRoll>=chance/100){if(e._sakuraBoss&&meleeRoll<Math.min(1,(chance+e.ev)/100))e._sakuraDodged=true;weaponWear(r,'melee');log(r,`${w.n}：近接攻撃を回避された`);return 0}
 const raw=Math.max(1,Math.floor(w.d*(1+(gearVal(mg,'damage')+tokSetBonuses(r).damage+tokAccessoryBonus(r,'attack'))/100)*(1+tokPmcStyle(r).damage/100)));const amount=dmg(raw,e.def,w.p+gearVal(mg,'penetration')+tokPmcStyle(r).pen+tokAccessoryBonus(r,'penetration'),r);if(raidGear(r,'helmet')?.base==='tiger_helmet'&&roll(r,.10))applyEnemyBleed(r,e);
 tokInjury(r,e,mg.base,false);tokChainOnHit(r,e);if(mg.base==='poison_scalpel'&&amount>0&&roll(r,.30))applyEnemyPoison(r,e);weaponWear(r,'melee');log(r,`${w.n}で近接攻撃 → ${amount}ダメージ（弾薬消費なし）`);return amount;
}
const AKIMBO_HANDGUNS=new Set(['pm','tt','glock17','deserteagle','gunslinger','kongou']);
function akimboEnabled(r){const a=r.equipment?.weapon,b=r.equipment?.secondary;return !!(a&&b&&AKIMBO_HANDGUNS.has(a.base)&&AKIMBO_HANDGUNS.has(b.base));}
function chooseWeapon(r,enemy,dist){
 if(r._akimboForcedSlot){const slot=r._akimboForcedSlot;const x=r.equipment?.[slot];if(!x||!W[x.base]||(x.dur??100)<=0)return false;r.activeSlot=slot;r.weapon=x.base;r.ammo=r.ammoByCaliber?.[W[x.base].ammo]||0;return r.ammo>0;}
 if(!r.ammoByCaliber)r.ammoByCaliber=W[r.weapon]?.ammo?{[W[r.weapon].ammo]:r.ammo||0}:{};
 if(W[r.weapon]?.ammo)r.ammoByCaliber[W[r.weapon].ammo]=Math.max(0,r.ammo||0);
 const firearms=primaryAndSecondary(r).filter(x=>(!W[x.base].melee||x.base==='chainsaw')&&(x.dur??100)>0&&(W[x.base].ammoFree||(r.ammoByCaliber[W[x.base].ammo]||0)>0));
 const score=x=>{const w=W[x.base];const bonus=weaponRangeBonus(x.base,dist);
  const hit=clamp(60+w.a+bonus+gearVal(x,'accuracy')-enemy.ev,5,95);
  return hit*dmg(w.d,enemy.def,w.p)*(w.shots||1)*.01;
 };
 firearms.sort((a,b)=>score(b)-score(a));const best=firearms[0];
 const mg=meleeRaidGear(r);const meleeScore=mg?((dist===0?1:dist===1?.4:.12)*clamp(62+W[mg.base].a+gearVal(mg,'accuracy')-enemy.ev,8,92)*dmg(W[mg.base].d,enemy.def,W[mg.base].p)/100):0;
 if(mg&&(!best||meleeScore>score(best)*1.08)){
  if(r.activeSlot!=='melee')log(r,`自動切替：${W[mg.base].n}（近接）`);
  r.activeSlot='melee';return true;
 }
 if(!best)return false;
 const nextSlot=best===r.equipment?.secondary?'secondary':'weapon';
 if(best.base!==r.weapon||r.activeSlot!==nextSlot)log(r,`自動切替：${W[best.base].n}（${DIST_LABEL[dist]}）`);
 r.weapon=best.base;r.activeSlot=nextSlot;r.ammo=W[r.weapon].ammoFree?999999:(r.ammoByCaliber[W[r.weapon].ammo]||0);return true;
}

function groupAttackPolicy(r,units){
 const policy=r.settings.targetPriority||'lowhp';
 const alive=units.filter(u=>u.hp>0);
 if(!alive.length)return null;
 const hp=u=>Number(u.hp)||0;
 const dist=u=>Number.isFinite(Number(u.dist))?Number(u.dist):1;
 const damage=u=>Number(u.d??u.atk??u.attack)||0;
 if(policy==='nearest')return [...alive].sort((a,b)=>dist(a)-dist(b)||hp(a)-hp(b))[0];
 if(policy==='threat')return [...alive].sort((a,b)=>damage(b)-damage(a)||hp(a)-hp(b))[0];
