function playerReloadTurn(r,slots){
 if(!r._playerReloadCycles)r._playerReloadCycles={};
 const entries=slots.map(slot=>{
  const x=r.equipment?.[slot],w=x&&W[x.base];
  if(!w||w.melee||w.ammoFree)return null;
  const id=x.id||x.base;
  let state=r._playerReloadCycles[slot];
  if(!state||state.id!==id)state=r._playerReloadCycles[slot]={id,actions:0};
  return {slot,w,state};
 }).filter(Boolean);
 if(!entries.length)return false;
 if(entries.some(({slot,w,state})=>state.actions>=Math.max(1,(w===W.machinegun?1:reloadAttackLimit(w)+attEffect(r.equipment?.[slot],'magazine')-(tokPmcStyleId(r)==='triggerhappy'?1:0))))){
  for(const {state} of entries)state.actions=0;
  log(r,slots.length>1?'【アキンボ】2丁を同時リロード（1ターン・攻撃なし）':'【リロード】攻撃休止（1ターン）');
  return true;
 }
 for(const {state} of entries)state.actions++;
 return false;
}
