// v3.5.73: Reload between encounters, with a 5% chance of forgetting.
// This resets the action-based magazine cycle, not carried ammunition.
function tokPrepareEncounterReload(r){
 if(!r._playerReloadCycles)r._playerReloadCycles={};
 const cycles=r._playerReloadCycles;
 const slots=['weapon','secondary'];
 const firearms=slots.map(slot=>{
  const gear=r.equipment?.[slot],w=gear&&W[gear.base];
  if(!w||w.melee||w.ammoFree)return null;
  const id=gear.id||gear.base;
  if(!cycles[slot]||cycles[slot].id!==id)cycles[slot]={id,actions:0};
  return {slot,w,state:cycles[slot]};
 }).filter(Boolean);
 // The first encounter has no preceding battle in which a reload could be forgotten.
 const hadPrior=r._tokReloadEncounterSeen===true;
 r._tokReloadEncounterSeen=true;
 if(!firearms.length)return;
 if(hadPrior&&roll(r,.05)){
  const remaining=firearms.filter(({state})=>state.actions>0);
  if(remaining.length){
   log(r,'【装填忘れ】警戒に気を取られ、リロードを忘れた！ 前戦闘の装填状態を引き継ぐ。');
  }else{
   log(r,'【装填忘れ】リロードを忘れたが、武器はすでに装填済みだった。');
  }
  return;
 }
 for(const {state} of firearms)state.actions=0;
 // Revolver cylinder tracks its own reload cycle.
