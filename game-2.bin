const WEAPON_FIXED={'glock17':'クイックドロー：戦闘開始時の初弾命中+10pt', 'deserteagle':'マグナムインパクト：胴体命中時のダメージ+10%', 'pm':'携帯性：初弾命中+8pt', 'tt':'硬芯弾：実効貫通力+5', 'pp19':'連射制御：2発目以降の命中減衰を2pt軽減', 'aks':'短銃身：近距離命中+8pt', 'ak':'標準制式：中距離命中+5pt', 'sks':'精密照準：遠距離命中+8pt', 'kedr': '超軽量：距離変更成功率+10pt', 'mp5': '低反動：2・3発目の連射減衰-5pt', 'pps43': '近接制圧：近距離で各弾威力+3', 'p90': '高密度連射：4・5発目の連射減衰-10pt', 'ak105': '機動戦：近距離命中+8pt', 'm4a1': '安定連射：3発目の連射減衰-5pt', 'aug': '精密射撃：遠距離命中+8pt、近距離-8pt', 'adar': '精密単発：ヘッドショット確率+3pt', 'rpk74': '持続連射：4発目の連射減衰-5pt', 'vpo136': '重い一撃：胴体ダメージ+15%', 'scarh': '装甲突破：貫通力+10', 'mosin': '狙撃の一撃：遠距離胴体ダメージ+15%', 'svd': '連続精密射撃：遠距離2発目の連射減衰-10pt', 'mp133': '至近距離の一撃：近距離ダメージ+20%', 'mp153': '連続散弾：近距離2発目の連射減衰-5pt', 'saiga12': '高速追撃：2発目の連射減衰-10pt'};
