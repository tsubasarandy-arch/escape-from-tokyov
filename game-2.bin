// v3.4.58: shared armor, headshot, penetration and enemy loadouts.
const ENEMY_ARMOR_CHANCES={scav:[40,45,14,1],raider:[10,20,50,20],elite:[0,10,35,55]};
const ENEMY_HELMET_CHANCES={scav:[60,30,9,1],raider:[20,20,45,15],elite:[5,10,35,50]};
const ENEMY_ARMOR_IDS=['none','light','standard','heavy'],ENEMY_HELMET_IDS=[null,'light','combat','heavy'];
function weightedEnemyGear(r,weights,ids){let x=rand(r)*100;for(let i=0;i<weights.length;i++){x-=weights[i];if(x<0)return ids[i]}return ids[ids.length-1]}
// v3.5.8 audit 3: enemy equipment variants use the existing weight-class draw.
// Within a drawn class, the base item and six existing variants are equally eligible.
function tokEnemyVariant(r,type,base){
 const pool=type==='armor'?A:type==='helmet'?H:B;
 const cls=type==='armor'?({light:'light',standard:'medium',heavy:'heavy'}[base]):type==='helmet'?({light:'light',combat:'medium',heavy:'heavy'}[base]):({small:'light',medium:'medium',large:'heavy'}[base]);
 if(!cls||!pool[base])return base;
