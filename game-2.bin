function tokEnemySet(u){
 const pieces=[['armor',u.armorId,u.armorDur],['helmet',u.helmetId,u.helmetDur],['bag',u.bagId,1]]
  .filter(([t,id,d])=>id&&(t==='bag'||d>0)).map(([t,id])=>({type:t,def:(t==='armor'?A:t==='helmet'?H:B)[id]})).filter(x=>x.def);
 const series={},weights={};
 for(const x of pieces){const sp=x.def.special,wt=x.def.weightClass;if(sp)series[sp]=(series[sp]||0)+1;if(wt)weights[wt]=(weights[wt]||0)+1;}
 const lvl=n=>n>=3?3:n>=2?2:0;
 const gh=lvl(series.dodge||0),tu=lvl(series.pen||0),go=lvl(series.shock||0),fo=lvl(series.loot||0),ph=lvl(series.wear||0),oc=lvl(series.all||0);
 const li=lvl(weights.light||0),me=lvl(weights.medium||0),he=lvl(weights.heavy||0);
 const sum=k=>pieces.reduce((v,x)=>v+(x.def.special===k?(x.def.specialValue||0):0),0);
 const all=pieces.filter(x=>x.def.special==='all').length;
 const bonuses={accuracy:(gh===3?7:gh===2?3:0)+(oc===3?4:oc===2?2:0),maxhp:(tu===3?15:tu===2?5:0)+(oc===3?8:oc===2?3:0)+(he===3?25:he===2?10:0),damage:go===3?8:go===2?3:0,foxRare:fo===3?10:fo===2?5:0,bleedImmune:ph>=2,statusImmune:ph===3,initiative:li===3?20:li===2?10:0,headshot:me===3?10:me===2?5:0,dodge:Math.min(20,sum('dodge')+all),pen:Math.min(25,sum('pen')),shock:Math.min(20,sum('shock')),wear:Math.min(40,sum('wear'))};
 // Ordinary enemies receive 70% of numeric set bonuses; bosses retain full bonuses.
 if(u.kind!=='boss')for(const key of Object.keys(bonuses)){
  if(typeof bonuses[key]==='number')bonuses[key]=Math.floor(bonuses[key]*.70);
