 const reason=enemyHP-dealt<=0&&shots<planned?'・途中撃破':shots<planned?'・弾薬または耐久不足':'';
 log(r,`${w.n}：${planned}連射予定 → 実射${shots}発${reason} → ${dealt}ダメージ（弾残${r.ammo}／次段階${r.minigunCycle===4?'冷却':(2*(r.minigunCycle+1))+'連射'}）`);
}else log(r,w.ammoFree?`${w.n} ${shots}回攻撃 → ${dealt}ダメージ（弾薬消費なし）`:`${w.n} ${shots}発射 → ${dealt}ダメージ（弾残${r.ammo}）`);r._deferHitStatus=false;flushHitStatus(r);if(headshotCount)log(r,`【ヘッドショット】敵の頭部に命中${headshotCount>1?`（${headshotCount}回）`:''}`);return dealt}

function playerAttack(r,e,enemyHP){
 if(!akimboEnabled(r))return playerAttackSingle(r,e,enemyHP);
 if(!r.ammoByCaliber)r.ammoByCaliber={};
 // Akimbo follows the same attack-turn reload cadence as other firearms.
 const slots=['weapon','secondary'];
 if(playerReloadTurn(r,slots))return 0;
 const available=slots.filter(slot=>{const x=r.equipment[slot];return x&&(x.dur??100)>0&&(r.ammoByCaliber[W[x.base].ammo]||0)>0;});
 if(!available.length){log(r,'【アキンボ】射撃可能な弾薬がありません');return 0;}
 let dealt=0;
 const originalSlot=r.activeSlot,originalWeapon=r.weapon;
 try{
  for(const slot of slots){
   if(enemyHP-dealt<=0)break;
   const x=r.equipment[slot],cal=W[x.base].ammo;
   if((x.dur??100)<=0||(r.ammoByCaliber[cal]||0)<=0)continue;
   r._akimboForcedSlot=slot;r.activeSlot=slot;r.weapon=x.base;r.ammo=r.ammoByCaliber[cal]||0;
   dealt+=playerAttackSingle(r,e,enemyHP-dealt);
   r.ammoByCaliber[cal]=r.ammo;
  }
 }finally{
  delete r._akimboForcedSlot;
  r.activeSlot=originalSlot||'weapon';r.weapon=originalWeapon;
  if(W[r.weapon]?.ammo)r.ammo=r.ammoByCaliber[W[r.weapon].ammo]||0;
 }
 return dealt;
}
function escapeCombat(r,e){const special=raidGear(r,'weapon')?.rarity==='legendary'&&r.weapon==='aks'?5:0;const chance=clamp(70-e.pursuit+(raidGear(r,'weapon')?.base==='phantom'?5:0)-bagPenalty(r)+tokArmorMobility(r).escape+raidVal(r,'weapon','escape')+raidVal(r,'armor','escape')+raidVal(r,'bag','escape')+special,15,90);for(let i=0;i<3;i++){if(roll(r,chance/100)){log(r,`敵から離脱成功（${chance}%）`);return 'escaped'}log(r,`離脱失敗 ${i+1}/3`);enemyStrike(r,e);if(r.hp<=0)return 'dead'}log(r,'離脱に3回失敗。最終戦闘に移行');return 'final'}

// Opening initiative: a single surprise action per encounter. Scav scouts are less dangerous than elite raiders.
function openingInitiative(r,units,eid){
 r.smokeTurns=0;
 log(r,'【開戦判定】先制攻撃・奇襲の判定');
 const base={scav:[.20,.09],raider:[.14,.16],elite:[.10,.14]}[eid]||[.14,.12];
 const value=rand(r);const heavy=r.equipment?.helmet?.base==='heavy'?.05:0;const initiative=tokSetBonuses(r).initiative/100;if(value<Math.max(0,base[0]-heavy+initiative)){
  const target=groupAttackPolicy(r,units);
  log(r,`【先制攻撃・追加行動】敵より先に行動！ ${target.n}を攻撃`);
  target.hp-=playerAttack(r,target,target.hp);
  if(target.hp<=0){normalKillReward(r,target,eid)}
 }else if(value<base[0]+base[1]){
  const aggressor=units[0];  log(r,`【敵の強襲攻撃】${aggressor.n}が奇襲！（戦闘開始前の先制行動）`);
  enemyStrike(r,{...aggressor,hit:Math.max(5,aggressor.hit-8+normalAimModifier(aggressor,r.combatDistance))});
 }
}
function districtEnemyPenBonus(map){return ({suburban:0,industrial:0,metro:0,school:0,hospital:5,mall:5,zoo:5,park:5,temple:5,airport:10,port:10,tower:10,police:10,power:15,lab:20})[map]||0}function districtEncounterMultiplier(map){return ({suburban:1,industrial:1,metro:1,school:1,hospital:1.10,mall:1.10,zoo:1.10,park:1.10,temple:1.10,airport:1.20,port:1.20,tower:1.20,police:1.20,power:1.30,lab:1.40})[map]||1}function battle(r,eid){tokPrepareEncounterReload(r);r._suppressEncounter=0;r.firstShotUsed=false;r.glockOpeningShotUsed=false;r.huntressTarget=null;r.minigunCycle=0;r.encounterGrenades=0;r.grenadeActionCount=0;r.normalCombatTurn=0;
 // Group encounter scales by map tier. Scavs can travel in pairs/trios, raiders sometimes in pairs; elites remain solo.
 const groupChance=eid==='scav'?.10:eid==='raider'?.05:0;
 // Military-only group size distributions, conditional on a normal encounter.
 // Ordinary raids retain their original group generation unchanged.
 const milGroupWeights=r?.militaryFloor?(
  r.militaryFloor<=4?[.98,.02,0]:
  r.militaryFloor<=8?[.95,.05,0]:
  r.militaryFloor<=12?[.92,.08,0]:
  r.militaryFloor<=16?[.88,.11,.01]:[.85,.13,.02]
 ):null;
 const milGroupRoll=milGroupWeights?rand(r):null;
 const count=milGroupWeights?(milGroupRoll<milGroupWeights[0]?1:milGroupRoll<milGroupWeights[0]+milGroupWeights[1]?2:3):roll(r,groupChance)?(eid==='scav'&&roll(r,.10)?3:2):1;
 const units=Array.from({length:count},(_,i)=>{const profile=drawNormalProfile(r,eid);return {...E[eid],pen:E[eid].pen+districtEnemyPenBonus(r.map),id:eid+'-'+i,kind:eid,n:profile.n+(count>1?' '+(i+1):''),hp:E[eid].hp,preferRange:profile.range,mob:profile.mob,meleeOnly:!!profile.meleeOnly,d:profile.d||E[eid].d,hit:profile.hit||E[eid].hit,enemyWeapon:tokEnemyWeaponPick(r,profile.weaponCategory),dist:profile.range}});units.forEach(u=>{tokEnemyAssignGrenade(r,u);enemyEquip(r,u);u.enemyGear=attAutoWeapon(r,{type:'weapon',base:u.enemyWeapon,rarity:'common',affixes:[]});});
 // Show the actual rolled loadout of every normal enemy, including grouped encounters.
 for(const u of units){
  const gun=W[u.enemyWeapon]?.n||'武器なし';
  const helm=u.helmetId&&H[u.helmetId]?H[u.helmetId].n:'なし';
  const armor=u.armorId&&u.armorId!=='none'&&A[u.armorId]?A[u.armorId].n:'なし';
  log(r,`【敵装備】${u.n}｜武器：${gun}｜ヘルメット：${helm}｜アーマー：${armor}`);
 }
 r.combatDistance=Math.floor(rand(r)*3);log(r,`敵と遭遇：${units.map(u=>u.n+'（'+W[u.enemyWeapon].n+'）').join('・')} ／ 距離：${DIST_LABEL[r.combatDistance]}`);openingInitiative(r,units,eid);if(r.hp<=0)return 'dead';if(units.every(x=>x.hp<=0)){bonusDrop(r,eid);return 'won'};
  function fight(rounds){for(let round=1;round<=rounds;round++){
   log(r,`【戦闘ターン 第${(r.normalCombatTurn||0)+1}ターン】`);
   if(!hasCombatWeapon(r))return 'noammo';
   const alive=units.filter(x=>x.hp>0);if(!alive.length)return 'won';
   r._bossObservedThisTurn=false;r._bossSpecialObserved=false;turnCare(r);enemyStatusTick(r,units);if(r.hp<=0)return 'dead';if(units.every(x=>x.hp<=0))return 'won';const target=groupAttackPolicy(r,units);
   const grenaded=throwGrenade(r,units,eid);if(!grenaded)target.hp-=playerAttack(r,target,target.hp);
   if(!grenaded&&target.hp<=0){normalKillReward(r,target,eid)}
   const after=units.filter(x=>x.hp>0);   if(!after.length){bonusDrop(r,eid);return 'won'};
   // Group pressure is intentionally capped; no more than two enemy attacks per round.
   const attacks=Math.min(2,after.length);for(let i=0;i<attacks&&r.hp>0;i++){
     const foe=after[(round+i-1)%after.length];
     if(tokEnemyThrowGrenade(r,foe))continue;
     if(foe.meleeOnly&&r.combatDistance!==0){
       log(r,`${foe.n}は接近中。距離が遠く攻撃できない`);
       continue;
     }
     enemyStrike(r,{...foe,hit:Math.max(5,foe.hit-(after.length>1?9:0)+normalAimModifier(foe,r.combatDistance))});
   }
   if(r.hp<=0)return 'dead';
   // Close-range-only enemies press forward every round, not just on turns 2/4/6.
   if(after.some(u=>u.hp>0&&u.meleeOnly)&&r.combatDistance>0&&roll(r,.88)){
     r.combatDistance--;
     log(r,`【近接敵の接近】${DIST_LABEL[r.combatDistance]}まで距離を詰めた`);
   }else normalDistanceTick(r,units,(r.normalCombatTurn||0)+1);
   r.normalCombatTurn=(r.normalCombatTurn||0)+1;flashAdvance(units);
 }return 'timeout'}
 let res=fight(6);if(res==='won'||res==='dead')return res;
 log(r,res==='noammo'?'弾切れ：離脱を試みる':'6ラウンド経過：離脱を試みる');
 const strongest=units.filter(x=>x.hp>0).sort((a,b)=>b.pursuit-a.pursuit)[0]||E[eid];
 const esc=escapeCombat(r,strongest);if(esc==='dead'||esc==='escaped')return esc;
 res=fight(6);if(res==='won')return 'finalwon';if(res==='dead')return 'dead';log(r,'最終戦闘が決着せず敗北');return 'dead';
}


// v2.1 normal enemy distance profiles; persistent no learning required.
const NORMAL_AREA={school:[45,40,15],zoo:[35,45,20],park:[40,40,20],temple:[45,40,15],power:[30,45,25],suburban:[30,45,25],industrial:[50,35,15],metro:[50,35,15],hospital:[50,35,15],port:[15,35,50],airport:[35,40,25],mall:[50,35,15],tower:[15,35,50],police:[35,40,25],lab:[35,40,25]};
const NORMAL_PROFILE={scav:[{n:'近接型SCAV',range:0,mob:.25,arm:['pm','tt','kedr','pp19','pps43','mp133']},{n:'一般SCAV',range:1,mob:.30,arm:['aks','ak','vpo136','adar']},{n:'狙撃型SCAV',range:2,mob:.25,arm:['sks','mosin']}],raider:[{n:'突撃型RAIDER',range:0,mob:.50,arm:['pp19','mp5','p90','ak105','saiga12','mp153']},{n:'戦闘型RAIDER',range:1,mob:.55,arm:['ak','aks','m4a1','aug','rpk74','adar']},{n:'射撃型RAIDER',range:2,mob:.50,arm:['sks','mosin','svd','scarh']}],elite:[{n:'強襲型ELITE',range:0,mob:.65,arm:['saiga12','p90','mp5']},{n:'戦術型ELITE',range:1,mob:.65,arm:['m4a1','aug','rpk74']},{n:'狙撃型ELITE',range:2,mob:.65,arm:['svd','scarh','mosin']} ]};
// Melee-only opponents are a separate rare encounter profile. They carry no firearm.
const MELEE_ENEMY_PROFILES={
 scav:[{n:'ナイフ使いSCAV',range:0,mob:.65,arm:['knife'],meleeOnly:true,d:17,hit:58},{n:'斧使いSCAV',range:0,mob:.48,arm:['hatchet'],meleeOnly:true,d:23,hit:49}],
 raider:[{n:'近接突撃RAIDER',range:0,mob:.72,arm:['machete'],meleeOnly:true,d:29,hit:66}],
 elite:[{n:'近接強襲ELITE',range:0,mob:.82,arm:['machete'],meleeOnly:true,d:37,hit:76}]
};
function drawNormalProfile(r,eid){
 const category=tokEnemyWeaponCategory(r,eid);
 if(category==='melee'){const profile=pick(r,MELEE_ENEMY_PROFILES[eid]);return {...profile,weaponCategory:category}}
 const range=category==='sr'||category==='dmr'?2:category==='sg'||category==='smg'?0:1;
 const profile=NORMAL_PROFILE[eid][range];return {...profile,weaponCategory:category};
}
function newEnemyWeapon(r,profile){const stage=['suburban'].includes(r.map)?0:['industrial','metro','hospital','port'].includes(r.map)?1:2;const weights=MAP[r.map]?.tier||[.7,.25,.05];const high=weights[2];const mid=weights[1];const tiers=profile.arm.map(id=>W[id].price>=42000?2:W[id].price>=23000?1:0);let idx=rand(r),tier=idx<high?2:idx<high+mid?1:0;let candidates=profile.arm.filter((id,i)=>tiers[i]===tier);if(!candidates.length)candidates=profile.arm.filter((id,i)=>tiers[i]===[...new Set(tiers)].sort((a,b)=>Math.abs(a-tier)-Math.abs(b-tier))[0]);return pick(r,candidates.length?candidates:profile.arm)}
function normalAimModifier(unit,dist){const delta=Math.abs((unit.preferRange??1)-dist);return ({scav:[5,0,-20],raider:[10,0,-15],elite:[10,0,-10]}[unit.kind]||[0,0,0])[delta]||0}
function normalTarget(units,here){const living=units.filter(u=>u.hp>0);if(!living.length)return here;const score=[0,1,2].map(d=>living.reduce((n,u)=>n+normalAimModifier(u,d),0));const best=Math.max(...score),options=[0,1,2].filter(d=>score[d]===best);return options.includes(here)?here:options[0]}
function normalPlayerScore(r,dist,units){const live=units.filter(u=>u.hp>0);if(!live.length)return 0;const weaponList=primaryAndSecondary(r).filter(x=>W[x.base]&&(x.dur??100)>0&&(r.ammoByCaliber?.[W[x.base].ammo]||0)>0);const target=live.reduce((a,b)=>a.hp<=b.hp?a:b);const dmgOut=Math.max(0,...weaponList.map(x=>{const w=W[x.base],h=clamp(60+w.a+weaponRangeBonus(x.base,dist)+gearVal(x,'accuracy')+levelAccuracyBonus()-target.ev,5,95)/100;return h*dmg(w.d,target.def,w.p+gearVal(x,'penetration'))*(w.shots||1)}));const danger=live.slice(0,2).reduce((n,u)=>n+clamp(u.hit+normalAimModifier(u,dist),5,95)/100*dmg(u.d,armorDef(r.armor,r.dur,raidGear(r,'armor')),u.pen),0);return dmgOut-danger}
function normalDistanceTick(r,units,turn){if(![2,4,6].includes(turn)||!units.some(u=>u.hp>0))return;const here=r.combatDistance;const live=units.filter(u=>u.hp>0);const cur=normalPlayerScore(r,here,live);const nearby=[here-1,here+1].filter(x=>x>=0&&x<=2);const best=nearby.map(dist=>({dist,score:normalPlayerScore(r,dist,live)})).sort((a,b)=>b.score-a.score)[0];const playerGoal=best?.score>=cur+5?best.dist:here;const goal=normalTarget(live,here);const enemyGoal=goal===here?here:here+Math.sign(goal-here);if(playerGoal===here&&enemyGoal===here)return;const rank={scav:0,raider:1,elite:2};const top=live.reduce((acc,x)=>!acc||rank[x.kind]>rank[acc.kind]||rank[x.kind]===rank[acc.kind]&&x.mob>acc.mob?x:acc,null);const enemyMob=clamp((top?.mob||.3)+(top?.meleeOnly?.20:0),0,1),playerMob=clamp(.5+(r.weapon==='kedr'?.10:0),0,1);let direction,prob;if(enemyGoal===here){direction=playerGoal;prob=playerMob}else if(playerGoal===here){direction=enemyGoal;prob=enemyMob}else if(playerGoal===enemyGoal){direction=playerGoal;prob=Math.max(enemyMob,playerMob)}else{const enemyPriority={scav:.30,raider:.50,elite:.60}[top.kind];const enemyWins=roll(r,enemyPriority);direction=enemyWins?enemyGoal:playerGoal;prob=enemyWins?enemyMob:playerMob}if(direction===here)return;const ok=roll(r,prob);const mover=direction===playerGoal&&direction===enemyGoal?'双方':direction===playerGoal?'プレイヤー':'敵グループ';const motion=direction<here?'接近':'後退';if(ok){log(r,`【距離変更成功】${mover}が${motion}：${DIST_LABEL[here]} → ${DIST_LABEL[direction]}（次ターンから適用）`);r.combatDistance=direction}else{log(r,`【距離変更失敗】${mover}が${motion}を試みるも、${DIST_LABEL[here]}を維持`);}}
const WEAPON_RARITY_BONUS={common:0,rare:8000,epic:15000,legendary:25000};
function recoveryValue(x){return gearPrice(x)+(WEAPON_RARITY_BONUS[x.rarity]||0)}
function recoverEnemyGun(r,u){const pool=[];const add=(type,base,weight,dur)=>{if(base&&base!=='none'&&GEARTYPE[type]?.[base]&&!isBossOnlyGear(BANKTYPE[type],base))pool.push({type,base,weight,dur})};add('weapon',u.enemyWeapon,25);add('helmet',u.helmetId,15,u.helmetDur);add('armor',u.armorId,20,u.armorDur);add('bag',u.bagId,10);add('accessory',u.accessoryId,5);const atts=attInstalled(u.enemyGear);if(atts.length)pool.push({type:'attachment',weight:25,atts});if(!pool.length)return true;let v=rand(r)*pool.reduce((a,x)=>a+x.weight,0);const p=pool.find(x=>(v-=x.weight)<0)||pool[pool.length-1];let x;if(p.type==='attachment'){x=structuredCloneSafe(pick(r,p.atts));x.id='gear-'+g.nextGearId++;}else{x=makeGear(r,p.type,p.base,'common');const max=repairOriginalMax(x);if(max)x.dur=Math.max(0,Math.min(Math.floor(max*(.30+rand(r)*.401)),p.dur??max));if(p.type==='weapon')x.attachments={};}x.sourceEnemy=u.n;if(x.type==='weapon'&&!W[x.base]?.melee&&!r.equipment?.secondary&&!r.recoveredSecondary){r.recoveredSecondary=x;r.lootAcquired=true;g.gearStats.found++;log(r,'【敵装備鹵獲】サブ枠：'+gearName(x));}else collectGear(r,x,'【敵装備鹵獲】');return true}
function drawGearRarity(r){const weights=(MAP[r.map]?.enemyRarity||[70,25,4.5,.5]).map(x=>x/100);const v=rand(r);let c=0;for(let i=0;i<weights.length;i++){c+=weights[i];if(v<c)return RARITIES[i]}return 'common'}
function normalKillReward(r,u,eid){r.xp+=u.xp;r.kills++;log(r,`${u.n}撃破：+${u.xp}XP`);const recovered=recoverEnemyGun(r,u);if(!recovered&&roll(r,.003*TOK_DROP_EQUIPMENT_FACTOR))collectGear(r,drawGear(r),`${u.n}撃破報酬`)}

// Consecutive strong-enemy protection: only the next normal encounter is softened.
// Map encounter rates, boss encounters and individual enemy stats are unchanged.
function drawEnemy(r){
 const m=MAP[r.map],prior=r.lastNormalEnemyKind||null;
 let scav=m.mix[0],raider=m.mix[1],elite=m.mix[2];
 if(prior==='raider'){
   // After a RAIDER, halve the combined RAIDER/ELITE chance.
   raider*=.5;elite*=.5;scav=1-raider-elite;
 }else if(prior==='elite'){
   // After an ELITE, the next normal battle cannot be another ELITE.
   // RAIDER is also less likely, leaving SCAV as the common follow-up.
   raider*=.5;elite=0;scav=1-raider;
 }
   if(r.investigation?.kind==='enemy'){raider*=.8;elite*=.8;scav=1-raider-elite;}  const v=rand(r);  const kind=v<scav?'scav':v<scav+raider?'raider':'elite';
 r.lastNormalEnemyKind=kind;
 return kind;
}
// Exploration depth affects the quality of discoveries, never the frequency of events.
const DEPTH_NAMES=['浅い探索','通常探索','深部探索','危険区域','最深部','未踏区域'];
function depthStage(n){return Math.min(5,Math.floor(Math.max(0,(n||1)-1)/5))}
function depthLabel(n){return DEPTH_NAMES[depthStage(n)]}
function depthQualityBoost(n){return [.00,.05,.10,.15,.20,.25][depthStage(n)]}
function depthDisplay(n){const count=Math.max(0,Math.min(30,n||0)),pct=Math.round(count/30*100);return `探索${count}/30 ／ 探索深度 ${pct}% ／ ${depthLabel(Math.max(1,count))}`}
function depthTierRoll(r,m){
 // Shift probability mass from common toward rare, keeping the sum exactly 1.
 const boost=depthQualityBoost(r.explore),common=Math.max(0,m.tier[0]-boost);
 const rare=Math.min(1-common,m.tier[2]+boost);
 const mid=Math.max(0,1-common-rare),v=rand(r);
 const tier=v<common?'common':v<common+mid?'mid':'rare';return tier!=='rare'&&roll(r,tokSetBonuses(r).foxRare/100)?'rare':tier;
}
const EXPLORE_LOCATIONS={"suburban": ["スーパーマーケットの売場", "駐車場の管理室", "閉店した飲食店"], "industrial": ["工場の作業場", "資材倉庫", "搬入口"], "metro": ["地下ホーム", "駅員室", "保守用通路"], "hospital": ["診察室", "薬品保管庫", "病棟"], "port": ["コンテナ置場", "港湾事務所", "荷役倉庫"], "airport": ["搭乗ゲート", "手荷物検査場", "整備格納庫"], "mall": ["衣料品売場", "フードコート", "バックヤード"], "tower": ["通信機器室", "非常階段", "屋上設備区画"], "police": ["取調室", "証拠品保管室", "留置区画"], "lab": ["研究室", "隔離区画", "実験設備室"], "school": ["教室", "職員室", "体育館"], "zoo": ["飼育員詰所", "獣舎", "管理倉庫"], "park": ["アトラクション管理室", "売店", "機械室"], "temple": ["本堂", "庫裏", "鐘楼"], "power": ["制御室", "発電設備室", "保守通路"]};
Object.assign(EXPLORE_LOCATIONS,{cinema:['映写室','ロビー','機材倉庫'],forest:['遊歩道','管理事務所','林間広場'],office:['オフィスフロア','会議室','非常階段'],stadium:['観客席','選手通路','設備室'],nightlife:['クラブ','ホテルの廊下','裏路地'],diet:['議場','議員控室','地下通路']});
function exploreLocation(r){const arr=EXPLORE_LOCATIONS[r.map]||['廃墟の一角','物資置場','管理室'];return pick(r,arr)}

