function playerAttackSingle(r,e,enemyHP){const dist=Number.isInteger(r.combatDistance)?r.combatDistance:1;if(!chooseWeapon(r,e,dist))return 0;if(r.activeSlot==='melee')return meleeAttack(r,e,dist);if(r.weapon==='chainsaw')return tokChainsawAttack(r,e,dist,enemyHP);if(!r._akimboForcedSlot&&!['viper','gunslinger'].includes(r.weapon)&&playerReloadTurn(r,[r.activeSlot||'weapon']))return 0;const w=W[r.weapon],wg=raidGear(r,r.activeSlot||'weapon');if(w.grenadeLauncher){r._rasputinTurn=(r._rasputinTurn||0)+1;if(w.grenadeLauncher.turns.includes(r._rasputinTurn)){if(!roll(r,.55)){log(r,'ラスプーチン：グレネードが外れた');return 0}const damage=dmg(65,e.armorId!==undefined?enemyDefense(e,false):e.def,50,r);log(r,`ラスプーチン：グレネード命中 ${damage}ダメージ`);return damage}}if(wg?.attachments?.muzzle?.base==='suppressor')r._suppressEncounter=(ATT_EFFECT.suppressor[ATT_RAR.indexOf(wg.attachments.muzzle.rarity)]||0)/100;const wr=(wg?.dur??100)/100;const jam=wr>.75?0:wr>.5?.05:wr>.25?.10:wr>.10?.15:wr>0?.25:1;if(roll(r,jam)){log(r,'【ジャム】'+w.n+'：射撃失敗（次の攻撃は通常どおり）');return 0}let dealt=0,shots=0,headshotCount=0,shotgunStaggered=false,hellfireHit=false;r._hitStatusQueue=[];r._deferHitStatus=true;if(r.weapon==='gunslinger'){r.cylinderShots=r.cylinderShots||0;if(r.cylinderShots>=5){r.cylinderShots=0;r._deferHitStatus=false;log(r,'処刑人のリボルバー：再装填（攻撃休止）');return 0}r.cylinderShots++}if(r.weapon==='viper'){r.minigunCycle=r.minigunCycle||0;if(r.minigunCycle>=4){r.minigunCycle=0;r._deferHitStatus=false;log(r,'毒蛇のミニガン：過熱冷却（攻撃休止）');return 0}r.minigunCycle++}const wd=Math.floor((w.d+tokAccessoryBonus(r,'attack'))*(1+(raidVal(r,r.activeSlot||'weapon','damage')+tokSetBonuses(r).damage)/100)*(wg?.base==='zero'&&r.hp<=50?1.15:1)*(wg?.base==='joker'&&r.hp<=maxRaidHp(r)*.5?1.15:1)),pen=w.p+raidVal(r,r.activeSlot||'weapon','penetration')+tokAccessoryBonus(r,'penetration');let falloff=smgWeapon(r.weapon)?5:(raidVal(r,r.activeSlot||'weapon','control')||10);falloff=Math.max(0,falloff-attEffect(wg,'control'));if(r.weapon==='hellfire')falloff=0;else if(r.weapon==='viper')falloff=3;else if(r.weapon==='gamma')falloff=5;if(r.weapon==='nemesis')falloff=Math.ceil(falloff/2);if(r.weapon==='pp19')falloff=Math.max(1,falloff-2);if(wg?.rarity==='legendary'&&r.weapon==='pp19')falloff=Math.max(1,falloff-3);for(let i=0;i<((r.weapon==='viper'?2*r.minigunCycle:w.shots)+(tokPmcStyle(r).name==='トリガーハッピー'?1:0))&&(w.ammoFree||r.ammo>0)&&enemyHP-dealt>0;i++){if((wg?.dur??100)<=0)break;shots++;weaponWear(r,r.activeSlot);if(!w.ammoFree&&!roll(r,raidVal(r,r.activeSlot||'weapon','saving')/100))r.ammo--;let bonus=(wg?.base==='joker'&&r.hp>maxRaidHp(r)*.5?5:0);const firstShot=!r.firstShotUsed;if(!r.firstShotUsed){r.firstShotUsed=true;if(wg?.rarity==='legendary'&&['pm','ak'].includes(r.weapon))bonus=15;if(wg?.base==='hawkeye'&&firstShot)bonus+=15;if(wg?.base==='huntress'){if(r.huntressTarget===e.n)bonus+=10;r.huntressTarget=e.n;}if(r.weapon==='alpha')bonus+=6;if(r.weapon==='gunslinger'&&r.cylinderShots===4)bonus+=15;if(r.weapon==='queenbee'&&r.queenBeeNext){bonus+=10;r.queenBeeNext=false}}const fixedHit=(r.weapon==='pm'&&i===0?8:0)+(r.weapon==='aks'&&dist===0?8:0)+(r.weapon==='ak'&&dist===1?5:0)+(r.weapon==='sks'&&dist===2?8:0)+(r.weapon==='ak105'&&dist===0?8:0)+(r.weapon==='aug'?(dist===2?8:dist===0?-8:0):0);const fixedControl=(r.weapon==='mp5'&&i>=1?5:0)+(r.weapon==='m4a1'&&i===2?5:0)+(r.weapon==='rpk74'&&i===3?5:0)+(r.weapon==='m249'&&i>=3&&i<=4?5:0)+(r.weapon==='p90'&&i>=3?10:0)+(r.weapon==='svd'&&dist===2&&i===1?10:0)+(r.weapon==='mp153'&&dist===0&&i===1?5:0)+(r.weapon==='saiga12'&&i===1?10:0);const hit=clamp(60+w.a+tokPmcStyle(r).hit-(r._akimboForcedSlot?15:0)-(r.perfumeAccuracyDebuff>0?20:0)+raidVal(r,r.activeSlot||'weapon','accuracy')+raidVal(r,'helmet','accuracy')+raidVal(r,'bag','accuracy')-tokFlashPenalty(r,r,true)-tokSmokePenalty(r,r,true)+attEffect(wg,'accuracy',dist)+levelAccuracyBonus()+tokSetBonuses(r).accuracy+tokAccessoryBonus(r,'accuracy')-(r.armBroken?15:0)-(r.burnTurns>0?10:0)-e.ev-attEffect(e.enemyGear,'do