",diet:"data:image/webp;base64,"});
// User-approved cinema cult leader portrait.
BOSS_ART.cinema='data:image/jpeg;base64,';
function bossPortrait(id){if(BOSS_ART[id])return `<img class="boss-art" alt="${escapeHTML(BOSSES[id].n)} イラスト" src="${BOSS_ART[id]}">`;
 const cfg={suburban:['#9a6955','shotgun',1],industrial:['#64756b','shield',1],metro:['#69718a','smg',1],hospital:['#9caa99','medical',1],port:['#718b78','rifle',1],airport:['#b18a67','revolver',1],mall:['#8e7968','minigun',1],tower:['#8d889f','sniper',1],police:['#77877c','smg',3],lab:['#8c695f','rifle',1]}[id]||['#718475','rifle',1];
 const [accent,weapon,count]=cfg;
 const gun={shotgun:'<path d="M98 128l103-28 5 11-107 35z"/>',shield:'<path d="M107 113l50-8 13 82-43 17-30-24z"/>',smg:'<path d="M102 123h94v13h-43l-8 25h-12l3-25h-34z"/>',medical:'<path d="M103 118h65v24h-65z"/><path d="M130 111h12v37h-12z"/>',rifle:'<path d="M99 126l133-17v9l-133 25z"/>',revolver:'<path d="M104 120h55v16h-26l-9 25-13-3 9-25h-16z"/><circle cx="130" cy="128" r="12" fill="#111b19"/>',minigun:'<path d="M98 113h115v24H98z"/><path d="M197 110h45v5h-45zm0 10h45v5h-45zm0 10h45v5h-45z"/>',sniper:'<path d="M94 127l148-26v8L94 139z"/><path d="M140 111h43v5h-43z"/>'}[weapon];
 function soldier(x,scale,opacity){return `<g transform="translate(${x} 0) scale(${scale})" opacity="${opacity}"><ellipse cx="137" cy="254" rx="62" ry="10" fill="#020606" opacity=".7"/><path d="M107 161l-12 94h32l13-68 11 68h32l-12-94z" fill="#192720" stroke="${accent}" stroke-opacity=".45"/><path d="M112 78l-26 18-21 76 37 12 15-42-2 51h73l-4-51 19 40 31-13-29-77-28-15z" fill="#28382f" stroke="${accent}" stroke-width="3"/><path d="M111 91l52 55 31-54" stroke="#9aa899" stroke-opacity=".4" stroke-width="5" fill="none"/><path d="M111 40q24-34 51 0l-2 30-12 16h-23l-14-16z" fill="#27332f" stroke="${accent}" stroke-width="3"/><path d="M109 50q3-35 29-35t29 35z" fill="#3b4940"/><path d="M113 57h51l-6 12h-39z" fill="#0a1312"/><path d="M120 63h36" stroke="${accent}" stroke-width="2" opacity=".9"/><g fill="#5b6a5d" stroke="#121c18" stroke-width="3">${gun}</g><path d="M98 102l-9 46m105-46 13 45" stroke="#738477" stroke-width="16" stroke-linecap="round"/></g>`}
 const figures=count===3?soldier(-38,.72,.83)+soldier(67,.84,1)+soldier(172,.72,.83):soldier(90,1.03,1);
 return `<svg class="boss-portrait" viewBox="0 0 440 285" role="img" aria-label="${count===3?'3人編成のボス部隊':'ボスの装備別シルエット'}" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="bossGlow"><stop stop-color="${accent}" stop-opacity=".22"/><stop offset="1" stop-color="${accent}" stop-opacity="0"/></radialGradient></defs><ellipse cx="220" cy="132" rx="180" ry="133" fill="url(#bossGlow)"/>${figures}</svg>`;
}

function bossDossierTargets(){
 const normal=DISTRICT_TIERS.flat().filter(id=>BOSSES[id]).map((id,index)=>{
  const b=BOSSES[id],u=!!g.unlocked[id],rec=g.bosses[id],status=rec?.first?'討伐済':!u?'未解放':bossKnown(id)?'討伐可能':'情報収集中';
  return `<button class="boss-target-row ${selectedBoss===id?'selected':''} ${u?'':'is-locked'}" data-action="bossSelect:${id}" aria-pressed="${selectedBoss===id}"><span class="boss-target-name">${escapeHTML(b.n)}</span><span class="boss-target-place">${index+1}. ${escapeHTML(MAP[id].n)}</span><span class="boss-target-state">${status}</span></button>`;
 }).join('');
 const roaming=Object.keys(ROAMING_BOSSES).map(id=>`<button class="boss-target-row ${selectedBoss===id?'selected':''}" data-action="bossSelect:${id}" aria-pressed="${selectedBoss===id}"><span class="boss-target-name">${escapeHTML(BOSSES[id].n)}</span><span class="boss-target-place">徘徊型ボス</span><span class="boss-target-state">${g.bosses[id]?.first?'討伐済':'未討伐'}</span></button>`).join('');
 const p=pursuerState();
 const pursuer=`<button class="boss-target-row ${selectedBoss==='pursuer'?'selected':''}" data-action="bossSelect:pursuer" aria-pressed="${selectedBoss==='pursuer'}"><span class="boss-target-name">追跡者</span><span class="boss-target-place">特殊ボス / 全通常レイド</span><span class="boss-target-state">${p.hp<=0&&p.revive>0?'復活待機':p.kills>0?'討伐済':'活動中'}</span></button>`;
 return `<div class="boss-tier"><div class="boss-tier-list">${normal}${roaming}${pursuer}</div></div>`;
}
function bossUniformMetrics(rows){return `<div class="boss-readout">${rows.map(([label,value,bar])=>`<div class="boss-metric"><span>${label}</span><b>${value}</b>${bar||''}</div>`).join('')}</div>`;}
function pursuerDossierScreen(){
 const p=pursuerState(),remaining=Math.min(10,Math.max(0,Math.floor(p.revive||0))),completed=10-remaining;
 const cells=Array.from({length:10},(_,i)=>`<span class="pursuer-revive-cell ${i<completed?'done':'pending'}">${i<completed?'✓':i+1}</span>`).join('');
 const status=p.hp<=0&&remaining>0?`復活待機 / 残り${remaining}レイド`:p.hp>0?'活動中':'復活準備完了';
 return `<section class="panel"><div class="boss-panel-title">TACTICAL INTELLIGENCE / BOSS DOSSIER</div><h2>ボス情報</h2><p class="muted">マップ番号順、徘徊型ボス、追跡者の順に表示します。</p><div class="boss-targets">${bossDossierTargets()}</div></section>
 <section class="panel"><div class="boss-panel-title">SPECIAL TARGET / PURSUER</div><h2>追跡者</h2><img class="pursuer-boss-image" src="${PURSUER_PORTRAIT}" alt="追跡者" loading="lazy"><p><strong>${status}</strong></p>${bossUniformMetrics([['HP',`${p.hp} / 1000`,`<div class="boss-bar"><div style="width:${Math.max(0,Math.min(100,p.hp/10))}%"></div></div>`],['情報解析 / INTEL','対象外（特殊ボス）'],['攻撃 / 防御','20 / 55'],['命中 / 回避 / 貫通','65% / 5% / 30'],['完全討伐回数',`${p.kills||0} 回`],['戦闘学習','対象外（特殊ボス）']])}
 <div class="item"><h3>復活までのレイド進行</h3>${remaining>0?`<p><strong>残り${remaining}レイド</strong>（${completed}/10回経過）</p><div class="pursuer-revive-grid" role="img" aria-label="復活まで残り${remaining}レイド">${cells}</div>`:p.hp>0?'<p>現在活動中です。完全討伐すると復活カウントが始まります。</p>':'<p>復活準備完了。次の通常レイドから出現します。</p>'}<p class="muted">完全討伐後は10レイドの間出現せず、11回目から再出現します。</p></div>
 <div class="item"><h3>人物紹介</h3><p>荒廃した東京の各地に現れる、正体不明の重武装兵士。その名は「追跡者」。全身を強固な装甲で覆い、ライトマシンガン「ネメシス」を携えた謎の存在。所属する組織も、その素顔も、何のために戦い続けているのかさえ明らかになっていない。ただ一つ確かなのは、一度標的と定めた相手を執拗に追い続けるということだ。激しい銃撃を浴びせても、その歩みは止まらない。たとえ一度は撃退できたとしても、追跡者は傷ついた身体のまま再び姿を現す。しかし、その不滅とも思える肉体にも限界はある。幾度もの死闘を経て追い詰められた追跡者は、やがて最後の戦いを迎える。その正体を知る者は、今もいない。</p></div><div class="item"><h3>基本ステータス・固有装備</h3><div class="boss-stats-inline">${[["最大HP",1000],["現在HP",p.hp],["攻撃",20],["防御",55],["命中","65%"],["回避","5%"],["貫通",30]].map(([k,v])=>`<div><small>${k}</small><b>${v}</b></div>`).join("")}</div><p>ネメシス：ダメージ24 ／ 貫通45 ／ 命中補正＋5 ／ 固有LMG。ボス自身の戦闘処理は3連射。</p><p>不滅の装甲：防御55 ／ 最大耐久150。</p></div><div class="item"><h3>特殊能力・交戦情報</h3><p><strong>追跡の気配</strong>：通常レイドで低確率で出現。残りHPが減るほど遭遇率上昇、最大4倍。</p><p><strong>執念の追撃</strong>：HPはレイド間で引き継ぐ。戦闘開始時HPが250を超える場合、開始時HPの25%以上のダメージで撃退。HP250以下ならHP0で完全討伐。最大8ラウンド。レイド終了時にHPを100回復。</p><p><strong>制圧射撃（ボス専用）</strong>：3回連続攻撃。各射撃の基本命中率65%／60%／55%。</p><p>完全討伐で称号「Escape from Stalker」を獲得します。</p></div></section>`;
}
const BOSS_DOSSIER_V1={
 suburban:{abilities:[['散弾追撃','3行動ごとに追加射撃。追加射撃の武器威力は通常の80%。'],['初撃強化','戦闘開始後の初撃は武器威力＋20%。']],weapon:'掃討者のショットガン',weaponDetail:'基礎ダメージ46 / 貫通24 / 命中補正－5'},
 industrial:{abilities:[['粉砕撃','巨大なハンマーによる近接攻撃。貫通100。射程外では接近を優先。'],['鉄壁の重装甲','被弾時15%の確率で受けるダメージを30%軽減。']],weapon:'ブルドーザーハンマー',weaponDetail:'基礎ダメージ46 / 貫通100 / 命中補正－13（プレイヤー装備時も同値）'},
 metro:{abilities:[['戦闘適応','4行動ごとに回避率＋25ポイント。初期5% → 30% → 55% → 80%。通常12ラウンドでは最大55%。'],['幻影のSMG','1回の攻撃で3連射。']],weapon:'幻影のSMG',weaponDetail:'基礎ダメージ17×3回 / 貫通22 / 命中補正＋12'},
 hospital:{abilities:[['毒付与','毒メスの攻撃が命中し、1以上のダメージを与えた場合30%で毒付与。毒は4ターン、毎ターン最大HPの5%（最低3）。'],['毒性増幅','毒状態の相手への武器威力＋25%。'],['再生の標準装甲','被弾後HPが最大値の50%以下になると最大HPの20%を回復。1レイド1回。']],weapon:'毒メス',weaponDetail:'基礎ダメージ28 / 貫通35 / 命中補正＋10（毒付与30%はプレイヤー装備時も共通）'},
 port:{abilities:[['初撃精密射撃','初回射撃の命中率＋15ポイント、貫通力＋15。'],['鷹の目','ヘッドショット発生率30%（通常15%）。']],weapon:'鷹の目のライフル',weaponDetail:'基礎ダメージ51 / 貫通65 / 命中補正＋5 / 単発射撃'}
};
// Boss dossier entries 06-10. Battle mechanics are unchanged except γ scout base accuracy.
Object.assign(BOSS_DOSSIER_V1,{
 airport:{weapon:'処刑人のリボルバー',weaponDetail:'基礎ダメージ55 / 貫通55 / 命中補正－10 / .500 Magnum / 5発装填',abilities:[['クイックドロー','戦闘開始時に先制射撃。'],['デッドアイ','2・4発目は命中＋15ポイント、貫通＋20、武器威力＋25%。'],['ファニングショット','通常射撃の命中時30%で追加射撃。追加射撃は命中－15ポイント、弾薬を消費し、連続発生する場合がある。'],['再装填','5発撃ち切ると次の行動は再装填に費やし、攻撃できない。']]},
 mall:{weapon:'毒蛇のミニガン',weaponDetail:'基礎ダメージ15 / 貫通65 / 命中補正－5 / 7.62×51mm / 連射数は2→4→6→8発',abilities:[['加速連射','2→4→6→8発と連射数が増加し、5行動目は過熱休止。以降この周期を繰り返す。プレイヤー使用時も同様。'],['毒蛇の執念（ボス専用）','連射数が4/6/8発のとき、命中率がそれぞれ＋5/＋10/＋15ポイント。']]},
 tower:{weapon:'女王蜂のマークスマンライフル',weaponDetail:'基礎ダメージ43 / 貫通75 / 命中補正＋6 / 7.62×51mm / 単発。プレイヤー使用時は貫通＋15、射撃後の次弾に命中＋10ポイント。',abilities:[['突撃スナイパー（ボス専用）','距離2では命中＋5ポイント、距離1では追加補正なし、距離0では命中＋20ポイント・武器威力＋20%。距離1〜2では60%の確率で1段階接近し、その行動では射撃しない。'],['固有武器効果（プレイヤー用）','女王蜂のマークスマンライフルはプレイヤー使用時に貫通＋15。射撃すると次の射撃に命中＋10ポイント。ボス専用の突撃スナイパーは付与されない。']]},
 police:{weapon:'α：MP-153／β：グロック17／γ：RPK-74',weaponDetail:'固有報酬は指揮官のヘッドセット・城塞のライオットシールド・猟犬のバックパック。3人全員撃破・生還で初回3種確定、以降各20%抽選。',stats:[['α隊長',90,16,25,72,10,45],['β重装兵',130,20,65,62,0,45],['γ偵察兵',70,14,10,68,30,35]],abilities:[['戦術指揮（α隊長）','αが生存している間、部隊全員の貫通力＋10。α自身の命中率＋8ポイント。'],['身代わり防御（β重装兵）','他の隊員が攻撃対象になると30%で攻撃を引き受ける。被ダメージ時は20%でダメージを25%軽減。'],['援護射撃（γ偵察兵）','γが攻撃すると、次に攻撃するαまたはβの命中率＋10ポイント。γ自身は命中率＋5ポイント・回避率＋5ポイント（基本命中68%、補正後73%）。'],['連携戦闘','毎ラウンド生存メンバーから最大2人がランダムに攻撃。戦闘開始時は12%でγの奇襲攻撃が発生。']]},
 lab:{weapon:'零式アサルトライフル',weaponDetail:'基礎ダメージ34 / 貫通52 / 命中補正＋3 / 5.45×39mm / 2連射',abilities:[['最終決戦型（ボス専用）','残HP70%以下で命中＋5ポイント、40%以下でさらに武器威力＋15%、20%以下でさらに貫通＋15。各効果は累積。プレイヤーが固有武器を使用してもこの能力は発動しない。']]}
});
Object.assign(BOSS_DOSSIER_V1,{
 machine:{weapon:'鉄雨',weaponDetail:'基礎ダメージ18 / 貫通55 / 命中補正±0 / 5連射 / 12ゲージ',abilities:[['装甲破砕弾（ボス専用）','「鉄雨」で5発の連続射撃を行う。射撃が進むごとに命中率が10ポイントずつ低下する一方、貫通力が10ずつ上昇する。'],['強制再装填（ボス専用）','5発射撃した次の行動は再装填のため攻撃できない。射撃と再装填を交互に繰り返す。'],['固有武器効果（プレイヤー用）','プレイヤーが「鉄雨」を装備しても、ボス専用の装甲破砕弾と強制再装填の行動パターンは適用されない。']]},
 shadow:{weapon:'影縫い',weaponDetail:'基礎ダメージ23 / 貫通65 / 命中補正±0 / 単発 / 7.62×51mm',abilities:[['魔弾（ボス専用）','4行動を1周期とし、1～2行動目は通常射撃、3行動目は精密照準で攻撃休止、4行動目に命中率95%・貫通力120の魔弾を発射する。以後繰り返す。'],['固有武器効果（プレイヤー用）','プレイヤーが「影縫い」を装備しても、ボス専用能力「魔弾」は発動しない。']]},
 death:{weapon:'冥府の大鎌',weaponDetail:'基礎ダメージ37 / 貫通45 / 命中補正±0 / 近接武器（弾薬なし）',abilities:[['死神の刃（ボス専用）','「冥府の大鎌」による攻撃でダメージを与えた際、50%の確率で出血状態を付与する。出血無効の装備効果がある場合は出血しない。'],['長射程近接攻撃','戦闘距離1以内から攻撃可能。距離2以上では接近行動を取り、攻撃しない。'],['固有武器効果（プレイヤー用）','プレイヤーが「冥府の大鎌」を装備しても、ボス専用の出血付与能力は適用されない。']]},
 perfume:{weapon:'芳香',weaponDetail:'基礎ダメージ25 / 貫通45 / 命中補正±0 / 2連射 / 5.56mm',abilities:[['香気戦術（ボス専用）','3行動を1周期としてアドレナリン→攪乱香→腐食香を順番に使用する。'],['アドレナリン','1行動目に発動。2連射の命中率をそれぞれ97%に固定する。'],['攪乱香','2行動目に発動。プレイヤーの命中率を20ポイント低下させる。設定上の持続時間は2ラウンド。'],['腐食香','3行動目に発動。プレイヤーの胴防具による防御力を25%低下させる。設定上の持続時間は2ラウンド。'],['戦闘行動','攪乱香と腐食香の使用時も通常攻撃を行う。'],['固有武器効果（プレイヤー用）','プレイヤーが「芳香」を装備しても、ボス専用能力「香気戦術」は発動しない。']]}
});

// v3.6.28: approved boss dossiers 15-20 and cult leader balance adjustments.
Object.assign(BOSS_DOSSIER_V1,{"school":{"weapon":"桜花","weaponDetail":"基礎ダメージ42 / 貫通15 / 命中補正＋10 / 日本刀（近接）","abilities":[["瞬歩（ボス専用）","戦闘距離1以上から距離0まで一気に接近。この行動では攻撃しない。"],["居合（ボス専用）","通常25%で発動し、「桜花」の武器威力が1.5倍。発動中は回避率が低下。"],["見切り（ボス専用）","プレイヤーの攻撃を回避すると、次の居合発動確率が40%に上昇。"],["固有武器効果（プレイヤー用）","プレイヤーが「桜花」を装備しても瞬歩・居合・見切りは発動しない。"]]},"temple":{"weapon":"不動明王／金剛法衣","weaponDetail":"不動明王：ダメージ38 / 貫通75 / 命中＋12 / 7.62×25mm・単発。金剛法衣：防御85 / 最大耐久130。","abilities":[["金剛の重装甲","高いHPと防御力を持つ。回避率は0%。"],["頭部の弱点（ボス専用）","頭部への攻撃に弱く、ヘッドショットで大きなダメージを受ける。"],["破甲弾（武器固有効果）","命中した弾のダメージ計算時のみ、対象の防御力を20低下させる。蓄積・持ち越しなし。"]]},"park":{"weapon":"Mr.バニー：PP-91 Kedr／Mrs.バニー：トカレフ（TT）","weaponDetail":"固有報酬はバニーマスクとボムバッグ。","abilities":[["バニーコンビネーション（ボス専用）","2人が独立したHPを持ち、それぞれ行動する。片方が倒れても残った1人は戦闘を続ける。"],["Mr.バニー：毒ガス攻撃","奇数ラウンドにガスグレネード、偶数ラウンドに通常射撃。"],["Mrs.バニー：爆発物攻撃","偶数ラウンドにフラググレネード、奇数ラウンドに通常射撃。"],]},"zoo":{"weapon":"ハントレス（マダム）／タイガーヘルメット","weaponDetail":"ハントレス：ダメージ55 / 貫通65 / 命中＋5 / 7.62×51mm・単発。タイガーヘルメット：防御45 / 最大耐久80。","abilities":[["血の追跡（マダム専用）","3ラウンドごとに命中率＋15ポイント。対象が出血中なら武器威力＋30%。"],["裂傷攻撃（タイガー専用）","本物の虎が爪と牙で近接攻撃。通常攻撃は20%、偶数ラウンドの強攻撃は40%で出血を付与。強攻撃の威力＋25%。"],["連携戦闘","マダムと虎のタイガーは独立したHPで行動し、片方が倒れても残った方は戦闘を続ける。"],["猛虎の爪（プレイヤー用装備効果）","タイガーヘルメットを装備した場合、命中した弾ごとに10%で出血を付与。"]]},"power":{"weapon":"ワイルドカード","weaponDetail":"基礎ダメージ30 / 貫通55 / 命中＋8 / 3連射 / 5.56mm","abilities":[["アダプティブ（武器固有効果）","使用者のHP50%超では命中率＋5ポイント、50%以下では武器威力＋15%。両効果は同時発動せず切り替わる。ボス・プレイヤー共通。"]]},"cinema":{"weapon":"PM（教祖）／教団の聖印（固有報酬）","weaponDetail":"教祖の通常射撃はPM（マカロフ拳銃）。初回討伐時の固有報酬は教団の聖印、2回目以降は20%抽選。","abilities":[["狂信者の護衛（ボス専用）","1・4・7ラウンド目にカルティストを召喚。カルティストが生存している間、プレイヤーの攻撃対象はカルティストに固定される。カルティストの回避率は25%。"],["フラッシュグレネード（ボス専用）","1・4・7ラウンド目に使用。成功率50%、命中時は3ターンの閃光効果。この行動では通常射撃しない。"],["狂信者の自爆（ボス専用）","3・6・9ラウンド目にカルティストが生存していれば自爆攻撃。攻撃50 / 命中80% / 貫通40。自爆後は消滅。"]]}});
// Approved dossier text for bosses 21–25 (display only; combat unchanged).
Object.assign(BOSS_DOSSIER_V1,{"forest": {"weapon": "チェーンソー／拘束の鎖", "weaponDetail": "チェーンソー：ダメージ35 / 貫通40 / 命中補正±0 / 2連撃。拘束の鎖：固有アクセサリー。", "abilities": [["チェーンソー2連撃（ボス専用）", "チェーンソーで2回連続攻撃。各攻撃は独立して命中判定し、ダメージを与えた際に10%で出血付与。"], ["拘束の鎖（ボス専用）", "20%の確率でチェーンソー攻撃の代わりに拘束攻撃。ダメージはないが、命中すると次ラウンドの通常攻撃を封じる。"]]}, "office": {"weapon": "ミョルニル／グングニル／ヴァルハラ", "weaponDetail": "スルーズ：ミョルニル（48/貫通35/命中－10/単発）。ヒルド：グングニル（21/貫通40/命中＋5/4連射）。シグルーン：ヴァルハラ（36/貫通65/命中＋5/単発）。", "stats": [["スルーズ", 150, 48, 15, 75, 35, 35], ["ヒルド", 110, 21, 25, 75, 20, 40], ["シグルーン", 100, 36, 45, 75, 10, 65]], "abilities": [["ヴァルキリーズ・コンビネーション", "毎ラウンド、生存メンバーから最大2人がランダムに攻撃。1人のみ生存時は連携なし。"], ["制圧射撃（スルーズ＋ヒルド）", "両者の命中率＋10ポイント。"], ["装甲突破（ヒルド＋シグルーン）", "両者の武器貫通力＋15。"], ["集中攻撃（シグルーン＋スルーズ）", "両者の武器威力＋15%。"]]}, "stadium": {"weapon": "ヘルファイア", "weaponDetail": "ダメージ18 / 貫通15 / 命中＋10ポイント / 3連射 / 弾薬消費なし。", "abilities": [["火炎放射", "ヘルファイアで3回連続攻撃。1アクションにつき1回、75%の確率で火傷を付与。"], ["業火の追撃（ボス専用）", "火傷状態のプレイヤーへのヘルファイアの攻撃ダメージ＋50%。"]]}, "nightlife": {"weapon": "雷神／風神", "weaponDetail": "雷神：ダメージ55 / 貫通70 / 命中－15 / .50 AE。風神：ダメージ32 / 貫通35 / 命中＋15 / .50 AE。", "abilities": [["二丁拳銃（ボス専用）", "毎ラウンド雷神と風神で各1回攻撃。両攻撃の命中率－10ポイント。HP50%以下で両武器のダメージ＋20%。"]]}, "diet": {"weapon": "ラスプーチン", "weaponDetail": "ダメージ25 / 貫通45 / 命中＋5 / 3連射 / 5.45×39mm / グレネードランチャー搭載。", "abilities": [["グレネードランチャー", "3・6・9・12ターン目に通常射撃の代わりに発射。ダメージ65 / 命中55% / 貫通50。プレイヤー装備時にも使用可能。"]]}});
function bossDossierV1Sections(id,b,show,full){
 const d=BOSS_DOSSIER_V1[id];if(!d)return '';
 const section=(n,title,body)=>`<div class="item" style="margin:12px 0"><h3>${n} / ${title}</h3>${body}</div>`;
 const locked='<p class="muted">情報収集・解析で公開されます。</p>';
 const stats=full?(d.stats?`<p>3名合計HP ${b.hp} ／ 経験値 ${b.xp}</p><table style="width:100%;font-size:.9em"><thead><tr><th>隊員</th><th>HP</th><th>攻撃</th><th>防御</th><th>命中</th><th>回避</th><th>貫通</th></tr></thead><tbody>${d.stats.map(u=>`<tr>${u.map((v,i)=>`<td>${i===0?escapeHTML(v):v}</td>`).join('')}</tr>`).join('')}</tbody></table>`:`<div class="boss-stats-inline">${[["HP",b.hp],["攻撃",b.d],["防御",b.def],["命中",b.hit+"%"],["回避",b.ev+"%"],["貫通",b.pen],["追撃",b.pursuit],["経験値",b.xp]].map(([k,v])=>`<div><small>${k}</small><b>${v}</b></div>`).join("")}</div>`):locked;
 return section('02','基本ステータス',stats)+section('03','使用武器',show?`<p><strong>${escapeHTML(d.weapon)}</strong></p>${d.weaponDetail&& !d.weaponDetail.startsWith(d.weapon+'：')?`<p>${escapeHTML(d.weaponDetail)}</p>`:''}`:locked)+section('04','特殊能力',show?d.abilities.map(a=>`<p><strong>${escapeHTML(a[0])}</strong>：${escapeHTML(a[1])}</p>`).join(''):locked)+section('05','出現地区・討伐報酬',show?`<p>出現地区：${escapeHTML(ROAMING_BOSSES[id]?ROAMING_AREAS[id].map(k=>MAP[k].n).join('・'):MAP[id].n)} ／ 固有装備：${escapeHTML(BOSS_REWARD_LABEL[id]||W[b.gear]?.n||'不明')} ／ ${['forest','office','zoo','park','nightlife','police','hospital','industrial','temple'].includes(id)?'初回討伐・生還で全種類確定、2回目以降は各20%で独立抽選。':'初回討伐・生還で確定報酬、2回目以降は20%抽選。'}</p>`:locked);
}
function bossBattleScreen(){
 reconcileDefeatedBossIntel();
 const ids=[...DISTRICT_TIERS.flat(),...Object.keys(ROAMING_BOSSES),'pursuer'];if(selectedBoss!=='pursuer'&&!BOSSES[selectedBoss])selectedBoss='suburban';if(selectedBoss==='pursuer')return pursuerDossierScreen();
 const id=selectedBoss,b=BOSSES[id],st=g.bosses[id]||{intel:0,kills:0,first:false},roaming=!!ROAMING_BOSSES[id],unlocked=roaming||!!g.unlocked[id],partial=roaming||bossKnown(id),full=roaming||bossFull(id),isActive=g.status==='raid'&&g.raid?.map===id&&g.raid?.settings?.raidType==='boss';
 const show=(unlocked||st.first||st.kills>0)&&partial,knownHp=full?b.hp:partial?'推定':'未判明';
 const intelPct=roaming?100:(unlocked||st.first||st.kills>0)?Math.min(100,Math.floor(bossEffectiveIntel(id)/Math.max(1,b.full)*100)):0;const portraitStage=st.first||st.portraitUnlocked?5:roaming?0:!unlocked?0:(intelPct===0?0:intelPct<25?1:intelPct<50?2:intelPct<75?3:intelPct<100?4:5);const badge=st.first?'討伐・生還済':roaming?'徘徊型ボス':!unlocked?'地区未解放':!partial?'情報収集中':'討伐可能';
 const targets=bossDossierTargets();
 const roamingTargets='';
 const eq=equippedGear('weapon'),weapon=eq?gearName(eq):'未装備',ammo=eq&&W[eq.base]?AM[W[eq.base].ammo]?.n:'—';
 return `<section class="panel"><div class="boss-panel-title">TACTICAL INTELLIGENCE / BOSS DOSSIER</div><h2 style="margin-top:6px">ボス戦画面</h2><p class="muted">情報は調査状況に応じて公開。戦闘結果はレイド終了後に表示されます。</p><div class="boss-targets">${targets}${roamingTargets}</div><p class="muted" style="margin:10px 0 0">マップ番号順に表示しています。徘徊型ボスと追跡者は一覧の末尾です。</p></section>
 <div class="boss-hud"><div class="boss-hud-top"><span>◈ ${escapeHTML(roaming?"徘徊型 / "+ROAMING_AREAS[id].map(k=>MAP[k].n).join("・"):MAP[id].n)} / TARGET FILE</span><span class="${isActive?'boss-live':''}">${isActive?'RAID ACTIVE':'INTEL VIEW'}</span></div><div class="boss-scene"><div class="boss-reticle"></div><div class="intel-portrait ${portraitStage===0?'locked':portraitStage===1?'stage1':portraitStage===2?'stage2':portraitStage===3?'stage3':portraitStage===4?'stage4':''}">${({power:EXTRA_BOSS_ART_POWER,school:EXTRA_BOSS_ART_SCHOOL,temple:EXTRA_BOSS_ART_TEMPLE,park:EXTRA_BOSS_ART_PARK,zoo:EXTRA_BOSS_ART_ZOO})[id]?`<img src="${({power:EXTRA_BOSS_ART_POWER,school:EXTRA_BOSS_ART_SCHOOL,temple:EXTRA_BOSS_ART_TEMPLE,park:EXTRA_BOSS_ART_PARK,zoo:EXTRA_BOSS_ART_ZOO})[id]}" alt="${escapeHTML(b.n)}">`:bossPortrait(id)}<div class="veil">${portraitStage===5?'画像完全公開':portraitStage===0?'TARGET UNKNOWN':'情報収集中 · ' + intelPct + '%'}</div></div><div class="boss-scene-label"><small>${id.toUpperCase()} / HIGH VALUE TARGET</small><strong>${escapeHTML(b.n)}</strong><span class="boss-status ${unlocked?'':'locked'}">${badge}</span></div></div>
 ${bossUniformMetrics([['HP',knownHp,`<div class="boss-bar"><div style="width:${full?'100':'0'}%"></div></div>`],['情報解析 / INTEL',`${bossEffectiveIntel(id)} / ${b.full}`,`<div class="progress"><div style="width:${intelPct}%"></div></div>`],['攻撃 / 防御',full?`${b.d} / ${b.def}`:'未解析'],['命中 / 回避 / 貫通',full?`${b.hit}% / ${b.ev}% / ${b.pen}`:'未解析'],['討伐・生還回数',`${st.kills||0} 回`],['戦闘学習',`${st.learning?.observations||0}/6（${Math.round(learningWeight(st.learning)*100)}%）`]])}</div>
 <section class="panel"><div class="boss-panel-title">THREAT ASSESSMENT</div><h2 style="margin-top:7px">交戦情報</h2><div class="item" style="margin-bottom:12px"><small>人物紹介</small><p style="margin:6px 0;line-height:1.7">${escapeHTML(BOSS_INTRO[id]||"危険な武装勢力の指揮官。")}</p></div>${bossDossierV1Sections(id,b,show,full)}${BOSS_DOSSIER_V1[id]?'':`<p>${show?escapeHTML(b.special):'通常レイドで情報を収集すると、特殊行動の情報が解放されます。'}</p>`}<div class="boss-brief"><div><small>固有装備</small><b>${show?escapeHTML(id==='police'?'固有装備3種類':BOSS_REWARD_LABEL[id]||W[b.gear]?.n||A[b.gear]?.n||'不明'):'未判明'}</b></div><div><small>初回討伐報酬</small><b>${id==='police'?'固有装備3種':(['industrial','temple','zoo','park'].includes(id)?'固有装備2種':'固有装備1種')}</b></div><div><small>自分の装備</small><b>${escapeHTML(weapon)}</b></div><div><small>対応弾薬</small><b>${escapeHTML(ammo||'—')}</b></div></div><p class="muted">${roaming?'徘徊型ボスは長期探索でのみ遭遇します。専用討伐レイドはありません。':''} 討伐記録・報酬・地区解放は撃破後の生還で確定。戦闘は自動進行します。</p><div class="item"><h3>調査記録・解析状況</h3><p>調査進捗：${bossEffectiveIntel(id)}/${b.full} ／ 討伐レイド解放：${b.intel} ／ 完全解析：${b.full}</p><div class="progress"><div style="width:${Math.min(100,bossEffectiveIntel(id)/b.full*100)}%"></div></div><p>目撃記録：${st.seen?'確認済み':'未確認'} ／ 初回生還討伐：${st.first?'達成':'未達成'} ／ 生還討伐：${fmt(st.kills)}回</p><p>推奨警戒距離：${full?['近距離','中距離','遠距離'][BOSS_DISTANCE_PROFILE[id]?.preferred??1]:'未解析'} ／ 命中率：${full?b.hit+'%':'未解析'} ／ 貫通：${full?b.pen:'未解析'}</p><p>行動特性：${full?(BOSS_DOSSIER_V1[id]?'詳細は特殊能力欄を参照':escapeHTML(b.special)):partial?'一部の行動を観測済み。完全解析で詳細公開。':'情報不足。探索で情報を収集してください。'}</p><p>固有装備：${show?escapeHTML(id==='police'?'指揮官のヘッドセット・城塞のライオットシールド・猟犬のバックパック':BOSS_REWARD_LABEL[id]||W[b.gear]?.n||A[b.gear]?.n||'未判明'):'未判明'} ／ 初回報酬：${st.first?'取得済み':'未取得'} ／ 2回目以降：討伐・生還時20%抽選</p><h3>距離別戦闘学習</h3>${['近距離','中距離','遠距離'].map((label,i)=>{const v=st.learning?.stats?.[i]||{};return `<p>${label}：観測射撃 ${fmt(v.shots)}回 ／ 被弾 ${fmt(v.hits)}回 ／ 被害 ${fmt(v.damage)}</p>`}).join('')}<p class="muted">戦闘学習の記録は観測済みデータのみ表示します。未調査の能力は開示されません。</p></div>${g.status==='base'&&unlocked&&!roaming?`<div class="btns"><button data-action="bossPrepare:${id}" class="primary">この地区の出撃準備へ</button></div>`:''}</section>`;
}
AREA_ART["power"]="data:image/webp;base64,";
const EXTRA_BOSS_ART_POWER="data:image/jpeg;base64,";
AREA_ART["school"]="data:image/webp;base64,";
const EXTRA_BOSS_ART_SCHOOL="data:image/jpeg;base64,";
AREA_ART["temple"]="data:image/webp;base64,";
const EXTRA_BOSS_ART_TEMPLE="data:image/jpeg;base64,";
AREA_ART["park"]="data:image/webp;base64,";
const EXTRA_BOSS_ART_PARK="data:image/jpeg;base64,";
AREA_ART["zoo"]="data:image/webp;base64,";
const EXTRA_BOSS_ART_ZOO="data:image/jpeg;base64,";
const BOSS_INTRO={"suburban":"かつての商業地区を縄張りとする、冷酷な掃討者。獲物を見つけると散弾銃による強烈な先制射撃を浴びせ、反撃の隙を与えず追撃を重ねる。荒廃した街区で生き残ってきたその戦い方には、一切の容赦がない。","industrial":"工業倉庫地区を徘徊する、重装甲の巨漢。分厚い装甲に身を包み、巨大なハンマーを引きずりながら獲物へと迫る。その動きは鈍重だが、一度間合いに入れば、凄まじい破壊力を持つ一撃が待ち受けている。銃弾を浴びてもなお歩みを止めないその姿から、いつしか「ブルドーザー」と呼ばれるようになった。","metro":"地下鉄廃駅の暗闇に潜む、正体不明の戦闘員。物音ひとつ立てずに姿を現し、短機関銃による連続射撃で侵入者を迎え撃つ。その真の脅威は、驚異的な戦闘適応能力にある。交戦を重ねるほど相手の動きを読み、銃撃をかわす精度を高めていく。長期戦になればなるほど、ファントムを捉えることは困難になる。","hospital":"荒廃した病院に居座る、素性不明の医療従事者。その手に握られているのは、治療のためではなく、獲物を傷つけるための毒メス。毒に侵された相手を執拗に追い詰め、致命傷を負っても異常な回復力で戦闘を続行する。彼がかつて何を研究し、なぜ病院に残り続けているのか。その答えを知る者はいない。","port":"港湾コンテナ地区を狩場とする、凄腕の狙撃手。入り組んだコンテナ群の高所から侵入者を監視し、標的が姿を現した瞬間、正確無比な一撃を放つ。その射撃は頭部を執拗に狙い、わずかな隙も見逃さない。彼の存在に気づいたときには、すでに照準の中に捉えられているかもしれない。","airport":"空港に現れる早撃ちの達人。弾倉が空になるまで攻撃の手を緩めない。","mall":"ミニガンを操る制圧の専門家。連射は加速するが過熱に隙がある。","tower":"機動力と貫通射撃を兼ね備えた狙撃手。遠距離で真価を発揮する。","police":"指揮官・重装兵・偵察兵の三人組。役割の異なる連携攻撃が持ち味。","lab":"研究施設の最深部で待ち受ける最終標的。追い詰めるほど危険になる。"};

// Apply approved boss biographies after BOSS_INTRO initialization.
Object.assign(BOSS_INTRO,{"school":"廃校となった学校を縄張りとする、謎の女剣士。その手には、美しい桜の名を冠した日本刀「桜花」が握られている。銃火器が支配する荒廃した都市において、彼女はただ一振りの刀で敵と対峙する。常人には捉えきれない速度で間合いを詰め、敵の攻撃を紙一重でかわしながら、鋭い斬撃を繰り出す。なかでも、静かな構えから一瞬で放たれる「居合」は、彼女の最も危険な技である。その華麗な剣技に見惚れたとき、すでに勝負は決しているかもしれない。","temple":"荒廃した寺院に居座る、巨躯の重装戦闘員。その身を包む「金剛法衣」は、並大抵の銃撃では貫くことのできない強固な防具である。愛用する特製銃「不動明王」から放たれる破甲弾は、敵の装甲を容赦なく打ち砕く。鈍重ながらも一歩たりとも退かず、正面からの攻撃を受け止めながら、侵入者を確実に追い詰めていく。しかし、その鉄壁の防御にも弱点は存在する。圧倒的な装甲に守られた巨体と、わずかに残された急所。その弱点を見抜けるかどうかが、金剛との戦いの明暗を分ける。","park":"廃墟となった遊園地を縄張りとする、奇妙なウサギの仮面をつけた二人組。Mr.バニーとMrs.バニー。その正体や二人の関係は明らかになっていない。かつて子供たちの笑い声が響いていた遊園地は、今や彼らの危険な遊び場と化している。Mr.バニーは毒性のガスを撒き散らし、Mrs.バニーは爆発物を投げつける。二人は互いの攻撃を補うように、絶え間なく侵入者を追い詰めていく。楽しげな仮面の奥に、どのような表情が隠されているのかを知る者はいない。この遊園地では、招かれざる客も彼らの遊び相手にされてしまう。","zoo":"荒廃した動物園を縄張りとする、女性狙撃手と一頭の虎。冷静沈着な女性「マダム」と、彼女に付き従う獰猛な虎「タイガー」。マダムは愛銃「ハントレス」で獲物を正確に狙い、タイガーは鋭い牙と爪で侵入者に襲いかかる。人間と猛獣という異色の組み合わせながら、その連携は極めて危険だ。タイガーが獲物に深い傷を負わせると、マダムはその出血を見逃さず、さらに強烈な一撃を撃ち込む。かつて動物たちの楽園だった場所は、今や彼女たちの狩猟場と化している。檻の外にいるからといって、狩られる側ではないとは限らない。","power":"荒廃した発電所を拠点とする、不気味な笑顔の仮面をつけた謎の女性。地下研究施設に潜む「ゼロ」の側近として知られるが、その素顔や過去を知る者はほとんどいない。常に笑みを浮かべた仮面を身につけており、その奥にどのような表情が隠されているのかは分からない。愛用する特製アサルトライフル「ワイルドカード」は、使用者の状態に応じて性能を変化させる特殊な武器。戦闘の序盤では正確な射撃で敵を追い詰め、負傷が深まると攻撃の激しさを増していく。追い詰められてなお、その不気味な笑顔が消えることはない。最後に切り札を握るのは、果たしてどちらなのか。","cinema":"廃墟となった映画館を拠点とする、謎のカルト教団を率いる女性。その素顔や過去は明らかになっておらず、信者たちからはただ「教祖」と呼ばれている。かつて多くの観客が映画を楽しんだ劇場は、今や狂信者たちが集う不気味な礼拝堂へと姿を変えた。教祖自身は拳銃を携えるものの、真の脅威は彼女に絶対的な忠誠を誓うカルティストたちにある。信者たちは自らの命を顧みず教祖を守り、時には侵入者を巻き込んで自爆することさえ厭わない。暗いスクリーンの前で繰り広げられる、狂気に満ちた儀式。その中心に立つ教祖は、今日も新たな犠牲者を待ち続けている。"});
Object.assign(BOSS_INTRO,{"forest": "荒廃した森林公園に潜む、正体不明の怪物。\n\nその素顔も正体も分からず、ただ巨大なチェーンソーを振り回す恐ろしい存在として知られている。\n\n森の奥から響く不気味なエンジン音。それは、怪物が獲物を見つけた合図なのかもしれない。\n\n怪物はチェーンソーによる激しい連続攻撃だけでなく、鎖を使って獲物の動きを封じる。\n\n一度捕まれば、逃れる間もなく鋭い刃が襲いかかる。\n\nかつて人々の憩いの場だった森林公園は、今や怪物の狩猟場と化している。", "office": "荒廃したオフィス街を拠点とする、3人組の女性精鋭部隊。\n\nその名は「ヴァルキリーズ」。\n\n高い機動力と強烈な一撃を誇るスルーズ、圧倒的な連射性能で敵を制圧するヒルド、優れた貫通性能で装甲を撃ち抜くシグルーン。\n\nそれぞれが北欧神話に由来する名を持つ特製武器を携え、侵入者の前に立ちはだかる。\n\n彼女たちの真の強さは、個々の戦闘能力だけではない。\n\nスルーズとヒルドは正確な制圧射撃を展開し、ヒルドとシグルーンは強固な装甲を突破する。そしてスルーズとシグルーンが並び立つとき、その攻撃はさらに激しさを増す。\n\n3人が揃う限り、戦場の主導権は彼女たちの手にある。", "stadium": "かつて数万人の観客で賑わった巨大スタジアムを支配する、炎を操る危険な戦闘員。\n\nその名は「インフェルノ」。\n\n彼が携える特殊火炎放射器「ヘルファイア」は、標的を容赦なく炎で包み込む恐るべき武器である。\n\n焼け焦げた観客席、黒く煤けた通路、熱によって歪んだ金属製の扉。\n\nスタジアムの至るところに残された焼失の痕跡が、その凄まじい破壊力を物語っている。\n\nインフェルノは炎に包まれた獲物を決して見逃さない。\n\n火傷によって動きが鈍った相手には、さらに激しい火炎を浴びせ、抵抗する力さえ奪い去る。\n\nかつて歓声が響いていた競技場には、今や炎の轟音だけが鳴り響いている。", "nightlife": "荒廃した歓楽街を支配する、ヤクザ組織の若頭。\n\nその名は「アシュラ」。\n\n髪をきっちりとオールバックに撫でつけた、鋭い眼光を持つ男。\n\nかつて華やかなネオンが街を照らしていた歓楽街は、今や彼の率いる組織が支配する無法地帯と化している。\n\nアシュラが愛用するのは、「雷神」と「風神」と名付けられた二丁のデザートイーグル。\n\n圧倒的な威力を誇る雷神と、正確な射撃で獲物を追い詰める風神。\n\n組織の若頭として数々の抗争を生き抜いてきた彼は、二丁拳銃を自在に操り、敵対する者を容赦なく排除する。\n\n追い詰められるほどに激しさを増す銃撃は、彼の凶暴な本性を物語っている。\n\n歓楽街に足を踏み入れた侵入者を待ち受けるのは、若頭アシュラによる容赦のない制裁である。", "diet": "荒廃した国会議事堂を占拠する、革命勢力の指導者。\n\nその名は「ドゥームズデイ」。\n\n立派なヒゲを蓄えた初老の男で、その鋭い眼差しには長年の闘争で培われた揺るぎない信念が宿っている。\n\nかつて国家の中枢であった国会議事堂を拠点とし、自らの理想とする新たな秩序を築くため、武装蜂起を続けている。\n\n彼が携えるのは、グレネードランチャーを搭載した特製アサルトライフル「ラスプーチン」。\n\n年齢を感じさせない力強さで銃を操り、激しい連続射撃と爆発物によって敵対者を圧倒する。\n\n彼にとって、この戦いは単なる生存競争ではない。\n\n腐敗した旧体制を打ち倒し、自らの信じる革命を成し遂げるための聖戦なのだ。\n\n国会議事堂に足を踏み入れる者は、革命に人生を捧げた男の覚悟と、その圧倒的な火力を思い知ることになる。"});


// Approved narrative descriptions for dossier entries 06-10.
Object.assign(BOSS_INTRO,{
 airport:'封鎖された国際空港を縄張りとする、凄腕のガンマン。その腰には、常人には扱いきれない大口径リボルバー「処刑人のリボルバー」が収められている。敵の姿を捉えた瞬間、目にも留まらぬ速さで銃を抜き、容赦のない先制射撃を浴びせる。なかでも「デッドアイ」と呼ばれる精密射撃は、強固な装甲さえ撃ち抜くほどの威力を誇る。彼と銃を抜き合うことになった時点で、すでに勝負は始まっている。',
 mall:'荒廃したショッピングモールを支配する、重火器の使い手。その手に携えるのは、凄まじい連射性能を誇る特殊ミニガン「毒蛇のミニガン」。一度引き金を引けば、銃声は次第に激しさを増し、逃げ惑う獲物を容赦なく追い詰めていく。しかし、その圧倒的な火力には代償がある。限界まで銃身が熱を帯びた瞬間、猛攻は一時的に途絶える。そのわずかな静寂こそが、反撃の好機となる。',
 tower:'高層通信施設を縄張りとする、攻撃的な戦闘スタイルを持つ女性マークスマン。愛用する「女王蜂のマークスマンライフル」は、優れた貫通性能と高い射撃精度を兼ね備えた特注品。遠距離から獲物を正確に射抜く腕を持ちながら、彼女は決して安全な距離に留まろうとはしない。敵を発見すると自ら距離を詰め、至近距離から強烈な一撃を撃ち込む。その大胆な戦い方こそが、彼女を「クィーンビー」と呼ばせる所以である。',
 police:'かつて警察本部だった廃墟を拠点とする、3人組の精鋭戦闘部隊。指揮官のα、重装甲で仲間を守るβ、高い機動力で敵を翻弄するγ。それぞれが異なる役割を担い、統率の取れた連携戦術で侵入者を排除する。αの指揮下では部隊全員の射撃が鋭さを増し、βは身を挺して仲間を守り、γは的確な援護で味方の攻撃を支える。単独では決して無敵ではない。しかし、3人が揃ったとき、その戦闘能力は個々の力の総和を大きく上回る。彼らを攻略するには、誰から倒すかという判断が生死を分ける。',
 lab:'地下研究施設の最深部に潜む、正体不明の戦闘員。その素性、経歴、所属組織は一切不明。判明しているのは、彼が「ゼロ」と呼ばれ、地下研究施設を守る最後の存在であるという事実だけだ。愛用する「零式アサルトライフル」は、高い連射性能と優れた射撃精度を兼ね備えた特注兵器。ゼロの真の恐ろしさは、追い詰められたときに発揮される。負傷が深まるほど射撃は正確さを増し、その攻撃は威力と貫通力を高めていく。勝利を確信した瞬間こそ、最も警戒すべき時である。地下研究施設の最深部で、すべての決着をつける戦いが始まる。'
});

/* v3.6.43: Removed obsolete short-form boss intro overrides; preserve approved full dossiers. */
Object.assign(BOSS_INTRO,{
 machine:'工業地帯を転々とする重装甲の掃討者。特製の高連射ショットガン「鉄雨」で接近する敵を弾幕に沈める。',
 shadow:'暗がりに潜む装甲狙撃手。威力よりも命中精度を重視し、狙いを定めた一撃で逃げ道を封じる。',
 death:'長大な大鎌を携える処刑人。間合いの外に見えても刃が届き、斬撃による出血で獲物を追い詰める。',
 perfume:'香気を利用して戦場を操る工作員。自らの射撃を強化しながら敵の命中と防御を崩し、カービンで仕留める。'
});
// v3.6.27: approved roaming-boss dossiers 11-14 (narrative and intel display only).
Object.assign(BOSS_INTRO,{
 machine:'複数の危険地区を渡り歩く、重装甲の戦闘員。全身を覆う分厚い装甲と、特製ショットガン「鉄雨」を装備し、遭遇した敵を圧倒的な火力で排除する。その射撃は一発ごとに装甲を打ち砕くように威力を増し、強固な防具さえも容赦なく貫いていく。しかし、凄まじい連射性能を誇る「鉄雨」には弱点がある。激しい射撃の直後には再装填を余儀なくされ、わずかな隙が生まれる。重装甲による防御と破壊的な弾幕。その姿から、彼は「マシーン」と呼ばれている。',
 shadow:'廃墟となった都市を静かに徘徊する、正体不明の狙撃手。重厚な装甲に身を包み、特製の狙撃銃「影縫い」を携えている。その射撃は極めて正確で、遮蔽物のわずかな隙間さえ見逃さない。しかし、彼の真の脅威は通常の狙撃ではない。一定の間隔で射撃を止め、長い照準の末に放たれる特殊弾「魔弾」。その一撃は強固な装甲さえも貫くほどの破壊力を秘めている。狙撃手が沈黙したとき、それは決して安全を意味しない。次の一発が、獲物の運命を決める。',
 death:'巨大な大鎌を携え、廃墟となった都市を彷徨う正体不明の戦闘員。その素顔を見た者は少なく、どこから現れ、何を目的としているのかも分かっていない。愛用する「冥府の大鎌」は、通常の近接武器を上回る間合いを持つ異形の武器。ひとたびその間合いに踏み込めば、鋭い刃が容赦なく振り下ろされ、深い傷と止まらぬ出血をもたらす。銃火器を持たず、ただ一振りの大鎌だけで武装した敵に立ち向かうその姿は、まるで死そのものを体現しているかのようだ。その姿を目撃した者たちは、畏怖を込めて彼を「デス」と呼ぶ。',
 perfume:'荒廃した都市を徘徊する、特殊な香気を操る謎の戦闘員。愛用する特製カービン「芳香」と、複数の薬剤を使い分ける独特の戦闘技術を持つ。彼女が放つ香気には、それぞれ異なる作用がある。ある香りは自身の集中力を極限まで高め、ある香りは敵の感覚を狂わせ、また別の香りは防具の性能さえも低下させる。その戦い方は、単なる銃撃戦とは大きく異なる。敵が異変に気づいたときには、すでに彼女の術中にはまっているのかもしれない。甘い香りの漂う戦場で、彼女は静かに引き金を引く。'
});
const BOSS_REWARD_LABEL={temple:'不動明王・金剛法衣',office:'ミョルニル・グングニル・ヴァルハラ',zoo:'ハントレス・タイガーヘルメット',park:'バニーマスク・ボムバッグ'};
Object.assign(BOSS_REWARD_LABEL,{school:'桜花',temple:'不動明王・金剛法衣',park:'バニーマスク・ボムバッグ',zoo:'ハントレス・タイガーヘルメット',power:'ワイルドカード',cinema:'教団の聖印'});


Object.assign(BOSS_REWARD_LABEL,{machine:'鉄雨',shadow:'影縫い',death:'冥府の大鎌',perfume:'芳香',industrial:'鉄壁の重装甲・ブルドーザーハンマー'});
// Handgun additions and Akimbo pairing.
const WEAPON_INTRO={"pm":"扱いやすい小型拳銃。軽装備での出撃に向く。","tt":"貫通力を重視した旧式拳銃。","pp19":"命中しやすい短機関銃。近〜中距離の連射向き。","aks":"取り回しのよい短銃身アサルトライフル。","ak":"威力と貫通力のバランスに優れた主力銃。","sks":"一発の重さを重視するセミオートライフル。","sweeper":"掃討者が愛用する近距離特化の散弾銃。","phantom":"機動戦と連射を得意とする特殊SMG。","hawkeye":"遠距離から高精度の一撃を放つ狙撃銃。","gunslinger":"一撃必殺を狙う大口径リボルバー。","viper":"連射数が増していく特殊ミニガン。","queenbee":"高い貫通力を持つ機動型マークスマンライフル。","alpha":"部隊指揮官の高精度カービン。","gamma":"機敏な偵察兵が使う連射型SMG。","zero":"追い込まれるほど火力を増す特殊ライフル。","kedr":"低価格で弾数を稼げる小型SMG。","mp5":"命中性能に優れた扱いやすいSMG。","pps43":"安価な連射火器。精度より手数を重視。","p90":"高い連射数で敵を圧倒するPDW。","ak105":"扱いやすさを高めた短銃身AK。","m4a1":"連射と貫通のバランスがよい汎用ライフル。","aug":"命中性能に優れたブルパップ式ライフル。","adar":"命中精度を重視した単発式カービン。","rpk74":"継続射撃で制圧する軽機関銃。","vpo136":"単発火力の高い民生型ライフル。","scarh":"高威力・高貫通のバトルライフル。","mosin":"強烈な単発威力を誇るボルトアクション銃。","svd":"遠距離から連続射撃できる狙撃銃。","mp133":"一発に賭けるポンプアクション散弾銃。","mp153":"連続射撃で押し切る半自動散弾銃。","saiga12":"連射と扱いやすさを両立した散弾銃。","knife":"携行しやすい基本の近接武器。","hatchet":"重い一撃を放つ近接武器。","machete":"威力と命中のバランスがよい近接武器。"};
Object.assign(WEAPON_INTRO,{glock17:'9×19mm対応。高い命中精度と多い装弾数が特徴のハンドガン。',deserteagle:'.50 AE対応。高威力だが命中精度は控えめな大型ハンドガン。'});

const BOSS_BADGE_ART={"suburban":"data:image/webp;base64,","industrial":"data:image/webp;base64,","metro":"data:image/webp;base64,","school":"data:image/webp;base64,","hospital":"data:image/webp;base64,","mall":"data:image/webp;base64,","zoo":"data:image/webp;base64,","park":"data:image/webp;base64,","temple":"data:image/webp;base64,","airport":"data:image/webp;base64,","port":"data:image/webp;base64,","tower":"data:image/webp;base64,","police":"data:image/webp;base64,","power":"data:image/webp;base64,","lab":"data:image/webp;base64,","machine":"data:image/webp;base64,","shadow":"data:image/webp;base64,","death":"data:image/webp;base64,","perfume":"data:image/webp;base64,"};
Object.assign(BOSS_BADGE_ART,{hospital: "data:image/webp;base64,",power: "data:image/webp;base64,",shadow: "data:image/webp;base64,",diet: "data:image/webp;base64,",nightlife: "data:image/webp;base64,",stadium: "data:image/webp;base64,",office: "data:image/webp;base64,",cinema: "data:image/webp;base64,",forest: "data:image/webp;base64,"});
function bossBadge(id,kills){return Number(kills)>0&&BOSS_BADGE_ART[id]?`<img class="boss-earned-badge" src="${BOSS_BADGE_ART[id]}" alt="${escapeHTML(BOSSES[id]?.n||id)}討伐バッジ" title="${escapeHTML(BOSSES[id]?.n||id)} 討伐済み" loading="lazy">`:``;}
function roamingBossCards(){return `<section class="panel"><h2>徘徊型ボス情報</h2><p class="muted">既存地区に低確率で出現する特殊ボス。専用討伐レイド・地区解放条件には含まれません。長期探索では遭遇後に自動戦闘し、生存時は探索を継続します。</p>${Object.keys(ROAMING_BOSSES).map(id=>{const x=BOSSES[id],st=g.bosses[id]||{kills:0,first:false};return `<div class="item"><div class="flex between"><b class="boss-badge-name">${bossBadge(id,st.kills)}<span>${escapeHTML(x.n)} — 徘徊型</span></b><span class="pill">討伐・生還 ${st.kills||0}回</span></div><p>${escapeHTML(BOSS_INTRO[id])}</p><p><small>出現地区：${ROAMING_AREAS[id].map(k=>escapeHTML(MAP[k]?.n||k)).join('・')}</small></p><p><small>戦闘特性：${escapeHTML(x.special)} ／ 固有装備：${escapeHTML(BOSS_REWARD_LABEL[id])}</small></p><p><small>初回討伐・生還：固有装備確定 ／ 2回目以降：20％抽選</small></p></div>`}).join('')}</section>`}
const PURSUER_PORTRAIT='data:image/jpeg;base64,';
function pursuerBossCard(){
 const p=pursuerState();
 const remaining=Math.min(10,Math.max(0,Math.floor(p.revive||0)));
 const defeated=p.hp<=0&&remaining>0;
 const completed=10-remaining;
 const cells=Array.from({length:10},(_,i)=>`<span class="pursuer-revive-cell ${i<completed?'done':'pending'}" aria-label="${i+1}回目 ${i<completed?'経過済み':'未経過'}">${i<completed?'✓':i+1}</span>`).join('');
 return `<section class="panel"><h2>追跡者</h2><div class="item"><img class="pursuer-boss-image" src="${PURSUER_PORTRAIT}" alt="追跡者" loading="lazy"><p>完全討伐 ${p.kills||0}回 ／ 現在HP ${p.hp}/1000</p><h3>復活までのレイド進行</h3>${defeated?`<p><strong>残り${remaining}レイド</strong>（${completed}/10回終了）</p><div class="pursuer-revive-grid" role="img" aria-label="復活まで残り${remaining}レイド、10マス中${completed}マス経過">${cells}</div><p class="muted">レイドを1回終了するごとに1マス進行。10回終了後、次の通常レイドから復活します。</p>`:p.hp>0?`<p>現在活動中です。完全討伐後に10マスの復活カウントが始まります。</p>`:`<p>復活準備完了。次の通常レイドから出現します。</p>`}</div></section>`;
}
function bossView(){return `<section class="panel"><h2>ボス情報・マップ解放</h2><p class="muted">調査は死亡しても保持。固有報酬・バッジ・地区解放は討伐後の生還で確定します。</p>${DISTRICT_TIERS.flat().map(id=>[id,BOSSES[id]]).filter(([id,b])=>!!b).map(([id,b])=>{const st=g.bosses[id],unlocked=!!g.unlocked[id],full=bossFull(id),partial=bossKnown(id);return `<div class="item"><div class="flex between"><b class="boss-badge-name">${bossBadge(id,st.kills)}<span>${unlocked?'✓':'🔒'} ${MAP[id].n} — ${b.n}</span></b><span class="pill">${bossEffectiveIntel(id)}/${b.full} 情報</span></div><p class="muted">${escapeHTML(BOSS_INTRO[id]||"危険な武装勢力の指揮官。")}</p><p><small>専用討伐 ${partial&&unlocked?'解放済':'未解放'}（必要${b.intel}） ／ 生還討伐 ${st.kills}回 </small></p><p><small>${full?`HP${b.hp} 防御${b.def} 回避${b.ev} / ${b.special}`:partial?'一部情報：HP・防御値は推定。特殊行動は未解明。':'情報不足。通常レイドで調査してください。'}</small></p><p><small>固有装備：${id==='police'?'指揮官のヘッドセット・城塞のライオットシールド・猟犬のバックパック（初回3種確定）':BOSS_REWARD_LABEL[id]||W[b.gear]?.n||A[b.gear]?.n} / 以降20%</small></p></div>`}).join('')}<p class="muted">旧ボスの討伐実績は維持されます。</p></section>${achievementBadgePanel()}${roamingBossCards()}${pursuerBossCard()}${royalCollectionView()}${collectionView()}`}

const MOD={survival:{n:'生存重視',enc:1,loot:1},normal:{n:'通常',enc:1,loot:1},value:{n:'戦利品価格重視',enc:1,loot:1},gear:{n:'装備品重視',enc:1,loot:1},capacity:{n:'バッグ容量重視',enc:1,loot:1},cautious:{n:'生存重視',enc:1,loot:1},greedy:{n:'戦利品価格重視',enc:1,loot:1}};
const EXPLORE_TARGETS={5:'浅い探索',10:'通常探索',15:'深部探索',20:'危険区域',25:'最深部',30:'未踏区域'};
function explorePlan(r){const mode=r.mode==='cautious'?'survival':r.mode==='greedy'?'value':r.mode;const target=Math.max(5,Math.min(30,Number(r.settings.exploreTarget)||15));return {mode,target,limit:Math.min(30,target+(['value','gear','capacity'].includes(mode)?5:0))}}
function explorationGoal(r){const p=explorePlan(r);if(r.explore<p.target)return null;if(p.mode==='survival'||p.mode==='normal')return '探索目標達成';if(r.explore>=p.limit)return '追加探索の上限';if(p.mode==='gear'&&(r.gearLoot||[]).length>0)return '装備品を獲得';if(p.mode==='capacity'&&raidUsedSlots(r)>=backpackCap(r))return 'バッグ満杯';if(p.mode==='value'){const found=Object.entries(r.loot||{}).reduce((sum,[id,n])=>sum+(L[id]?.price||0)*n,0)+(r.gearLoot||[]).reduce((sum,x)=>sum+gearPrice(x),0);const expected=(MAP[r.map]?.tier?.[2]||.1)*100000+20000;if(found>=expected)return '戦利品価格目標達成'}return null}

const fmt=x=>Math.floor(x||0).toLocaleString('ja-JP');const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));const escapeHTML=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const initial=()=>({version:VERSION,revision:0,status:'base',cleared:false,money:100000,hp:100,xp:0,level:1,bank:{weapons:{pm:1,pp19:1,mp133:1,aks:1},armors:{light:2,standard:1,heavy:1},helmets:{light:2,combat:1,heavy:1},bags:{small:2,medium:1,large:1},ammo:{'9x18':100,'9x19':100,'12ga':100,'545':100},loot:{},key:false},equipped:{weapon:'pm',armor:'light',helmet:'light',bag:'small'},dur:{light:60,standard:80,heavy:100},raid:null,raidId:0,industrialCount:0,keyUnlocked:false,history:[],collection:{},reportPending:false,stats:{raids:0,wins:0,losses:0,kills:0,earned:0,revivals:0},recoveryMs:0,incomeMs:0,baseAt:Date.now(),notice:'ようこそ。初期装備と100,000₽を用意しました。',settings:{map:'suburban',raidType:'normal',bossPolicy:'fight',bossTactic:'normal',cerberusPriority:'commander',targetPriority:'lowhp',mode:'normal',exploreTarget:15,hp:50,bag:80,loot:30000,ammo:25,time:10},createdAt:Date.now(),gear:[{id:'gear-1',type:'weapon',base:'pm',rarity:'common',affixes:[],favorite:false,dur:W['pm'].max||null},{id:'gear-2',type:'bag',base:'small',rarity:'common',affixes:[],favorite:false,dur:B['small'].max||null},{id:'gear-3',type:'armor',base:'light',rarity:'common',affixes:[],favorite:false,dur:A['light'].max||null},{id:'gear-4',type:'helmet',base:'light',rarity:'common',affixes:[],favorite:false,dur:H['light'].max||null},{id:'gear-5',type:'armor',base:'light',rarity:'common',affixes:[],favorite:false,dur:A['light'].max||null},{id:'gear-6',type:'helmet',base:'light',rarity:'common',affixes:[],favorite:false,dur:H['light'].max||null},{id:'gear-7',type:'armor',base:'standard',rarity:'common',affixes:[],favorite:false,dur:A['standard'].max||null},{id:'gear-8',type:'helmet',base:'combat',rarity:'common',affixes:[],favorite:false,dur:H['combat'].max||null},{id:'gear-9',type:'armor',base:'heavy',rarity:'common',affixes:[],favorite:false,dur:A['heavy'].max||null},{id:'gear-10',type:'helmet',base:'heavy',rarity:'common',affixes:[],favorite:false,dur:H['heavy'].max||null},{id:'gear-11',type:'bag',base:'small',rarity:'common',affixes:[],favorite:false,dur:B['small'].max||null},{id:'gear-12',type:'bag',base:'medium',rarity:'common',affixes:[],favorite:false,dur:B['medium'].max||null},{id:'gear-13',type:'bag',base:'large',rarity:'common',affixes:[],favorite:false,dur:B['large'].max||null},{id:'gear-14',type:'weapon',base:'pp19',rarity:'common',affixes:[],favorite:false,dur:W['pp19'].max||null},{id:'gear-15',type:'weapon',base:'mp133',rarity:'common',affixes:[],favorite:false,dur:W['mp133'].max||null},{id:'gear-16',type:'weapon',base:'aks',rarity:'common',affixes:[],favorite:false,dur:W['aks'].max||null}],nextGearId:17,eqIds:{weapon:'gear-1',secondary:null,melee:null,armor:'gear-3',helmet:'gear-4',bag:'gear-2'},gearStats:{found:0,returned:0,lost:0},settingsGear:{priority:'gear'}});
let g,tab='base',ticker=0;let selectedBoss='airport';// Dual persistence: Documents/WebKit may discard file:// localStorage between launches.
const TOKYOV_IDB='tokyov_save_v266', TOKYOV_STORE='saves';
let tokIDB=null, tokSaveQueue=Promise.resolve(), tokBootPending=true, tokPersistentWarning='';
let tokWarningDismissed=false,tokLocalOK=false,tokLatestPayload=null,tokLastSaved=0,tokMaxRevision=0,tokPersist='未確認',tokResetting=false;
const tokStatus={local:'未確認',db:'未確認',opfs:'未確認'};
const tokTimeout=(p,ms=5000)=>new Promise((res,rej)=>{const t=setTimeout(()=>rej(Error('timeout')),ms);Promise.resolve(p).then(v=>{clearTimeout(t);res(v)},e=>{clearTimeout(t);rej(e)})});
function tokOpenDB(){return new Promise((resolve,reject)=>{if(!window.indexedDB)return reject(Error('IndexedDB unavailable'));const req=indexedDB.open(TOKYOV_IDB,1);req.onupgradeneeded=()=>{if(!req.result.objectStoreNames.contains(TOKYOV_STORE))req.result.createObjectStore(TOKYOV_STORE)};req.onsuccess=()=>{const db=req.result;db.onversionchange=()=>{db.close();if(tokIDB===db)tokIDB=null};resolve(db)};req.onerror=()=>reject(req.error||Error('IndexedDB open failed'))})}
function tokDBGet(db){return new Promise((resolve,reject)=>{const tx=db.transaction(TOKYOV_STORE,'readonly');const req=tx.objectStore(TOKYOV_STORE).get(KEY);req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error);tx.onabort=()=>reject(Error('read aborted'))})}
function tokDBPut(db,payload){return new Promise((resolve,reject)=>{const tx=db.transaction(TOKYOV_STORE,'readwrite');tx.objectStore(TOKYOV_STORE).put(payload,KEY);tx.oncomplete=()=>resolve(true);tx.onerror=()=>reject(tx.error||Error('write failed'));tx.onabort=()=>reject(tx.error||Error('write aborted'))})}
function tokValid(x){return x&&x.version===VERSION&&x.bank&&x.equipped&&x.settings&&Array.isArray(x.gear)&&Number.isFinite(x.money)}
function tokRevision(x){return Number(x?.revision)||0}
function tokParse(raw){try{const x=JSON.parse(raw);return tokValid(x)?x:null}catch(e){return null}}
async function tokDB(){if(!tokIDB)tokIDB=await tokTimeout(tokOpenDB());return tokIDB}
async function tokFile(create=false){if(!navigator.storage?.getDirectory)throw Error('OPFS unavailable');const root=await navigator.storage.getDirectory();return root.getFileHandle(KEY+'.json',{create})}
async function tokOPRead(){try{return await (await (await tokFile()).getFile()).text()}catch(e){if(e.name==='NotFoundError')return null;throw e}}
async function tokOPWrite(payload){const h=await tokFile(true);const w=await h.createWritable();try{await w.write(payload);await w.close()}catch(e){try{await w.abort()}catch(_){}throw e}if(await (await h.getFile()).text()!==payload)throw Error('OPFS verification failed')}
function tokLocalWrite(payload){try{localStorage.setItem(KEY,payload);if(localStorage.getItem(KEY)!==payload)throw Error('verification failed');tokStatus.local='成功';tokLocalOK=true;tokLastSaved=Date.now();return true}catch(e){tokStatus.local='失敗';tokLocalOK=false;return false}}
async function tokPersistRequest(){try{tokPersist=await navigator.storage?.persisted?.()?'許可済み':await navigator.storage?.persist?.()?'許可済み':'未許可・非対応'}catch(e){tokPersist='利用不可'}}
function tokWarn(message,show=true){tokPersistentWarning=message;console.warn(message);if(!show||tokWarningDismissed)return;let banner=document.getElementById('tok-save-warning');if(!banner){banner=document.createElement('div');banner.id='tok-save-warning';banner.style.cssText='position:fixed;top:calc(8px + env(safe-area-inset-top));right:8px;left:auto;max-width:85%;z-index:9999;background:#532b26;color:white;padding:8px;font-size:12px;border-radius:8px;display:flex;align-items:center;gap:8px';document.body.append(banner)}banner.textContent='保存できません。バックアップを保存してください。';const close=document.createElement('button');close.textContent='×';close.setAttribute('aria-label','警告を閉じる');close.style.cssText='padding:4px 8px;min-height:0';close.onclick=()=>{tokWarningDismissed=true;banner.remove()};banner.append(close)}
function tokSaveSuccess(){document.getElementById('tok-save-warning')?.remove();tokWarningDismissed=false;}

async function tokWriteAll(payload){const localOK=payload===tokLatestPayload?tokLocalWrite(payload):false;const results=await Promise.all([ (async()=>{try{const db=await tokDB();await tokTimeout(tokDBPut(db,payload));if(await tokTimeout(tokDBGet(db))!==payload)throw Error('verification failed');tokStatus.db='成功';return true}catch(e){tokStatus.db='失敗';try{tokIDB?.close()}catch(_){}tokIDB=null;return false}})(),(async()=>{try{await tokOPWrite(payload);tokStatus.opfs='成功';return true}catch(e){tokStatus.opfs='失敗・非対応';return false}})()]);const ok=localOK||results.some(Boolean);if(ok)tokLastSaved=Date.now();if(payload===tokLatestPayload){if(ok){tokSaveSuccess();tokPersistentWarning=''}else tokWarn('全保存先への書き込み失敗')}return ok}
let tokQueued=false, tokWrittenPayload=null;
function tokQueueDB(payload){tokLatestPayload=payload;if(tokQueued)return;tokQueued=true;tokSaveQueue=tokSaveQueue.catch(()=>{}).then(async()=>{try{while(tokWrittenPayload!==tokLatestPayload){const p=tokLatestPayload;const ok=await tokWriteAll(p);tokWrittenPayload=p;if(!ok)break}}finally{tokQueued=false}})}
async function tokBoot(){const candidates=[];let unread=false;function add(raw,source){if(raw==null){tokStatus[source]='データなし';return}const x=tokParse(raw);if(x){candidates.push(x);tokStatus[source]='読込成功'}else{unread=true;tokStatus[source]='不正データ'}}try{add(localStorage.getItem(KEY),'local')}catch(e){unread=true;tokStatus.local='読込失敗'}await Promise.all([(async()=>{try{add(await tokTimeout(tokDBGet(await tokDB())),'db')}catch(e){unread=true;tokStatus.db='読込失敗';tokIDB=null}})(),(async()=>{try{add(await tokTimeout(tokOPRead()),'opfs')}catch(e){tokStatus.opfs='読込不可・非対応'}})()]);candidates.sort((a,b)=>tokRevision(b)-tokRevision(a));const chosen=candidates[0];if(chosen){g=migrateUniqueLoot(ensureBossState(chosen));g.level=levelFor(g.xp||0);tokMaxRevision=tokRevision(chosen);tokLastSaved=Number(chosen.savedAt)||0;window.__tokyovSaveReadError=false}else{window.__tokyovSaveReadError=true;tokPersistentWarning=unread?'保存先の読み込み失敗。自動保存停止。':'保存データなし。自動保存停止。'}tokBootPending=false;if(chosen){advance();save()}render();tokPersistRequest()}
function save(){if(tokBootPending||tokResetting||window.__tokyovSaveReadError||!g)return false;try{g.revision=tokMaxRevision=Math.max(tokMaxRevision+1,tokRevision(g)+1,Date.now());g.savedAt=Date.now();const payload=JSON.stringify(g);tokLocalWrite(payload);tokQueueDB(payload);return true}catch(e){tokWarn('保存データの作成失敗');return false}}
function tokSaveDiagnostics(){return `最終確認保存：${tokLastSaved?new Date(tokLastSaved).toLocaleString('ja-JP'):'未確認'} / localStorage: ${tokStatus.local} / IndexedDB: ${tokStatus.db} / OPFS: ${tokStatus.opfs} / 永続化: ${tokPersist}`}

function migrateUniqueLoot(x){
  // Run exactly once per save. Preserve one copy and reimburse excess at old sale prices.
  if(x.uniqueLootMigrationDone)return x;
  x.bank=x.bank||{};x.bank.loot=x.bank.loot||{};
  let refund=0;
  for(const id of ['memory','research']){
    const n=Math.max(0,Math.floor(Number(x.bank.loot[id])||0));
    if(n>1)refund+=(n-1)*L[id].price;
    x.bank.loot[id]=Math.min(1,n);
  }
  x.money=(Number(x.money)||0)+refund;
  x.uniqueLootMigrationDone=true;
  if(refund)x.notice=`重要任務品の余剰分を売却額で精算：+${fmt(refund)}₽。各1個を保管しました。`;
  return x;
}
function load(){try{let raw=localStorage.getItem(KEY);if(!raw){raw=localStorage.getItem('tokyov_offline_v14')||localStorage.getItem('tokyov_offline_v13')||localStorage.getItem('tokyov_offline_v12');if(!raw)return initial();const old=JSON.parse(raw);if(old.version===4||old.version===3)return migrateUniqueLoot(ensureBossState({...old,version:5}));if(old.version!==2)throw Error('旧形式が不正');return migrateUniqueLoot(ensureBossState({...migrate(old),version:5}))}const x=JSON.parse(raw);if(x.version!==VERSION||!x.bank||!x.equipped||!x.settings||!Array.isArray(x.gear)||!Number.isFinite(x.money))throw Error('invalid');if(x.status==='cleared'){x.status='base';x.cleared=true}x.level=levelFor(x.xp||0);return migrateUniqueLoot(ensureBossState(x))}catch(e){window.__tokyovSaveReadError=true;alert('セーブデータを読み込めませんでした。既存データを保護するため自動保存を停止しました。バックアップから復元してください。');return initial()}}
function migrate(x){x.version=VERSION;x.cleared=x.status==='cleared';if(x.cleared)x.status='base';x.gear=[];x.nextGearId=1;x.eqIds={weapon:null,secondary:null,melee:null,armor:null,helmet:null,bag:null};x.gearStats={found:0,returned:0,lost:0};x.settingsGear={priority:'gear'};for(const [type,bankType,defs] of [['weapon','weapons',W],['armor','armors',A],['bag','bags',B]]){for(const [id,num] of Object.entries(x.bank[bankType]||{})){if(!defs[id]||id==='none')continue;for(let i=0;i<Math.max(0,Math.min(1000,Math.floor(num)));i++){const gear={id:'gear-'+x.nextGearId++,type,base:id,rarity:'common',affixes:[],favorite:false,dur:type==='armor'?(x.dur[id]??defs[id].max):null};x.gear.push(gear);if(x.equipped[type]===id&&!x.eqIds[type])x.eqIds[type]=gear.id}}}if(x.status==='raid'&&x.raid){x.raid.equipment={weapon:x.gear.find(y=>y.id===x.eqIds.weapon)||null,armor:x.gear.find(y=>y.id===x.eqIds.armor)||null,bag:x.gear.find(y=>y.id===x.eqIds.bag)||null};x.raid.gearLoot=[];x.raid.firstShotUsed=false;x.raid.armorSpecialUsed=false}return x}
g=ensureBossState(initial());if(!g.v19Migrated){g.bank.supplies=g.bank.supplies||{};g.bank.loot=g.bank.loot||{};for(const [oldId,newId] of [['bandage','bandage'],['medkit','med']]){const qty=Math.max(0,Math.floor(g.bank.loot[oldId]||0));g.bank.supplies[newId]=(g.bank.supplies[newId]||0)+qty;g.bank.loot[oldId]=0;}g.carry={};g.ammoCarry=g.ammoCarry||{};g.v19Migrated=true;if(g.status==='raid'&&g.raid){g.raid.v19Legacy=true;}}let raidPane='current',stashFilter='all',stashSort='new',historyFilter='all',historyDetailId=null,compareId=null,detailId=null,selectedBulk=new Set();function rand(r){let t=r.seed=(r.seed+0x6D2B79F5)>>>0;t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);return ((t^(t>>>14))>>>0)/4294967296}function roll(r,p){return rand(r)<clamp(p,0,1)}function pick(r,arr){return arr[Math.floor(rand(r)*arr.length)]}function log(r,s){if(r._deferHitStatus&&/(出血|毒(?!蛇)|火傷|骨折|【状態異常】|【怯み】|【戦闘効果・怯み】)/.test(s)){(r._hitStatusQueue||(r._hitStatusQueue=[])).push(s);return;}r.log.push(s);if(r.log.length>MAX_LOG)r.log.shift()}function flushHitStatus(r){const pending=r._hitStatusQueue||[];r._hitStatusQueue=[];for(const msg of pending)log(r,msg)}
function tokCombatLogType(line){
 const t=String(line??'');
 if(/戦闘ターン|第\d+ターン|ROUND|ラウンド開始|【ターン/.test(t))return ['round','TURN'];
 if(/追跡者|重い足音|追っている気配|背後で金属/.test(t)&&/接近|足音|気配|撤退|遭遇|襲撃|追跡|復活/.test(t))return ['stalker','追跡者'];
 if(/^ヴァイパー：/.test(t))return ['enemy','敵'];
 if(/怯み/.test(t))return ['support','戦闘効果'];
 if(/出血|毒|火傷|骨折|状態異常|麻痺/.test(t))return ['status','状態異常'];
 if(/回復|治療|包帯|止血帯|解毒薬|医療キット|救急キット/.test(t))return ['heal','回復・治療'];
 // Enemy names are not necessarily the literal word '敵' (e.g. 哨戒隊長, 分隊長).
 if(/^(?:敵の攻撃|【敵の強襲攻撃】|[^：\n]{1,55}：(?:[^\n]*?(?:\d+\/\d+発目|リロード|攻撃休止|射撃|命中|攻撃|近接攻撃|\-\d+HP)))/.test(t)
   || /^(?:SCAV|RAIDER|ELITE|PMC以外|哨戒|分隊|追跡者)/.test(t)&&/攻撃|発目|リロード|射撃|HP/.test(t))return ['enemy','敵'];
 if(/リロード|再装填|装填|弾切れ|ジャム|冷却|撤退|脱出|発見|獲得|戦利品|帰還|探索|確定/.test(t))return ['system','補助・探索'];
 if(/攻撃|命中|ダメージ|射撃|連射|ヘッドショット|斬撃|近接|ミス|回避|発射/.test(t))return ['player','プレイヤー'];
 return ['system','記録'];
}
function tokCombatLogHTML(line){
 const [kind,label]=tokCombatLogType(line);
 return `<p class="tok-log-line tok-log-${kind}"><span class="tok-log-label">【${label}】</span>${escapeHTML(String(line??''))}</p>`;
}
// Lv1–10 keep original thresholds. Beyond Lv10: +1000, +1100, ... XP per level.
const LEVEL_CAP=50;
function xpThreshold(level){if(level<=1)return 0;if(level<=10)return 50*(level-1)*(level-1);const steps=level-10;return 4050+1000*steps+50*steps*(steps-1)}
function levelFor(x){let n=1;while(n<LEVEL_CAP&&x>=xpThreshold(n+1))n++;return n}
function levelAccuracyBonus(lv=g.level){return 2*(Math.min(lv,10)-1)+Math.max(0,lv-10)*.5}
function levelLootBonus(lv=g.level){return (Math.min(lv,10)-1)+Math.floor(Math.max(0,lv-10)/5)}
function levelDodgeBonus(lv=g.level){return Math.floor((lv-1)/2)}
function levelHpBonus(lv=g.level){return 2*(lv-1)}
function baseMaxHp(){return 100+levelHpBonus()+((typeof g!=='undefined'&&g)?tokAccessoryValue(equippedGear('accessory'),'maxhp'):0)}
const TOK_PMC_STYLES={standard:{name:'スタンダード',desc:'標準型',hit:0,dodge:0,damage:0,pen:0},marksman:{name:'マークスマン',desc:'精密射撃型',hit:10,dodge:-10,damage:0,pen:0},defender:{name:'ディフェンダー',desc:'防御型',hit:-10,dodge:10,damage:0,pen:0},assault:{name:'アサルト',desc:'強襲型',hit:0,dodge:-10,damage:15,pen:0},skirmisher:{name:'スカーミッシャー',desc:'機動型',hit:0,dodge:15,damage:-15,pen:0},breacher:{name:'ブリーチャー',desc:'装甲突破型',hit:-10,dodge:0,damage:0,pen:10},triggerhappy:{name:'トリガーハッピー',desc:'弾幕型',hit:-5,dodge:0,damage:0,pen:0}};
function tokPmcStyleId(r){const id=r?.pmcStyle??g?.pmcStyle;return Object.prototype.hasOwnProperty.call(TOK_PMC_STYLES,id)?id:'standard';}
function tokNiferEnabled(r){
 const get=slot=>r?raidGear(r,slot):equippedGear(slot);
 const armor=get('armor'),helmet=get('helmet'),bag=get('bag');
 if(!armor||armor.base!=='light'||helmet||!bag||bag.base!=='small')return false;
 const weapons=['weapon','secondary','melee'].map(get).filter(Boolean);
 if(weapons.length!==1)return false;
 const x=weapons[0];return !!(MELEE[x.base]||AKIMBO_HANDGUNS.has(x.base));
}
function tokPmcStyle(r){
 if(r&&akimboEnabled(r))return {name:'アキンボ',desc:'二丁拳銃',hit:0,dodge:0,damage:0,pen:0};
 if(tokNiferEnabled(r))return {name:'ナイファー',desc:'軽装型',hit:0,dodge:10,damage:0,pen:0};
 return TOK_PMC_STYLES[tokPmcStyleId(r)];
}
function tokPmcStyleDodge(r){return tokPmcStyle(r).dodge/100;}
function baseDodgeChance(){return levelDodgeBonus()/100}
// v3.6.112: base armor tradeoffs; only standard armor types, no boss/series gear changes.
function tokArmorMobility(r){const id=raidGear(r,'armor')?.base||r.armor;return id==='light'?{dodge:.10,escape:12}:id==='standard'?{dodge:.04,escape:4}:id==='heavy'?{dodge:-.07,escape:-12}:{dodge:0,escape:0};}


