TOK_EQUIPMENT_IMAGES['armor:ex_bison_rig']='data:image/jpeg;base64,';
</script>

<style id="tok-intel-pmc-tabs-v354">
.tok-boss-mode-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:12px 0}
.tok-boss-mode-tabs button{min-width:0;padding:11px 8px;border-radius:8px;border:1px solid #557083;background:#182b37;color:#e7eff5;font-weight:700;cursor:pointer}
.tok-boss-mode-tabs button.on{border-color:#dfc47d;background:#344451;color:#fff}
.tok-mil-dossier .boss-targets{margin-top:8px}
.tok-mil-dossier .boss-target-row{width:100%}
.pmc-record-screen .pmc-record-nav:first-of-type{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;overflow:visible!important;flex-wrap:wrap!important}
.pmc-record-screen .pmc-record-nav:first-of-type button{min-width:0!important;width:100%!important;white-space:normal!important;overflow-wrap:anywhere!important;padding:9px 4px!important;font-size:clamp(10px,2.9vw,14px)!important}
.pmc-record-screen .pmc-record-nav:first-of-type button:first-child{grid-column:1/-1!important;width:100%!important}
</style>
<script>
/* v3.6.54 — Information Room boss dossiers and PMC mode navigation */
(function(){
 let tokBossIntelMode='normal';
 let tokMilIntelSelected=1;
 const floorNames=['ハリネズミ','ベルゼバブ','ハリケーン','トラッパー','バイソン'];
 const rewardNames=['バスティオン','ハイヴ','ベルセルク','ボンバーズアイ','猛牛のアーマーリグ'];
 const bossAbilities=[
  '暴力的な弾幕：3連射、各弾の威力は通常攻撃の50%。1発以上命中すると30%で怯み（次の攻撃命中率−20pt）。3ターン攻撃後、4ターン目にリロード。',
  '攻撃ドローン：奇数ターンに70%で固定10ダメージ。妨害ドローン：偶数ターンに80%で妨害。ドローンガード：被弾時30%でダメージ20軽減。',
  '狂戦士：HP110以下で攻撃＋15・命中＋10・防御−15。近距離まで接近して両手斧で攻撃。',
  'グレネードを2ターン連続使用し、3ターン目は休止。地雷は最大1個設置し、距離変更成功時に固定35ダメージ。',
  'LMG二丁持ち：PKPを左右各3連射、合計6発を独立判定。追加命中率−15pt。2回攻撃後、リロードに2ターン必要。'
 ];
 const priorBossBattleScreen=bossBattleScreen;
 const tabs=()=>'<div class="tok-boss-mode-tabs" role="group" aria-label="ボス情報の分類">'+
  '<button type="button" data-action="tokBossIntel:normal" class="'+(tokBossIntelMode==='normal'?'on':'')+'">通常レイド</button>'+
  '<button type="button" data-action="tokBossIntel:military" class="'+(tokBossIntelMode==='military'?'on':'')+'">軍事施設</button></div>';
 const esc=x=>escapeHTML(String(x==null?'':x));
 function militaryDossier(){
  const m=tokMilState();
  const buttons=TOK_MIL_FLOORS.map((f,i)=>{
   const n=i+1,cleared=!!(m.cleared?.includes(n)||m.kills?.[n]);
   return '<button type="button" class="boss-target-row '+(tokMilIntelSelected===n?'selected':'')+'" data-action="tokMilIntelFloor:'+n+'" aria-pressed="'+(tokMilIntelSelected===n)+'"><span class="boss-target-name">'+n+'F '+esc(f[1])+'</span><span class="boss-target-place">'+esc(f[0])+'</span><span class="boss-target-state">'+(cleared?'討伐済':'未討伐')+'</span></button>';
  }).join('');
  const floor=Math.min(20,Math.max(1,tokMilIntelSelected));
  const f=TOK_MIL_FLOORS[floor-1];
  const wins=Number(m.kills?.[floor]||0);
  const known=floor<=5;
  const weapon=known?['暴力的な弾幕','TT トカレフ','ベルセルク','PM マカロフ','PKP ペチェネグ ×2'][floor-1]:(W[f[8]]?.n||f[8]||'未設定');
  return '<section class="panel tok-mil-dossier"><div class="boss-panel-title">TACTICAL INTELLIGENCE / MILITARY FACILITY</div><h2>ボス情報</h2>'+tabs()+
   '<p class="muted">Ex軍事施設 1〜20Fの階層ボスを選択できます。</p><div class="boss-targets"><div class="boss-tier"><div class="boss-tier-list">'+buttons+'</div></div></div></section>'+
   '<section class="panel tok-mil-dossier"><h2>'+floor+'F '+esc(f[1])+'</h2><p class="muted">'+esc(f[0])+' ／ 討伐記録 '+wins+'回</p>'+
   '<div class="boss-readout">'+[['HP',f[2]],['攻撃',f[3]],['防御',f[4]],['命中',f[5]+'%'],['回避',f[6]+'%'],['貫通',f[7]]].map(([k,v])=>'<div class="boss-metric"><span>'+k+'</span><b>'+esc(v)+'</b></div>').join('')+'</div>'+
   '<div class="item"><h3>使用武器</h3><p>'+esc(weapon)+'</p></div>'+
   (known?'<div class="item"><h3>固有能力</h3><p>'+esc(bossAbilities[floor-1])+'</p></div><div class="item"><h3>固有報酬</h3><p>'+esc(rewardNames[floor-1])+'（BOSS UNIQUE）</p><p class="muted">初回討伐確定、2回目以降20%抽選。</p></div>':
   '<div class="item"><h3>階層情報</h3><p class="muted">この階層の詳細な固有能力・報酬は、既存の軍事施設仕様に従います。</p></div>')+
   '</section>';
 }
 bossBattleScreen=function(){
  if(tokBossIntelMode==='military')return militaryDossier();
  const original=priorBossBattleScreen();
  // Insert the new mode selector in the normal dossier header, including pursuer.
  const host=document.createElement('div');host.innerHTML=original;
  const first=host.querySelector('section.panel');
  if(first){
   const heading=first.querySelector('h2');
   if(heading)heading.insertAdjacentHTML('afterend',tabs());
   else first.insertAdjacentHTML('afterbegin',tabs());
  }
  return host.innerHTML;
 };
 document.addEventListener('click',function(ev){
  const button=ev.target.closest('[data-action]');
  if(!button)return;
  const action=button.dataset.action||'';
  if(action==='tokBossIntel:normal'||action==='tokBossIntel:military'){
   ev.preventDefault();ev.stopImmediatePropagation();
   tokBossIntelMode=action.split(':')[1];render();return;
  }
  if(action.startsWith('tokMilIntelFloor:')){
   ev.preventDefault();ev.stopImmediatePropagation();
   tokMilIntelSelected=Math.min(20,Math.max(1,Number(action.split(':')[1])||1));
   tokBossIntelMode='military';render();
  }
 },true);
})();
</script>

<script>
/* v3.6.55: Military boss portrait gallery, in 1F-5F order */
const TOK_EX_BOSS_PORTRAITS=[
'data:image/jpeg;base64,',
'data:image/jpeg;base64,',
'data:image/jpeg;base64,',
'data:image/jpeg;base64,',
'data:image/jpeg;base64,',
 ];

(function(){
 const picture=(floor,small=false)=>{
  const f=Number(floor);
  if(!Number.isInteger(f)||f<1||f>5)return '';
  const name=EX_NAMES[f-1];
  return '<figure class="tok-ex-boss-photo'+(small?' compact':'')+'"><img loading="lazy" decoding="async" src="'+TOK_EX_BOSS_PORTRAITS[f-1]+'" alt="Ex軍事施設 '+f+'Fボス '+escapeHTML(name)+'"><figcaption>'+f+'F '+escapeHTML(name)+'</figcaption></figure>';
 };
 const previousBossScreen=bossBattleScreen;
 bossBattleScreen=function(){
  const result=previousBossScreen();
  if(!result.includes('tok-mil-dossier'))return result;
  const host=document.createElement('div');host.innerHTML=result;
  const dossier=host.querySelectorAll('section.tok-mil-dossier')[1];
  if(!dossier)return result;
  const heading=dossier.querySelector('h2');
  const match=heading?.textContent.match(/^\s*(\d+)F\s/);
  if(match)heading.insertAdjacentHTML('afterend',picture(Number(match[1])));
  return host.innerHTML;
 };
 const previousFloorPanel=tokMilFloorPanel;
 tokMilFloorPanel=function(){
  const result=previousFloorPanel();
  const m=tokMilState();
  if(m.mode!=='military'||m.floor>5)return result;
  const host=document.createElement('div');host.innerHTML=result;
  const floorHeading=host.querySelector('.tok-mil-floor-list');
  if(floorHeading)floorHeading.insertAdjacentHTML('afterend',picture(m.floor,true));
  return host.innerHTML;
 };
 const previousRaidView=raidView;
 raidView=function(){
  const result=previousRaidView();
  const r=g.raid;
  if(!r?.exVersion||!r.militaryFloor||r.militaryFloor>5)return result;
  const host=document.createElement('div');host.innerHTML=result;
  const first=host.querySelector('section.panel');
  if(first){
   const heading=first.querySelector('h2');
   if(heading)heading.insertAdjacentHTML('afterend',picture(r.militaryFloor,true));
  }
  return host.innerHTML;
 };
})();
</script>
<style id="tok-ex-boss-portrait-css">
.tok-ex-boss-photo{margin:12px auto 18px;max-width:520px}
.tok-ex-boss-photo img{display:block;width:100%;height:auto;max-height:590px;object-fit:contain;border-radius:12px;background:#0c1118;border:1px solid #42525d}
.tok-ex-boss-photo figcaption{text-align:center;font-weight:700;color:#dce6eb;margin-top:7px}
.tok-ex-boss-photo.compact{max-width:280px;margin:10px auto}
.tok-ex-boss-photo.compact img{max-height:280px;object-fit:cover;object-position:top}
@media(max-width:480px){.tok-ex-boss-photo{max-width:100%}.tok-ex-boss-photo img{max-height:480px}}
</style>

<script>
/* v3.6.56 — Ex Military 6F–10F bosses and boss-unique equipment */
(function(){
 const specs={
  6:{n:'ホワイトホット',hp:160,d:25,def:20,hit:80,ev:10,pen:35,weapon:'glock17'},
  7:{n:'サイレント',hp:200,d:32,def:35,hit:85,ev:30,pen:40,weapon:'ex_silent_knife'},
  8:{n:'クラッシャー',hp:280,d:35,def:65,hit:75,ev:5,pen:55,weapon:'ex_crusher_arm'},
  9:{n:'ツインファング',hp:270,d:25,def:35,hit:85,ev:10,pen:40,weapon:'ex_agyo'},
  10:{n:'教官',hp:240,d:30,def:45,hit:80,ev:20,pen:45,weapon:'m4a1'}
 };
 const rewards={6:[['helmet','ex_whiteout']],7:[['weapon','ex_silent_knife']],8:[['accessory','ex_ironheart']],9:[['weapon','ex_agyo'],['weapon','ex_ungyo']],10:[['weapon','ex_punishment']]};
 W.ex_silent_baton={n:'サイレントのコンバットナイフ',d:32,a:0,p:40,melee:true,ammoFree:true,shots:1,price:0,max:150};
 W.ex_crusher_arm={n:'油圧式パワーアーム（ボス専用）',d:35,a:0,p:55,melee:true,ammoFree:true,shots:1,price:0,max:180};
 W.ex_silent_knife={n:'サイレントナイフ',d:38,a:0,p:45,melee:true,ammoFree:true,shots:1,price:150000,max:150,fixed:true};
 W.ex_agyo={...W.mp5,n:'阿形',price:155000,fixed:true};
 W.ex_ungyo={...W.pp19,n:'吽形',price:155000,fixed:true};
 W.ex_punishment={n:'懲罰棒',d:30,a:0,p:35,melee:true,ammoFree:true,shots:1,price:155000,max:150,fixed:true};
 H.ex_whiteout={...H.thermal_goggles,n:'ホワイトアウト',price:150000,max:H.thermal_goggles.max||100};
 TOK_ACCESSORIES.ex_ironheart={n:'アイアンハート',price:160000};
 const fixed={ex_whiteout:'煙幕の命中率低下を無効化。煙幕中、命中率＋10pt',ex_silent_knife:'敵の攻撃回避時30%で即時反撃（1ターン最大1回）',ex_ironheart:'最大HP＋30、防御力＋10',ex_agyo:'命中率＋10pt',ex_ungyo:'回避率＋10pt',ex_punishment:'命中時40%で1ターンスタン（敵味方同性能）'};
 Object.assign(BOSS_FIXED,fixed);
 const bossIds=new Set(Object.keys(fixed));
 for(const item of (g?.gear||[]))if(bossIds.has(item.base))item.rarity='boss';
 const priorBossOnly=isBossOnlyGear;
 isBossOnlyGear=function(type,id){return bossIds.has(id)||priorBossOnly(type,id)};
 for(const [key,s] of Object.entries(specs)){
  const f=Number(key);TOK_MIL_FLOORS[f-1][1]=s.n;TOK_MIL_FLOORS[f-1].splice(2,7,s.hp,s.d,s.def,s.hit,s.ev,s.pen,s.weapon);EX_NAMES[f-1]=s.n;
 }
 const oldGearVal=gearVal;
 gearVal=function(x,key){let v=oldGearVal(x,key);if(key==='accuracy'&&x?.base==='ex_agyo')v+=10;if(key==='accuracy'&&x?.base==='ex_whiteout'&&(g?.raid?.smokeTurns||0)>0)v+=10;return v};
 const oldAccessory=tokAccessoryValue;
 tokAccessoryValue=function(item,key){if(item?.base==='ex_ironheart'){if(key==='maxhp')return 30;if(key==='defense')return 10}return oldAccessory(item,key)};
 const oldAccessoryBonus=tokAccessoryBonus;
 tokAccessoryBonus=function(r,key){let v=oldAccessoryBonus(r,key);if(key==='evasion'&&(raidGear(r,'weapon')?.base==='ex_ungyo'||raidGear(r,'secondary')?.base==='ex_ungyo'))v+=10;return v};
 const oldThermal=tokThermal;
 tokThermal=function(r,unit,isPlayer){if(isPlayer&&raidGear(r,'helmet')?.base==='ex_whiteout')return true;if(!isPlayer&&unit?._exWhitehot)return true;return oldThermal(r,unit,isPlayer)};
 const oldSmoke=tokSmokePenalty;
 tokSmokePenalty=function(r,unit,isPlayer){if(r?._exAlwaysSmoke){return tokThermal(r,unit,isPlayer)?0:30}return oldSmoke(r,unit,isPlayer)};
 const oldChainHit=tokChainOnHit;
 tokChainOnHit=function(r,e){oldChainHit(r,e);if(raidGear(r,r.activeSlot||'weapon')?.base==='ex_punishment'&&e&&e.hp>0&&roll(r,.40)){e._exStun=1;log(r,'【懲罰棒】電撃スタン：敵の次の行動を封じる')}};
 const oldDrop=tokMilEquipmentDrop;
 tokMilEquipmentDrop=function(r,floor){if(floor<6||floor>10)return oldDrop(r,floor);const [type,id]=rewards[floor][0];return createReward(r,type,id,floor)};
 function createReward(r,type,id,floor){const x=makeGear(r,type,id,'boss');x.affixes=[];x.sourceBoss='military-'+floor;if(type==='weapon'||type==='helmet')x.dur=GEARTYPE[type][id].max||100;return x}
 function giveRewards(r,floor){const count=Number(tokMilState().kills[floor]||0);for(const [type,id] of rewards[floor]){if(count===0||roll(r,.20)){const x=createReward(r,type,id,floor);(r.gearLoot||(r.gearLoot=[])).push(x);log(r,'【ボス固有ドロップ】'+gearName(x)+'を獲得')}else log(r,'【ボス固有ドロップ】'+GEARTYPE[type][id].n+'：今回はドロップなし')}}
 // Keep all boss attack calculations within the existing enemyStrike path.
 function strike(r,e,weapon,damage,hit,pen){
  const key=weapon||e.enemyWeapon;
  const base=W[key];if(!base)return;
  const old=W[key];W[key]={...base,d:damage,p:pen??e.pen,a:0};
  try{enemyStrike(r,{...e,enemyWeapon:key,hit:hit??e.hit,_weaponState:e})}finally{W[key]=old}
 }
 function applyBossStun(r,damageBefore,source){if(r.hp<damageBefore&&roll(r,.40)){r._exPlayerStun=1;log(r,'【'+source+'】電撃制圧：次のプレイヤー行動をスタンで封じる')}}
 function playerTurn(r,units){
  const alive=units.filter(e=>e.hp>0);if(!alive.length)return;
  if(r._exPlayerStun){r._exPlayerStun=0;log(r,'【スタン】攻撃・投擲・距離変更不可（1ターン）');return}
  const thrown=throwGrenade(r,alive,'boss');if(thrown)return;
  const target=groupAttackPolicy(r,alive)||alive[0];
  // Existing playerAttack handles distance, ammo, reload, armor, attachments and durability.
  if(target._exStun){/* enemy stun is resolved in enemy phase */}
  if(target._exCounter){target._sakuraBoss=true;target._sakuraDodged=false}
  const damage=playerAttack(r,target,target.hp);target.hp=Math.max(0,target.hp-damage);
  if(target._exCounter&&target._sakuraDodged&&roll(r,.50)&&!r._exBossCounterThisTurn){r._exBossCounterThisTurn=true;log(r,'【サイレント】合気の達人：回避反撃');strike(r,target,'ex_silent_knife',38,85,45)}
 }
 function bossTurn(r,units,turn,floor){
  if(floor!==9&&units[0]?._exStun){units[0]._exStun=0;log(r,'【懲罰棒】'+units[0].n+'はスタンで行動不能');return}
  if(floor===6){const e=units[0];if(e.hp<=0)return;const active=r._exMarkTurns>0;const before=r.hp;strike(r,e,'glock17',active?35:25,active?95:80,35);if(r.hp<before){r._exMarkTurns=2;log(r,'【ホワイトホット】熱源マーキング：次の攻撃から攻撃＋10／命中＋15pt（2ターン）')}else if(active)r._exMarkTurns--;return}
  if(floor===7){const e=units[0];if(e.hp<=0)return;if(r.combatDistance!==0){if(roll(r,.70)){r.combatDistance=Math.max(0,r.combatDistance-1);log(r,'【サイレント】接近成功')}else log(r,'【サイレント】接近失敗');return}const before=r.hp;strike(r,e,'ex_silent_knife',38,85,45);if(r.hp<before&&roll(r,.30)){r._exPlayerStun=1;log(r,'【サイレント】制圧術：1ターン拘束')}return}
  if(floor===8){const e=units[0];if(e.hp<=0)return;if(r.combatDistance!==0){if(roll(r,.65)){r.combatDistance=Math.max(0,r.combatDistance-1);log(r,'【クラッシャー】接近成功')}else log(r,'【クラッシャー】接近失敗');return}const power=turn%3===0?Math.floor(35*1.5):35;const hit=turn%3===0?60:75;if(turn%3===0)log(r,'【クラッシャー】油圧駆動：威力150%、命中−15pt');const before=r.hp;strike(r,e,'ex_crusher_arm',power,hit,55);if(r.hp<before&&turn%3!==0&&roll(r,.30)){r._exArmorBreak=2;log(r,'【クラッシャー】粉砕打撃：防御力−20（2ターン）')}return}
  if(floor===9){const alive=units.filter(x=>x.hp>0);if(!alive.length)return;const combo=alive.length===2&&roll(r,.30);if(combo)log(r,'【ツインファング】クロスファイア');let hits=0;const attackers=combo?alive:[alive[(turn-1)%alive.length]];for(const e of attackers){if(e._exStun){e._exStun=0;log(r,'【懲罰棒】'+e.n+'はスタンで行動不能');continue}const before=r.hp;strike(r,e,e.enemyWeapon,e.d,e.hit,e.pen);if(r.hp<before)hits++}if(combo&&hits===2){r.hp=Math.max(0,r.hp-10);log(r,'【クロスファイア】連携命中：固定10ダメージ')}return}
  if(floor===10){const e=units[0];if(e.hp<=0)return;const boost=Math.min(20,Math.floor((turn-1)/3)*5);if(turn===4||turn===7||turn===10)log(r,'【教官】戦闘教練：命中率＋'+boost+'pt');if(r.combatDistance===0){const before=r.hp;strike(r,e,'ex_punishment',30,80+boost,35);applyBossStun(r,before,'教官')}else if(turn%3===0){if(roll(r,.75)){r.combatDistance=Math.max(0,r.combatDistance-1);log(r,'【教官】スタンバトンで接近')}else log(r,'【教官】接近失敗')}else{strike(r,e,'m4a1',30,80+boost,45)}return}
 }
 const previous=tokMilBossBattle;
 tokMilBossBattle=function(r){
  const floor=r.militaryFloor;if(floor<6||floor>10)return previous(r);
  tokPrepareEncounterReload(r);const s=specs[floor];
  const units=floor===9?[
   {n:'ツインファング・制圧型',kind:'boss',hp:150,maxHp:150,d:25,def:35,hit:85,ev:10,pen:40,enemyWeapon:'ex_agyo',actions:0,magActions:0,flashTurns:0},
   {n:'ツインファング・機動型',kind:'boss',hp:120,maxHp:120,d:22,def:20,hit:75,ev:35,pen:35,enemyWeapon:'ex_ungyo',actions:0,magActions:0,flashTurns:0}
  ]:[{n:s.n,kind:'boss',hp:s.hp,maxHp:s.hp,d:s.d,def:s.def,hit:s.hit,ev:s.ev,pen:s.pen,enemyWeapon:s.weapon,actions:0,magActions:0,flashTurns:0,pursuit:15}];
  if(floor===6){units[0]._exWhitehot=true;r._exAlwaysSmoke=true;r.smokeTurns=3;log(r,'【ホワイトホット】常時煙幕：サーマル装備以外は命中率−30pt')}
  if(floor===7)units[0]._exCounter=true;
  r.bossEncountered=true;r.militaryBossRarity='boss';r.combatDistance=Number.isInteger(r.combatDistance)?r.combatDistance:1;
  log(r,'【Ex軍事施設 '+floor+'F ボス】'+s.n+' '+(floor===9?'制圧型HP150／機動型HP120':'HP'+s.hp));
  try{
   for(let turn=1;turn<=12;turn++){
    if(!hasCombatWeapon(r))break;
    turnCare(r);if(r.hp<=0)return 'dead';
    r._exBossCounterThisTurn=false;
    if(floor===6)r.smokeTurns=3;
    if(floor===8&&r._exArmorBreak>0){r._exArmorDebuffActive=true;r._exArmorBreak--;}else r._exArmorDebuffActive=false;
    const originalArmorDef=armorDef;
    if(r._exArmorDebuffActive)armorDef=function(...args){return Math.max(0,originalArmorDef(...args)-20)};
    try{playerTurn(r,units);if(r.hp>0&&units.some(x=>x.hp>0))bossTurn(r,units,turn,floor)}finally{armorDef=originalArmorDef}
    if(floor===9&&units.filter(x=>x.hp>0).length===1&&!r._exRevenge){const e=units.find(x=>x.hp>0);e.d+=10;e.hit+=10;e.ev+=10;r._exRevenge=true;log(r,'【ツインファング】復讐の牙：攻撃＋10／命中＋10pt／回避＋10pt')}
    if(units.every(x=>x.hp<=0)){
     r.kills+=floor===9?2:1;r.xp+=45+floor*12;r.militaryBossWon=true;giveRewards(r,floor);log(r,'【階層制覇】'+s.n+'を撃破！ '+floor+'Fクリア');return 'won'
    }
    if(r.hp<=0)return 'dead';
    if(!hasCombatWeapon(r)||r.hp<=Math.max(8,Math.floor((r.maxHp||baseMaxHp())*.2)))break;
  }
  log(r,'【ボス未撃破】'+s.n+'から撤退を試みる');const result=escapeCombat(r,units.find(x=>x.hp>0)||units[0]);return result==='dead'||result==='final'?'dead':'escaped';
  }finally{r._exAlwaysSmoke=false;r._exArmorDebuffActive=false;r._exMarkTurns=0;r._exPlayerStun=0;r._exArmorBreak=0;r.smokeTurns=0}
 };
 // Avoid double kill increments: the original v3.6.55 1F–5F wrapper only increments for <=5.
 // Military information-room display: extend known dossiers to 10F without changing 11F–20F.
 const oldDossier=bossBattleScreen;
 bossBattleScreen=function(){let html=oldDossier();if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
  const f=Number((html.match(/<h2>(\d+)F /)||[])[1]);if(!(f>=6&&f<=10))return html;
  const details={6:['グロック17／サーマルゴーグル','常時煙幕：煙幕の命中率−30ptが常時有効（サーマル装備は無効化）。熱源追跡：命中時2ターンのマーキング、次の攻撃から攻撃＋10／命中＋15pt。','ホワイトアウト'],7:['サイレントナイフ','合気の達人：攻撃回避時50%で即時反撃（1ターン1回）。制圧術：通常攻撃命中時30%で1ターン拘束。','サイレントナイフ'],8:['油圧式パワーアーム','粉砕打撃：通常攻撃命中時30%で防御−20（2ターン）。油圧駆動：3ターンに1回、威力150%、命中−15pt。','アイアンハート'],9:['阿形（MP5ベース・制圧型）／吽形（PP-19ベース・機動型）','制圧型：HP150／攻25／防35／命85／回10／貫40。機動型：HP120／攻22／防20／命75／回35／貫35。クロスファイア：両者生存中30%で連携、両者命中で固定10ダメージ。復讐の牙：相棒撃破で攻撃＋10／命中＋10pt／回避＋10pt。','阿形・吽形'],10:['M4A1／懲罰棒','電撃制圧：懲罰棒命中時40%で1ターンスタン。戦闘教練：4・7・10ターン目に命中＋5／10／15pt。','懲罰棒']}[f];
  const escape=s=>escapeHTML(s);const section='<div class="item"><h3>固有能力</h3><p>'+escape(details[1])+'</p></div><div class="item"><h3>固有報酬</h3><p>'+escape(details[2])+'（BOSS UNIQUE）</p><p class="muted">初回確定、以降各20%独立抽選。</p></div>';
  return html.replace(/<div class="item"><h3>階層情報<\/h3>[\s\S]*?<\/div>/,section).replace(/<div class="item"><h3>使用武器<\/h3><p>[\s\S]*?<\/p><\/div>/,'<div class="item"><h3>使用武器</h3><p>'+escape(details[0])+'</p></div>')
 };
})();

</script>

<script>
/* v3.6.57: 6F-10F boss portraits and six boss-unique item images */
(function(){
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EQUIPMENT_IMAGES['helmet:ex_whiteout']='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES['weapon:ex_silent_knife']='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES['accessory:ex_ironheart']='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES['weapon:ex_agyo']='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES['weapon:ex_ungyo']='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES['weapon:ex_punishment']='data:image/jpeg;base64,';

 const names={6:'ホワイトホット',7:'サイレント',8:'クラッシャー',9:'ツインファング',10:'教官'};
 function portrait(f,compact){
   if(!names[f]||!TOK_EX_BOSS_PORTRAITS[f-1])return '';
   return '<figure class="tok-ex-boss-photo'+(compact?' compact':'')+'"><img loading="lazy" decoding="async" src="'+TOK_EX_BOSS_PORTRAITS[f-1]+'" alt="Ex軍事施設 '+f+'F '+names[f]+'"><figcaption>'+f+'F '+names[f]+'</figcaption></figure>';
 }
 const originalBossScreen=bossBattleScreen;
 bossBattleScreen=function(){
   const result=originalBossScreen();
   if(!result.includes('tok-mil-dossier'))return result;
   const host=document.createElement('div');host.innerHTML=result;
   const dossier=host.querySelectorAll('section.tok-mil-dossier')[1];
   const match=dossier?.querySelector('h2')?.textContent.match(/^\s*(\d+)F\s/);
   const floor=Number(match?.[1]);
   if(floor>=6&&floor<=10){
     const heading=dossier.querySelector('h2');
     if(heading&&!dossier.querySelector('.tok-ex-boss-photo'))heading.insertAdjacentHTML('afterend',portrait(floor,false));
   }
   return host.innerHTML;
 };
 const originalFloorPanel=tokMilFloorPanel;
 tokMilFloorPanel=function(){
   const result=originalFloorPanel();const m=tokMilState();
   if(m.mode!=='military'||m.floor<6||m.floor>10)return result;
   const host=document.createElement('div');host.innerHTML=result;
   const list=host.querySelector('.tok-mil-floor-list');
   if(list&&!host.querySelector('.tok-ex-boss-photo'))list.insertAdjacentHTML('afterend',portrait(m.floor,true));
   return host.innerHTML;
 };
 const originalRaidView=raidView;
 raidView=function(){
   const result=originalRaidView();const r=g.raid;
   if(!r?.exVersion||!r.militaryFloor||r.militaryFloor<6||r.militaryFloor>10)return result;
   const host=document.createElement('div');host.innerHTML=result;
   const heading=host.querySelector('section.panel h2');
   if(heading&&!host.querySelector('.tok-ex-boss-photo'))heading.insertAdjacentHTML('afterend',portrait(r.militaryFloor,true));
   return host.innerHTML;
 };
})();
</script>
<script>
/* v3.6.59 — Ex military 15F Blood Brothers: two units, command, revenge, unique reward */
(function(){
 const floor=15, name='ブラッドブラザーズ';
 const f=TOK_MIL_FLOORS[floor-1];
 f[1]=name;f.splice(2,7,320,30,40,75,20,45,'scarh');EX_NAMES[floor-1]=name;
 TOK_ACCESSORIES.ex_brothers_tags={n:'兄弟のドッグタグ',price:180000};
 BOSS_FIXED.ex_brothers_tags='攻撃力＋15／回避率＋15pt';
 const prevBossOnly=isBossOnlyGear;
 isBossOnlyGear=function(type,id){return id==='ex_brothers_tags'||prevBossOnly(type,id)};
 const oldAccessory=tokAccessoryValue;
 tokAccessoryValue=function(item,key){if(item?.base==='ex_brothers_tags'){if(key==='attack')return 15;if(key==='evasion')return 15}return oldAccessory(item,key)};
 for(const item of g?.gear||[])if(item.base==='ex_brothers_tags')item.rarity='boss';
 const oldDrop=tokMilEquipmentDrop;
 tokMilEquipmentDrop=function(r,f){if(f!==15)return oldDrop(r,f);const x=makeGear(r,'accessory','ex_brothers_tags','boss');x.affixes=[];x.sourceBoss='military-15';return x};
 const prev=tokMilBossBattle;
 function strike(r,e){enemyStrike(r,{...e,_weaponState:e});e.actions=(e.actions||0)+1}
 tokMilBossBattle=function(r){
  if(r.militaryFloor!==15)return prev(r);
  tokPrepareEncounterReload(r);
  const brother={n:'ブラッドブラザーズ・兄（指揮官）',kind:'boss',hp:120,maxHp:120,d:20,def:25,hit:80,ev:15,pen:30,enemyWeapon:'vpo136',actions:0,magActions:0,flashTurns:0,pursuit:15};
  const younger={n:'ブラッドブラザーズ・弟（戦闘担当）',kind:'boss',hp:200,maxHp:200,d:30,def:40,hit:75,ev:20,pen:45,enemyWeapon:'scarh',actions:0,magActions:0,flashTurns:0,pursuit:15};
  const units=[brother,younger];
  r.bossEncountered=true;r.militaryBossRarity='boss';
  log(r,'【Ex軍事施設 15F】ブラッドブラザーズ：兄 HP120（VPO-136）／弟 HP200（SCAR-H）');
  let revenge=false;
  for(let turn=1;turn<=12;turn++){
   if(!hasCombatWeapon(r))break;
   turnCare(r);if(r.hp<=0)return 'dead';
   const command=brother.hp>0&&younger.hp>0&&turn%2===1;
   const active=units.filter(e=>e.hp>0);
   if(!active.length)break;
   // Respect the player’s multi-enemy attack priority setting.
   const thrown=throwGrenade(r,active,'boss');
   if(!thrown){
    const target=groupAttackPolicy(r,active)||active[0];
    const originalEvasion=target.ev;
    if(target===younger&&command)target.ev+=15;
    try{target.hp=Math.max(0,target.hp-playerAttack(r,target,target.hp))}finally{target.ev=originalEvasion}
   }
   if(brother.hp<=0&&younger.hp>0&&!revenge){revenge=true;log(r,'【血の復讐】兄の撃破で弟の攻撃力＋20／命中率＋15pt（戦闘終了まで）')}
   if(units.every(e=>e.hp<=0)){
    r.kills+=2;r.xp+=45+floor*12;r.militaryBossWon=true;
    const kills=Number(tokMilState().kills[floor]||0);
    if(kills===0||roll(r,.20)){
     const x=makeGear(r,'accessory','ex_brothers_tags','boss');x.affixes=[];x.sourceBoss='military-15';
     (r.gearLoot||(r.gearLoot=[])).push(x);
     log(r,'【ボス固有ドロップ】兄弟のドッグタグを獲得');
    }else log(r,'【ボス固有ドロップ】兄弟のドッグタグ：今回はドロップなし');
    log(r,'【階層制覇】ブラッドブラザーズを撃破！ 15Fクリア');return 'won';
   }
   if(brother.hp>0){
    if(turn%2===1)log(r,'【兄の号令】弟の攻撃力＋15／回避率＋15pt（このターン限定）');
    else strike(r,brother);
   }
   if(r.hp<=0)return 'dead';
   if(younger.hp>0){
    const attack={...younger};
    if(revenge){attack.d+=20;attack.hit+=15}
    else if(command&&brother.hp>0){attack.d+=15;attack.ev+=15}
    enemyStrike(r,{...attack,_weaponState:younger});younger.actions++;
   }
   if(r.hp<=0)return 'dead';
   if(!hasCombatWeapon(r)||r.hp<=Math.max(8,Math.floor((r.maxHp||baseMaxHp())*.2)))break;
  }
  log(r,'【ボス未撃破】ブラッドブラザーズから撤退を試みる');
  const result=escapeCombat(r,units.find(e=>e.hp>0)||younger);
  return result==='dead'||result==='final'?'dead':'escaped';
 };
 const prevDossier=bossBattleScreen;
 bossBattleScreen=function(){let html=prevDossier();if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY')||!/<h2>15F /.test(html))return html;
  const section='<div class="item"><h3>兄弟の戦闘能力</h3><p>兄（指揮官）：HP120／攻20／防25／命80%／回15%／貫30／VPO-136。弟（戦闘担当）：HP200／攻30／防40／命75%／回20%／貫45／SCAR-H。</p></div><div class="item"><h3>固有能力</h3><p>兄の号令：奇数ターンに弟の攻撃＋15・回避＋15pt（当該ターンのみ）。偶数ターンは兄も射撃。血の復讐：兄撃破後、弟の攻撃＋20・命中＋15pt（戦闘終了まで）。</p></div><div class="item"><h3>固有報酬</h3><p>兄弟のドッグタグ（アクセサリー）：攻撃＋15／回避＋15pt。初回確定、以降20%。</p></div>';
  return html.replace(/<div class="item"><h3>階層情報<\/h3>[\s\S]*?<\/div>/,section);
 };
})();
</script>
<script>
/* v3.6.60 — Ex 11F–14F: bespoke encounters and unique equipment */
(function(){
 const defs=[
  [11,'テスラ',200,35,35,85,15,40,'svd'],
  [12,'実験体28号',180,25,20,80,15,35,'aug'],
  [13,'クロノス',220,25,25,80,35,35,'mp5'],
  [14,'オールドワン',180,35,20,85,15,60,'mosin']
 ];
 for(const [floor,name,hp,d,def,hit,ev,pen,weapon] of defs){
  const f=TOK_MIL_FLOORS[floor-1];f.splice(1,8,name,hp,d,def,hit,ev,pen,weapon);EX_NAMES[floor-1]=name;
 }
 W.ex_tesla_railgun={n:'レールガン',d:70,a:-10,p:80,price:250000,shots:1,ammoFree:true,fixed:true,max:80};
 A.ex_ghost_cloak={...A.standard,n:'ゴーストクローク',price:180000};
 TOK_ACCESSORIES.ex_chrono_watch={n:'クロノウォッチ',price:160000};
 H.ex_whiteout={...H.thermal_goggles,n:'ホワイトアウト'};
 ATTACH.ex_old_scope={n:'オールドスコープ',slot:'sight',prices:[160000,160000,160000,160000]};
 ATT_EFFECT.ex_old_scope=[15,15,15,15];
 Object.assign(BOSS_FIXED,{ex_tesla_railgun:'充電→発射→冷却の3ターン周期。攻撃70／貫通80／耐久80',ex_ghost_cloak:'タクティカルアーマー相当／回避＋15pt',ex_chrono_watch:'回避＋10pt',ex_old_scope:'狙撃銃の命中＋15pt'});
 const oldBossOnly=isBossOnlyGear;
 isBossOnlyGear=function(type,id){return ['ex_tesla_railgun','ex_ghost_cloak','ex_chrono_watch','ex_old_scope'].includes(id)||oldBossOnly(type,id)};
 const oldAccessory=tokAccessoryValue;
 tokAccessoryValue=function(item,key){if(item?.base==='ex_chrono_watch'&&key==='evasion')return 10;return oldAccessory(item,key)};
 const oldGearVal=gearVal;
 gearVal=function(x,key){return oldGearVal(x,key)+(x?.base==='ex_ghost_cloak'&&key==='evasion'?15:0)};
 const oldAttEffect=attEffect;
 attEffect=function(x,key,dist){let v=oldAttEffect(x,key,dist);if(key==='accuracy'&&attInstalled(x).some(a=>a.base==='ex_old_scope'))v+=15;return v};
 const oldSmoke=tokSmokePenalty;
 tokSmokePenalty=function(r,unit,isPlayer){if(r?.militaryFloor===11&&r._exTeslaSmoke){if(isPlayer)return tokThermal(r,unit,true)?0:30;return 0}return oldSmoke(r,unit,isPlayer)};
 const oldThermal=tokThermal;
 tokThermal=function(r,unit,isPlayer){return isPlayer&&raidGear(r,'helmet')?.base==='ex_whiteout'||oldThermal(r,unit,isPlayer)};
 const oldMelee=meleeAttack;
 meleeAttack=function(r,e,dist){if(e?.exPhase){log(r,'【物質透過】近接攻撃（1発）の命中を回避');return 0}return oldMelee(r,e,dist)};
 const oldAttack=playerAttack;
 playerAttack=function(r,e,hp){
  if(r.weapon!=='ex_tesla_railgun'){const dealt=oldAttack(r,e,hp);return r.militaryFloor===11&&r._exTeslaCharge?Math.floor(dealt*.7):dealt;}
  r._exRailgunCycle=(r._exRailgunCycle||0)%3+1;
  if(r._exRailgunCycle===1){log(r,'【レールガン】充電中（攻撃なし）');return 0}
  if(r._exRailgunCycle===3){log(r,'【レールガン】冷却中（攻撃なし）');return 0}
  log(r,'【レールガン】電磁加速弾発射');return oldAttack(r,e,hp);
 };
 const oldDrop=tokMilEquipmentDrop;
 tokMilEquipmentDrop=function(r,floor){
  if(floor<11||floor>14)return oldDrop(r,floor);
  const id={11:'ex_tesla_railgun',12:'ex_ghost_cloak',13:'ex_chrono_watch',14:'ex_old_scope'}[floor];
  let item;
  if(floor===14)item={id:'gear-'+g.nextGearId++,type:'attachment',base:id,rarity:'boss',affixes:[],favorite:false};
  else item=makeGear(r,{11:'weapon',12:'armor',13:'accessory'}[floor],id,'boss');
  item.affixes=[];item.sourceBoss='military-'+floor;
  if(floor===11)item.dur=80;
  if(floor===12)item.dur=A.standard.max;
  return item;
 };
 const oldBattle=tokMilBossBattle;
 tokMilBossBattle=function(r){
  const floor=r.militaryFloor;if(floor<11||floor>14)return oldBattle(r);
  tokPrepareEncounterReload(r);
  const [place,name,hp,d,def,hit,ev,pen,weapon]=TOK_MIL_FLOORS[floor-1];
  const e={n:name,kind:'boss',hp,maxHp:hp,d,def,hit,ev,pen,enemyWeapon:weapon,actions:0,magActions:0,flashTurns:0,pursuit:15};
  r.bossEncountered=true;r.militaryBossRarity='boss';
  log(r,`【Ex軍事施設 ${floor}F】${name} HP${hp}`);
  let marked=0,aimed=false;
  try{
   for(let turn=1;turn<=12;turn++){
    if(!hasCombatWeapon(r))break;
    turnCare(r);if(r.hp<=0)return 'dead';
    if(floor===12){r.combatDistance=Math.floor(rand(r)*3);log(r,`【ゴーストウォーク】距離が${['近距離','中距離','遠距離'][r.combatDistance]}に変化`)}
    if(floor===11){r._exTeslaCharge=turn%3===1}
    const attack={...e};
    if(floor===11&&turn%3===1){log(r,'【敵】テスラ：電磁障壁を展開（被ダメージ30%軽減）');}
    if(floor===12)attack.exPhase=true;
    const beforeDistance=r.combatDistance;
    const hpBeforeGrenade=e.hp;     const thrown=throwGrenade(r,[e],'boss');     if(thrown&&floor===11&&r._exTeslaCharge&&e.hp<hpBeforeGrenade){const raw=hpBeforeGrenade-e.hp;const reduced=Math.floor(raw*.7);e.hp=hpBeforeGrenade-reduced;log(r,`【電磁障壁】投擲ダメージ ${raw} → ${reduced}`)}     if(thrown&&floor===12){if(e.hp<hpBeforeGrenade)e.hp=hpBeforeGrenade;log(r,'【物質透過】投擲攻撃の1発目を確定回避')}     if(!thrown)e.hp=Math.max(0,e.hp-playerAttack(r,attack,e.hp));     if(floor===14&&beforeDistance!==r.combatDistance){aimed=true;log(r,'【狙撃手の直感】距離変更成功を察知：次の攻撃の命中率＋15pt')}
    if(e.hp<=0){
     r.kills++;r.xp+=45+floor*12;r.militaryBossWon=true;
     const kills=Number(tokMilState().kills[floor]||0);
     if(kills===0||roll(r,.20)){
      const item=tokMilEquipmentDrop(r,floor);
      (r.gearLoot||(r.gearLoot=[])).push(item);
      log(r,`【ボス固有ドロップ】${{11:'レールガン',12:'ゴーストクローク',13:'クロノウォッチ',14:'オールドスコープ'}[floor]}を獲得`);
     }else log(r,'【ボス固有ドロップ】今回はドロップなし');
     log(r,`【階層制覇】${name}を撃破！ ${floor}Fクリア`);return 'won';
    }
    if(floor===11){
     if(turn%3===1){log(r,'【敵】テスラ：レールガン充電中（攻撃なし）');}
     else if(turn%3===2){
      log(r,'【敵】テスラ：電磁加速砲を発射');
      const strike={...e,d:70,hit:75,pen:80,enemyWeapon:null};
      enemyStrike(r,strike);
     }else log(r,'【敵】テスラ：電磁加速砲の冷却中（攻撃なし）');
    }else if(floor===13&&[5,10].includes(turn)){
     r.hp=Math.max(0,r.hp-70);log(r,`【デッドライン】第${turn}ラウンド：防御・回避不可の固定70ダメージ`);
    }else{
     const strike={...e,_weaponState:e};
     if(floor===14&&aimed){strike.hit+=15;aimed=false;log(r,'【狙撃手の直感】命中率＋15pt')}
     enemyStrike(r,strike);e.actions++;
    }
    if(r.hp<=0)return 'dead';
    if(floor===14){
     r.combatDistance=2;log(r,'【絶対射程】戦闘距離が遠距離に戻った');
    }
    if(!hasCombatWeapon(r)||r.hp<=Math.max(8,Math.floor((r.maxHp||baseMaxHp())*.2)))break;
   }
   log(r,`【ボス未撃破】${name}から撤退を試みる`);
   const result=escapeCombat(r,e);return result==='dead'||result==='final'?'dead':'escaped';
  }finally{delete r._exTeslaSmoke;delete r._exTeslaCharge;delete r._exOldDistanceBefore}
 };
 const oldScreen=bossBattleScreen;
 bossBattleScreen=function(){let html=oldScreen();
  const f=Number(html.match(/<h2>(1[1-4])F /)?.[1]);if(!f||!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
  const descriptions={
   11:'テスラ：HP200／攻35／防35／命85%／回15%／貫40。電磁加速砲：充電→発射（攻撃70・命中75%・貫通80）→冷却。充電中は電磁障壁で被ダメージ30%軽減。固有：レールガン（耐久80、初回確定・以降20%）。',
   12:'実験体28号：HP180／攻25／防20／命80%／回15%／貫35。ゴーストウォーク：毎ターン開始時距離ランダム。物質透過：各攻撃行動の1発目を必ず回避。固有：ゴーストクローク（タクティカルアーマー相当、回避＋15pt）。',
   13:'クロノス：HP220／攻25／防25／命80%／回35%／貫35、MP5。デッドライン：第5・10ラウンドに通常攻撃に代わり防御・回避不可の固定70ダメージ。固有：クロノウォッチ（回避＋10pt）。',
   14:'オールドワン：HP180／攻35／防20／命85%／回15%／貫60、Mosin。絶対射程：毎ターン終了時に遠距離へ。狙撃手の直感：距離が変化すると次の攻撃命中＋15pt。固有：オールドスコープ（狙撃銃命中＋15pt）。'
  };
  return html.replace(/<div class="item"><h3>階層情報<\/h3>[\s\S]*?<\/div>/,`<div class="item"><h3>正式ボス仕様</h3><p>${descriptions[f]}</p></div>`);
 };
})();
</script>
