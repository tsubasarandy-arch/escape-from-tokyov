=\"空港\" style=\"cursor:pointer\"><circle cx=\"135\" cy=\"1605\" r=\"83\" fill=\"#142d39\" stroke=\"#c879f5\" stroke-width=\"5\"/><text x=\"135\" y=\"1577\" fill=\"#fff\" font-size=\"29\" font-weight=\"800\" text-anchor=\"middle\">19</text><text x=\"135\" y=\"1614\" fill=\"#fff\" font-size=\"19\" font-weight=\"700\" text-anchor=\"middle\">空港</text><text x=\"135\" y=\"1662\" fill=\"#c879f5\" font-size=\"20\" font-weight=\"800\" text-anchor=\"middle\">V</text></g><g data-tok-map-id=\"port\" tabindex=\"0\" role=\"button\" aria-label=\"港湾コンテナ\" style=\"cursor:pointer\"><circle cx=\"390\" cy=\"1605\" r=\"83\" fill=\"#142d39\" stroke=\"#c879f5\" stroke-width=\"5\"/><text x=\"390\" y=\"1577\" fill=\"#fff\" font-size=\"29\" font-weight=\"800\" text-anchor=\"middle\">20</text><text x=\"390\" y=\"1614\" fill=\"#fff\" font-size=\"19\" font-weight=\"700\" text-anchor=\"middle\">港湾コンテナ</text><text x=\"390\" y=\"1662\" fill=\"#c879f5\" font-size=\"20\" font-weight=\"800\" text-anchor=\"middle\">V</text></g><g data-tok-map-id=\"lab\" tabindex=\"0\" role=\"button\" aria-label=\"地下研究施設\" style=\"cursor:pointer\"><circle cx=\"645\" cy=\"1605\" r=\"83\" fill=\"#142d39\" stroke=\"#c879f5\" stroke-width=\"5\"/><text x=\"645\" y=\"1577\" fill=\"#fff\" font-size=\"29\" font-weight=\"800\" text-anchor=\"middle\">21</text><text x=\"645\" y=\"1614\" fill=\"#fff\" font-size=\"19\" font-weight=\"700\" text-anchor=\"middle\">地下研究施設</text><text x=\"645\" y=\"1662\" fill=\"#c879f5\" font-size=\"20\" font-weight=\"800\" text-anchor=\"middle\">V</text></g>";
function tokWorldMapView(){
 const labels=['','I','II','III','IV','V','VI'];
 const groups=[1,2,3,4,5,6].map(tier=>{
  const ids=DISTRICT_TIERS[tier-1],obtained=ids.filter(id=>g.districtKeys?.[id]||g.unlocked?.[id]).length;
  const ready=districtTierReady(g,tier-1);
  const status=tier===1?'初期解放':tier===6?(g.districtKeys?.lab||g.unlocked?.lab?'専用キー獲得済み':'専用キーが必要'):`キー ${obtained}/2 ・ ${ready?'階層到達':'階層未到達'}`;
  let cards=TOK_WORLD_NODES.filter(n=>n.tier===tier).sort((a,b)=>a.num-b.num).map(n=>{
   const open=!!g.unlocked?.[n.id],key=!!g.districtKeys?.[n.id];
   const state=open?'解放済み':key?'キー獲得・階層待ち':'キー未取得';
   const image=tokDistrictScene(n.id);
   return `<button type="button" class="tok-map-card tok-map-tier-${tier} ${open?'':'tok-map-locked'}" data-tok-map-id="${n.id}" aria-label="${n.num}番 ${escapeHTML(n.name)} ${state}"><span class="tok-map-image">${image?`<img src="${image}" alt="" loading="lazy" decoding="async">`:'<span class="tok-map-image-missing">画像未登録</span>'}<span class="tok-map-number">${n.num}</span></span><span class="tok-map-name">${escapeHTML(n.name)}</span><span class="tok-map-risk">${state}</span></button>`
  }).join('');
  if(tier===6){
   const mil=tokMilState();
   cards+=`<button type="button" class="tok-map-card tok-map-tier-6" data-tok-map-id="military" aria-label="Ex 軍事施設"><span class="tok-map-image"><img src="${TOK_MIL_MAP_IMAGE}" alt="" loading="lazy" decoding="async"><span class="tok-map-number">Ex</span></span><span class="tok-map-name">軍事施設</span><span class="tok-map-risk">攻略 ${mil.cleared.length}/10</span></button>`;
  }
  return `<div class="tok-map-tier-group"><h3>危険度 ${labels[tier]} <small>${status}</small></h3><div class="tok-map-card-grid">${cards}</div></div>`;
 }).join('<div class="tok-tier-arrow" aria-hidden="true">↓</div>');
 return `<section class="panel"><h2>ワールドマップ・地区情報</h2><p class="tok-world-info">各階層の異なる地区キー2種類で次の危険度へ。個別の地区は対応キーが必要です。最終地区は専用キーで解放します。</p><div class="tok-world-wrap"><div class="tok-world-board tok-world-card-board">${groups}</div><aside class="tok-world-detail" id="tok-world-detail"><b>地区情報</b><p>地区を選択してください。</p></aside></div></section>`;
}

const TOK_DISTRICT_SCENES={nightlife:"data:image/jpeg;base64,",stadium:"data:image/jpeg;base64,",forest:"data:image/jpeg;base64,",office:"data:image/jpeg;base64,",cinema:"data:image/jpeg;base64,"};
TOK_DISTRICT_SCENES.diet="data:image/jpeg;base64,";
function tokDistrictScene(id){return TOK_DISTRICT_SCENES[id]||AREA_ART[id]||"";}
function tokDistrictThumb(id){const src=tokDistrictScene(id);return src?`<img class="tok-district-thumb" src="${src}" alt="${MAP[id]?.n||id}の風景" loading="lazy">`:"";}
const TOK_MAP_CATEGORY_NAMES={jewelry:'貴金属・宝飾品',electronics:'電子機器',medical:'医療・研究用品',industrial:'工業部品',daily:'食料・日用品',art:'美術品・収集品',documents:'書類・情報媒体'};
const TOK_MAP_WEAPON_NAMES={melee:'近接武器',hg:'HG',smg:'SMG',sg:'SG',ar:'AR',dmr:'DMR',sr:'SR',lmg:'LMG'};
const TOK_MAP_ENEMY_NAMES={scav:'SCAV',raider:'RAIDER',elite:'ELITE'};
function tokMapIntelExtra(id){
 const cat=TOK_VAL_MAP[id],mix=TOK_ENEMY_MIX[id],wmap=TOK_WEAPON_MAP[id];
 if(!cat||!mix||!wmap)return '';
 const categoryList=[cat[0],cat[1]];
 const featured=categoryList.map((key,i)=>{
   const items=Object.entries(L).filter(([itemId,v])=>v.valuableCategory===key&&!v.regionalMap&&!v.repairMaterial&&!v.repairTool).sort((a,b)=>a[1].price-b[1].price);
   const sample=items.length?items[Math.floor((items.length-1)/2)][1].n:'';
   return '<li><b>'+escapeHTML(TOK_MAP_CATEGORY_NAMES[key])+'</b>（×'+(i===0?'2.0':'1.3')+'）'+(sample?' <span class="muted">例：'+escapeHTML(sample)+'</span>':'')+'</li>';
 }).join('');
 const regional=Object.entries(L).filter(([itemId,v])=>v.regionalMap===id&&TOK_REGIONAL_COLLECTION_SET.has(itemId)).sort((a,b)=>({low:0,mid:1,high:2}[a[1].regionalGrade]??3)-({low:0,mid:1,high:2}[b[1].regionalGrade]??3));
 const enemyKinds=['scav','raider','elite'];
 const combos=[];
 for(let k=0;k<3;k++){
   const kind=enemyKinds[k],base=TOK_WEAPON_BASE[kind];
   const weights=TOK_WEAPON_CATS.map((weapon,j)=>base[j]*(wmap[0].includes(weapon)?2:wmap[1].includes(weapon)?1.3:wmap[2].includes(weapon)?.5:1));
   const total=weights.reduce((a,b)=>a+b,0);
   TOK_WEAPON_CATS.forEach((weapon,j)=>combos.push({kind,weapon,score:mix[k]*weights[j]/total}));
 }
 combos.sort((a,b)=>b.score-a.score);
 const first=combos[0];
 // Avoid displaying two identical enemy classes or weapon categories, for a more useful scouting report.
 const second=combos.find(x=>x.kind!==first.kind&&x.weapon!==first.weapon)||combos.find(x=>x.weapon!==first.weapon)||combos[1];
 const enemyText=[first,second].map(x=>'<li><b>'+escapeHTML(TOK_MAP_WEAPON_NAMES[x.weapon])+'を持った'+TOK_MAP_ENEMY_NAMES[x.kind]+'</b></li>').join('');
 return '<div class="tok-map-intel-extra"><h4>出やすい一般換金品</h4><ul>'+featured+'</ul><h4>出やすい敵（代表2種類）</h4><ul>'+enemyText+'</ul><p class="muted">敵種別割合と武器種別補正から算出した代表例です。確定出現ではありません。</p><h4>このマップ特有の換金品</h4><ul>'+(regional.length?regional.map(([itemId,v])=>'<li>'+escapeHTML(v.n)+' <span class="muted">'+fmt(v.price)+'₽</span></li>').join(''):'<li>登録なし</li>')+'</ul><p class="muted">地域限定品はこのマップでのみ抽選されます。</p></div>';
}
function tokSelectWorldDistrict(id){
 if(id==='military'){tokSelectMilitaryFacility();return;}
 const n=TOK_WORLD_NODES.find(x=>x.id===id),m=MAP[id];if(!n||!m)return;
 const sources=districtTier(id)>0?DISTRICT_TIERS[districtTier(id)-1]:[];
 const sourceNames=sources.map(k=>TOK_WORLD_NODES.find(x=>x.id===k)?.name||k);
 const clues=g.districtClues?.[id]||[];
 const clueNames=typeof DISTRICT_CLUES!=='undefined'?DISTRICT_CLUES[id]||[]:[];
 const chance=typeof keyDiscoveryChance==='function'?Math.round(keyDiscoveryChance(id)*100):null;
 const target=document.getElementById('tok-world-detail');if(!target)return;
 target.innerHTML=(tokDistrictScene(id)?'<img class="tok-district-detail-image" src="'+tokDistrictScene(id)+'" alt="'+escapeHTML(n.name)+'の風景">':'')+'<h3>'+n.num+'. '+escapeHTML(n.name)+'</h3>'+'<p>危険度：'+['Ⅰ','Ⅱ','Ⅲ','Ⅳ','Ⅴ','Ⅵ'][n.tier-1]+'</p><p>解放状態：'+(g.unlocked?.[id]?'解放済み':g.districtKeys?.[id]?'キー取得済み・階層待ち':'未解放')+'</p><p>敵遭遇率：'+Math.round(m.enc*100)+'%（基本値）</p><p>手掛かり・キー探索元：'+(sourceNames.length?sourceNames.map(escapeHTML).join(' ／ '):'初期解放地区')+'</p><p>発見した手掛かり：'+(clues.length?clues.map(i=>escapeHTML(clueNames[i]||'手掛かり')).join(' ／ '):'なし')+'</p>'+(chance!==null?'<p>キー発見率：'+chance+'%</p>':'')+tokMapIntelExtra(id);
}
function tokSelectMilitaryFacility(){
 const target=document.getElementById('tok-world-detail');if(!target)return;
 const m=tokMilState();m.mode='military';
 target.innerHTML=`<img class="tok-district-detail-image" src="${TOK_MIL_MAP_IMAGE}" alt="軍事施設"><h3>Ex. 軍事施設 — 20階層</h3><p>攻略進度：${m.cleared.length}/20階層</p><p>各階層の探索回数はランダム・非公開。最終戦に固有ボスが必ず出現します。</p><p>5F・10F・15Fのボス撃破でチェックポイントを恒久解放。</p>${exLaunchHtml(m)}`;
}
document.addEventListener('click',e=>{const node=e.target.closest?.('[data-tok-map-id]');if(node)tokSelectWorldDistrict(node.dataset.tokMapId)});
document.addEventListener('keydown',e=>{if(e.key!=='Enter'&&e.key!==' ')return;const node=e.target.closest?.('[data-tok-map-id]');if(node){e.preventDefault();tokSelectWorldDistrict(node.dataset.tokMapId)}});
</script>

<style>
#tok-discovery-overlay{position:fixed;inset:0;z-index:999999;display:none;align-items:center;justify-content:center;padding:14px;background:rgba(2,8,12,.88);font-family:inherit}
#tok-discovery-overlay.active{display:flex}
.tok-discovery-card{--accent:#91c8de;width:min(100%,560px);max-height:90dvh;overflow:auto;color:#e9eef0;background:linear-gradient(150deg,#152029,#0b1117 70%);border:2px solid #637680;box-shadow:0 20px 70px #000b,inset 0 0 0 2px #202e37;border-radius:5px;padding:0 18px 20px}
.tok-discovery-card.gold{--accent:#e9bd62}.tok-discovery-card.royal{--accent:#d7b66e}
.tok-discovery-head{margin:0 -18px 16px;padding:16px 18px 13px;border-bottom:2px solid var(--accent);background:linear-gradient(100deg,#1d2c37,#0b1118);font-size:clamp(19px,5vw,25px);font-weight:900;color:var(--accent)}
.tok-discovery-brand{display:block;font-size:10px;letter-spacing:.18em;color:#a7b1b9;margin-bottom:6px}
.tok-discovery-item{display:flex;align-items:center;gap:15px;padding:15px 8px;border:1px solid #3a515e;background:#101c25;min-height:105px}
.tok-discovery-symbol{flex:0 0 76px;height:76px;display:grid;place-items:center;border:1px solid var(--accent);font-size:38px;color:var(--accent);background:#15232b}
.tok-discovery-item b{display:block;font-size:18px;line-height:1.4}.tok-discovery-tag{font-size:12px;color:var(--accent);font-weight:bold}.tok-discovery-line{margin:12px 0;padding:9px 0;border-bottom:1px solid #43535c}
.tok-discovery-warning{border:1px solid #856e45;padding:12px;background:#242017;color:#e5c98c;font-size:13px;line-height:1.65}
.tok-discovery-warning.loss{border-color:#934c4c;color:#f3b6b6;background:#291b1d}
.tok-discovery-foot{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:16px}
.tok-discovery-foot button,.tok-discovery-open{background:#c5ccd0;color:#101820;border:1px solid #eef1f2;font-weight:800;border-radius:3px;padding:12px 24px;min-width:140px}
.tok-discovery-open{background:#d8b66e;border-color:#f4d58c;width:100%;font-size:16px}
</style>
<div id="tok-discovery-overlay" role="dialog" aria-modal="true" aria-label="発見報告" onclick="if(event.target===this)tokCloseDiscoveryNotices()"><div class="tok-discovery-card" id="tok-discovery-card"></div></div>
<script>
(function(){
let notices=[],index=0;
const safe=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function view(){const n=notices[index];if(!n){tokCloseDiscoveryNotices();return}
const mapName=id=>MAP[id]?.n||id||'不明';let title='',tag='',name='',detail='',location='',symbol='◇',gold=false;
if(n.kind==='clue'){title='手がかりを発見！';tag='手がかり';name=DISTRICT_CLUES[n.target]?.[n.clue]||'手がかり';detail='地区解放のための情報を入手しました。';location='関連地区：'+mapName(n.target);symbol='⌕';}
else if(n.kind==='districtKey'){title='キーアイテムを発見！';tag='地区アクセスキー';name=DISTRICT_KEY_NAMES[n.target]||mapName(n.target)+'のアクセスキー';detail='生還すると、この地区が解放されます。';location='解放対象：'+mapName(n.target);symbol='⚿';gold=true;}
else if(n.kind==='secretKey'){title='秘密の部屋のキーを発見！';tag='秘密の部屋の鍵';name=L[n.item]?.n||n.item;detail='対応する秘密の部屋を探索するための鍵です。';location='発見地区：'+mapName((g.history||[])[0]?.map);symbol='⚿';gold=true;}
else if(n.kind==='royal'){title=(L[n.item]?.n||'王室収集品')+'を発見！';tag='王室収集品';name=L[n.item]?.n||n.item;detail='秘密の部屋で王室収集品を発見しました。';location='発見地区：'+mapName((g.history||[])[0]?.map);symbol='♛';gold=true;}
const warning=n.win?(n.kind==='districtKey'?'生還成功：地区を解放しました。':n.kind==='royal'?'生還成功：コレクションに登録しました。':'生還成功：獲得しました。'):'レイド失敗：今回発見したアイテムは喪失しました。';
const card=document.getElementById('tok-discovery-card');card.className='tok-discovery-card'+(gold?' gold':'');card.innerHTML='<div class="tok-discovery-head"><span class="tok-discovery-brand">ESCAPE FROM TOKYOV / INTELLIGENCE REPORT</span>'+safe(title)+'</div><div class="tok-discovery-item"><div class="tok-discovery-symbol">'+symbol+'</div><div><span class="tok-discovery-tag">'+safe(tag)+'</span><b>'+safe(name)+'</b><div>'+safe(detail)+'</div></div></div><div class="tok-discovery-line">'+safe(location)+'</div><div class="tok-discovery-warning'+(n.win?'':' loss')+'">'+safe(warning)+'</div><div class="tok-discovery-foot"><small>'+String(index+1)+' / '+String(notices.length)+'</small><button type="button" onclick="tokNextDiscoveryNotice()">'+(index===notices.length-1?'閉じる':'次へ')+'</button></div>';
}
window.tokShowDiscoveryNotices=function(){notices=(g.history?.[0]?.discoveryNotices||[]).slice();index=0;if(!notices.length)return;document.getElementById('tok-discovery-overlay').classList.add('active');view()};
window.tokNextDiscoveryNotice=function(){index++;view()};
window.tokCloseDiscoveryNotices=function(){document.getElementById('tok-discovery-overlay').classList.remove('active')};
})();
</script>
<style id="tok-military-ex-v92">
.tok-raid-mode-tabs:has([data-action='tokRaidMode:military']){grid-template-columns:repeat(3,minmax(0,1fr))}.tok-mil-floor-list{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;margin:12px 0}
.tok-mil-floor-list button{padding:10px 2px;border:1px solid #557c8e;border-radius:7px;background:#142b38;color:#e8f2f7;cursor:pointer}
.tok-mil-floor-list button.selected{border:2px solid #e4c36a;background:#314051}
.tok-mil-floor-list button:disabled{opacity:.5;cursor:not-allowed}
.tok-map-tier-6 .tok-map-number{font-size:22px!important}
</style><style id="tok-ex-20f-ui">.tok-ex-choice{display:block;width:100%;margin:7px 0;padding:12px;text-align:left;border:1px solid #60798c;border-radius:9px;background:#183043;color:#f2f6f9;cursor:pointer}.tok-ex-choice:hover{background:#28495c}.tok-mil-floor-list{grid-template-columns:repeat(5,minmax(0,1fr))}.tok-military-panel .item button[data-ex-action]{margin:5px;padding:10px 12px}</style><script>
/* Ex Military 1F-5F boss implementation — preserves 6F-20F original encounters */
(function(){
 const specs=[
  {n:'ハリネズミ',hp:250,d:24,def:85,hit:75,ev:0,pen:45,weapon:'ex_hedgehog'},
  {n:'ベルゼバブ',hp:160,d:20,def:25,hit:85,ev:30,pen:30,weapon:'tt'},
  {n:'ハリケーン',hp:220,d:38,def:35,hit:75,ev:10,pen:45,weapon:'ex_berserker'},
  {n:'トラッパー',hp:180,d:24,def:30,hit:80,ev:20,pen:35,weapon:'pm'},
  {n:'バイソン',hp:250,d:28,def:20,hit:65,ev:5,pen:45,weapon:'ex_pkp_boss'}
 ];
 const rewards=[['helmet','ex_bastion'],['bag','ex_hive'],['weapon','ex_berserker'],['accessory','ex_bombers_eye'],['armor','ex_bison_rig']];
 W.m249={n:'M249 SAW',d:22,a:-5,p:30,price:58000,shots:5,ammo:'556',fixed:true};
 W.pkp={n:'PKP ペチェネグ',d:32,a:-15,p:55,price:72000,shots:3,ammo:'762x54',fixed:true};
 W.ex_hedgehog={n:'暴力的な弾幕',d:12,a:0,p:45,price:0,shots:3,ammo:null,ammoFree:true};
 W.ex_berserker={n:'ベルセルク',d:45,a:0,p:50,price:160000,shots:1,ammo:null,melee:true,max:150};
 W.ex_pkp_boss={...W.pkp,n:'PKP ペチェネグ（二丁）',d:28,shots:3};
 H.ex_bastion={n:'バスティオン',def:35,max:160,price:150000,evasion:-15,headshotExtraReduction:.50};
 B.ex_hive={n:'ハイヴ',kg:B.small.kg,max:120,price:150000};
 A.ex_bison_rig={n:'猛牛のアーマーリグ',def:20,max:60,price:140000,repair:A.light.repair,reloadBonus:1};
 TOK_ACCESSORIES.ex_bombers_eye={n:'ボンバーズアイ',price:125000,grenadeAccuracy:15};
 // v3.6.49: boss-only rewards retain their unique rarity in existing save data.
 const exBossOnlyBases=new Set(['ex_bastion','ex_hive','ex_berserker','ex_bombers_eye','ex_bison_rig']);
 for(const item of (g?.gear||[])){if(exBossOnlyBases.has(item.base))item.rarity='boss'}

 for(let i=0;i<5;i++){
  const s=specs[i];TOK_MIL_FLOORS[i][1]=s.n;
  TOK_MIL_FLOORS[i].splice(2,7,s.hp,s.d,s.def,s.hit,s.ev,s.pen,s.weapon);
  EX_NAMES[i]=s.n;
 }
 const priorReload=reloadAttackLimit;
 reloadAttackLimit=function(w){if(w===W.pm||w===W.tt||w===W.glock17)return 4;return priorReload(w)};
 const priorPlayerReload=playerReloadTurn;
 playerReloadTurn=function(r,slots){
  const extra=raidGear(r,'armor')?.base==='ex_bison_rig'&&r.dur>0?1:0;
  if(!extra)return priorPlayerReload(r,slots);
  // Temporarily adjust each eligible weapon's reload limit via a reversible wrapper.
  const old=reloadAttackLimit;
  reloadAttackLimit=function(w){return old(w)+(w&&!w.melee&&!w.ammoFree?extra:0)};
  try{return priorPlayerReload(r,slots)}finally{reloadAttackLimit=old}
 };
 const priorAccessory=tokAccessoryValue;
 tokAccessoryValue=function(item,key){if(item?.base==='ex_bombers_eye'&&key==='grenadeAccuracy')return 15;return priorAccessory(item,key)};
 const priorGrenade=throwGrenade;
 throwGrenade=function(r,units,kind){
  // The normal throw logic uses fixed probabilities; shift the roll threshold only
  // for the equipped boss accessory, preserving the original grenade effects.
  if(tokAccessoryBonus(r,'grenadeAccuracy')!==15)return priorGrenade(r,units,kind);
  const oldRoll=roll;
  let inside=false;
  roll=function(raid,chance){
   // Add +15pt only to known grenade hit-rate checks, not to damage/status rolls.
   if(inside&&[.80,.70,.60,.55,.45,.35,.25,.75,.65,.50].some(v=>Math.abs(v-chance)<1e-9))return oldRoll(raid,Math.min(1,chance+.15));
   return oldRoll(raid,chance)
  };
  try{inside=true;return priorGrenade(r,units,kind)}finally{roll=oldRoll}
 };
 const oldDrop=tokMilEquipmentDrop;
 tokMilEquipmentDrop=function(r,floor){
  if(floor>5)return oldDrop(r,floor);
  const [type,id]=rewards[floor-1];
  const item=makeGear(r,type,id,'boss');item.affixes=[];item.dur=GEARTYPE[type][id].max??null;item.sourceBoss='military-'+floor;return item
 };
 const oldBoss=tokMilBossBattle;
 function specialStrike(r,e,shots,power){
  const old=e.enemyWeapon,oldW=W[old],temp={...oldW,shots,d:power};
  W[old]=temp;
  try{enemyStrike(r,{...e,specialShots:shots,_weaponState:{magActions:0}})}finally{W[old]=oldW}
 }
 function exGrenade(r,type){
  if(type==='smoke'){tokSmokeDeploy(r);log(r,'【トラッパー】スモークグレネード');return}
  const rates={frag:.50,flash:.50,molotov:.50,gas:.45};
  if(!roll(r,rates[type])){log(r,'【トラッパー】'+ITEMS[type].n+'は命中しなかった');return}
  if(type==='frag'){const damage=dmg(40+Math.floor(rand(r)*36),armorDef(r.armor,r.dur,raidGear(r,'armor')),35,r);r.hp=Math.max(0,r.hp-damage);log(r,'【トラッパー】フラグ命中 -'+damage+'HP')}
  else if(type==='flash'){r.shotgunStaggerPending=Math.max(r.shotgunStaggerPending||0,20);log(r,'【トラッパー】フラッシュ命中：次の攻撃命中率−20pt')}
  else if(type==='gas'){r.poisonTurns=Math.max(r.poisonTurns||0,4);log(r,'【トラッパー】ガス命中：毒4ターン')}
  else if(type==='molotov'){r.burnTurns=Math.max(r.burnTurns||0,4);log(r,'【トラッパー】モロトフ命中：火傷4ターン')}
 }
 tokMilBossBattle=function(r){
  const floor=r.militaryFloor;if(floor<1||floor>5)return oldBoss(r);
  tokPrepareEncounterReload(r);
  const s=specs[floor-1],e={n:s.n,kind:'boss',hp:s.hp,maxHp:s.hp,d:s.d,def:s.def,hit:s.hit,ev:s.ev,pen:s.pen,pursuit:15,enemyWeapon:s.weapon,actions:0,magActions:0,flashTurns:0};
  r.bossEncountered=true;r.militaryBossRarity='boss';r.combatDistance=Number.isInteger(r.combatDistance)?r.combatDistance:1;
  log(r,`【Ex軍事施設 ${floor}F ボス】${s.n} HP${s.hp}`);
  let mine=false,mineDistance=null,droneDebuff=0,stagger=false,berserk=false,approaches=0;
  for(let turn=1;turn<=12;turn++){
   if(!hasCombatWeapon(r))break;
   turnCare(r);if(r.hp<=0)return 'dead';
   let view={...e}; // 妨害ドローンは敵の回避率ではなく、次の敵攻撃時のプレイヤー回避率に作用
   if(stagger){r._exStagger=true;stagger=false}
   const thrown=throwGrenade(r,[e],'boss');
   if(!thrown){
    const priorHit=playerAttack;
    if(r._exStagger){
     // Apply the one-attack accuracy penalty without modifying weapon definitions.
     const previous=gearVal;
     gearVal=function(item,key){return previous(item,key)-(key==='accuracy'?20:0)};
     try{e.hp-=priorHit(r,view,e.hp)}finally{gearVal=previous;r._exStagger=false}
    }else{const damage=priorHit(r,view,e.hp);const guarded=floor===2&&damage>0&&roll(r,.30);e.hp-=guarded?Math.max(0,Math.floor(damage*.80)):damage;if(guarded)log(r,'【ベルゼバブ】ドローンガード：被ダメージ20%軽減')}
   }
   if(e.hp<=0){
    r.kills++;r.xp+=45+floor*12;r.militaryBossWon=true;
    const kills=tokMilState().kills[floor]||0;
    if(kills===0||roll(r,.20)){
     const item=tokMilEquipmentDrop(r,floor);r.gearLoot=r.gearLoot||[];r.gearLoot.push(item);
     log(r,'【ボス固有ドロップ】'+gearName(item)+'を獲得');
    }else log(r,'【ボス固有ドロップ】今回はドロップなし');
    log(r,`【階層制覇】${s.n}を撃破！ ${floor}Fクリア`);return 'won'
   }
   if(floor===1){
    if(turn%4===0)log(r,'【ハリネズミ】リロード（攻撃休止）');
    else{
     const before=r.hp;log(r,'【ハリネズミ】暴力的な弾幕：3連射');specialStrike(r,e,3,Math.floor(s.d*.50));
     if(r.hp<before&&roll(r,.30)){stagger=true;log(r,'【ハリネズミ】怯み：次の攻撃命中率−20pt')}
    }
   }else if(floor===2){
    if(droneDebuff>0){
     const previousDodge=baseDodgeChance;
     baseDodgeChance=function(...args){return Math.max(0,previousDodge(...args)-.10)};
     try{enemyStrike(r,{...e,_weaponState:e})}finally{baseDodgeChance=previousDodge;droneDebuff=0}
    }else enemyStrike(r,{...e,_weaponState:e});
    if(turn%2===1){if(roll(r,.70)){r.hp=Math.max(0,r.hp-10);log(r,'【攻撃ドローン】固定10ダメージ')}}
    else if(roll(r,.80)){droneDebuff=1;log(r,'【妨害ドローン】次の敵攻撃時：プレイヤーの回避−10pt')}
   }else if(floor===3){
    if(!berserk&&e.hp<=110){berserk=true;log(r,'【ハリケーン】狂戦士発動：攻撃+15、命中+10、防御−15')}
    if(berserk)e.def=20;
    if(r.combatDistance!==0){
     // Existing distance-change chance (not an unconditional teleport).
     const success=roll(r,clamp((e.approach||65)/100,.05,.95));
     if(success){r.combatDistance=Math.max(0,r.combatDistance-1);log(r,'【ハリケーン】接近成功')}else log(r,'【ハリケーン】接近失敗');
    }else enemyStrike(r,{...e,hit:e.hit+(berserk?10:0),d:e.d+(berserk?15:0),_weaponState:e});
   }else if(floor===4){
    if(turn%3===0)log(r,'【トラッパー】投擲休止');
    else if(!mine&&roll(r,.20)){mine=true;mineDistance=r.combatDistance;log(r,'【トラッパー】地雷設置（最大1個）')}
    else{const types=['frag','flash','molotov','gas','smoke'];exGrenade(r,types[Math.floor(rand(r)*types.length)])}
    if(mine&&mineDistance!==null&&r.combatDistance!==mineDistance){r.hp=Math.max(0,r.hp-35);mine=false;mineDistance=null;log(r,'【地雷起爆】防御無視・固定35ダメージ')}
   }else if(floor===5){
    if((turn-1)%4>=2){log(r,'【バイソン】二丁PKPリロード '+((turn-1)%4===2?'1/2':'2/2')+'（攻撃なし）')}
    else{
     log(r,'【バイソン】PKP二丁斉射・6発');
     const fire={...e,hit:e.hit-15,enemyWeapon:'ex_pkp_boss'};
     specialStrike(r,fire,3,28);if(r.hp>0)specialStrike(r,fire,3,28)
    }
   }
   e.actions++;if(r.hp<=0)return 'dead';
   if(!hasCombatWeapon(r)||r.hp<=Math.max(8,Math.floor((r.maxHp||baseMaxHp())*.2)))break;
  }
  log(r,`【ボス未撃破】${s.n}から撤退を試みる`);
  const result=escapeCombat(r,e);return result==='dead'||result==='final'?'dead':'escaped'
 };
 // The 20F survival wrapper normally bypasses old finish-drop handling; these
 // five floors award the unique item immediately at victory instead.
 const oldFinish=finishRaidCore;
 finishRaidCore=function(win){const r=g.raid;if(r?.exVersion&&r.militaryBossWon&&r.militaryFloor<=5){
   const m=tokMilState();m.kills[r.militaryFloor]=(m.kills[r.militaryFloor]||0)+1;
  }return oldFinish(win)};
})();

</script>
<script>
/* v3.6.50: Embedded boss-unique equipment art, in floor order. */
TOK_EQUIPMENT_IMAGES['helmet:ex_bastion']='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES['bag:ex_hive']='data:image/jpeg;base64,';
TOK_MELEE_IMAGE_IDS['ex_berserker']='ex_berserker';
TOK_WEAPON_IMAGES['ex_berserker']='data:image/jpeg;base64,';
