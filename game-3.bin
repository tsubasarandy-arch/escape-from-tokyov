</style>
<script>
/* v3.6.61 — User-supplied Ex 11F–15F portraits and boss-unique equipment artwork. */
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_EX_BOSS_PORTRAITS.push('data:image/jpeg;base64,');
TOK_WEAPON_IMAGES["ex_tesla_railgun"]='data:image/jpeg;base64,';
TOK_EQUIPMENT_IMAGES["armor:ex_ghost_cloak"]='data:image/jpeg;base64,';
TOK_ACCESSORY_IMAGES["ex_chrono_watch"]='data:image/jpeg;base64,';
TOK_ATTACHMENT_IMAGES["ex_old_scope"]='data:image/jpeg;base64,';
TOK_ACCESSORY_IMAGES["ex_brothers_tags"]='data:image/jpeg;base64,';
TOK_WEAPON_IMAGE_IDS["ex_tesla_railgun"]="ex_tesla_railgun";
const tokExArtNames={11:"テスラ",12:"実験体28号",13:"クロノス",14:"オールドワン",15:"ブラッドブラザーズ"};
const tokExArtDrops={11:["レールガン",TOK_WEAPON_IMAGES["ex_tesla_railgun"]],12:["ゴーストクローク",TOK_EQUIPMENT_IMAGES["armor:ex_ghost_cloak"]],13:["クロノウォッチ",TOK_ACCESSORY_IMAGES["ex_chrono_watch"]],14:["オールドスコープ",TOK_ATTACHMENT_IMAGES["ex_old_scope"]],15:["兄弟のドッグタグ",TOK_ACCESSORY_IMAGES["ex_brothers_tags"]]};
const tokExPriorDossier=bossBattleScreen;
bossBattleScreen=function(){
 const html=tokExPriorDossier();
 if(!html.includes("TACTICAL INTELLIGENCE / MILITARY FACILITY"))return html;
 const m=html.match(/<h2>(1[1-5])F ([^<]*)<\/h2>/);if(!m)return html;
 const floor=Number(m[1]);if(!tokExArtNames[floor])return html;
 const portrait=TOK_EX_BOSS_PORTRAITS[floor-1];const drop=tokExArtDrops[floor];
 const figure=(src,caption)=>`<figure class="tok-ex-asset-art"><img src="${src}" alt="${caption}" loading="lazy" decoding="async"><figcaption>${caption}</figcaption></figure>`;
 const heading=m[0];
 let result=html.replace(heading,heading+figure(portrait,`${floor}F ${tokExArtNames[floor]}`));
 const target="</section>";const panelStart=result.indexOf(heading);const panelEnd=result.indexOf(target,panelStart);
 if(panelEnd>=0){result=result.slice(0,panelEnd)+`<div class="item"><h3>固有装備画像</h3>${figure(drop[1],drop[0])}</div>`+result.slice(panelEnd)}
 return result;
};
</script>

<script>
/* v3.6.62: Restore military intelligence dossier unique reward images for floors 1-5. */
(function(){
 const rewardNames=["バスティオン", "ハイヴ", "ベルセルク", "ボンバーズアイ", "猛牛のアーマーリグ"];
 const rewardImages=["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
 const previous=bossBattleScreen;
 bossBattleScreen=function(){
   const html=previous();
   if(!html.includes('TACTICAL INTELLIGENCE / MILITARY FACILITY'))return html;
   const match=html.match(/<h2>([1-5])F ([^<]*)<\/h2>/);
   if(!match)return html;
   const floor=Number(match[1]), idx=floor-1;
   const header=match[0];
   const sectionEnd=html.indexOf('</section>',html.indexOf(header));
   if(sectionEnd<0)return html;
   const img='<div class="item tok-ex-unique-art"><h3>固有装備画像</h3><figure class="tok-ex-asset-art"><img src="'+rewardImages[idx]+'" alt="'+rewardNames[idx]+'" loading="lazy" decoding="async"><figcaption>'+rewardNames[idx]+'（BOSS UNIQUE）</figcaption></figure></div>';
   return html.slice(0,sectionEnd)+img+html.slice(sectionEnd);
 };
})();
</script>

