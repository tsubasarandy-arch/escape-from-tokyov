",'regional_forest_high':"data:image/jpeg;base64,",'regional_office_mid':"data:image/jpeg;base64,",'regional_cinema_high':"data:image/jpeg;base64,",'regional_diet_high':"data:image/jpeg;base64,"};
function tokRegionalImage(id){const src=TOK_REGIONAL_IMAGES[id];return src?`<img src="${src}" alt="${escapeHTML(L[id]?.n||id)}" loading="lazy" decoding="async" style="display:block;width:100%;max-width:420px;max-height:350px;object-fit:contain;object-position:center;background:#0c1010;border:1px solid #46534a;border-radius:10px;margin:10px auto">`:``;}
const TOK_REGIONAL_COLLECTION_IDS=["regional_suburban_mid", "regional_industrial_high", "regional_metro_high", "regional_school_high", "regional_hospital_high", "regional_mall_low", "regional_zoo_high", "regional_park_high", "regional_temple_high", "regional_airport_mid", "regional_port_high", "regional_tower_high", "regional_police_high", "regional_power_high", "regional_lab_high", "regional_nightlife_high", "regional_stadium_mid", "regional_forest_high", "regional_office_mid", "regional_cinema_high", "regional_diet_high"];
const TOK_REGIONAL_COLLECTION_SET=new Set(TOK_REGIONAL_COLLECTION_IDS);
// v3.5.85: 21 ordinary valuables (3 per category).
// Legacy items remain defined for saves, sale, quests and barter.
const TOK_COMMON_VALUABLE_IDS=new Set(["silver_ring", "watch", "pearl_necklace", "portable_radio", "electronics", "board", "thermometer", "surgical_instruments", "lab_specimen", "tools", "parts", "control_module", "can", "water", "emergency_rations", "souvenir_figure", "vintage_record", "antique_painting", "office_documents", "archive_drive", "sealed_blueprint"]);
const TOK_COMMON_LEGACY_EXEMPT_IDS=new Set(['memory','research']);
function drawLoot(r){
 const tier=depthTierRoll(r,MAP[r.map]);
 const excluded=['bandage','medkit','secretkey',...SECRET_KEYS,...ROYAL_IDS];
 const allowed=id=>!excluded.includes(id)&&(!L[id]?.regionalMap||TOK_REGIONAL_COLLECTION_SET.has(id))&&L[id]?.t===tier&&(!['memory','research'].includes(id)||(!activeCount(g.bank.loot,id)&&!(r.loot[id]||0)));
 const all=Object.keys(L).filter(allowed);
 const regular=all.filter(id=>!L[id].repairMaterial&&!L[id].repairTool&&!L[id].regionalMap&&(TOK_COMMON_VALUABLE_IDS.has(id)||TOK_COMMON_LEGACY_EXEMPT_IDS.has(id)));
 const regional=TOK_REGIONAL_COLLECTION_IDS.filter(id=>L[id].regionalMap===r.map);
 const material=Object.keys(L).filter(id=>L[id].repairMaterial);
 const tools=Object.keys(L).filter(id=>L[id].repairTool);
 const v=rand(r);
 const pool=v<.02&&tools.length?tools:v<.22&&material.length?material:v<.35&&regional.length?regional:regular.length?regular:all;
 if(!pool.length)return 'can';
 const weighted=pool.map(id=>({id,w:L[id].regionalMap?({low:60,mid:30,high:10}[L[id].regionalGrade]||1):L[id].repairMaterial?(REPAIR_LOOT_BONUS[id]||[]).includes(r.map)?2:1:L[id].valuableCategory?tokValCategoryWeight(r.map,L[id].valuableCategory):1}));
 const total=weighted.reduce((n,x)=>n+x.w,0);
 let p=rand(r)*total;
 for(const x of weighted){p-=x.w;if(p<0)return x.id;}
 return weighted[weighted.length-1].id;
}
function startExtraction(r,why){if(r.phase==='extract')return;r.phase='extract';if(!r.longMode&&r.pursuerMet&&!r.pursuerKilled&&(r.pursuerEncounters||0)<3&&pursuerState().hp>0&&roll(r,.20)){const outcome=pursuerBattle(r,true);if(outcome==='dead'){finishRaid(false);return;}}const n=r.explore;r.required=Math.max(1,(n<=5?1:n<=12?2:n<=21?3:4)+(r.legBroken?2:0)-(tokPmcStyle(r).name==='ナイファー'?1:0));r.legExtractExtra=!!r.legBroken;r.progress=0;log(r,`脱出開始（理由：${why}）。必要${r.required}イベント`)}
function threshold(r){if(r.longMode&&r.hp>0&&r.hp/Math.max(1,r.maxHp||baseMaxHp())<=.30)return '長期探索・HP30%以下の安全撤退';const p=explorePlan(r);if(!hasCombatWeapon(r))return '弾切れ';const max=Math.max(1,r.maxHp||100),hpRatio=r.hp/max;const ammoRatio=r.initialAmmo>0?totalRaidAmmo(r)/r.initialAmmo:1;const survival=p.mode==='survival';if(hpRatio<=(survival?.55:.25))return 'HP低下による安全撤退';if(!meleeRaidGear(r)&&ammoRatio<=(survival?.3:.12))return '弾薬不足による安全撤退';if((r.poisonTurns>0||r.bleed)&&hpRatio<=(survival?.7:.4))return '状態異常による安全撤退';if(raidUsedSlots(r)>=backpackCap(r))return 'バッグ満杯';if(r.explore>=30)return '15分の探索上限';return explorationGoal(r)}

function stepRaid(){const r=g.raid;if(!r)return;if(r.longMode&&r.phase==='explore'&&r.hp>0&&r.hp/Math.max(1,r.maxHp||baseMaxHp())<=.30){log(r,'【長期探索】HP30%以下：安全撤退を開始');startExtraction(r,'長期探索・HP30%以下');}const m=MAP[r.map];if(r.phase==='approach'){outsideCare(r,'接近');if(r.hp<=0){finishRaid(false);return}r.explore++;if(roll(r,.12))bossIntel(r,1,'接近中に情報を発見');log(r,`ボス接近 ${r.explore}/${BOSSES[r.map].approach}`);if(roll(r,attEncounterChance(r,clamp(m.enc*.35*districtEncounterMultiplier(r.map),0,1)))){const result=battle(r,drawEnemy(r));if(result==='dead'){finishRaid(false);return}if(result==='escaped'||result==='finalwon'){startExtraction(r,'接近中の戦闘離脱');return}}if(r.hp<=bossTactic(r).hp||(!meleeRaidGear(r)&&r.ammo<Math.ceil(bossEstimate(r)*bossTactic(r).ammo))){startExtraction(r,'接近中の安全撤退');return}if(r.explore>=BOSSES[r.map].approach){const result=bossBattle(r);if(result==='dead'){finishRaid(false);return}startExtraction(r,result==='won'?'ボス撃破':'ボスから撤退')}return}if(r.phase==='explore'){
  if(r.explore>=30){startExtraction(r,'探索時間上限');return}
  const idx=r.explore+1;let result='none';const pursuerResult=pursuerStep(r);if(pursuerResult==='dead'){finishRaid(false);return;}const roamingId=roamingEncounter(r);
   if(roamingId){if(g.longRun?.active)g.longRun.roamerEncountered=true;r.bossEncountered=true;log(r,`【徘徊型ボス】${BOSSES[roamingId].n}と遭遇`);
     if(r.paidRoamingEncounter){
       // Consume only after the actual encounter is committed; never at raid start or on a failed map check.
       if(g.investigation?.pending?.kind==='roaming'&&g.investigation.pending.boss===roamingId)g.investigation.pending=null;
       log(r,'【情報解析】徘徊型ボスの遭遇確定予約が発動');
       r.paidRoamingEncounter=false;
     }else if(!r.longMode&&r.settings.bossPolicy==='avoid'){log(r,'徘徊型ボスとの交戦を回避');startExtraction(r,'徘徊型ボス回避');return;}
     const outcome=roamingBossBattle(r,roamingId);
     if(outcome==='dead'){finishRaid(false);return;}
     if(!r.longMode){startExtraction(r,outcome==='won'?'徘徊型ボス撃破':'徘徊型ボスから撤退');return;}log(r,'【長期探索】徘徊型ボス戦終了。生存したため探索を継続');
   }
   if(!r.bossEncountered&&roll(r,BOSSES[r.map].spawn)){r.bossEncountered=true;if(r.settings.bossPolicy==='avoid'){bossIntel(r,3,'ボスを発見・回避');log(r,'ボスとの交戦を回避');startExtraction(r,'ボス回避');return}const outcome=bossBattle(r);if(outcome==='dead'){finishRaid(false);return}startExtraction(r,outcome==='won'?'ボス撃破':'ボスから撤退');return}const enc=attEncounterChance(r,clamp(m.enc*MOD[r.mode].enc*.90*districtEncounterMultiplier(r.map)*(r.investigation?.kind==='enemy'?.90:1),0,1));if(roll(r,enc)){result=battle(r,drawEnemy(r));if(result==='dead'){finishRaid(false);return}if(result==='escaped'||result==='finalwon'){startExtraction(r,'戦闘離脱・最終戦闘');return}}
     r.explore++;tokInvestigatedFind(r);const exploredPlace=exploreLocation(r);log(r,`【探索地点】${exploredPlace}を探索`);if(r.explore===1||r.explore%5===1)log(r,`【探索深度】${depthDisplay(r.explore)}`);if(roll(r,.07))bossIntel(r,1,'探索中に情報を発見');districtExplore(r);if(r.map==='industrial'){g.industrialCount++;if(g.industrialCount>=30&&!g.keyUnlocked){g.keyUnlocked=true;log(r,'工業地区の探索実績30回達成：特殊アクセスキー解放（次回レイドから）')}}
  if(roll(r,.004*(r.longMode?.5:1))){const key=pick(r,SECRET_KEYS);if(bagLoad(r)+L[key].g<=bagCapacity(r)){r.loot[key]=(r.loot[key]||0)+1;r.lootAcquired=true;log(r,`【レア発見】${L[key].n}を発見！`)}else log(r,`${L[key].n}を発見したがバッグ容量不足`)}
  if(r.secretKeyCarry&&!r.secretRoomOpened&&r.secretRoomEligible){const key=r.secretKeyCarry;r.secretRoomOpened=true;r.secretKeyUsed=true;const relic=ROYAL_RELICS[key];if(relic){r.loot[relic]=(r.loot[relic]||0)+1;r.lootAcquired=true;log(r,`【秘密の部屋】収集品「${L[relic].n}」を発見！ 生還するとコレクションに記録されます`);}log(r,`【秘密の部屋】${exploredPlace}の奥で${L[key].n}に対応する秘密の部屋を発見。鍵を消費して侵入！`);for(let j=0;j<3;j++){const rare=Object.keys(L).filter(id=>L[id].t==='rare'&&!['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id));const item=pick(r,rare);if(item&&bagLoad(r)+L[item].g<=bagCapacity(r)){r.loot[item]=(r.loot[item]||0)+1;r.lootAcquired=true;log(r,`【秘密の部屋】${L[item].n}を回収`)}else log(r,'【秘密の部屋】容量不足で戦利品を回収できなかった')}for(let j=0;j<2;j++){const gear=drawGear(r);gear.rarity=pick(r,['rare','epic','legendary']);collectGear(r,gear,'【秘密の部屋】')}}
  if(r.map==='industrial'&&r.keyEligible&&!r.keyEventProcessed&&idx===1){r.keyEventProcessed=true;r.key=true;log(r,'【重要任務】特殊アクセスキーを発見。重量0kg・バッグ容量消費なし')}
  if(roll(r,clamp((m.loot*MOD[r.mode].loot+levelLootBonus()/100+raidVal(r,'bag','loot')/100+extBonus(r).loot/100)*(r.map==='suburban'&&!r.longMode?1.25:.72)*(r.longMode?.48:1)+tokAccessoryBonus(r,'loot')/100,0,.95))){const id=drawLoot(r);if(!id||!tokOrdinaryLootAllowed(r,id)||!roll(r,(L[id]?.t==='rare'?(r.longMode?.45:.70):(r.longMode?.60:.80)) * (['bandage','medkit'].includes(id)? .90 : 1))){if(idx===1||idx%5===0)log(r,`探索${idx}：目立った収穫はなかった`);}else if(bagLoad(r)+(r.v19Legacy?L[id].g:Math.ceil(L[id].g/1000)*1000)<=bagCapacity(r)){if(!r.v19Legacy&&['bandage','medkit'].includes(id)){acquireSupply(r,id==='medkit'?'med':'bandage',1,`探索${idx}`);r.xp+=2}else{r.loot[id]=(r.loot[id]||0)+1;r.lootAcquired=true;r.xp+=2;log(r,`探索${idx}：${L[id].n}を回収（+2XP）`)}}else log(r,`探索${idx}：${L[id].n}を発見したが容量不足`)}else if(idx===1||idx%5===0)log(r,`探索${idx}：目立った収穫はなかった`);extLootExtra(r,idx);bonusDrop(r,'explore');outsideCare(r,'探索');if(r.hp<=0){finishRaid(false);return}gearRoll(r,(['airport','mall','tower','police'].includes(r.map)?.23:r.map==='industrial'?.14:.08),`探索${idx}`);
  const why=threshold(r);if(why)startExtraction(r,why);
}else{outsideCare(r,'脱出');if(r.hp<=0){finishRaid(false);return}if(g.raid!==r)return;const chance=attEncounterChance(r,m.enc*.5);if(roll(r,chance)){const result=battle(r,drawEnemy(r));if(result==='dead'){finishRaid(false);return}if(result==='escaped')log(r,'脱出中の離脱成功：進行度維持');if(result==='finalwon')log(r,'最終戦闘に勝利：脱出を継続')}r.progress=Math.min(r.required,r.progress+1);log(r,`脱出進行 ${r.progress}/${r.required}`);if(r.progress>=r.required)finishRaid(true)}}
function finishRaid(win){const r=g.raid;if(!r)return;
 // Prevent reentrant finalization and repeated XP/stat rewards if a later step throws.
 if(r._finishCommitted)return;
 r._finishCommitted=true;
 const before=structuredCloneSafe(g);
 try{finishRaidCore(win)}catch(err){
  console.error('Raid finalization failed; rolling back and safely closing raid',err);
  g=before;const stuck=g.raid;
  if(stuck){
   // Preserve the raid as a recoverable report, without duplicating rewards.
   g.history=g.history||[];
   const report={id:stuck.id,map:stuck.map,mode:stuck.mode,raidType:stuck.raidType||'normal',bossKilled:!!stuck.bossKilled,win:false,interrupted:true,explore:stuck.explore||0,required:stuck.required||0,progress:stuck.progress||0,lootVal:0,loot:{},gearLoot:[],gearCount:0,gearValue:0,kills:stuck.kills||0,xp:0,hp:stuck.hp||0,key:false,log:[...(stuck.log||[]),'【システム保護】帰還処理中のエラーを検出。報酬の重複付与を防ぎ、レイドを安全に終了しました。'],at:Date.now()};
   if(!g.history.some(x=>x.id===stuck.id))g.history.unshift(report);
   g.history=g.history.slice(0,30);
  }
  g.raid=null;g.status='base';g.baseAt=Date.now();g.reportPending=true;g.notice='レイド終了処理でエラーが発生しました。戦績の重複を防止しました。設定からバックアップを保存してください。';
  tab='raid';raidPane='current';
  try{save()}catch(e){console.error('Emergency save failed',e)}
  try{render()}catch(e){console.error('Emergency render failed',e)}
 }
}

// v2.8.0 — capacity-limited warehouse and post-raid temporary container.
const STASH_STEPS=[400,500,600,700,800,900,1000],STASH_COSTS=[100000,250000,500000,1000000,2000000,4000000];
function storageInit(){if(!g.storage||typeof g.storage!=='object')g.storage={};const q=g.storage;q.level=Math.max(0,Math.min(6,Math.floor(Number(q.level)||0)));if(!q.container||typeof q.container!=='object')q.container={gear:[],loot:{},ammo:{},supplies:{}};for(const k of ['gear','loot','ammo','supplies'])if(!q.container[k])q.container[k]=k==='gear'?[]:{};return q}
function storageCap(){return STASH_STEPS[storageInit().level]}
function storageGearSlots(x){
 if(!x)return 0;
 // Installed attachments are included in the weapon's single slot.
 if(x.type==='weapon'||x.type==='accessory')return 1;
 if(x.type==='attachment')return 0.5;
 if(x.type==='armor')return 3;
 if(x.type==='helmet')return 1;
 if(x.type==='bag')return 2;
 return 1;
}
function storageSlotsText(n){return Number(n).toFixed(1).replace(/\\.0$/,'')}
function isCapacityFreeValuable(id){return !!(L[id]&&(L[id].valuableCategory||L[id].regionalMap));}
function valuableStoredCount(){return Object.entries(g.bank.loot||{}).reduce((sum,[id,n])=>sum+(isCapacityFreeValuable(id)?Math.max(0,n):0),0)}
function storageMapSlots(m,category){let total=0;for(const [id,n] of Object.entries(m||{})){if(n<=0)continue;total+=category==='ammo'?Math.ceil(n/100):category==='warehouseLoot'&&isCapacityFreeValuable(id)?0:n}return total}
function storageUsed(){storageInit();return g.gear.filter(x=>!Object.values(g.eqIds||{}).includes(x.id)).reduce((v,x)=>v+storageGearSlots(x),0)+storageMapSlots(g.bank.loot,'warehouseLoot')+storageMapSlots(g.bank.ammo,'ammo')+storageMapSlots(g.bank.supplies,'supplies')}
function storageBreakdown(){
 storageInit();
 const equipped=new Set(Object.values(g.eqIds||{}));
 const gear=g.gear.filter(x=>!equipped.has(x.id)).reduce((sum,x)=>sum+storageGearSlots(x),0);
 const ammo=storageMapSlots(g.bank.ammo,'ammo');
 const supplies=storageMapSlots(g.bank.supplies,'supplies');
 const loot=storageMapSlots(g.bank.loot,'warehouseLoot');
 return {gear,ammo,supplies,loot,total:gear+ammo+supplies+loot};
}
function sellWarehouseSupply(id,qty){
 if(g.status!=='base'||g.longRun?.active||!ITEMS[id])return;
 const n=Math.min(activeCount(g.bank.supplies,id),Math.max(0,Math.floor(Number(qty)||0)));
 if(!n)return;
 const price=Math.floor((ITEMS[id].price||0)*.5);
 g.bank.supplies[id]-=n;
 g.money+=price*n;
 g.stats.earned+=price*n;
 save();render();
}
function warehouseSupplyPanel(){
 const rows=Object.entries(ITEMS).sort(([a],[b])=>{const ag=TOK_GRENADES.includes(a),bg=TOK_GRENADES.includes(b);if(ag!==bg)return Number(ag)-Number(bg);if(!ag)return Number(a==='antidote')-Number(b==='antidote');return 0;}).map(([id,o])=>{
  const n=activeCount(g.bank.supplies,id);
  const locked=g.status!=='base'||!!g.longRun?.active;
  return `<div class="item"><div class="flex between"><strong>${escapeHTML(o.n)}</strong><span class="pill">所持 ${fmt(n)}個 ／ ${fmt(n)}マス</span></div>${tokConsumableImage(id)}<small>売却単価 ${fmt(Math.floor((o.price||0)*.5))}₽</small><div class="btns">${b('1個売却',`supplySell:${id}:1`,'small',locked||n<1)} ${b('10個売却',`supplySell:${id}:10`,'small',locked||n<10)}</div></div>`;
 }).join('');
 return `<section class="panel"><h2>医療品・消耗品</h2><p class="muted">医療品とグレネードの倉庫在庫です。1個または10個ずつ売却できます。売却価格は購入価格の50％です。</p>${rows}</section>`;
}
function containerUsed(){const c=storageInit().container;return c.gear.reduce((v,x)=>v+storageGearSlots(x),0)+storageMapSlots(c.loot,'loot')+storageMapSlots(c.ammo,'ammo')+storageMapSlots(c.supplies,'supplies')}
function containerHasItems(){return containerUsed()>0}
function storageAvailable(kind,id,qty=1){const need=kind==='gear'?storageGearSlots(id):kind==='ammo'?Math.ceil(((g.bank.ammo[id]||0)+qty)/100)-Math.ceil((g.bank.ammo[id]||0)/100):kind==='loot'&&isCapacityFreeValuable(id)?0:qty;return storageUsed()+need<=storageCap()}
function storageExpand(){if(g.status!=='base'||g.longRun?.active)return;const q=storageInit();if(q.level>=6)return;const cost=STASH_COSTS[q.level];if(g.money<cost){alert('倉庫拡張の資金が不足しています');return}g.money-=cost;q.level++;save();render()}
function containerMove(kind,id,qty){if(g.status!=='base'||g.longRun?.active)return;const c=storageInit().container;if(kind==='gear'){const i=c.gear.findIndex(x=>x.id===id);if(i<0||!storageAvailable('gear',c.gear[i]))return;g.gear.push(c.gear.splice(i,1)[0]);}else{if(!['loot','ammo','supplies'].includes(kind))return;const n=Math.min(Math.floor(qty)||0,c[kind][id]||0);if(n<=0)return;let allowed=n;if(kind==='ammo'){while(allowed>0&&!storageAvailable('ammo',id,allowed))allowed--}else allowed=kind==='loot'&&isCapacityFreeValuable(id)?n:Math.min(n,Math.max(0,storageCap()-storageUsed()));if(allowed<=0)return;c[kind][id]-=allowed;g.bank[kind][id]=(g.bank[kind][id]||0)+allowed}save();render()}
function containerMoveAll(){
 if(g.status!=='base'||g.longRun?.active)return;
 const c=storageInit().container;
 let moved=0;
 // Capacity-free valuables first: they must never be blocked by a full warehouse.
 const transfer=(kind,id,n)=>{
  if(n<=0)return;
  let allowed=0;
  if(kind==='loot'&&isCapacityFreeValuable(id))allowed=n;
  else if(kind==='ammo'){
   // The warehouse counts ammunition in stacks of 100, including partial stacks.
   let lo=0,hi=n;
   while(lo<hi){const mid=Math.ceil((lo+hi)/2);if(storageAvailable('ammo',id,mid))lo=mid;else hi=mid-1;}
   allowed=lo;
  }else allowed=Math.min(n,Math.max(0,storageCap()-storageUsed()));
  if(allowed<=0)return;
  c[kind][id]-=allowed;
  g.bank[kind][id]=(g.bank[kind][id]||0)+allowed;
  moved+=allowed;
 };
 for(const [id,n] of Object.entries(c.loot))if(n>0&&isCapacityFreeValuable(id))transfer('loot',id,n);
 // Move any equipment that fits; leave oversized pieces for later.
 for(let i=0;i<c.gear.length;){
  const gear=c.gear[i];
  if(storageAvailable('gear',gear)){g.gear.push(c.gear.splice(i,1)[0]);moved++;}
  else i++;
 }
 for(const kind of ['ammo','supplies','loot']){
  for(const [id,n] of Object.entries(c[kind])){
   if(n>0&&!(kind==='loot'&&isCapacityFreeValuable(id)))transfer(kind,id,n);
  }
 }
 if(moved>0)save();
 const remaining=containerUsed();
 render();
 if(remaining>0)alert(`倉庫に移動できる品を${moved}個移動しました。容量不足のため、戦利品が${storageSlotsText(remaining)}マス残っています。残った品は売却・破棄されません。`);
 else if(moved>0)alert(`戦利品を${moved}個、倉庫へ一括移動しました。`);
}
function containerSell(kind,id,qty){if(g.status!=='base'||g.longRun?.active)return;const c=storageInit().container;let amount=0;if(kind==='gear'){const i=c.gear.findIndex(x=>x.id===id);if(i<0)return;const x=c.gear[i];if(x.favorite||isBossGear(x)){alert('保護装備・ボス固有装備は売却せず倉庫へ移動してください');return}amount=gearPrice(x);if(x.type==='weapon')c.gear.push(...attInstalled(x));c.gear.splice(i,1)}else{if(!['loot','ammo','supplies'].includes(kind)||kind==='loot'&&['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id))return;const n=Math.min(Math.floor(qty)||0,c[kind][id]||0);if(n<=0)return;const obj=kind==='loot'?L:kind==='ammo'?AM:ITEMS;amount=Math.floor((obj[id]?.price||0)*(kind==='loot'?1:.5))*n;c[kind][id]-=n}g.money+=amount;g.stats.earned+=amount;save();render()}
function storagePanel(){const q=storageInit(),c=q.container,used=storageUsed(),cu=containerUsed();const cost=STASH_COSTS[q.level];const row=(kind,id,n)=>{const name=kind==='loot'?L[id]?.n:kind==='ammo'?AM[id]?.n:ITEMS[id]?.n;return `<div class="item">${kind==='loot'&&L[id]?.rarity&&RN[L[id].rarity]?`<span class="rarity ${L[id].rarity}">${RN[L[id].rarity]}</span> `:''}${escapeHTML(name||id)} ×${n} ${b('倉庫へ',`containerMove:${kind}:${id}:${kind==='ammo'?Math.min(100,n):1}`,'small',(kind!=='loot'||!isCapacityFreeValuable(id))&&used>=storageCap())} ${b('全量移動',`containerMove:${kind}:${id}:${n}`,'small',(kind!=='loot'||!isCapacityFreeValuable(id))&&used>=storageCap())} ${b('売却',`containerSell:${kind}:${id}:${n}`,'small',['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id))}</div>`};return `<section class="panel"><h2>倉庫容量：${storageSlotsText(used)} / ${storageCap()}マス</h2><p>装備・弾薬・医療品・修理素材などを合算。一般換金品と地域限定換金品は別枠・無制限です。装備中の品は倉庫容量に含みません。</p>${(()=>{const d=storageBreakdown();return `<div class="item"><strong>倉庫容量の内訳</strong><p>装備品：${storageSlotsText(d.gear)}マス ／ 弾薬：${storageSlotsText(d.ammo)}マス ／ 医療品・消耗品：${storageSlotsText(d.supplies)}マス ／ その他の戦利品（食料・飲料水・修理素材など）：${storageSlotsText(d.loot)}マス ／ 換金品（別枠）：${fmt(valuableStoredCount())}個</p><strong>合計：${storageSlotsText(d.total)}マス</strong></div>`})()}${q.level<6?`<p>次の拡張：${STASH_STEPS[q.level+1]}マス ／ ${fmt(cost)}₽</p>${b('倉庫を100マス拡張', 'storageExpand','primary',g.status!=='base'||g.money<cost)}`:'<p>最大容量に到達しています。</p>'}${used>storageCap()?'<p class="warn">容量超過中：新しい品を預け入れできません。</p>':''}</section><section class="panel"><h2>戦利品：${storageSlotsText(cu)} / 200マス</h2><p>通常・長期探索共通の受取場所です。戦利品は自動で倉庫に入りません。手動で移動・売却してください。未整理の間は出撃できません。200マス超過時も保持します。</p>${cu?`<div class="btns">${b('一括倉庫へ移動','containerMoveAll','primary',g.status!=='base'||!!g.longRun?.active)}<small>空き容量の範囲で移動し、残りは戦利品に保持します。</small></div>`:''}${c.gear.map(x=>`<div class="item">${gearLabel(x)}（${storageSlotsText(storageGearSlots(x))}マス） ${b('倉庫へ',`containerMove:gear:${x.id}:1`,'small',used+storageGearSlots(x)>storageCap())} ${b('売却',`containerSell:gear:${x.id}:1`,'small',x.favorite||isBossGear(x))}</div>`).join('')}${['loot','ammo','supplies'].map(k=>Object.entries(c[k]).filter(([,n])=>n>0).map(([id,n])=>row(k,id,n)).join('')).join('')||''}${!cu?'<p class="ok">空です。出撃できます。</p>':''}</section>`}
function storageDepositRaid(r){if(!r||r.longMode||longBusy&&g.longRun?.active)return;const c=storageInit().container;let omitted=0;const deposit=(kind,id,n)=>{if(n<=0)return;let allowed=n;if(kind==='ammo'){allowed=n}else allowed=n;if(allowed){c[kind][id]=(c[kind][id]||0)+allowed;g.bank[kind][id]=Math.max(0,(g.bank[kind][id]||0)-allowed)}omitted+=n-allowed};for(const [id,n] of Object.entries(r.loot||{}))deposit('loot',id,n);for(const x of [...(r.gearLoot||[]),...(r.bossRewards||[])]){const idx=g.gear.findIndex(y=>y.id===x.id);if(idx<0)continue;const size=storageGearSlots(x);{c.gear.push(g.gear.splice(idx,1)[0])}}}

function finishRaidCore(win){const r=g.raid;if(!r)return;pursuerEndRaid(r);
 // One fixed wear charge per completed raid for every weapon brought along.
 // Apply it to the raid equipment snapshots before normal weapon durability sync.
 if(!r._raidWeaponWearApplied){
  r._raidWeaponWearApplied=true;
  const seen=new Set();
  for(const slot of ['weapon','secondary','melee']){
   const item=r.equipment?.[slot];
   if(!item||item.id==null||seen.has(String(item.id)))continue;
   seen.add(String(item.id));
   const before=Math.max(0,Number(item.dur??100));
   item.dur=Math.max(0,before-2);
   if(before>0&&item.dur===0)log(r,`【武器破損】${gearName(item)}の耐久が0になりました`);
  }
  if(seen.size)log(r,`【レイド消耗】持ち込んだ武器${seen.size}点の耐久値がそれぞれ2減少`);
 }
const lostEquipmentSnapshot=Object.values(r.equipment||{}).filter(Boolean).map(x=>structuredCloneSafe(x));const lostAmmoSnapshot=structuredCloneSafe(r.ammoByCaliber||{});const lostLootSnapshot=structuredCloneSafe(r.loot||{});if(r.recoveredSecondary){r.gearLoot=r.gearLoot||[];r.gearLoot.push(r.recoveredSecondary);r.recoveredSecondary=null;}if(win&&!r.longMode){
 const ultra=tokUltraRarePick(.005);
 if(ultra){r.loot[ultra]=(r.loot[ultra]||0)+1;tokUltraRareRegister(ultra);log(r,`【激レア収集品】${L[ultra].n}を発見！`);}
}
const lootVal=lootValue(r);const gearValTotal=(r.gearLoot||[]).reduce((sum,x)=>sum+gearPrice(x),0);const xpGained=r.xp+(win?20:0);g.xp+=xpGained;g.level=levelFor(g.xp);g.stats.raids++;g.stats.kills+=r.kills;if(win&&r.equipment?.bag&&(!r.longMode||((g.longRun?.completed||0)%4===3))){const bag=findGear(r.equipment.bag.id);if(bag){bag.dur=Math.max(0,(bag.dur??repairMax(bag))-3);if(bag.dur===0)log(r,'【バッグ破損】帰還後、修理するまで次の出撃はできません');}}if(win&&r.pursuerSupplyReward){for(const [id,n] of Object.entries(r.pursuerSupplyReward.supplies||{}))g.bank.supplies[id]=(g.bank.supplies[id]||0)+n;for(const [id,n] of Object.entries(r.pursuerSupplyReward.ammo||{}))g.bank.ammo[id]=(g.bank.ammo[id]||0)+n;for(const [id,n] of Object.entries(r.pursuerSupplyReward.loot||{}))r.loot[id]=(r.loot[id]||0)+n;}if(win){if(r.secretKeyCarry&&!r.secretKeyUsed)g.bank.loot[r.secretKeyCarry]=(g.bank.loot[r.secretKeyCarry]||0)+1;g.stats.wins++;for(const id of ROYAL_IDS)if((r.loot?.[id]||0)>0)g.royalCollection={...(g.royalCollection||{}),[id]:true};ensureRoyalCollection();if(r.bossKilled)bonusDrop(r,'boss');g.hp=Math.max(0,Math.min(baseMaxHp(),Number(r.hp)||0));g.poisonTurns=Math.max(0,Math.floor(r.poisonTurns||0));g.bleed=!!r.bleed;g.armBroken=!!r.armBroken;g.legBroken=!!r.legBroken;g.burnTurns=r.burnTurns||0;g.grenadeSlots=(r.grenadeSlots||Array(6).fill(null)).slice();for(const id of g.grenadeSlots.filter(Boolean))g.bank.supplies[id]=(g.bank.supplies[id]||0)+1;for(const [id,n] of Object.entries(r.loot)){g.bank.loot[id]=(g.bank.loot[id]||0)+n;if(n>0&&TOK_REGIONAL_COLLECTION_SET.has(id)){g.regionalCollection=g.regionalCollection||{};g.regionalCollection[id]=true;}}if(r.ammoByCaliber){if(W[r.weapon]?.ammo)r.ammoByCaliber[W[r.weapon].ammo]=r.ammo;for(const [cal,remaining] of Object.entries(r.ammoByCaliber))g.bank.ammo[cal]=(g.bank.ammo[cal]||0)+remaining;}else if(W[r.weapon]?.ammo)g.bank.ammo[W[r.weapon].ammo]=(g.bank.ammo[W[r.weapon].ammo]||0)+r.ammo;if(r.equipment.armor){const armor=findGear(r.equipment.armor.id);if(armor)armor.dur=Math.min(repairMax(armor),r.dur)}if(r.equipment.helmet){const helm=findGear(r.equipment.helmet.id);if(helm)helm.dur=Math.min(repairMax(helm),r.helmetDur)}for(const slot of ['weapon','secondary','melee']){const item=r.equipment[slot];if(item){const real=findGear(item.id);if(real)real.dur=Math.min(repairMax(real),item.dur??100)}}if(!r.v19Legacy)for(const [id,n] of Object.entries(r.supplies||{}))g.bank.supplies[id]=(g.bank.supplies[id]||0)+Math.max(0,n);for(const x of r.gearLoot||[]){x.newItem=true;x.acquiredAt=Date.now();g.gear.push(x);}g.gearStats.returned+=(r.gearLoot||[]).length;if(r.key)g.bank.key=true;for(const [id,indices] of Object.entries(r.foundDistrictClues||{})){g.districtClues[id]=[...new Set([...(g.districtClues[id]||[]),...indices])];for(const i of indices)log(r,`【手掛かり獲得】${MAP[id].n}：${DISTRICT_CLUES[id]?.[i]||"手掛かり"}`)}for(const id of r.foundDistrictKeys||[]){g.districtKeys=g.districtKeys||{};g.districtKeys[id]=true;log(r,`【地区キー獲得】${MAP[id].n}`)}syncTierUnlocks(g);for(const id of r.foundDistrictKeys||[])if(g.unlocked[id])log(r,`【新地区解放】${MAP[id].n}`);log(r,`【生還】通常戦利品 ${fmt(lootVal)}₽、装備${(r.gearLoot||[]).length}個、経験値+${xpGained}`)}else{g.stats.losses++;g.hp=25;g.poisonTurns=0;g.bleed=false;g.armBroken=false;g.legBroken=false;g.burnTurns=0;g.grenadeSlots=Array(6).fill(null);const lostIds=Object.values(r.equipment||{}).filter(Boolean).map(x=>x.id);g.gear=g.gear.filter(x=>!lostIds.includes(x.id));g.gearStats.lost+=(r.gearLoot||[]).length;for(const type of ['weapon','secondary','melee','armor','helmet','bag','accessory'])if(lostIds.includes(g.eqIds[type]))g.eqIds[type]=null;for(const [id,indices] of Object.entries(r.foundDistrictClues||{})){for(const i of indices)log(r,`【手掛かり喪失】${MAP[id].n}：${DISTRICT_CLUES[id]?.[i]||"手掛かり"}`)}for(const id of r.foundDistrictKeys||[])log(r,`【キー喪失】${DISTRICT_KEY_NAMES[id]||MAP[id].n}`);log(r,`【敗北】出撃装備・携行弾薬・拾得装備を喪失。経験値+${xpGained}`)}if(r.bossKilled)g.bosses[r.roamingBoss||r.map].portraitUnlocked=true;if(win&&r.bossKilled){const bossKey=r.roamingBoss||r.map;const b=BOSSES[bossKey],st=g.bosses[bossKey];st.kills++;const rewards=bossRewardList(r,bossKey,!st.first);if(rewards.length){for(const item of rewards){item.newItem=true;item.acquiredAt=Date.now();item.sourceBoss=bossKey;item.bossKillOrdinal=st.kills;g.gear.push(item);g.collection[item.base]=true;}r.bossReward=rewards[0];r.bossRewards=rewards;g.gearStats.returned+=rewards.length;if(!st.first&&BOSS_AMMO[b.gear]){const a=BOSS_AMMO[b.gear];g.bank.ammo[a]=(g.bank.ammo[a]||0)+b.ammoGift;log(r,`初回弾薬支給：${AM[a].n}×${b.ammoGift}`)}for(const item of rewards)log(r,`【固有報酬】${gearName(item)}（ランダム能力${item.affixes.length}種）`)}else log(r,'固有装備抽選：今回は獲得なし');st.first=true;st.intel=b.full;st.seen=true;st.portraitUnlocked=true;log(r,'【情報完全開示】討伐・生還によりボス情報をすべて解放');log(r,'討伐バッジ・マップ解放を確定')}if(win&&r.pursuerKilled){const p=pursuerState();for(const [type,id] of [['weapon','nemesis'],['armor','immortal_armor']]){if(p.kills===1||roll(r,.20)){const item=specialBossGear(r,type,id);item.newItem=true;item.acquiredAt=Date.now();item.sourceBoss='pursuer';g.gear.push(item);g.collection[id]=true;r.bossRewards=(r.bossRewards||[]).concat([item]);g.gearStats.returned++;log(r,`【追跡者固有報酬】${gearName(item)}`);}}}if(win)marketSurvival();if(win&&!longBusy)storageDepositRaid(r);if(longBusy&&g.longRun?.active){longCollect(r,win);g.raid=null;g.status='base';g.reportPending=false;g.carry={};reconcileEquipment();return}const discoveryNotices=[];
for(const [id,indices] of Object.entries(r.foundDistrictClues||{}))for(const i of indices)discoveryNotices.push({kind:'clue',target:id,clue:i,win});
for(const id of r.foundDistrictKeys||[])discoveryNotices.push({kind:'districtKey',target:id,win});
for(const key of SECRET_KEYS)if((r.loot?.[key]||0)>0)discoveryNotices.push({kind:'secretKey',item:key,win});
for(const item of ROYAL_IDS)if((r.loot?.[item]||0)>0)discoveryNotices.push({kind:'royal',item,win});
const report={discoveryNotices,lostEquipment:win?[]:lostEquipmentSnapshot,lostAmmo:win?{}:lostAmmoSnapshot,lostLoot:win?{}:lostLootSnapshot,id:r.id,map:r.map,mode:r.mode,raidType:r.raidType||'normal',bossKilled:!!r.bossKilled,defeatedBossId:r.bossKilled?(r.roamingBoss||r.map):null,bossReward:r.bossReward?structuredCloneSafe(r.bossReward):null,bossRewards:structuredCloneSafe(r.bossRewards||[]),win,explore:r.explore,required:r.required||0,progress:r.progress||0,lootVal:win?lootVal:0,loot:win?structuredCloneSafe(r.loot):{},gearLoot:win?structuredCloneSafe(r.gearLoot||[]):[],gearCount:(r.gearLoot||[]).length,gearValue:win?gearValTotal:0,kills:r.kills,xp:xpGained,hp:r.hp,key:win&&r.key,log:[...r.log],at:r.startedAt+(r.processed+1)*STEP};g.history.unshift(report);g.history=g.history.slice(0,30);g.reportPending=true;g.raid=null;g.status='base';g.injuryMs={};g.notice=win?'生還しました。':'戦死しました。';if(!r.v19Legacy)g.carry={};reconcileEquipment();if(!canEquip())g.stats.revivals++;maybeComplete();tab='report';raidPane='current'}

function structuredCloneSafe(x){return JSON.parse(JSON.stringify(x))}
function raidPreflight(){
 const errors=[],warnings=[];
 if(g.status!=='base')errors.push('拠点にいないため出撃できません（状態：'+g.status+'）');
 if(g.longRun?.active&&!longBusy)errors.push('長期探索中です');
 if(g.reportPending&&!longBusy)errors.push('前回のレイド結果が未確認です');
 if(containerHasItems()&&!longBusy)errors.push('戦利品に戦利品が残っています');
 if(g.hp<1)errors.push('HPが1未満です');
 const bag=equippedGear('bag'),w=equippedGear('weapon'),m=findGear(g.eqIds.melee);
 if(!bag)errors.push('バッグが未装備です');else if((bag.dur??repairMax(bag))<=0)errors.push('バッグの耐久値が0です。修理してから出撃してください');
 const gunOK=!!w&&!!W[w.base]&&!W[w.base].melee&&(w.dur??100)>0&&(W[w.base].ammoFree||requestedAmmo(W[w.base].ammo)>=1);
 const meleeOK=!!m&&(m.dur??100)>0;
 if(!gunOK&&!meleeOK){
  if(!w&&!m)errors.push('武器が未装備です');
  else {
   if(w&&!W[w.base])errors.push('メイン武器の種類を認識できません');
   if(w&&W[w.base]&&!W[w.base].melee&&(w.dur??100)<=0)errors.push('メイン武器の耐久値が0です。修理または交換してください');
   if(w&&W[w.base]&&!W[w.base].melee&&!W[w.base].ammoFree&&requestedAmmo(W[w.base].ammo)<1)errors.push('対応する弾薬がありません（携行設定と倉庫を確認）');
   if(m&&(m.dur??100)<=0)errors.push('近接武器の耐久値が0です');
   if(!errors.some(x=>/武器|弾薬/.test(x)))errors.push('使用可能な銃＋弾薬、または近接武器が必要です');
  }
 }
 if(!g.unlocked[g.settings.map])errors.push('選択した地区が未解放です');
 if(g.settings.raidType==='boss'&&!bossKnown(g.settings.map))errors.push('ボス討伐レイドに必要な情報が不足しています');
 if(playerLoadoutSlots()>bankCarrySlots())errors.push('バッグ容量を超えています（'+playerLoadoutSlots()+' / '+bankCarrySlots()+'マス）');
 if(g.hp>=1&&g.hp<baseMaxHp())warnings.push('HPが最大値ではありません（'+g.hp+'/'+baseMaxHp()+'）');
 if(gunOK&&!W[w.base].ammoFree){const cal=W[w.base].ammo,n=requestedAmmo(cal);if(n<30)warnings.push('メイン武器の弾薬が少なめです（'+n+'発）');}
 if(g.bleed)warnings.push('出血状態が残っています');
 if((g.poisonTurns||0)>0)warnings.push('毒状態が残っています（残り'+g.poisonTurns+'ターン）');
 return {errors,warnings};
}
function raidReadinessHTML(){const p=raidPreflight();return `<div class="raid-preflight ${p.errors.length?'raid-preflight-blocked':p.warnings.length?'raid-preflight-warning':'raid-preflight-ready'}"><strong>${p.errors.length?'出撃できません：確認が必要です':p.warnings.length?'出撃前の注意事項':'出撃準備OK'}</strong>${p.errors.map(x=>`<p class="bad">● ${escapeHTML(x)}</p>`).join('')}${p.warnings.map(x=>`<p class="warn">⚠ ${escapeHTML(x)}</p>`).join('')}${!p.errors.length&&!p.warnings.length?'<p class="ok">現在の装備・携行品で出撃できます。</p>':''}</div>`}
function startRaid(){if(!longBusy)advance();const preflight=raidPreflight();if(preflight.errors.length){alert('出撃できない理由：\n・'+preflight.errors.join('\n・'));render();return}if(!longBusy&&preflight.warnings.length){g.notice='出撃時の注意：'+preflight.warnings.join(' / ');}if(g.longRun?.active&&!longBusy){alert('長期探索中です');return}if(g.status!=='base'){
 const details=[
  '現在の内部状態：'+String(g.status),
  '進行中レイド：'+(g.raid?'あり':'なし'),
  '長期探索：'+(g.longRun?.active?'進行中':'停止'),
  '前回報告：'+(g.reportPending?'未確認':'確認済み')
 ];
 alert('出撃できません。\\n'+details.join('\\n')+'\\n状態が画面表示と異なる場合は不具合です。');
 return
}if(g.reportPending&&!longBusy){alert('前回のレイド結果を確認してから出撃してください。');tab='report';render();return}if(containerHasItems()&&!longBusy){alert('戦利品を空にしてから出撃してください。');tab='stash';pmcPane='warehouse';render();return}if(!canEquip()){const reasons=[];if(g.hp<1)reasons.push('HPが1未満です');if(!equippedGear('bag'))reasons.push('バッグが未装備です');const w=equippedGear('weapon'),m=findGear(g.eqIds.melee);const validGun=!!w&&(w.dur??100)>0&&(!W[w.base]?.melee||w.base==='chainsaw')&&(W[w.base].ammoFree||requestedAmmo(W[w.base].ammo)>=1);const validMelee=!!m&&(m.dur??100)>0;if(!validGun&&!validMelee){if(!w&&!m)reasons.push('武器が未装備です');else if(w&&!W[w.base]?.melee&&(w.dur??100)<=0)reasons.push('メイン武器の耐久が0です');else if(w&&!W[w.base]?.melee&&!W[w.base].ammoFree&&requestedAmmo(W[w.base].ammo)<1)reasons.push('対応する弾薬の携行数が0発です');else reasons.push('使用可能な銃＋弾薬、または近接武器が必要です')}alert('出撃できない理由：\n・'+reasons.join('\n・'));return}if(!g.unlocked[g.settings.map]){alert('未解放の地区です');return}if(g.settings.raidType==='boss'&&!bossKnown(g.settings.map)){alert('専用討伐レイドにはボス情報が必要です');return}if(playerLoadoutSlots()>bankCarrySlots()){alert('バッグ容量が不足しています。携行品・弾薬を調整してください。');tab='stash';render();return}const secretKeyCarry=SECRET_KEYS.includes(g.secretKeyEquipped)&&activeCount(g.bank.loot,g.secretKeyEquipped)>0?g.secretKeyEquipped:null;if(secretKeyCarry)g.bank.loot[secretKeyCarry]--;const eq={accessory:equippedGear('accessory'),helmet:equippedGear('helmet'),weapon:equippedGear('weapon'),secondary:g.eqIds.secondary?findGear(g.eqIds.secondary):null,melee:g.eqIds.melee?findGear(g.eqIds.melee):null,armor:equippedGear('armor'),bag:equippedGear('bag')};const w=eq.weapon?.base||eq.melee.base,b=eq.bag.base,a=eq.armor?.base||'none';const ammoByCaliber={};for(const x of [eq.weapon,eq.secondary].filter(x=>x&&!W[x.base].melee)){const caliber=W[x.base].ammo;if(!caliber)continue;if(!(caliber in ammoByCaliber)){ammoByCaliber[caliber]=requestedAmmo(caliber);g.bank.ammo[caliber]=activeCount(g.bank.ammo,caliber)-ammoByCaliber[caliber]}}const loadedAmmo={};for(const [cal,n] of Object.entries(ammoByCaliber))loadedAmmo[cal]=Math.min(30,n);const grenadeSlots=tokSlots(g).slice();const supplies={};for(const [id,qty] of Object.entries(g.carry||{}))supplies[id]=Math.max(0,Math.min(activeCount(g.bank.supplies,id),Math.floor(qty||0)));for(const id of Object.keys(ITEMS)){g.bank.supplies[id]=(g.bank.supplies[id]||0)-(supplies[id]||0)}for(const id of grenadeSlots.filter(Boolean))g.bank.supplies[id]=Math.max(0,(g.bank.supplies[id]||0)-1);const amount=W[w].ammo?(ammoByCaliber[W[w].ammo]||0):0;const id=++g.raidId;const seed=((Date.now()^Math.imul(id,2654435761))>>>0)||1;const tokPending=(!longBusy&&g.settings.raidType==='normal'&&g.investigation?.pending?.map===g.settings.map)?structuredCloneSafe(g.investigation.pending):null; if(tokPending&&tokPending.kind!=='roaming')g.investigation.pending=null;g.raid={investigation:tokPending,pmcStyle:tokPmcStyleId(null),id,map:g.settings.map,mode:g.settings.mode,weapon:w,armor:a,bag:b,equipment:structuredCloneSafe(eq),activeSlot:eq.weapon?'weapon':'melee',ammoByCaliber,ammo:amount,initialAmmo:Object.values(ammoByCaliber).reduce((t,n)=>t+n,0),dur:eq.armor?eq.armor.dur:0,helmetDur:eq.helmet?eq.helmet.dur:0,loadedAmmo,supplies,grenadeSlots,armBroken:!!g.armBroken,legBroken:!!g.legBroken,burnTurns:g.burnTurns||0,bleed:!!g.bleed,poisonTurns:Math.max(0,Math.floor(g.poisonTurns||0)),lootAcquired:false,secretKeyCarry,secretKeyUsed:false,secretRoomOpened:false,secretRoomEligible:!!secretKeyCarry&&Math.random()<.05,hp:g.hp,loot:{},gearLoot:[],key:false,keyEligible:g.settings.map==='industrial'&&g.keyUnlocked&&!g.bank.key,keyEventProcessed:false,raidType:g.settings.raidType,phase:g.settings.raidType==='boss'?'approach':'explore',explore:0,required:0,progress:0,processed:0,startedAt:Date.now(),seed,xp:0,kills:0,firstShotUsed:false,armorSpecialUsed:false,log:[`レイド#${id}開始：${MAP[g.settings.map].n}／${MOD[g.settings.mode].n}／弾薬${Object.values(ammoByCaliber).reduce((t,n)=>t+n,0)}発／メイン${W[w].n}${eq.secondary?'・サブ'+W[eq.secondary.base].n:''}${eq.melee?'・近接'+W[eq.melee.base].n:''}`],settings:structuredCloneSafe(g.settings)};if(g.raid.poisonTurns>0&&!tokSetBonuses(g.raid).statusImmune&&(g.raid.supplies.antidote||0)>0){g.raid.supplies.antidote--;g.raid.poisonTurns=0;log(g.raid,'出撃時に解毒薬を自動使用');}g.status='raid';g.notice='レイド進行中。詳細ログは帰還後に公開します。';tab='raid';save();render()}

function transact(cost,fn){advance();if(g.longRun?.active){alert('長期探索中は購入できません');return}if(g.status!=='base'){alert('拠点待機中のみ利用できます');return}if(g.money<cost){alert('資金不足です');return}g.money-=cost;fn();if(g.money>=9040)g.incomeMs=0;save();render()}
function buy(type,id,qty=1){
  // v3.4.71: 弾薬購入の入力値・倉庫データを正規化し、購入不可の理由を表示する
  type=String(type||'').trim();
  id=String(id||'').trim().toLowerCase();
  qty=Number(qty);
  const obj={weapons:W,armors:A,bags:B,helmets:H,supplies:ITEMS,ammo:AM}[type];
  if(!obj?.[id]||!Number.isInteger(qty)||qty<1||qty>999){
    alert('購入情報を確認できません。弾薬の種類・数量を確認してください。');return;
  }
  if(type==='ammo'){
    if(!g.bank||typeof g.bank!=='object')g.bank={};
    if(!g.bank.ammo||typeof g.bank.ammo!=='object')g.bank.ammo={};
    if(!Number.isFinite(Number(g.bank.ammo[id])))g.bank.ammo[id]=0;
    if(g.status!=='base'){alert('拠点待機中のみ弾薬を購入できます');return;}
    if(g.longRun?.active){alert('長期探索中は弾薬を購入できません');return;}
    if(g.money<obj[id].price*qty){alert('資金不足です（必要：'+fmt(obj[id].price*qty)+'₽）');return;}
    if(!storageAvailable('ammo',id,qty)){
      alert('倉庫容量が不足しています（使用 '+storageUsed()+' / '+storageCap()+' マス）。');return;
    }
    transact(obj[id].price*qty,()=>{
      g.bank.ammo[id]=activeCount(g.bank.ammo,id)+qty;
      g.notice=obj[id].n+'を'+qty+'発購入しました';
    });
    return;
  }if(isBossOnlyGear(type,id)){alert('ボス固有装備はショップで購入できません');return}if(!equipmentShopSells(type,id)){alert('この装備は装備品店では販売していません。レイドまたはマーケットで入手してください');return}if(type==='weapons'&&!weaponShopUnlocked(id)){alert('ボス討伐で販売解放されます');return}if(type==='ammo'&&!storageAvailable('ammo',id,qty)||type==='supplies'&&storageUsed()+qty>storageCap()||!['ammo','supplies'].includes(type)&&storageUsed()+qty*storageGearSlots({type:{weapons:'weapon',armors:'armor',bags:'bag',helmets:'helmet'}[type],base:id})>storageCap()){alert('倉庫容量が不足しています');return}transact(obj[id].price*qty,()=>{if(type==='ammo')g.bank.ammo[id]=activeCount(g.bank.ammo,id)+qty;else if(type==='supplies')g.bank.supplies[id]=activeCount(g.bank.supplies,id)+qty;else{const kind={weapons:'weapon',armors:'armor',bags:'bag',helmets:'helmet'}[type];for(let i=0;i<qty;i++)g.gear.push({id:'gear-'+g.nextGearId++,type:kind,base:id,rarity:'common',affixes:[],favorite:false,newItem:true,acquiredAt:Date.now(),dur:kind==='armor'?A[id].max:kind==='helmet'?H[id].max:kind==='weapon'?100:null})}})}

function sell(type,id,qty=1){if(g.status!=='base')return;if(type==='loot'&&['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id))return;const obj={ammo:AM,loot:L}[type];if(!obj?.[id]||activeCount(g.bank[type],id)<qty||qty<1)return;const price=type==='loot'?obj[id].price:Math.floor(obj[id].price*.5);g.bank[type][id]-=qty;g.money+=price*qty;g.stats.earned+=price*qty;save();render()}

function equip(type,id){if(g.status!=='base')return;if(type==='accessory'){const old=tokAccessoryValue(equippedGear('accessory'),'maxhp');const item=findGear(id);if(!item||item.type!=='accessory')return;g.eqIds.accessory=id;g.hp=Math.max(0,Math.min(baseMaxHp(),g.hp+tokAccessoryValue(item,'maxhp')-old));reconcileEquipment();save();render();return;}if(type==='melee'){const x=findGear(id);if(!x||!W[x.base]?.melee||x.base==='chainsaw')return;g.eqIds.melee=id;reconcileEquipment();save();render();return;}if(type==='secondary'){const x=findGear(id);if(!x||x.type!=='weapon'||W[x.base]?.melee||g.eqIds.weapon===id)return;g.eqIds.secondary=id;reconcileEquipment();save();render();return;}if(type==='armor'&&id==='none'){g.eqIds.armor=null;reconcileEquipment();save();render();return}const x=findGear(id);if(!x||x.type!==type||(type==='weapon'&&W[x.base]?.melee&&x.base!=='chainsaw'))return;if(type==='bag'&&playerLoadoutSlots()>B[x.base].kg+gearVal(x,'capacity')){alert('バッグ容量不足：携行品を減らしてから交換してください');return}g.eqIds[type]=id;if(type==='weapon'&&g.eqIds.secondary===id)g.eqIds.secondary=null;reconcileEquipment();save();render()}

function equippedAmmoSupplyPlan(){
 const target=100;
 return equippedAmmoCalibers().filter(cal=>AM[cal]).map(cal=>{
  const stock=activeCount(g.bank.ammo,cal);
  const buy=Math.max(0,target-stock);
  return {cal,stock,buy,price:buy*AM[cal].price};
 });
}
function supplyEquippedAmmo(){
 if(g.status!=='base'||g.longRun?.active)return;
 const plan=equippedAmmoSupplyPlan();
 if(!plan.length){g.notice='弾薬を使用する武器が装備されていません';render();return;}
 const total=plan.reduce((n,x)=>n+x.price,0);
 if(g.money<total){g.notice=`弾薬補給には${fmt(total)}₽必要です（不足${fmt(total-g.money)}₽）`;render();return;}
 const needed=plan.reduce((n,x)=>n+(Math.ceil((x.stock+x.buy)/100)-Math.ceil(x.stock/100)),0);
 if(storageUsed()+needed>storageCap()){g.notice='弾薬補給に必要な倉庫容量が不足しています';render();return;}
 g.money-=total;
 // Bulk supply affects warehouse stock only, never the raid carry settings.
 for(const x of plan)g.bank.ammo[x.cal]=x.stock+x.buy;
 g.notice=`装備中の武器用弾薬を倉庫へ補給しました（${fmt(total)}₽）。${plan.map(x=>AM[x.cal].n+'：倉庫'+activeCount(g.bank.ammo,x.cal)+'発').join(' / ')}`;
 save();render();
}
function equippedAmmoSupplyButton(){
 const plan=equippedAmmoSupplyPlan();
 const cost=plan.reduce((n,x)=>n+x.price,0);
 const disabled=g.status!=='base'||!!g.longRun?.active||!plan.length||g.money<cost;
 return `<div class="item"><div class="flex between"><strong>装備武器の弾薬を自動補給</strong><span class="pill">目標：各口径100発 / ${fmt(cost)}₽</span></div><p class="muted">メイン・サブ武器の使用口径を対象に、倉庫の在庫が100発未満なら不足分を購入。携行弾薬の設定は変更しません。初期設定は30発ですが、手動で自由に変更できます。既に100発以上ある口径は購入しません。</p><p class="muted">${plan.map(x=>`${AM[x.cal].n}：在庫${x.stock}発 → ${Math.max(100,x.stock)}発（購入${x.buy}発）`).join(' / ')||'弾薬を使用する武器が未装備です'}</p>${b('装備武器の弾薬を100発まで自動補給','supplyEquippedAmmo','primary',disabled)}</div>`;
}
function equippedRepairCandidates(){
 const seen=new Set();
 return ['weapon','secondary','melee','armor','helmet','bag']
  .map(slot=>findGear(g.eqIds[slot]))
  .filter(x=>{
   if(!x||seen.has(x.id))return false;
   seen.add(x.id);
   return ['weapon','armor','helmet','bag'].includes(x.type)&&repairPrice(x)>0;
  });
}
function repairEquippedAll(){
 if(g.status!=='base'||g.longRun?.active)return;
 const items=equippedRepairCandidates();
 if(!items.length){g.notice='修理が必要な装備品はありません';render();return;}
 const cost=items.reduce((total,x)=>total+repairPrice(x),0);
 if(g.money<cost){g.notice=`一括修理には ${fmt(cost)}₽ 必要です（不足 ${fmt(cost-g.money)}₽）`;render();return;}
 transact(cost,()=>{
  for(const x of items){const next=repairNextMax(x);x.maxDur=next;x.dur=next;}
  g.notice=`装備中の${items.length}点を一括修理しました（${fmt(cost)}₽）。通常修理による最大耐久値の減少が適用されます。`;
 });
}
function equippedRepairButton(){
 const items=equippedRepairCandidates();
 const cost=items.reduce((total,x)=>total+repairPrice(x),0);
 const locked=g.status!=='base'||!!g.longRun?.active||!items.length||g.money<cost;
 return `<div class="item"><div class="flex between"><strong>装備中の一括修理</strong><span class="pill">${items.length}点 / ${fmt(cost)}₽</span></div><p class="muted">メイン・サブ・近接武器、アーマー、ヘルメット、バッグのうち修理が必要な装備のみ対象。倉庫内の未装備品は対象外です。通常修理と同じく最大耐久値が減少します。</p>${b('装備しているものを一括で修理する','repairEquippedAll','primary',locked)}${items.length&&g.money<cost?`<p class="muted">資金不足：${fmt(cost-g.money)}₽</p>`:''}</div>`;
}
function repair(id){if(g.status!=='base')return;const x=findGear(id||g.eqIds.armor);if(!x||!['armor','helmet','weapon','bag'].includes(x.type))return;const cost=repairPrice(x);if(!cost)return;const next=repairNextMax(x);transact(cost,()=>{x.maxDur=next;x.dur=next})}
function completeRepairRecipe(x){if(!x)return null;return REPAIR_RECIPES[x.type==='weapon'?(W[x.base]?.melee?'melee':'gun'):x.type]||null;}
function completeRepairCost(x){return Math.max(500,Math.ceil((GEARTYPE[x.type]?.[x.base]?.price||3000)*.04));}
function completeRepair(id){
 if(g.status!=='base'||g.longRun?.active)return;
 const x=findGear(id),recipe=completeRepairRecipe(x);
 if(!recipe)return;
 const original=repairOriginalMax(x),current=repairMax(x);
 if(current>=original){alert('最大耐久値はすでに初期値です');return;}
 if(activeCount(g.bank.loot,recipe.tool)<1){alert('必要な修理道具：'+L[recipe.tool].n);return;}
 for(const material of recipe.materials)if(activeCount(g.bank.loot,material)<1){alert('必要な消費素材：'+L[material].n);return;}
 const cost=completeRepairCost(x);
 if(g.money<cost){alert('修理費用が不足しています：'+fmt(cost)+'₽');return;}
 g.money-=cost;
 for(const material of recipe.materials)g.bank.loot[material]--;
 const next=Math.min(original,current+Math.max(1,Math.ceil(original*.15)));
 x.maxDur=next;
 // Repair restores the capacity of the equipment, not its current condition.
 x.dur=Math.min(next,Math.max(0,Number.isFinite(x.dur)?x.dur:current));
 g.notice=gearName(x)+'の最大耐久値を '+current+' → '+next+' に回復しました';
 save();render();
}
function completeRepairToolInventory(){
 const rows=[['special_tools','銃・近接武器'],['repair_kit','アーマー・ヘルメット'],['sewing_kit','バッグ']];
 return `<div class="item"><strong>必要な修理道具・現在の所持数</strong><p class="muted">専用道具は消費されません。倉庫内の所持数を表示しています。</p>${rows.map(([id,uses])=>{const count=activeCount(g.bank.loot,id);return `<p class="muted">${count>0?'✅':'❌'} <strong>${L[id].n}</strong>（${uses}）：<strong>${count}個 ${count>0?'／所持':'／未所持'}</strong></p>`}).join('')}</div>`;
}
function completeRepairPanel(types){
 const items=g.gear.filter(x=>types.includes(x.type)&&repairOriginalMax(x)>repairMax(x));
 return `<section class="panel"><h2>完全修理（最大耐久値の復元）</h2><p class="muted">専用道具は所持しているだけで使用可能（消費なし）。素材2種類を各1個とルーブルを消費し、初期最大耐久値の15%を回復します。現在耐久値は別途通常修理で回復してください。</p>${completeRepairToolInventory()}${items.map(x=>{
 const recipe=completeRepairRecipe(x);if(!recipe)return '';
 const cost=completeRepairCost(x),toolCount=activeCount(g.bank.loot,recipe.tool),hasTool=toolCount>0;
 const materials=recipe.materials.map(id=>({id,count:activeCount(g.bank.loot,id)}));
 const hasMat=materials.every(x=>x.count>=1),hasMoney=g.money>=cost;
 const mats=materials.map(({id,count})=>`${count>=1?'✅':'❌'} ${L[id].n}：${count}/1個`).join(' ／ ');
 const ready=hasTool&&hasMat&&hasMoney&&g.status==='base'&&!g.longRun?.active;
 const problems=[!hasTool?L[recipe.tool].n:'',...materials.filter(x=>x.count<1).map(x=>L[x.id].n),!hasMoney?`ルーブル ${fmt(cost-g.money)}₽不足`:'' ].filter(Boolean);
 return `<div class="item"><strong>${gearLabel(x)}</strong><p class="muted">最大耐久 ${repairMax(x)} / ${repairOriginalMax(x)}</p><p class="muted">${hasTool?'✅':'❌'} 必要な専用道具：<strong>${L[recipe.tool].n}</strong>（所持 ${toolCount}個／必要 1個・消費なし）</p><p class="muted">必要な消費素材：${mats}</p><p class="muted">費用：${fmt(cost)}₽ ／ 所持金：${fmt(g.money)}₽ ${hasMoney?'✅':'❌'}</p><p class="muted">${ready?'✅ 完全修理可能':problems.length?'不足：'+problems.join('、'):'拠点でのみ修理できます'}</p><div class="btns">${b('完全修理',`completeRepair:${x.id}`,'small',!ready)}</div></div>`;
 }).join('')||'<p class="muted">最大耐久値が減少している装備はありません。</p>'}</section>`;
}

function setCarry(id,change){if(TOK_GRENADES.includes(id)){alert('グレネードは装備画面の専用スロットで設定してください');return}if(g.status!=='base'||!ITEMS[id])return;const qty=g.carry[id]||0,next=qty+change;if(next<0||next>activeCount(g.bank.supplies,id))return;g.carry[id]=next;if(playerLoadoutSlots()>bankCarrySlots()){g.carry[id]=qty;alert('バッグ容量が不足しています');return}save();tokKeepEquipmentScroll(()=>render())}

function tokHpRate(){return Number(g.level)<5?25:50}
function instantHeal(){const missing=baseMaxHp()-g.hp;if(missing<=0)return;transact(missing*tokHpRate(),()=>{g.hp=baseMaxHp();g.recoveryMs=0})}
function changeSetting(k,v){if(g.status!=='base')return;if(['exploreTarget'].includes(k))g.settings[k]=Number(v);else g.settings[k]=v;if(k==='map'&&!g.unlocked[v])g.settings.map='suburban';if(k==='map'&&!bossKnown(g.settings.map))g.settings.raidType='normal';save();tokKeepEquipmentScroll(()=>tokRenderKeepRaidPosition())}
const b=(s,act,cls='',disabled=false)=>`<button class="${cls}" ${disabled?'disabled':''} data-action="${act}">${s}</button>`;
function ammoGuide(weaponId){const w=W[weaponId];if(!w)return '';if(w.melee)return '近接武器 / 弾薬不要';if(w.ammoFree)return '燃料・弾薬不要（無限使用）';const a=AM[w.ammo];const count=activeCount(g.bank.ammo,w.ammo);return `対応弾薬：<b class="ok">${a?a.n:w.ammo}</b>（倉庫 ${fmt(count)}発）`}
WEAPON_INTRO.m249='5連射で敵を制圧する軽機関銃。後半2発の連射命中減衰を軽減する。';
WEAPON_INTRO.pkp='高威力・高貫通の軽機関銃。防御力40以上の敵に対して貫通力がさらに上昇する。';
function weaponFixedLabel(id){return WEAPON_FIXED[id]?`<div class="weapon-perk"><b>◆ 武器固有能力</b><div>${escapeHTML(WEAPON_FIXED[id])}</div><small>武器の種類に固定された効果（レアリティ・ランダム能力とは別）</small></div>`:''}
function weaponBaseStats(id,o){return `<div class="weapon-stat">威力 ${o.d} ／ 命中 ${o.a>=0?'+':''}${o.a}pt ／ 貫通 ${o.p} ／ 発射数 ${o.shots} ／ ${(o.melee||o.ammoFree)?'リロード不要':`リロードまで ${reloadAttackLimit(o)}回攻撃（基本）`} ／ 対応弾薬 ${escapeHTML(o.melee?'不要（近接）':o.ammoFree?'不要（無限使用）':AM[o.ammo]?.n||o.ammo||'—')}</div>`}
function itemRow(id,o,type){const n=type==='ammo'||type==='loot'?activeCount(g.bank[type],id):g.gear.filter(x=>x.type===({weapons:'weapon',armors:'armor',bags:'bag'}[type])&&x.base===id).length;const desc=type==='ammo'?`${o.n} / ${fmt(o.price)}₽/発${W[g.equipped.weapon]?.ammo===id?' ／ ★現在装備の武器に対応':''}`:type==='loot'?(['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id)?'重要任務品 / 1回のみ入手 / 売却不可':`${o.g/1000}kg / 売却${fmt(o.price)}₽`):type==='weapons'?`対応弾薬：${o.melee?'不要（近接）':o.ammoFree?'不要（無限使用）':AM[o.ammo]?.n||o.ammo} / 威力${o.d} / 命中${o.a>=0?'+':''}${o.a}pt / 貫通${o.p} / ${o.shots}発 / ${(o.melee||o.ammoFree)?'リロード不要':`リロードまで${reloadAttackLimit(o)}回攻撃`}`:type==='armors'?`防御${o.def} / 耐久${o.max} ${extInfo(o)}`:`容量${o.kg}kg ${extInfo(o)}`;const shop=tab==='weaponShop'||tab==='equipmentShop'||(tab==='facility'&&(v3Section.facility==='weaponShop'||v3Section.facility==='equipmentShop'));const locked=shop&&type==='weapons'&&!weaponShopUnlocked(id);const buttons=shop?`${b(locked?'未解放':'購入',`buy:${type}:${id}:1`,'small',type==='ammo'?false:(locked||g.money<o.price))}${type==='ammo'?b('10発購入',`buy:${type}:${id}:10`,'small',false):''}`:type==='loot'?(['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id)?'<span class="pill">重要任務品・売却不可</span>':`${b('売却',`sell:${type}:${id}:1`,'small',!n)} ${b('すべて売却',`sell:${type}:${id}:${n}`,'small',!n)}`):type==='ammo'?`${b('1発購入',`buy:${type}:${id}:1`,'small',false)} ${b('10発購入',`buy:${type}:${id}:10`,'small',false)} ${b('売却',`sell:${type}:${id}:1`,'small',!n)} ${b('10発売却',`sell:${type}:${id}:10`,'small',n<10)}`:'';return `<div class="item"><div class="flex between"><span class="item-title">${o.n}</span><span class="pill">${shop?'価格 '+fmt(o.price)+'₽':'所持 '+fmt(n)}</span></div>${shop&&type==='weapons'?tokWeaponImage(id):''}${(type==='armors'||type==='bags')?tokEquipmentImage(id,type):''}${(type==='consumables'||type==='consumable'||type==='items'||type==='medical')?tokConsumableImage(id):''}${type==='loot'?tokUltraRareImage(id):''}<small>${desc}</small>${shop&&type==='weapons'?`${weaponFixedLabel(id)}<details class="weapon-shop-more"><summary>武器の詳細・性能を確認</summary>${weaponBaseStats(id,o)}<p class="muted">ショップで購入する個体はコモンです。ランダム能力は入手個体によって異なります。</p></details>`:''}<div class="btns">${buttons}</div></div>`}

function isBossGear(x){return !!x&&(x.rarity==='boss'||!!BOSS_FIXED[x.base])}
function unreadyGear(x){return !x.favorite&&!isBossGear(x)&&!Object.values(g.eqIds).includes(x.id)&&g.status==='base'}
function newCount(){return g.gear.filter(x=>x.newItem).length}
function markGearRead(id){const x=findGear(id);if(x&&x.newItem){x.newItem=false;save()}}
function gearDetails(x){const weaponImage=x.type==='accessory'?tokAccessoryImage(x.base):x.type==='attachment'?tokAttachmentImage(x.base):x.type==='weapon'?tokWeaponImage(x.base):tokEquipmentImage(x.base,x.type);const def=GEARTYPE[x.type][x.base];const extra=x.type==='helmet'?`${weaponImage}<p>防御 ${H[x.base].def} / 耐久 ${(x.dur??repairMax(x))}/${repairMax(x)}（初期 ${repairOriginalMax(x)}）${x.base==='heavy'?' / 先制−5pt':''}</p>`:x.type==='weapon'?`${weaponImage}<p>${weaponBaseStats(x.base,def)}</p><p>耐久度 ${(x.dur??repairMax(x))}/${repairMax(x)}（初期 ${repairOriginalMax(x)}）</p>${weaponFixedLabel(x.base)}<p class="muted"><b>武器紹介：</b>${escapeHTML(WEAPON_INTRO[x.base]||'特性に応じて使い分けたい武器。')}</p>`:x.type==='armor'?`${weaponImage}<p>耐久 ${x.dur??repairMax(x)}/${repairMax(x)}（初期 ${repairOriginalMax(x)}）</p>`:x.type==='bag'?`${weaponImage}<p>バッグ耐久 ${(x.dur??repairMax(x))}/${repairMax(x)}（初期 ${repairOriginalMax(x)}）</p>`:'';const randomAffixes=(x.affixes||[]).map(v=>{const n=x.type==='accessory'?TOK_ACCESSORY_LABELS[v.type]:(GC[x.type]?.[v.type]?.[0]||v.type);return `${n} +${v.value}${['damage','saving','absorb','durprotect','repair','organize'].includes(v.type)?'%':['accuracy','escape','load','loot','detect'].includes(v.type)?'pt':v.type==='capacity'?'kg':''}`});return `<p><b>基礎性能</b>：${escapeHTML(gearName(x))}</p>${x.type==='attachment'?weaponImage:''}${extra}${x.type==='weapon'?tokAttDetails(x):''}<p><b>ランダム能力（武器本体）</b>：${randomAffixes.length?escapeHTML(randomAffixes.join(' / ')):'なし'}</p>${x.rarity==='legendary'&&SPECIAL[x.base]?`<p><b>★ レジェンダリー能力</b>：${escapeHTML(SPECIAL[x.base])}</p>`:''}${isBossGear(x)?`<p><b>★ ボス固有能力</b>：${escapeHTML(BOSS_FIXED[x.base]||'なし')}</p><p class="muted">入手元：${escapeHTML(BOSSES[x.sourceBoss]?.n||'旧データ・未記録')} / 入手日：${x.acquiredAt?new Date(x.acquiredAt).toLocaleDateString('ja-JP'):'旧データ・未記録'} / 生還討伐：${x.bossKillOrdinal||'未記録'}回目</p>`:''}`}

function collectionView(){const ids=[...new Set(Object.keys(BOSS_FIXED))];const seen=new Set(Object.keys(g.collection||{}).filter(id=>g.collection[id]));return `<section class="panel"><h2>ボス固有装備コレクション ${ids.filter(id=>seen.has(id)).length}/${ids.length}</h2><p class="muted">一度獲得した種類は永久記録。独立した称号や報酬はありません。旧データで取得が確認できない履歴は推定しません。</p>${ids.map(id=>`<div class="item">${seen.has(id)?'✓':'🔒'} ${seen.has(id)?escapeHTML(W[id]?.n||A[id]?.n||H[id]?.n||B[id]?.n||id):'未獲得の固有装備'} <span class="pill">現在所持 ${g.gear.filter(x=>x.base===id&&isBossGear(x)).length}</span></div>`).join('')}</section>`}
function sellOne(id){if(g.status!=='base')return;const x=findGear(id);if(!x||Object.values(g.eqIds).includes(id))return;if(x.favorite){if(!confirm(`★お気に入り装備「${gearName(x)}」を売却しますか？`))return;if(!confirm('お気に入り装備を永久に失います。最終確認：売却しますか？'))return}else if(isBossGear(x)&&!confirm('ボス固有装備を売却しますか？'))return;const amount=gearPrice(x);if(x.type==='weapon')g.gear.push(...attInstalled(x));g.gear=g.gear.filter(y=>y.id!==id);g.money+=amount;g.stats.earned+=amount;selectedBulk.delete(id);save();render()}
function sellBulk(){if(g.status!=='base')return;const list=g.gear.filter(x=>selectedBulk.has(x.id)&&unreadyGear(x));if(!list.length)return;const amount=list.reduce((n,x)=>n+gearPrice(x),0);if(!confirm(`${list.length}点をまとめて ${fmt(amount)}₽ で売却しますか？`))return;const ids=new Set(list.map(x=>x.id));for(const x of list)if(x.type==='weapon')g.gear.push(...attInstalled(x));g.gear=g.gear.filter(x=>!ids.has(x.id));g.money+=amount;g.stats.earned+=amount;selectedBulk.clear();save();render()}
function prepareWarnings(){const w=equippedGear('weapon'),a=equippedGear('armor');let warnings=[];if(g.hp<40)warnings.push('HPが少なくなっています');if(w){const n=requestedAmmo(W[w.base].ammo);if(n<Math.max(10,(W[w.base].burst||1)*10))warnings.push('対応弾薬の残数が少なくなっています')}if(a&&a.dur<(A[a.base].max+gearVal(a,'durability'))*.3)warnings.push('防具の耐久度が低下しています');return warnings.length?`<div class="notice">⚠ ${warnings.map(escapeHTML).join(' / ')}（条件を満たしていれば出撃可能）</div>`:''}

function compareEquipped(x){if(x.type!=='weapon')return equippedGear(x.type);const slot=W[x.base]?.melee&&x.base!=='chainsaw'?'melee':(g.eqIds.secondary===x.id?'secondary':'weapon');return findGear(g.eqIds[slot])}
function compareStats(x){if(!x)return null;const d=GEARTYPE[x.type]?.[x.base];if(!d)return null;const a={};if(x.type==='weapon'){a['威力']=d.d+gearVal(x,'damage');a['命中(pt)']=d.a+gearVal(x,'accuracy');a['貫通']=d.p+gearVal(x,'penetration');a['発射数']=d.shots;a['弾薬節約(%)']=gearVal(x,'saving');a['連射減衰軽減']=gearVal(x,'control')}else if(x.type==='armor'){a['防御']=d.def+gearVal(x,'defense');a['最大耐久']=d.max+gearVal(x,'durability');a['衝撃吸収(%)']=gearVal(x,'absorb');a['耐久保護(%)']=gearVal(x,'durprotect')}else if(x.type==='helmet'){a['防御']=d.def;a['最大耐久']=d.max}else if(x.type==='bag'){a['容量(kg)']=d.kg+gearVal(x,'capacity');a['装備重量軽減(%)']=gearVal(x,'organize');a['装備発見率(pt)']=gearVal(x,'detect')}a['離脱補正(pt)']=gearVal(x,'escape');return a}
function gearComparison(x){const y=compareEquipped(x),a=compareStats(x)||{},c=y?compareStats(y)||{}:{};const keys=[...new Set([...Object.keys(a),...Object.keys(c)])];const value=(v)=>v===undefined?'—':String(v);return `<div class="notice"><b>装備比較</b><p class="muted">左：倉庫で選択した装備 ／ 右：現在装備中。同じ種類の性能を比較します。</p><div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;text-align:left;font-size:.9em"><thead><tr><th>項目</th><th>${escapeHTML(gearName(x))}<br><small>比較対象</small></th><th>${y?escapeHTML(gearName(y)):'未装備'}<br><small>現在装備中</small></th></tr></thead><tbody>${keys.map(k=>{const v=a[k],old=c[k];const delta=typeof v==='number'&&typeof old==='number'?v-old:null;return `<tr style="border-top:1px solid #5555"><td>${escapeHTML(k)}</td><td><b>${value(v)}</b>${delta!==null&&delta!==0?` <small class="${delta>0?'ok':'warn'}">(${delta>0?'+':''}${delta})</small>`:''}</td><td>${value(old)}</td></tr>`}).join('')}<tr style="border-top:1px solid #5555"><td>現在耐久</td><td>${x.dur??'—'}</td><td>${y?.dur??'—'}</td></tr><tr style="border-top:1px solid #5555"><td>レアリティ</td><td>${escapeHTML(RN[x.rarity]||x.rarity)}</td><td>${y?escapeHTML(RN[y.rarity]||y.rarity):'—'}</td></tr><tr style="border-top:1px solid #5555"><td>ランダム能力</td><td>${escapeHTML(affixText(x))}</td><td>${y?escapeHTML(affixText(y)):'—'}</td></tr></tbody></table></div><p class="muted">緑は数値上昇、橙は低下。実戦性能は固有能力・敵の防御・射程などにも左右されます。</p></div>`}
function gearQuickStats(x){
 if(!x)return '';
 const d=GEARTYPE[x.type]?.[x.base];if(!d)return '';
 const pill=(k,v)=>`<span class="pill" style="margin:2px 3px 2px 0;display:inline-block">${k} <b>${escapeHTML(String(v))}</b></span>`;
 const max=repairMax(x),dur=Math.max(0,Number(x.dur??max));
 if(x.type==='weapon'){
  const w=W[x.base]||MELEE[x.base]||d;
  return `<div class="gear-quick-stats">${pill('威力',(w.d??w.damage??d.d??0)+gearVal(x,'damage'))}${pill('命中',`${(w.a??d.a??0)+gearVal(x,'accuracy')}pt`)}${pill('貫通',(w.p??d.p??0)+gearVal(x,'penetration'))}${pill('連射',w.shots??d.shots??1)}${pill('リロードまで',w.melee?'不要':`${reloadAttackLimit(w)+attEffect(x,'magazine')}回攻撃`)}${pill('弾薬',w.melee?'不要':AM[w.ammo]?.n||w.ammo||'不要')}${max?pill('耐久',`${Math.floor(dur)}/${Math.floor(max)}（初期 ${repairOriginalMax(x)}）`):''}</div>`;
 }
 if(x.type==='armor')return `<div class="gear-quick-stats">${pill('基礎防御',(d.def||0)+gearVal(x,'defense'))}${pill('実効防御',armorDef(x.base,dur,x))}${pill('耐久',`${Math.floor(dur)}/${Math.floor(max)}（初期 ${repairOriginalMax(x)}）`)}${gearVal(x,'absorb')?pill('衝撃吸収',`${gearVal(x,'absorb')}%`):''}</div>`;
 if(x.type==='helmet'){
  const original=Math.max(1,d.max||1);
  const effective=Math.floor((d.def||0)*dur/original);
  return `<div class="gear-quick-stats">${pill('基礎防御',d.def||0)}${pill('実効防御',effective)}${pill('耐久',`${Math.floor(dur)}/${Math.floor(max)}（初期 ${repairOriginalMax(x)}）`)}</div>`;
 }
 if(x.type==='bag')return `<div class="gear-quick-stats">${pill('容量',`${effectiveBagCapacity(x)}kg（耐久減少 −${bagWearPenalty(x)}）`)}${gearVal(x,'organize')?pill('重量軽減',`${gearVal(x,'organize')}%`):''}${gearVal(x,'detect')?pill('装備発見',`+${gearVal(x,'detect')}pt`):''}${pill('耐久',`${Math.floor(dur)}/${Math.floor(max)}（初期 ${repairOriginalMax(x)}）`)}</div>`;
 return '';
}
function gearRow(x){const meleeEq=x.type==='weapon'&&g.eqIds.melee===x.id,mainEq=g.eqIds[x.type]===x.id,subEq=x.type==='weapon'&&g.eqIds.secondary===x.id,eq=mainEq||subEq||meleeEq;const onRaid=g.status==='raid'&&Object.values(g.raid.equipment||{}).some(y=>y?.id===x.id);const max=repairMax(x);return `<div class="item gear-card ${x.rarity}"><div class="flex between"><span class="item-title">${gearLabel(x)} ${eq?'<span class="pill ok">装備中</span>':''}${x.favorite?' ★':''}${isBossGear(x)?'<span class="pill">BOSS UNIQUE</span>':''}${x.newItem?'<span class="new-mark">NEW</span>':''}</span><span class="pill">${fmt(gearPrice(x))}₽</span></div>${x.type==='attachment'?tokAttachmentImage(x.base):x.type==='accessory'?tokAccessoryImage(x.base):x.type==='weapon'?tokWeaponImage(x.base):tokEquipmentImage(x.base,x.type)}<small>${x.type==='weapon'?`<span class="ammo-guide">${W[x.base]?.melee?'弾薬不要（近接）':ammoGuide(x.base)} / 得意距離：${DIST_LABEL[(RANGE_RULES[x.base]||[0,0,0]).indexOf(Math.max(...(RANGE_RULES[x.base]||[0,0,0])))]}</span>`:''}${escapeHTML(affixText(x))}${['armor','weapon','helmet'].includes(x.type)?` / 耐久${Math.floor(x.dur??max)}/${Math.floor(max)}（新品時${repairOriginalMax(x)}）`:''}</small>${x.type==='weapon'?weaponFixedLabel(x.base):''}${gearQuickStats(x)}<div class="btns">${b('詳細',`gearDetail:${x.id}`,'small')}${b('比較',`gearCompare:${x.id}`,'small')}${x.type==='attachment'?'':(!W[x.base]?.melee||x.base==='chainsaw')?b(mainEq?'メイン装備中':'メインに装備',`gearEquip:${x.id}`,'small',mainEq||g.status!=='base'):b(meleeEq?'近接装備中':'近接に装備',`equipMelee:${x.id}`,'small',meleeEq||g.status!=='base')}${x.type==='weapon'&&!W[x.base]?.melee?b(subEq?'サブ装備中':'サブに装備',`equipSecondary:${x.id}`,'small',subEq||mainEq||g.status!=='base'):''}${b(x.favorite?'★解除':'☆保護',`gearFavorite:${x.id}`,'small',g.status!=='base')}${['armor','weapon','helmet','bag'].includes(x.type)?b('修理',`gearRepair:${x.id}`,'small',g.status!=='base'||(x.dur??max)>=max):''}${b('売却',`gearSell:${x.id}`,'small',eq||onRaid||g.status!=='base')}${unreadyGear(x)?`<label class="pill"><input type="checkbox" data-bulk-id="${x.id}" ${selectedBulk.has(x.id)?'checked':''}> 一括対象</label>`:''}</div>${compareId===x.id?gearComparison(x):''}${detailId===x.id?`<div class="notice">${gearDetails(x)}</div>`:''}</div>`}
function gearCompare(id){const x=findGear(id);if(!x)return;markGearRead(id);compareId=compareId===id?null:id;detailId=null;render()}
function gearSell(id){sellOne(id)}
let raidSetupTab='map';
function baseView(){ensureRoyalCollection();const needs=canEquip()?'出撃可能':'出撃条件を満たしていません';const s=g.settings;return `${g.reportPending?'<div class="notice">レイド終了・結果未確認。次の出撃前に報告を確認してください。'+b('結果を開く','reportOpen','small')+'</div>':''}<div class="hero"><strong>${escapeHTML(g.notice||'拠点で出撃準備を整えましょう')}</strong><p>現在地：拠点 ／ 状態：<span class="${canEquip()?'ok':'warn'}">${needs}</span></p><div class="flex">${b('装備・倉庫へ','tab:stash')}${b('武器店','tab:weaponShop')}${b('装備品店','tab:equipmentShop')}${b('病院','tab:heal')}</div></div>${containerHasItems()?`<div class="notice">戦利品に戦利品が残っています。${b('戦利品を整理','tab:stash','small')}</div>`:''}${prepareWarnings()}<div class="grid"><section class="panel"><h2>出撃準備</h2><p class="muted">v2.0：ボス戦の自動交戦距離・戦闘学習を追加。ヘッドショット・ヘルメット・医療品・グレネード・耐久修理に対応。交戦開始時に先制攻撃／敵の強襲攻撃を判定。メイン・サブ・近接武器は距離に応じて自動選択します。複数敵も出現します。</p><p>武器：<b>${equippedGear('weapon')?gearName(equippedGear('weapon')):'未装備'}</b> ／ 弾薬：${W[g.equipped.weapon]?`${AM[W[g.equipped.weapon].ammo].n}（倉庫${fmt(activeCount(g.bank.ammo,W[g.equipped.weapon].ammo))}発／携行${fmt(requestedAmmo(W[g.equipped.weapon].ammo))}発）`:'—'}</p><p>サブ武器：<b>${g.eqIds.secondary?gearName(findGear(g.eqIds.secondary)):'なし'}</b> ${g.eqIds.secondary?b('サブを外す','unequipSecondary','small',g.status!=='base'):''}</p><p>近接武器：<b>${g.eqIds.melee?gearName(findGear(g.eqIds.melee)):'なし'}</b> ${g.eqIds.melee?b('近接を外す','unequipMelee','small',g.status!=='base'):''}</p><p>防具：${equippedGear('armor')?gearName(equippedGear('armor')):'なし'} ／ バッグ：${equippedGear('bag')?gearName(equippedGear('bag')):'未装備'}</p><p>HP：${g.hp}/${baseMaxHp()}（拠点で毎分+1）</p><p>資金：${fmt(g.money)}₽（9,040₽未満なら毎分+10₽）</p><p><small>弾薬は「装備・倉庫」の携行品画面で口径別に持込数を指定できます。倉庫の残弾は持ち出しません。生還時は携行残弾が倉庫へ戻ります。</small></p></section><section class="panel"><h2>最終目標</h2><p>${g.bank.key?'✓':'○'} 特殊アクセスキー</p><p>${activeCount(g.bank.loot,'memory')?'✓':'○'} 暗号化記憶装置</p><p>${activeCount(g.bank.loot,'research')?'✓':'○'} 希少研究資料</p><p class="muted">3種類を同時に倉庫へ保管するとクリア。</p><p>工業探索実績：<b>${fmt(g.industrialCount)}/30</b> ${g.keyUnlocked?'<span class="ok">キー解放済み</span>':''}</p></section></div><section class="panel raid-setup"><h2>レイド出撃</h2><div class="raid-setup-tabs">${[['map','マップ選択'],['target','探索目標'],['mode','探索方針'],['detail','詳細設定']].map(([id,label])=>`<button type="button" class="${raidSetupTab===id?'active':''}" data-raid-setup="${id}">${label}</button>`).join('')}</div><div class="raid-setup-body">${raidSetupTab==='map'?`<h3>出撃するマップ</h3><div class="raid-choice-grid raid-map-grid">${Object.entries(MAP).filter(([id])=>g.unlocked[id]).sort((a,b)=>DISTRICT_TIERS.flat().indexOf(a[0])-DISTRICT_TIERS.flat().indexOf(b[0])).map(([id,m])=>`<label class="raid-choice ${s.map===id?'chosen':''}"><input type="radio" name="raid-map-ui" data-setting="map" value="${id}" ${s.map===id?'checked':''}>${tokDistrictThumb(id)}<strong>${m.n}</strong></label>`).join('')}</div><p class="muted">解放済みの地区から選択できます。</p>`:raidSetupTab==='target'?`<h3>探索目標</h3><div class="raid-choice-grid">${Object.entries(EXPLORE_TARGETS).map(([id,n])=>`<label class="raid-choice ${Number(s.exploreTarget||15)===Number(id)?'chosen':''}"><input type="radio" name="explore-target-ui" data-setting="exploreTarget" value="${id}" ${Number(s.exploreTarget||15)===Number(id)?'checked':''}><strong>${id}回</strong><small>${n}</small></label>`).join('')}</div>`:raidSetupTab==='mode'?`<h3>探索方針</h3><div class="raid-choice-grid">${['survival','normal','value','gear','capacity'].map(id=>`<label class="raid-choice ${(s.mode==='cautious'?'survival':s.mode==='greedy'?'value':s.mode)===id?'chosen':''}"><input type="radio" name="explore-mode-ui" data-setting="mode" value="${id}" ${(s.mode==='cautious'?'survival':s.mode==='greedy'?'value':s.mode)===id?'checked':''}><strong>${MOD[id].n}</strong></label>`).join('')}</div><p class="muted">価格・装備品・バッグ容量重視は目標達成後も最大5回追加探索します。</p>`:`<h3>出撃種別</h3><div class="raid-choice-grid">${[['normal','通常レイド'],...(bossKnown(s.map)?[['boss','ボス討伐レイド']]:[])].map(([id,n])=>`<label class="raid-choice ${s.raidType===id?'chosen':''}"><input type="radio" name="raid-type-ui" data-setting="raidType" value="${id}" ${s.raidType===id?'checked':''}><strong>${n}</strong></label>`).join('')}</div><h3>通常レイドのボス対応</h3><div class="raid-choice-grid">${[['fight','交戦する'],['avoid','回避して脱出']].map(([id,n])=>`<label class="raid-choice ${s.bossPolicy===id?'chosen':''}"><input type="radio" name="boss-policy-ui" data-setting="bossPolicy" value="${id}" ${s.bossPolicy===id?'checked':''}><strong>${n}</strong></label>`).join('')}</div><h3>ボス戦術</h3><div class="raid-choice-grid">${[['cautious','生存重視'],['normal','標準'],['aggressive','強襲重視']].map(([id,n])=>`<label class="raid-choice ${s.bossTactic===id?'chosen':''}"><input type="radio" name="boss-tactic-ui" data-setting="bossTactic" value="${id}" ${s.bossTactic===id?'checked':''}><strong>${n}</strong></label>`).join('')}</div><p class="muted">情報進捗 ${g.bosses[s.map].intel}/${BOSSES[s.map].full}</p><h3>複数敵・攻撃優先</h3><div class="raid-choice-grid">${[['lowhp','HPの低い敵から'],['threat','攻撃力の高い敵から'],['nearest','近い敵から']].map(([id,n])=>`<label class="raid-choice ${s.targetPriority===id?'chosen':''}"><input type="radio" name="target-priority-ui" data-setting="targetPriority" value="${id}" ${s.targetPriority===id?'checked':''}><strong>${n}</strong></label>`).join('')}</div>`}</div><div class="raid-summary"><strong>出撃内容</strong><p>マップ：${escapeHTML(MAP[s.map]?.n||'未選択')}</p><p>探索目標：${s.exploreTarget||15}回 ／ 方針：${MOD[s.mode]?.n||'通常'}</p><p>出撃種別：${s.raidType==='boss'?'ボス討伐レイド':'通常レイド'}</p></div>${raidReadinessHTML()}<div class="raid-launch"><button type="button" class="primary" id="tok-raid-launch" data-action="start" onclick="tokRaidLaunchDirect(event)">レイドに出撃</button></div></section>${bossView()}` }
function raidView(){if(raidPane==='history')return historyView();const r=g.raid;if(!r)return `<section class="panel"><h2>レイド</h2>${g.reportPending?'<div class="record-unread">レイドが終了しました。結果は未確認です。'+b('結果を確認する','reportOpen','primary')+'</div>':'進行中のレイドはありません。'}${b('過去の履歴','raidHistory','small')}</section>`;const elapsed=clamp(Math.floor((Date.now()-r.startedAt)/1000),0,1020),total=r.phase==='explore'?900:900+r.required*30;const pct=r.phase==='explore'?Math.min(100,r.explore/30*100):r.phase==='approach'?Math.min(100,r.explore/BOSSES[r.map].approach*100):Math.min(100,r.progress/r.required*100);return `<div class="raid-pane">${b('現在のレイド','raidCurrent','small')}${b('過去の履歴','raidHistory','small')}</div>${r.settings?.raidType==='boss'?`<div class="boss-combat-strip"><div class="boss-panel-title">OPERATION / BOSS HUNT</div><strong>${escapeHTML(BOSSES[r.map].n)}</strong><div class="line"></div><small>ボス接近中・自動戦闘待機。戦闘結果は帰還後に公開。</small></div>`:''}<div class="hero">${tokDistrictScene(r.map)?`<img class="raid-art" alt="${escapeHTML(MAP[r.map].n)} の背景" src="${tokDistrictScene(r.map)}">`:""}<strong>レイド進行中</strong><p>${MAP[r.map].n} ／ ${MOD[r.mode].n} ／ 経過 ${Math.floor(elapsed/60)}分${String(elapsed%60).padStart(2,'0')}秒</p><p>${r.phase==='explore'?'探索フェーズ':r.phase==='approach'?'ボス接近フェーズ':'脱出フェーズ'}（${r.phase==='explore'?`${depthDisplay(r.explore)}`:r.phase==='approach'?`${r.explore}/${BOSSES[r.map].approach}`:`${r.progress}/${r.required}`}）</p><div class="progress"><div style="width:${pct}%"></div></div><p>戦闘・戦利品・負傷・弾薬の詳細はレイド終了後に公開されます。</p><p class="muted">30秒ごとにイベントが進行します。画面を閉じても、再開時にオフライン分を処理します。</p>${b('経過を更新','refresh','primary')}</div>`}
function v19ShopItem(type,id,o){return `<div class="item"><strong>${escapeHTML(o.n)}</strong> <span class="pill">${fmt(o.price)}₽</span>${tokEquipmentImage(id,type)}<small>${o.def??'—'} 防御 / ${o.max??'—'} 耐久 ${extInfo(o)}</small><div class="btns">${b('購入',`buy:${type}:${id}:1`,'small',g.money<o.price)}${b('3個購入',`buy:${type}:${id}:3`,'small',g.money<o.price*3)}</div></div>`}
function operatorPanel(){const slots=[['accessory','アクセサリー'],['helmet','ヘルメット'],['armor','アーマー'],['bag','バッグ'],['weapon','メイン'],['secondary','サブ'],['melee','近接']];return `<section class="panel"><h2>PMC EQUIPMENT — 装備中</h2>${equippedRepairButton()}${equippedAmmoSupplyButton()}<div class="grid"><div class="item" style="display:grid;place-items:center;min-height:200px;background:#17241e;border-radius:8px"><svg viewBox="0 0 160 240" width="135" height="205" aria-label="PMC固定シルエット"><circle cx="80" cy="33" r="24" fill="#718376"/><path d="M44 65h72l26 75-23 10-15-44 12 115H44l12-115-15 44-23-10z" fill="#526b5a"/><path d="M64 205l-5 33h-24l9-65h72l9 65h-24l-5-33" fill="#303e35"/></svg><small>立ち絵は後日選択可能に拡張</small></div><div>${slots.map(([id,label])=>{const item=findGear(g.eqIds[id]);return `<div class="item"><small>${label}</small><br><strong>${item?escapeHTML(gearName(item)):'未装備'}</strong>${item?(item.type==='accessory'?tokAccessoryImage(item.base):tokEquipmentImage(item.base,item.type)):''}${item?(item.type==='accessory'?'<small>'+escapeHTML(affixText(item))+'</small>':gearQuickStats(item)):''}${item?`<div class="btns">${b('外す',`unequipSlot:${id}`,'small',g.status!=='base')}${repairMax(item)?b(`修理 ${fmt(repairPrice(item))}₽`,`gearRepair:${item.id}`,'small',g.status!=='base'||!repairPrice(item)||g.money<repairPrice(item)):''}</div>`:''}</div>`}).join('')}</div></div></section>${tokSetPanel()}`}
function bagSlotGrid(used,cap){
 const total=Math.max(0,Math.floor(Number(cap)||0)),filled=Math.max(0,Math.floor(Number(used)||0));
 const cells=Array.from({length:total},(_,i)=>`<span class="bag-slot ${i<filled?'occupied':'empty'}" aria-hidden="true"></span>`).join('');
 return `<div class="bag-slots-wrap" role="img" aria-label="バッグ使用量 ${filled} / ${total} 枠"><div class="bag-slots">${cells||'<span class="muted">バッグ未装備</span>'}</div><small class="muted">■ 使用中　□ 空き　（${filled}/${total}枠）</small></div>`;
}
function supplyPanel(){const cap=bankCarrySlots(),used=playerLoadoutSlots();const ammoRows=equippedAmmoCalibers().map(cal=>{const stock=activeCount(g.bank.ammo,cal),qty=requestedAmmo(cal),available=stock-qty,locked=g.status!=='base';return `<div class="item"><div class="flex between"><strong>${escapeHTML(AM[cal]?.n||cal)}</strong><small>倉庫所持 ${fmt(stock)}発 ／ 出撃携行 ${fmt(qty)}発 ／ 倉庫に残す ${fmt(available)}発</small></div><div class="btns">${b('−10',`ammoCarry:${cal}:-10`,'small',locked||qty===0)}${b('−1',`ammoCarry:${cal}:-1`,'small',locked||qty===0)}<span class="pill">携行 ${fmt(qty)}発</span>${b('＋1',`ammoCarry:${cal}:1`,'small',locked||qty>=stock)}${b('＋10',`ammoCarry:${cal}:10`,'small',locked||qty>=stock)}${b('最大',`ammoCarry:${cal}:max`,'small',locked||qty>=stock)}${b('0発',`ammoCarry:${cal}:none`,'small',locked||qty===0)}</div></div>`}).join('');return `<section class="panel"><h2>CARRIED ITEMS — 携行品</h2><p class="notice">バッグ：${used}/${cap}枠 ／ 予備弾薬は口径ごと30発につき1枠（装填分30発は除外）。</p>${bagSlotGrid(used,cap)}<h3>レイドに持ち込む弾薬</h3><p class="muted">装備したメイン・サブ武器の口径ごとに携行数を指定します。未携行分は倉庫に残り、レイドで失われません。同じ口径の武器は弾薬を共有します。</p>${ammoRows||'<div class="item">銃を装備すると対応弾薬の携行数を調整できます。</div>'}${Object.entries(ITEMS).filter(([id])=>!TOK_GRENADES.includes(id)).map(([id,o])=>`<div class="item"><div class="flex between"><strong>${o.n}</strong><small>倉庫 ${activeCount(g.bank.supplies,id)}個 · ${o.slots}枠/個</small></div><div class="btns">${b('−',`carry:${id}:-1`,'small',g.status!=='base'||!(g.carry[id]||0))}<span class="pill">持込 ${g.carry[id]||0}</span>${b('＋',`carry:${id}:1`,'small',g.status!=='base'||(g.carry[id]||0)>=activeCount(g.bank.supplies,id)||used+o.slots>cap)}</div></div>`).join('')}</section>`}

let pmcPane='equipment';
function pmcStatusView(){
 const injuryInfo=`<section class="panel"><h2>状態異常</h2><p>出血：${g.bleed?'あり':'なし'} ／ 毒：${g.poisonTurns||0}ターン ／ 火傷：${g.burnTurns||0}ターン</p><p>腕骨折：${g.armBroken?'命中−15pt・回避−10pt':'なし'} ／ 足骨折：${g.legBroken?'回避−20pt・脱出＋2ターン':'なし'}</p></section>`;
 const e=equippedGear, armor=e('armor'),helmet=e('helmet'),bag=e('bag');
 const ext=extBonus(null);
 const set=tokSetBonuses(null);
 const maxHp=baseMaxHp()+gearVal(armor,'maxhp')+set.maxhp;
 const main=e('weapon'),sub=e('secondary');
 const akimboPistols=new Set(['pm','tt','glock17','deserteagle','gunslinger','kongou']);
 const akimboOn=!!(main&&sub&&akimboPistols.has(main.base)&&akimboPistols.has(sub.base));
 const selectedStyle=tokPmcStyleId(null),niferOn=!akimboOn&&tokNiferEnabled(null),currentStyle=akimboOn?{name:'アキンボ',desc:'二丁拳銃',hit:0,dodge:0,damage:0,pen:0}:niferOn?{name:'ナイファー',desc:'軽装型',hit:0,dodge:10,damage:0,pen:0}:TOK_PMC_STYLES[selectedStyle];
 const stylePicker=`<label for="tok-pmc-style">通常スタイルを選択</label><select id="tok-pmc-style" data-pmc-style="1" ${g.status==='base'?'':'disabled'}>${Object.entries(TOK_PMC_STYLES).map(([id,v])=>`<option value="${id}" ${id===selectedStyle?'selected':''}>${v.name}（${v.desc}）</option>`).join('')}</select>`;
 const styleBonus=akimboOn?'アキンボ発動中は通常スタイルの補正を一時停止':niferOn?'ナイファー強制発動：回避+10pt ／ 脱出必要イベント−1（通常スタイルの補正は一時停止）':`命中 ${currentStyle.hit>=0?'+':''}${currentStyle.hit}pt ／ 回避 ${currentStyle.dodge>=0?'+':''}${currentStyle.dodge}pt ／ 攻撃 ${currentStyle.damage>=0?'+':''}${currentStyle.damage}% ／ 貫通 ${currentStyle.pen>=0?'+':''}${currentStyle.pen}`;
 const akimboPanel=injuryInfo+`<section class="panel"><h2>戦闘スタイル</h2><div class="item"><div class="flex between"><span>現在のスタイル</span><strong>${currentStyle.name}（${currentStyle.desc}）${akimboOn||niferOn?'・強制発動':''}</strong></div></div>${niferOn?'<p class="muted">ライトベスト・ヘルメットなし・近接武器またはハンドガン1本・小型バッグで自動発動します。</p>':''}${stylePicker}<p>${styleBonus}</p>${g.status!=='base'?'<small class="muted">レイド中は変更できません。</small>':''}${akimboOn?`<p>メイン：${escapeHTML(gearName(main))}<br>サブ：${escapeHTML(gearName(sub))}</p><p>1回の攻撃でメイン → サブの順に各1回攻撃します。両方の命中率に−15ptが適用され、弾薬・命中・ダメージ・貫通・ヘッドショット・即死判定はそれぞれ独立します。</p><p>弾薬は各銃で消費します。左右いずれかの武器の連射数に応じた攻撃回数に達すると、次の攻撃時に1ターン使って2丁を同時リロードします。予備弾薬がない銃は射撃できません。</p>`:`<p class="muted">メイン武器とサブ武器の両方にハンドガンを装備すると、自動的にアキンボスタイルになります。解除後は選択していた通常スタイルに戻ります。</p>`}</section>`;
 const stat=(name,value,info='')=>`<div class="item"><div class="flex between"><span>${name}</span><strong>${value}</strong></div>${info?`<small class="muted">${info}</small>`:''}</div>`;
 const extPanel=`<section class="panel"><h3>装備ビルド補正</h3><p>回避 +${ext.dodge}pt ／ 耐貫通 ${ext.pen}% ／ 衝撃吸収 ${ext.shock}% ／ 探索発見 +${ext.loot}pt ／ 耐久保護 ${ext.wear}% ／ 追加戦利品抽選 ${ext.extra}%</p><small>軽装 ${ext.light}部位・中装 ${ext.medium}部位。破損した防具の特殊効果は無効です。</small></section>`;
 const weapons=[['weapon','メイン武器'],['secondary','サブ武器'],['melee','近接武器']].map(([slot,label])=>{
  const x=e(slot);if(!x)return `<section class="panel"><h3>${label}</h3><p class="muted">未装備</p></section>`;
  const w=W[x.base]||MELEE[x.base]||{},damage=w.d??w.damage,accuracy=w.a,pen=w.p;
  const line=(name,base,bonus,unit='')=>base===undefined?stat(name,'—'):stat(name,`${base+bonus}${unit}`,`基本 ${base}${unit} ／ 装備能力 ${bonus>=0?'+':''}${bonus}${unit}`);
  const isGun=!!W[x.base]&&!w.melee;
  return `<section class="panel"><h3>${label}：${escapeHTML(gearName(x))}</h3><p class="muted">${escapeHTML(RN[x.rarity]||x.rarity||'')} ／ ${escapeHTML(affixText(x))}</p>${line('威力',damage,gearVal(x,'damage'))}${set.damage?stat('セット攻撃力補正',`+${set.damage}%`,'上記の威力に対する戦闘時の倍率補正'):''}${line('命中補正',accuracy,gearVal(x,'accuracy'),'pt')}${line('貫通力',pen,gearVal(x,'penetration'))}${stat('連射数',w.shots??1)}${stat('対応弾薬',isGun?escapeHTML(AM[w.ammo]?.n||w.ammo||'—'):'不要')}${stat('武器耐久',`${x.dur??repairMax(x)} / ${repairMax(x)}`)}${stat('連射減衰補正',`${gearVal(x,'control')}pt`)}${stat('弾薬節約補正',`${gearVal(x,'saving')}%`)}<p class="muted">※距離・敵・射撃順・固有能力による戦闘中の補正は別途適用されます。</p></section>`;
 }).join('');
 const amax=armor?A[armor.base].max+gearVal(armor,'durability'):0;
 const hmax=helmet?H[helmet.base].max:0;
 const adef=armor?armorDef(armor.base,armor.dur??amax,armor):0;
 const hdef=helmet?Math.floor((H[helmet.base].def||0)*Math.max(0,helmet.dur??hmax)/Math.max(1,hmax)):0;
 return `${akimboPanel}${extPanel}${tokSetPanel()}<section class="panel"><h2>PMC STATUS — キャラクター状態</h2><p class="muted">現在の装備をもとに計算した拠点での参考値です。装備を変更すると自動更新されます。</p>${stat('レベル',g.level)}${stat('経験値',fmt(g.xp))}${stat('現在HP',`${g.hp} / ${maxHp}`,`基本100 ＋レベル補正 ${levelHpBonus()} ＋防具能力 ${gearVal(armor,'maxhp')} ＋セット ${set.maxhp}`)}${stat('次のレベルまで',g.level<LEVEL_CAP?`${fmt(Math.max(0,xpThreshold(g.level+1)-g.xp))} XP`:'最大レベル')}${stat('状態',g.status==='base'?'拠点待機中':'レイド中')}</section><section class="panel"><h2>防御・生存性能</h2>${stat('回避率（レベル補正）',`${levelDodgeBonus()}%`,'敵の命中判定後に独立して判定。距離や敵の命中率は別計算です。')}${stat('射撃・近接命中（レベル補正）',`+${levelAccuracyBonus()+set.accuracy}pt`,'レベル +'+levelAccuracyBonus()+'pt ／ セット +'+set.accuracy+'pt')}${stat('セット効果（戦闘・探索）',`先制 +${set.initiative}pt ／ ヘッドショット +${set.headshot}pt ／ 希少品昇格 +${set.foxRare}pt`)}${stat('戦利品発見（レベル補正）',`+${levelLootBonus()}pt`)}${stat('アーマー実効防御',adef,armor?`基礎防御 ${A[armor.base].def} ＋能力 ${gearVal(armor,'defense')} ／ 耐久 ${armor.dur??amax}/${amax}`:'未装備')}${stat('ヘルメット防御',hdef,helmet?`基礎防御 ${H[helmet.base].def} ／ 耐久 ${helmet.dur??hmax}/${hmax}`:'未装備')}${stat('衝撃吸収補正',`${gearVal(armor,'absorb')}%`)}${stat('防具耐久保護',`${gearVal(armor,'durprotect')}%`)}${stat('離脱補正（装備能力合計）',`${['weapon','secondary','melee','armor','helmet','bag'].reduce((v,k)=>v+gearVal(e(k),'escape'),0)}pt`)}${stat('バッグ容量',bag?`${B[bag.base].kg+gearVal(bag,'capacity')}kg`:'未装備')}${bagSlotGrid(playerLoadoutSlots(),bankCarrySlots())}${stat('重量ペナルティ軽減',`${gearVal(bag,'load')}%`)}<p class="muted">※回避率・最終被ダメージは敵の命中、距離、貫通、特殊行動によって変化するため、固定の数値としては表示しません。</p></section><h2>攻撃性能</h2>${weapons}`;
}
function pmcTabs(){return `<section class="panel"><div class="btns">${[['status','PMCステータス'],['equipment','装備一覧'],['warehouse','倉庫']].map(([id,name])=>b(name,`pmcPane:${id}`,pmcPane===id?'primary':'small')).join('')}</div></section>`}
if(!g.secretKeysMigrated){const old=activeCount(g.bank.loot,'secretkey');if(old){g.bank.loot.key_heart=(g.bank.loot.key_heart||0)+old;delete g.bank.loot.secretkey}if(g.secretKeyEquipped===true)g.secretKeyEquipped='key_heart';g.secretKeysMigrated=true;save()}
function secretKeyToggle(key){if(g.status!=='base'||g.longRun?.active)return;g.secretKeyEquipped=g.secretKeyEquipped===key?null:key;save();render()}
function stashView(){if(pmcPane==='status')return pmcTabs()+pmcStatusView();if(pmcPane==='equipment')return pmcTabs()+operatorPanel()+supplyPanel();let arr=[...g.gear].filter(x=>stashFilter==='all'||stashFilter==='new'&&x.newItem||stashFilter==='favorite'&&x.favorite||stashFilter==='boss'&&isBossGear(x)||stashFilter===x.type);arr.sort((a,b)=>stashSort==='rarity'?(['common','rare','epic','legendary','boss'].indexOf(b.rarity)-['common','rare','epic','legendary','boss'].indexOf(a.rarity)):stashSort==='value'?gearPrice(b)-gearPrice(a):(b.acquiredAt||Number(b.id.split('-').pop())||0)-(a.acquiredAt||Number(a.id.split('-').pop())||0));const checked=g.gear.filter(x=>selectedBulk.has(x.id)&&unreadyGear(x));return `${pmcTabs()}${storagePanel()}${warehouseSupplyPanel()}<section class="panel"><h3>秘密の部屋の鍵</h3><p>対応する秘密の部屋を見つけると鍵を1個消費します。見つからず生還した場合は返却、死亡時はロストします。</p>${SECRET_KEYS.map(key=>`<div class="item">${L[key].n}：${activeCount(g.bank.loot,key)}個 ${b(g.secretKeyEquipped===key?'持ち込み：ON':'持ち込み：OFF',`secretKeyToggle:${key}`,'small',g.status!=='base'||!activeCount(g.bank.loot,key))}</div>`).join('')}</section><section class="panel"><h2>装備品</h2><p class="muted">装備品タブを開くとNEW表示が解除されます。保護品・ボス装備・装備中の品は一括売却できません。</p><div class="toolbar"><select data-ui="stashFilter"><option value="all" ${stashFilter==='all'?'selected':''}>すべて</option>${[['new','NEWのみ'],['weapon','武器'],['accessory','アクセサリー'],['armor','防具'],['helmet','ヘルメット'],['bag','バッグ'],['favorite','お気に入り'],['boss','ボス固有']].map(([k,n])=>`<option value="${k}" ${stashFilter===k?'selected':''}>${n}</option>`).join('')}</select><select data-ui="stashSort">${[['new','新着順'],['rarity','レアリティ順'],['value','売却額順']].map(([k,n])=>`<option value="${k}" ${stashSort===k?'selected':''}>${n}</option>`).join('')}</select></div>${arr.map(gearRow).join('')||'<p>該当する装備はありません</p>'}<div class="notice">一括売却：${checked.length}点 / ${fmt(checked.reduce((n,x)=>n+gearPrice(x),0))}₽<div class="btns">${b('売却可能な通常装備を選択','bulkSelect','small',g.status!=='base')}${b('選択解除','bulkClear','small')}${b('選択品を売却','bulkSell','small',!checked.length)}</div></div></section><div class="grid"><section class="panel"><h2>弾薬</h2><p class="notice">${equippedGear('weapon')?ammoGuide(equippedGear('weapon').base):'武器未装備'}</p>${Object.entries(AM).map(([id,o])=>itemRow(id,o,'ammo')).join('')}</section><section class="panel"><h2>通常戦利品・食料・飲料水</h2><p class="muted">売却できる通常アイテムのみ表示します。秘密の部屋の鍵・重要任務品は下の専用欄にまとめています。</p>${Object.entries(L).filter(([id,o])=>!['bandage','medkit','memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id)&&(!o.regionalMap||TOK_REGIONAL_COLLECTION_SET.has(id)||activeCount(g.bank.loot,id)>0)).map(([id,o])=>itemRow(id,o,'loot')).join('')}</section><section class="panel"><h2>マップ解放情報</h2><p class="muted">探索で得た手掛かりと地区アクセスキーの解放記録です。アクセスキーは生還時に自動使用され、地区が永久解放されます。所持数や売却操作はありません。</p>${DISTRICT_TIERS.slice(1).flat().filter(id=>(g.districtClues?.[id]?.length||0)>0||g.unlocked?.[id]).map(id=>`<div class="item"><div class="flex betw"><strong>${MAP[id].n}</strong><span class="pill">${g.unlocked?.[id]?'解放済み':'未解放'}</span></div>${(g.districtClues?.[id]||[]).length?`<p class="muted">発見した手掛かり</p>${(g.districtClues[id]||[]).map(i=>`<div class="muted">・${DISTRICT_CLUES[id]?.[i]||'手掛かり'}</div>`).join('')}`:'<p class="muted">手掛かり未発見</p>'}<p class="muted">${g.unlocked?.[id]?`地区アクセスキー：${DISTRICT_KEY_NAMES[id]||MAP[id].n+'のアクセスキー'}（解放記録）`:`地区アクセスキー：未入手 ／ キー発見率 ${(keyDiscoveryChance(id)*100).toFixed(0)}%`}</p></div>`).join('')||'<p class="muted">マップ解放に関する手掛かり・解放記録はまだありません。</p>'}</section><section class="panel"><h2>重要任務アイテム</h2><p class="muted">クリア条件に関係する一度きりの任務品です。所持している品だけを表示し、売却・数量表示は行いません。</p>${[g.bank.key?'特殊アクセスキー':null,activeCount(g.bank.loot,'memory')?'暗号化記憶装置':null,activeCount(g.bank.loot,'research')?'希少研究資料':null].filter(Boolean).map(name=>`<div class="item"><strong>${name}</strong><span class="pill">取得済み・売却不可</span></div>`).join('')||'<p class="muted">現在所持している重要任務アイテムはありません。</p>'}</section></div>`}
function shopRepairPanel(types,title){
 const items=g.gear.filter(x=>types.includes(x.type)&&repairMax(x)>0);
 const ordered=items.slice().sort((a,b)=>{const ea=Object.values(g.eqIds).includes(a.id)?0:1,eb=Object.values(g.eqIds).includes(b.id)?0:1;return ea-eb});
 return `<section class="panel"><h2>${title}</h2><p class="muted">通常修理では現在耐久値を回復し、最大耐久値が減少します。</p>${ordered.filter(x=>(x.dur??repairMax(x))<repairMax(x)).map(x=>{const max=repairMax(x),cost=repairPrice(x),eq=Object.values(g.eqIds).includes(x.id);return `<div class="item"><div class="flex between"><strong>${gearLabel(x)}</strong>${eq?'<span class="pill">装備中</span>':''}</div><p class="muted">耐久 ${x.dur??max}/${max} ／ 修理費 ${fmt(cost)}₽</p><div class="btns">${b('修理する',`gearRepair:${x.id}`,'small',g.status!=='base'||!cost||g.money<cost)}</div></div>`}).join('')||'<p class="muted">修理が必要な装備はありません。</p>'}</section>`+completeRepairPanel(types)
}
/* v3.6.58: 常設販売銃器の種別分類と並び替え */
const TOK_SHOP_WEAPON_GROUPS=[
 ['HG','ハンドガン',['pm','tt','glock17','deserteagle']],
 ['SMG','SMG',['pp19','kedr','mp5','pps43','p90']],
 ['SG','SG（ショットガン）',['mp133','mp153','saiga12']],
 ['LMG','LMG（軽機関銃）',['rpk74','m249','pkp']],
 ['AR','AR（アサルトライフル）',['aks','ak','ak105','m4a1','aug','adar','vpo136','scarh']],
 ['SR','SR（狙撃・マークスマン）',['sks','mosin','svd']]
];
function tokShopWeaponSections(){
 const entries=Object.entries(W).filter(([id,o])=>!isBossOnlyGear('weapons',id)&&!id.startsWith('ex_')&&!o.melee);
 const assigned=new Set(TOK_SHOP_WEAPON_GROUPS.flatMap(group=>group[2]));
 const section=(code,label,items)=>items.length?`<section class="panel"><h2>${label} <span class="pill">${code}</span> <small class="muted">${items.length}種類</small></h2>${items.map(([id,o])=>`<div class="tok-weapon-type">${itemRow(id,o,'weapons')}</div>`).join('')}</section>`:'';
 return TOK_SHOP_WEAPON_GROUPS.map(([code,label,ids])=>section(code,label,entries.filter(([id])=>ids.includes(id)).sort((a,b)=>ids.indexOf(a[0])-ids.indexOf(b[0])))).join('')+
 section('OTHER','その他の射撃武器',entries.filter(([id])=>!assigned.has(id)));
}
function weaponShopView(){return `<div class="notice"><b>武器店</b>：銃・近接武器・弾薬・グレネードの購入と武器の修理を行います。購入した武器は倉庫に送られます。</div><div class="grid">${tokShopWeaponSections()}<section class="panel"><h2>近接武器</h2>${Object.entries(MELEE).filter(([id])=>!isBossOnlyGear('weapons',id)).map(([id,o])=>itemRow(id,o,'weapons')).join('')}</section><section class="panel"><h2>アタッチメント（COMMON）</h2><p class="muted">装着・交換は拠点の装備画面から行います。</p>${Object.entries(ATTACH).map(([id,a])=>`<div class="item tok-att-shop-item">${tokAttachmentImage(id)}<strong>${a.n}</strong> <span class="rarity common">COMMON</span>　${fmt(a.prices[0])}₽ ${b('購入',`attShop:${id}`,'small',g.status!=='base'||g.money<a.prices[0])}</div>`).join('')}</section><section class="panel"><h2>弾薬</h2><p class="notice">${g.equipped.weapon?`現在装備中：${gearName(equippedGear('weapon'))}<br>${ammoGuide(g.equipped.weapon)}`:'武器を装備すると必要な弾薬を案内します。'}</p>${Object.entries(AM).sort(([a],[b])=>Number(b===W[equippedGear('weapon')?.base]?.ammo)-Number(a===W[equippedGear('weapon')?.base]?.ammo)).map(([id,o])=>itemRow(id,o,'ammo')).join('')}<p>${b('装備・倉庫へ','tab:stash','small')}</p></section><section class="panel"><h2>グレネード</h2>${Object.entries(ITEMS).filter(([id])=>TOK_GRENADES.includes(id)).map(([id,o])=>`<div class="item"><div class="flex between"><strong>${escapeHTML(o.n)}</strong><span class="pill">${fmt(o.price)}₽</span></div>${tokConsumableImage(id)}<div class="btns">${b('購入',`buy:supplies:${id}:1`,'small',g.money<o.price)}${b('3個購入',`buy:supplies:${id}:3`,'small',g.money<o.price*3)}</div></div>`).join('')}</section>${shopRepairPanel(['weapon'],'武器の修理')}</div>`}
const BOSS_ONLY_GEAR={armors:new Set(['kongou_robe','bulldozer']),helmets:new Set(['tiger_helmet']),bags:new Set(['bombbag']),weapons:new Set(['sakura','huntress','bunny','kongou','joker','bulldozer_hammer','poison_scalpel'])};
// ボス報酬の登録情報を販売禁止判定の唯一の基準として併用する。
// 徘徊ボス（鉄雨・影縫い・冥府の大鎌・芳香）も対象。
const BOSS_REWARD_BASE_IDS=new Set([
 ...Object.values(BOSSES).map(b=>b.gear).filter(Boolean),
 'alpha','beta','gamma','bulldozer_hammer','poison_scalpel','huntress','tiger_helmet',
 'bunny','bombbag','kongou_robe','joker','sakura',
 'chainsaw','binding_chain','valhalla','gungnir','mjolnir','one_take','onetake','lastshot','guardian','guardian_shield','execution_axe','rasputin','hellfire','fuujin','raijin',
 'ex_bastion','ex_hive','ex_berserker','ex_bombers_eye','ex_bison_rig'
]);
function isBossOnlyGear(type,id){if(['nemesis','immortal_armor'].includes(id))return true;return !!BOSS_ONLY_GEAR[type]?.has(id)||BOSS_REWARD_BASE_IDS.has(id)||!!BOSS_FIXED[id]}
const EQUIPMENT_SHOP_BASE_IDS={armors:new Set(['light','standard','heavy']),helmets:new Set(['light','combat','heavy','thermal_goggles']),bags:new Set(['small','medium','large'])};
function equipmentShopSells(type,id){return !EQUIPMENT_SHOP_BASE_IDS[type]||EQUIPMENT_SHOP_BASE_IDS[type].has(id)}
const TOK_SHOP_ACCESSORY_IDS=Object.keys(TOK_ACCESSORIES).filter(id=>!isBossOnlyGear('accessories',id));
function buyShopAccessory(id){
 const def=TOK_ACCESSORIES[id];
 if(!def||!TOK_SHOP_ACCESSORY_IDS.includes(id)){alert('このアクセサリーは販売対象外です');return}
 if(storageUsed()+storageGearSlots({type:'accessory',base:id})>storageCap()){alert('倉庫容量が不足しています');return}
 transact(def.price,()=>{
  const r={seed:Math.floor(Math.random()*4294967296)};
  const gear=makeGear(r,'accessory',id,'common');
  gear.newItem=true;gear.acquiredAt=Date.now();
  g.gear.push(gear);
  g.notice=def.n+'を購入しました。能力は倉庫または装備画面で確認できます。';
 });
}
function tokShopAccessoryPanel(){return `<section class="panel"><h2>アクセサリー（COMMON・常時販売）</h2><p class="muted">購入時に能力をランダム抽選します。購入前は能力が表示されません。購入後、倉庫・装備画面で確認できます。</p><div class="grid">${TOK_SHOP_ACCESSORY_IDS.map(id=>{const o=TOK_ACCESSORIES[id];return `<div class="item"><strong>${escapeHTML(o.n)}</strong> <span class="pill">COMMON</span> <span class="pill">${fmt(o.price)}₽</span>${tokAccessoryImage(id)}<p class="muted">特殊能力：？？？（購入後に判明）</p>${b('購入',`buyShopAccessory:${id}`,'small',g.money<o.price)}</div>`}).join('')}</div></section>`}
function equipmentShopView(){return `<div class="notice"><b>装備品店</b>：基本装備（アーマー・ヘルメット・バッグ）と通常アクセサリーを常時販売します。アクセサリーはCOMMON固定で、能力は購入後に判明します。その他の装備はレイド・マーケットで入手できます。防具とヘルメットの修理も可能です。</div><div class="grid"><section class="panel"><h2>アーマー</h2>${Object.entries(A).filter(([id])=>equipmentShopSells('armors',id)).map(([id,o])=>itemRow(id,o,'armors')).join('')}</section><section class="panel"><h2>ヘルメット</h2>${Object.entries(H).filter(([id])=>equipmentShopSells('helmets',id)).map(([id,o])=>v19ShopItem('helmets',id,o)).join('')}</section><section class="panel"><h2>バッグ</h2>${Object.entries(B).filter(([id])=>equipmentShopSells('bags',id)).map(([id,o])=>itemRow(id,o,'bags')).join('')}</section>${tokShopAccessoryPanel()}${shopRepairPanel(['armor','helmet','bag'],'防具・ヘルメットの修理')}</div>`}
function treatStatus(kind){advance();if(g.status!=='base'){alert('拠点待機中のみ治療できます');return;}const poison=kind==='poison',bleed=kind==='bleed';if(!['poison','bleed','arm','leg','burn'].includes(kind))return;const active=poison?(g.poisonTurns>0):bleed?!!g.bleed:kind==='arm'?!!g.armBroken:kind==='leg'?!!g.legBroken:!!g.burnTurns;if(!active){alert('治療する状態異常がありません');return;}const cost=tok111TreatCost(kind);if(g.money<cost){alert('治療費が不足しています');return;}g.money-=cost;if(poison)g.poisonTurns=0;else if(bleed)g.bleed=false;else if(kind==='arm')g.armBroken=false;else if(kind==='leg')g.legBroken=false;else g.burnTurns=0;if(g.injuryMs)delete g.injuryMs[kind];g.notice='状態異常を病院で治療しました。';save();render();}
function healView(){const missing=baseMaxHp()-g.hp;return `<div class="notice"><b>病院</b>：負傷の治療と医療アイテムの購入ができます。グレネードは武器店で購入できます。</div><section class="panel"><h2>治療・HP回復</h2><p>HP：<b>${g.hp}/${baseMaxHp()}</b></p><div class="progress"><div style="width:${Math.min(100,100*g.hp/baseMaxHp())}%"></div></div><p>無料回復：拠点待機中、現実時間1分につきHP+1（状態異常と並行）。オフラインでも進行します。</p><p>即時治療：${fmt(missing*tokHpRate())}₽（${tokHpRate()}₽/HP）</p>${b('即時全回復','heal','primary',missing===0||g.money<missing*tokHpRate())}<p class="muted">医療品をバッグに持ち込むとレイド中に自動回復します。HPが1以上なら負傷したまま出撃できます。</p></section><section class="panel"><h2>状態異常の治療</h2><p class="muted">帰還後は各状態異常が並行して無料で自然治癒します。オフラインでも進行します。</p>${[['bleed','出血',1500,!!g.bleed],['arm','腕骨折',2200,!!g.armBroken],['leg','足骨折',2200,!!g.legBroken],['poison','毒',3000,g.poisonTurns>0],['burn','火傷',1600,g.burnTurns>0]].map(([key,name,oldCost,affected])=>{const cost=tok111TreatCost(key);return `<div class="item" style="padding:16px;margin:12px 0;border:1px solid #526759;border-radius:12px"><div class="flex between"><strong style="font-size:1.2em">${name}</strong><span class="pill">${affected?'治療が必要':'異常なし'}</span></div><p>治療費：<b>${fmt(cost)}₽</b></p>${affected?`<p>自然治癒まで ${Math.ceil(tok111InjuryLeft(key)/60)}分以内</p>`:''}<div class="btns">${b(name+'を治療','treat:'+key,'primary',!affected||g.money<cost)}</div></div>`}).join('')}</section><section class="panel"><h2>医療アイテム</h2>${Object.entries(ITEMS).filter(([id])=>!TOK_GRENADES.includes(id)).sort(([a],[b])=>(a==='antidote')-(b==='antidote')).map(([id,o])=>`<div class="item"><div class="flex between"><strong>${escapeHTML(o.n)}</strong><span class="pill">${fmt(o.price)}₽</span></div>${tokConsumableImage(id)}<div class="btns">${b('購入',`buy:supplies:${id}:1`,'small',g.money<o.price)}${b('3個購入',`buy:supplies:${id}:3`,'small',g.money<o.price*3)}</div></div>`).join('')}</section>`}
function reportView(){
 const h=(g.history||[])[0];if(!h)return `<section class="panel">レイド結果はありません。</section>`;
 const safe=x=>escapeHTML(String(x??''));
 const items=(entries,lookup)=>Object.entries(entries||{}).filter(([id,n])=>Number(n)>0).map(([id,n])=>`<div class="tok-result-row"><span>${safe(lookup(id))}</span><b>×${fmt(n)}</b></div>`).join('')||'<p class="muted">なし</p>';
 const equipment=(list)=>Array.isArray(list)&&list.length?list.map(x=>`<div class="tok-result-row"><span>${gearLabel(x)}</span></div>`).join(''):'<p class="muted">なし</p>';
 const bossName=h.bossKilled?(BOSSES[h.defeatedBossId||h.roamingBoss||(Object.keys(BOSSES).find(k=>BOSSES[k].gear&&[h.bossReward,...(h.bossRewards||[])].some(x=>x&&(x.base===BOSSES[k].gear||x.id===BOSSES[k].gear)))||h.map)]?.n||'ボス'):'なし';
 const stats=[['探索地区',MAP[h.map]?.n||h.map||'不明'],['探索回数',fmt(h.explore||0)+'回'],['敵撃破',fmt(h.kills||0)+'体'],['ボス撃破',bossName],['獲得経験値','+'+fmt(h.xp||0)+'XP'],[h.win?'回収戦利品':'回収戦利品',''+fmt(h.win?h.lootVal||0:0)+'₽相当'],['回収装備',h.win?fmt((h.gearLoot||[]).length+(h.bossRewards||[]).length)+'個':'0個']];
 return `<div class="tok-raid-result">${(h.discoveryNotices||[]).length?`<section class="panel"><button type="button" class="tok-discovery-open" onclick="tokShowDiscoveryNotices()">📋 発見報告を確認（${h.discoveryNotices.length}件）</button><p class="muted">レイド終了後にまとめて表示します。死亡時は今回発見した手がかり・キー・収集品を喪失します。</p></section>`:''}<section class="panel tok-result-hero ${h.win?'tok-survived':'tok-kia'}"><div class="muted">RAID RESULT / #${safe(h.id)}</div><div class="tok-result-word">${h.win?'生還':'戦死'}</div><div>${safe(MAP[h.map]?.n||h.map||'不明な地区')}</div></section><section class="panel"><h2>レイド戦績</h2><div class="tok-result-stats">${stats.map(([label,value])=>`<div class="tok-result-row"><span>${label}</span><b>${safe(value)}</b></div>`).join('')}</div></section>${h.win?`<section class="panel"><h2>回収報告</h2><h3>装備品</h3>${equipment([...(h.gearLoot||[]),...(h.bossRewards||[])])}<h3>戦利品・アイテム</h3>${items(h.loot,id=>L[id]?.n||id)}<p class="muted">保管先は既存の倉庫・戦利品の処理に従います。</p></section>`:`<section class="panel"><h2>損失報告</h2><p>最終HP：${fmt(h.hp||0)} ／ 獲得経験値 +${fmt(h.xp||0)}XP は保持</p><h3>失った装備</h3>${equipment(h.lostEquipment)}<h3>失った携行弾薬</h3>${items(h.lostAmmo,id=>AM[id]?.n||id)}<h3>失った戦利品</h3>${items(h.lostLoot,id=>L[id]?.n||id)}</section>`}<section class="panel"><details><summary style="cursor:pointer;font-weight:700">詳細ログを表示</summary><div class="log">${(h.log||[]).map(tokCombatLogHTML).join('')||'<p class="muted">ログなし</p>'}</div></details></section><section class="panel tok-result-actions">${b('拠点へ戻る','returnBase','primary')}${b('戦利品へ','resultWarehouse')}${b('詳細ログ','resultLog')}</section></div>`;
}
function historyView(){
 const list=(Array.isArray(g.history)?g.history:[]).filter(h=>(historyFilter==='all'||historyFilter==='boss'&&h.raidType==='boss'||historyFilter==='win'&&h.win||historyFilter==='loss'&&!h.win));
 const chosen=historyDetailId===null?null:g.history.find(h=>String(h.id)===String(historyDetailId));
 const details=chosen?`<section class="panel" id="history-detail"><div class="flex between"><h2>レイド #${escapeHTML(chosen.id)} 詳細</h2>${b('一覧に戻る','historyClose','small')}</div><p><strong>${chosen.win?'✓ 生還':'× 敗北'}</strong> ／ ${escapeHTML(MAP[chosen.map]?.n||chosen.map||'不明な地区')} ／ ${escapeHTML(chosen.raidType==='boss'?'ボス討伐レイド':'通常レイド')}</p><p>日時：${Number.isFinite(Number(chosen.at))?new Date(chosen.at).toLocaleString('ja-JP'):'記録なし'} ／ 探索：${fmt(chosen.explore)}回 ／ 敵撃破：${fmt(chosen.kills)}体</p><p>獲得XP：${fmt(chosen.xp)} ／ 戦利品：${fmt(chosen.lootVal)}₽相当 ／ ボス撃破：${chosen.bossKilled?'あり':'なし'}</p><h3>回収装備</h3>${(chosen.gearLoot||[]).length?(chosen.gearLoot||[]).map(x=>`<p>${gearLabel(x)}</p>`).join(''):'<p class="muted">記録なし</p>'}<h3>回収アイテム</h3>${Object.entries(chosen.loot||{}).length?Object.entries(chosen.loot||{}).map(([id,n])=>`<p>${escapeHTML(L[id]?.n||id)} ×${fmt(n)}</p>`).join(''):'<p class="muted">記録なし</p>'}<h3>戦闘・探索ログ</h3><div class="log">${(Array.isArray(chosen.log)?chosen.log:[]).map(tokCombatLogHTML).join('')||'<p class="muted">ログなし</p>'}</div>${b('一覧に戻る','historyClose','small')}</section>`:'';
 return `<section class="panel"><h2>レイド履歴（直近30件）</h2><div class="raid-pane">${b('現在のレイド','raidCurrent','small')}${b('過去の履歴','raidHistory','small')}</div><div class="toolbar"><select data-ui="historyFilter">${[['all','すべて'],['win','生還'],['loss','戦死・失敗'],['boss','ボス戦']].map(([k,n])=>`<option value="${k}" ${historyFilter===k?'selected':''}>${n}</option>`).join('')}</select></div>${list.map(h=>`<div class="item"><b>${h.win?'✓ 生還':'× 敗北'} · #${escapeHTML(h.id)} · ${escapeHTML(MAP[h.map]?.n||h.map||'不明')}</b><p class="muted">${Number.isFinite(Number(h.at))?new Date(h.at).toLocaleString('ja-JP'):'日時不明'} / +${fmt(h.xp)} XP</p>${b('詳細を見る','historyId:'+h.id,'small')}</div>`).join('')||'<p>該当する履歴はありません</p>'}<p>累計出撃 ${fmt(g.stats.raids)} / 生還 ${fmt(g.stats.wins)} / 戦死 ${fmt(g.stats.losses)}</p></section>${details}`;
}
function settingsView(){return `<section class="panel"><h2>セーブデータ</h2><p>PWAはオフラインで動作します。localStorage・IndexedDB・対応端末ではOPFSに保存します。端末の保存領域は永続性を保証できません。</p><p class="warn">定期的に外部バックアップを保存してください。</p><div class="btns">${b('バックアップを保存','export','primary')}${b('共有して保存','shareBackup')}${b('テキストで保存','textBackup')}${b('バックアップを読み込む','import')}</div><div id="backup-status" role="status" aria-live="polite" class="notice" style="display:none"></div><div id="restore-review" class="panel" style="display:none;border:2px solid #a9bd87"><h3>読み込んだバックアップの確認</h3><pre id="restore-review-info" style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit"></pre><p class="warn">現在のデータは上書きされます。バックアップ内容を確認してから実行してください。</p><div class="btns"><button class="primary" data-action="applyRestore">このバックアップを復元</button><button data-action="cancelRestore">キャンセル</button></div></div><div id="backup-text-panel" class="panel" style="display:none"><h3>バックアップデータ（JSON）</h3><p>下の内容をすべてコピーし、メモなどに保存してください。復元時はこの欄に貼り付けて「貼り付けたデータを復元」を押します。</p><textarea id="backup-text" style="min-height:180px" spellcheck="false"></textarea><div class="btns"><button data-action="copyBackup">全文コピー</button><button data-action="restoreTextBackup">貼り付けたデータを復元</button><button data-action="closeBackupText">閉じる</button></div></div><p class="muted">v3.6.111 / ${escapeHTML(tokSaveDiagnostics())}</p><p class="muted">保存診断：${escapeHTML(tokPersistentWarning||'エラー報告なし')}</p><p class="muted">保存形式 v${g.version} / リビジョン ${g.revision}</p></section><section class="panel"><h2>操作</h2>${b('セーブを手動実行','manualsave')}${b('最初からやり直す','reset','danger')}<p class="muted">やり直しは確認後、現在のセーブを消去します。必要なら先にバックアップしてください。</p></section><section class="panel"><h2>ルール概要</h2><p>探索30秒/回、最大30回。脱出距離は探索0〜5回→1、6〜12回→2、13〜21回→3、22〜30回→4イベント。</p><p>先制攻撃・敵の強襲攻撃は交戦開始時に一度だけ判定。近接武器は弾薬不要、距離が遠いと接近失敗します。戦闘は最大6ラウンド→離脱最大3回→最終戦闘最大6ラウンド。敗北すると出撃装備と戦利品を失いますが、経験値は残ります。</p><p>工業地区で生存完了した探索イベントが累計30回になると、次回以降の工業レイドの最初の探索イベント完了時に特殊キーを発見します。</p><p>破産ゲームオーバーなし。資金が9,040₽未満のとき、拠点で10₽/分支給（上限9,040₽）。</p></section>`}

/* Market v1: save-compatible extension; no storage key/version changes. */
if(!GC.helmet)GC.helmet={...GC.armor};
const MARKET_CATS={accessory:'アクセサリー',attachment:'アタッチメント',ar:'アサルトライフル',smg:'サブマシンガン',sg:'ショットガン',sr:'スナイパーライフル',other:'その他の武器',armor:'アーマー',helmet:'ヘルメット',bag:'バッグ'};
function marketCategory(x){if(x.type==='accessory'||x.type==='attachment'||x.type==='armor'||x.type==='helmet'||x.type==='bag')return x.type;const id=x.base;const w=W[id]||{};const name=(w.n||'').toLowerCase();if(/ショットガン|saiga|mp133|mp153|sweeper/i.test(id+' '+name))return 'sg';if(/スナイパー|狙撃|mosin|svd|hawkeye|queenbee/i.test(id+' '+name))return 'sr';if(/smg|短機関|mp5|pp19|pps43|kedr|p90|phantom|gamma/i.test(id+' '+name))return 'smg';if(/ak|m4a1|aug|adar|rpk|scar|sks|vpo|alpha|zero/i.test(id+' '+name))return 'ar';return 'other'}
function marketMultiplier(){const q=Math.random();let lo,hi,label;if(q<.10){lo=.50;hi=.70;label='暴落'}else if(q<.35){lo=.71;hi=.90;label='安値'}else if(q<.70){lo=.91;hi=1.10;label='通常'}else if(q<.95){lo=1.11;hi=1.40;label='高値'}else{lo=1.41;hi=1.80;label='高騰'}return {rate:Math.round((lo+Math.random()*(hi-lo))*100)/100,label}}
function marketNewStock(){
 // A fixed category quota prevents the large armor variant pool from crowding out weapons.
 const pools={weapon:[],armor:[],helmet:[],bag:[],attachment:[],accessory:[]};
 for(const [type,defs] of [['weapon',W],['armor',A],['helmet',H],['bag',B]])for(const [base,def] of Object.entries(defs)){
  if(!def||!Number.isFinite(def.price)||def.price<=0||base==='none'||isBossOnlyGear(BANKTYPE[type],base)||def.fixed||(type==='weapon'&&def.melee))continue;
  pools[type].push({type,base});
 }
 pools.accessory=Object.keys(TOK_ACCESSORIES).filter(x=>x!=='cult_seal'&&!isBossOnlyGear('accessories',x)).map(base=>({type:'accessory',base}));pools.attachment=Object.keys(ATTACH).map(base=>({type:'attachment',base}));const stock=[];const seen=new Set();
 const add=(type,n)=>{
  const choices=pools[type].filter(c=>!seen.has(c.type+':'+c.base));
  for(let i=0;i<n&&choices.length;i++){
   const index=Math.floor(Math.random()*choices.length),candidate=choices.splice(index,1)[0];
   seen.add(candidate.type+':'+candidate.base);
   const r=Math.random(),rarity=r<.40?'common':r<.90?'rare':r<.98?'epic':'legendary';
   const temp={seed:Math.floor(Math.random()*4294967295)},previousGearId=g.nextGearId;
   const gear=candidate.type==='attachment'?attMake(temp,candidate.base,attRollRarity(null,true)):makeGear(temp,candidate.type,candidate.base,rarity);if(gear.type==='weapon')attAutoWeapon(temp,gear);g.nextGearId=previousGearId;
   gear.dur=['armor','helmet'].includes(gear.type)?GEARTYPE[gear.type][gear.base].max+gearVal(gear,'durability'):gear.type==='weapon'?100:null;
   const mult={common:1,rare:1.5,epic:2.5,legendary:10}[gear.rarity];
   const price=Math.max(1,Math.round((gear.type==='attachment'?attPrice(gear):GEARTYPE[gear.type][gear.base].price*mult)*(.9+Math.random()*.2)));
   stock.push({gear,price,sold:false});
  }
 };
 add('weapon',3);add('attachment',2);add('armor',2);add('helmet',2);add('bag',2);add('accessory',1);
 // Fallback for games with smaller custom item pools.
 for(const type of ['weapon','attachment','armor','helmet','bag','accessory'])if(stock.length<12)add(type,12-stock.length);
 for(let i=stock.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[stock[i],stock[j]]=[stock[j],stock[i]]}
 return stock;
}
function tokRebalanceExistingMarket(){if(!g?.market||!Array.isArray(g.market.stock)||g.market.attachmentQuotaVersion===2)return;const old=g.market.stock,stock=marketNewStock();const sold=old.filter(x=>x?.sold);for(let i=0;i<Math.min(sold.length,stock.length);i++)stock[i]={...sold[i],sold:true};g.market.stock=stock;g.market.attachmentQuotaVersion=2;if(!g.market.rates)g.market.rates={};if(!g.market.rates.attachment)g.market.rates.attachment=marketMultiplier();if(!g.market.rates.accessory)g.market.rates.accessory=marketMultiplier();}
function ensureMarket(){tokRebalanceExistingMarket();if(!g.market||!Array.isArray(g.market.stock)||!g.market.rates){g.market={progress:0,cycle:1,stock:marketNewStock(),rates:Object.fromEntries(Object.keys(MARKET_CATS).map(k=>[k,marketMultiplier()]))}}else{if(!g.market.rates.attachment)g.market.rates.attachment=marketMultiplier();if(!g.market.rates.accessory)g.market.rates.accessory=marketMultiplier();for(const item of g.market.stock){if(item?.gear&&isBossOnlyGear(BANKTYPE[item.gear.type],item.gear.base))item.sold=true}}return g.market}
function marketSurvival(){const m=ensureMarket();m.progress++;if(m.progress>=10){m.progress=0;m.cycle++;m.stock=marketNewStock();m.rates=Object.fromEntries(Object.keys(MARKET_CATS).map(k=>[k,marketMultiplier()]));g.notice='マーケットが更新されました。商品と買取相場をご確認ください。'}}
function marketSellPrice(x){if(x?.emergencyIssued)return 0;const m=ensureMarket(),r=m.rates[marketCategory(x)]?.rate||1;let value=Math.max(1,Math.floor(gearPrice(x)*r));if(Number.isFinite(x.marketPurchasePrice))value=Math.min(value,x.marketPurchasePrice);return value}
function marketBuy(index){if(g.status!=='base')return;const m=ensureMarket(),item=m.stock[index];if(!item||item.sold||!item.gear||isBossOnlyGear(BANKTYPE[item.gear.type],item.gear.base))return;if(g.money<item.price){alert('資金が不足しています');return}const gear=JSON.parse(JSON.stringify(item.gear));gear.id='gear-'+g.nextGearId++;for(const a of attInstalled(gear))a.id='gear-'+g.nextGearId++;gear.marketPurchasePrice=item.price;gear.favorite=false;gear.newItem=true;gear.acquiredAt=Date.now();g.money-=item.price;g.gear.push(gear);item.sold=true;save();render()}
function marketSell(id){
 if(g.status!=='base'){alert('拠点でのみ売却できます。');return}
 const x=findGear(id);
 if(!x){alert('売却する装備が見つかりません。');return}
 if(Object.values(g.eqIds).includes(id)){alert('装備中のアイテムは外してから売却してください。');return}
 if(g.raid?.equipment&&Object.values(g.raid.equipment).some(y=>y?.id===id)){alert('レイド中の装備は売却できません。');return}
 const price=marketSellPrice(x);
 if(x.favorite&&!confirm('★お気に入り装備を売却しますか？'))return;
 if(x.favorite&&!confirm('お気に入り装備を永久に失います。最終確認です。'))return;
 if(isBossGear(x)&&!confirm('ボス固有装備を売却しますか？'))return;
 if(!confirm(`${gearName(x)}を${fmt(price)}₽でマーケットへ売却しますか？`))return;
 if(x.type==='weapon')g.gear.push(...attInstalled(x));g.gear=g.gear.filter(y=>y.id!==id);g.money+=price;g.stats.earned+=price;
 selectedBulk.delete(id);g.notice=`${gearName(x)}を${fmt(price)}₽で売却しました。`;
 save();render();
}

// Long exploration: durable progress, independent vault, and fixed-time 15-minute sorties.
let longBusy=false;
const LONG_DURATIONS=[1,2,3,6,12,24],LONG_SEGMENT=900000;
function tokMergeLongVault(){
 if(!g?.longVault)return;
 const v=g.longVault,c=storageInit().container;
 for(const key of ['loot','ammo','supplies'])for(const [id,n] of Object.entries(v[key]||{}))if(n>0)c[key][id]=(c[key][id]||0)+n;
 if(Array.isArray(v.gear))c.gear.push(...v.gear);
 delete g.longVault;
}
function longState(){tokMergeLongVault();return storageInit().container}
function longCount(){tokMergeLongVault();return 0}
function longStart(hours){advance();tokMergeLongVault();if(!LONG_DURATIONS.includes(hours)||g.status!=='base'||g.longRun?.active)return;if(containerHasItems()){alert('戦利品を空にしてから出撃してください');return}if(g.reportPending){alert('先にレイド報告を確認してください');return}if(!canEquip()){alert('武器・弾薬・バッグ・HPなど通常の出撃条件を確認してください');return}if(playerLoadoutSlots()>bankCarrySlots()){alert('バッグ容量を超えています');return}if(!Object.keys(MAP).some(id=>g.unlocked[id])){alert('解放済み地区がありません');return}const need=hours;if(activeCount(g.bank.loot,'can')<need||activeCount(g.bank.loot,'water')<need){alert('食料と飲料水がそれぞれ'+need+'個必要です');return}g.bank.loot.can-=need;g.bank.loot.water-=need;g.longRun={originalMap:g.settings.map,healCount:0,healMinutes:0,healCost:0,healMode:longHealMode,active:true,hours,map:null,startedAt:Date.now(),completed:0,total:hours*4,success:0,failed:0,initialAmmo:{},history:[],stopped:false};g.settings.raidType='normal';longBusy=true;try{longLaunch(g.longRun.startedAt)}finally{longBusy=false}if(!g.raid){g.bank.loot.can+=need;g.bank.loot.water+=need;g.longRun=null;g.status='base';alert('長期探索の出撃に失敗したため、食料と飲料水を返却しました。装備・携行品・出撃条件を確認してください。')}tab='long';save();render()}
function longRandomMap(){
 const choices=Object.keys(MAP).filter(id=>g.unlocked[id]&&MAP[id]&&!ROAMING_AREAS[id]);
 if(!choices.length)return null;
 const weight=id=>{const name=MAP[id]?.n||'';const ranks={'郊外商業地区':1,'学校':1,'映画館':1,'森林公園':1,'工業倉庫地区':2,'地下鉄廃駅':2,'寺院':2,'封鎖ショッピングモール':2,'ショッピングモール':2,'動物園':2,'封鎖病院':3,'病院':3,'遊園地':3,'オフィス街':3,'スタジアム':3,'歓楽街':4,'高層通信施設':4,'通信施設':4,'発電所':4,'警察本部跡地':5,'国会議事堂':5,'封鎖国際空港':5,'空港':5,'港湾コンテナ地区':5,'地下研究施設':5};const n=ranks[name]||Math.max(1,Math.min(5,Math.round((MAP[id]?.enc||.2)*8)));return [0,10,7,5,3,1][n]};
 const sum=choices.reduce((n,id)=>n+weight(id),0);let pick=Math.random()*sum;
 for(const id of choices){pick-=weight(id);if(pick<0)return id}return choices[choices.length-1];
}
function longRecordDetails(run,r,win,loot=0){
 const entry={win,loot,at:r.startedAt+LONG_SEGMENT,map:r.map,hp:r.hp,maxHp:r.maxHp||baseMaxHp(),reason:win?'生還':'戦死',log:Array.isArray(r.log)?r.log.slice():[]};
 run.history.push(entry);run.history=run.history.slice(-100);
}
function longLaunch(at){const run=g.longRun;if(!run?.active)return;if(!canEquip()){run.active=false;run.reason='装備または弾薬不足';return}if(playerLoadoutSlots()>bankCarrySlots()){run.active=false;run.reason='携行容量不足';return}const reserved=g.investigation?.pending;const reservedMaps=reserved?.kind==='roaming'?(ROAMING_AREAS[reserved.boss]||[]).filter(id=>g.unlocked[id]):[];const selected=reservedMaps.length?reservedMaps[Math.floor(Math.random()*reservedMaps.length)]:longRandomMap();if(!selected){run.active=false;run.reason='探索可能な地区なし';return}run.map=selected;g.settings.map=selected;g.settings.raidType='normal';startRaid();if(!g.raid){run.active=false;run.reason='再出撃不可';return}g.raid.longMode=true;g.raid.startedAt=at;g.raid.settings.exploreTarget=30;g.raid.settings.raidType='normal';g.raid.settings.bossPolicy='avoid';g.raid.longOriginalAmmo=structuredCloneSafe(g.raid.ammoByCaliber||{});g.raid.longOriginalSupplies=structuredCloneSafe(g.raid.supplies||{});if(!Object.keys(run.initialAmmo).length)run.initialAmmo=structuredCloneSafe(g.raid.ammoByCaliber||{});run.snapshot={loot:structuredCloneSafe(g.bank.loot),ammo:structuredCloneSafe(g.bank.ammo),supplies:structuredCloneSafe(g.bank.supplies),gearIds:g.gear.map(x=>x.id)};run.segmentDurability={};for(const slot of ['weapon','secondary','melee','armor','helmet']){const item=equippedGear(slot)||findGear(g.eqIds[slot]);if(item)run.segmentDurability[slot]={id:item.id,dur:Number(item.dur??repairMax(item))};}}
// Expected retained item counts relative to a single 15-minute raid.
const LONG_REWARD_TARGETS={1:1.2,2:1.5,3:1.75,6:2.2,12:2.8,24:3.2};
function longRewardKeepRate(run){
 const target=LONG_REWARD_TARGETS[run.hours]??2.8;
 return Math.min(1,target/Math.max(1,run.total));
}
function longRewardSample(n,rate){
 const whole=Math.max(0,Math.floor(Number(n)||0));let kept=0;
 for(let i=0;i<whole;i++)if(Math.random()<rate)kept++;
 return kept;
}
const LONG_HEAL_MINUTES={bleed:5,poison:10,arm:15,leg:20,burn:10};
const LONG_TREAT_COST={bleed:750,poison:1500,arm:1100,leg:1100,burn:800};
let longHealMode='economy';
function longHpWaitMinutes(){const max=Math.max(1,baseMaxHp());return Math.ceil(10*60000*Math.max(0,max-g.hp)/max)/60000}
function longTreatmentPrice(injuries){const missing=Math.max(0,baseMaxHp()-g.hp);return Math.ceil((missing*tokHpRate()+injuries.reduce((sum,k)=>sum+tok111TreatCost(k),0))*1.25)}

function longInjuries(){return Object.keys(LONG_HEAL_MINUTES).filter(k=>k==='bleed'?!!g.bleed:k==='poison'?g.poisonTurns>0:k==='arm'?!!g.armBroken:k==='leg'?!!g.legBroken:g.burnTurns>0)}
function longHealBegin(run,at){
 const injuries=longInjuries();const missing=Math.max(0,baseMaxHp()-g.hp);
 if(!injuries.length&&!missing)return;
 const price=longTreatmentPrice(injuries);
 if(run.healMode==='efficient'&&g.money>=price){
   g.money-=price;g.hp=baseMaxHp();longClearInjuries(injuries);
   run.healCount=(run.healCount||0)+1;run.healCost=(run.healCost||0)+price;
   run.history.push({healing:true,minutes:0,injuries,at,paid:true,cost:price,hpRecovered:missing});
   return;
 }
 const minutes=Math.max(Math.ceil(longHpWaitMinutes()),...injuries.map(k=>LONG_HEAL_MINUTES[k]),0);
 if(!minutes)return;
 run.healing={startedAt:at,until:at+minutes*60000,injuries,hpTarget:baseMaxHp()};
 run.healCount=(run.healCount||0)+1;run.healMinutes=(run.healMinutes||0)+minutes;
 run.history.push({healing:true,minutes,injuries,at,paid:false,hpRecovered:missing});
}
function longClearInjuries(injuries){
 for(const k of injuries){if(k==='bleed')g.bleed=false;else if(k==='poison')g.poisonTurns=0;else if(k==='arm')g.armBroken=false;else if(k==='leg')g.legBroken=false;else if(k==='burn')g.burnTurns=0}
}
function longHealFinish(run){
 const h=run.healing;if(!h)return;
 longClearInjuries(h.injuries||[]);
 g.hp=Math.min(baseMaxHp(),h.hpTarget||baseMaxHp());
 run.healing=null;
}
function longCollect(r,win){
 const run=g.longRun;if(!run)return;
 run.completed++;run[win?'success':'failed']++;
 if(!win){longRecordDetails(run,r,false,0);run.active=false;run.reason='戦闘中に死亡';return}
 const v=longState(),snap=run.snapshot,rate=longRewardKeepRate(run);
 // The battle log describes finds before the long-expedition reward retention roll.
 // Record the actual retained items separately so the report matches the loot container.
 const retained={loot:{},ammo:{},supplies:{},gear:[]};
 let keptValue=0;
 for(const key of ['loot','ammo','supplies']){
  for(const [id,num] of Object.entries(g.bank[key])){
   const carried=key==='ammo'?(r.longOriginalAmmo?.[id]||0):key==='supplies'?(r.longOriginalSupplies?.[id]||0):0;
   const diff=Math.max(0,num-(snap[key][id]||0)-carried-(key==='loot'&&id===r.secretKeyCarry&&!r.secretKeyUsed?1:0));
   if(diff>0){
    const kept=longRewardSample(diff,rate);
    if(kept>0){v[key][id]=(v[key][id]||0)+kept;retained[key][id]=(retained[key][id]||0)+kept;keptValue+=kept*Number((key==='loot'?L[id]?.price:key==='ammo'?AM[id]?.price:ITEMS[id]?.price)||0)}
    // All rewards, including the rejected portion, leave the temporary raid bank.
    g.bank[key][id]-=diff;
   }
  }
 }
 const newGear=g.gear.filter(x=>!snap.gearIds.includes(x.id));
 for(const x of newGear)if(Math.random()<rate){v.gear.push(x);retained.gear.push(gearName(x));keptValue+=Number(gearPrice(x)||0)}
 g.gear=g.gear.filter(x=>snap.gearIds.includes(x.id));
 longRecordDetails(run,r,true,Math.floor(keptValue));
 const report=run.history[run.history.length-1];
 report.retained=retained;
 const itemLines=[];
 for(const [key,items] of Object.entries(retained)){
  if(key==='gear'){for(const name of items)itemLines.push('装備：'+name);continue}
  for(const [id,count] of Object.entries(items)){
   const name=key==='loot'?(L[id]?.n||id):key==='ammo'?(AM[id]?.n||id):(ITEMS[id]?.n||id);
   itemLines.push(name+' ×'+count);
  }
 }
 report.log.push('【確定獲得品】'+(itemLines.length?'以下のアイテムを戦利品に保管':'なし'));
 for(const line of itemLines)report.log.push('【確定】'+line);
 report.log.push('※探索途中の「発見」「獲得」ログは抽選前の記録です。実際に持ち帰った品は上記の【確定獲得品】を参照してください。');
 g.recoveryMs=0;longHealBegin(run,r.startedAt+LONG_SEGMENT);
 // Recover up to 20% of original maximum durability, but retain at least 2 points of each segment's wear.
 for(const slot of ['weapon','secondary','melee','armor','helmet']){
  const item=equippedGear(slot)||findGear(g.eqIds[slot]);
  const baseline=run.segmentDurability?.[slot];
  if(!item||!baseline||item.id!==baseline.id)continue;
  const max=repairMax(item),current=Math.max(0,Number(item.dur??max));
  const wear=Math.max(0,baseline.dur-current);
  const recovery=Math.min(Math.floor(max*.2),Math.max(0,wear-2));
  if(recovery>0)item.dur=Math.min(max,current+recovery);
 }
 run.segmentDurability=null;
 // Each long-expedition segment starts with the ammunition selected at expedition start.
 // Restore only the expedition's original carried ammunition; do not create warehouse stock.
 for(const [cal,initial] of Object.entries(run.initialAmmo)){
  g.bank.ammo[cal]=Math.max(0,Math.floor(Number(initial)||0));
 }
 if(run.completed>=run.total){
 if(!run.ultraRareRolled){
  run.ultraRareRolled=true;
  const ultra=tokUltraRarePick(TOK_LONG_ULTRARARE_RATE[run.hours]||.005);
  if(ultra){
   const v=longState();
   v.loot[ultra]=(v.loot[ultra]||0)+1;
   tokUltraRareRegister(ultra);
   run.ultraRareFound=ultra;
   run.history.push({at:Date.now(),rareCollection:ultra,loot: L[ultra].price});
  }
 }
 run.active=false;run.reason='探索完了';
}
}
function longAdvance(now=Date.now()){const run=g.longRun;if(!run?.active||longBusy)return;longBusy=true;try{let steps=0;while(run.active&&steps++<100){const end=run.startedAt+run.hours*3600000;
 if(run.healing&&run.healing.until>end&&now>=end){run.active=false;run.reason='探索時間終了（療養中）';break}
 if(run.healing){if(now<run.healing.until)break;const healedAt=run.healing.until;longHealFinish(run);run.nextAt=healedAt;}
 const startAt=run.nextAt??(run.startedAt+run.completed*LONG_SEGMENT);
 const due=startAt+LONG_SEGMENT;
 if(due>end){run.active=false;run.reason='探索時間終了';break}
 if(now<due)break;if(!g.raid){longLaunch(startAt);if(!run.active)break}const r=g.raid;let count=0;while(g.raid===r&&g.status==='raid'&&count++<38){if(count===31&&r.phase==='explore')startExtraction(r,'一時帰還');stepRaid();r.processed++}if(g.raid===r&&g.status==='raid')finishRaid(r.hp>0);if(!run.active)break;run.nextAt=due;if(!run.healing&&due<run.startedAt+run.hours*3600000)longLaunch(due)}if(!run.active){if(run.originalMap&&g.unlocked[run.originalMap])g.settings.map=run.originalMap;g.status='base';g.raid=null;g.baseAt=now;g.notice='長期探索終了：'+run.reason;run.reportSeen=false;tab='longReport'}else{g.notice='長期探索進行中';}save()}finally{longBusy=false}}
let longExitArmed=false;
function longEmergencyExit(){
 // Confirm before any time-consuming simulation; cancellation must remain responsive.
 if(!g.longRun?.active)return;
 longExitArmed=false;
 const run=g.longRun;
 // Never resolve the current unfinished segment on emergency exit.
 const r=g.raid;
 if(r?.longMode){
  for(const [cal,n] of Object.entries(r.longOriginalAmmo||{}))g.bank.ammo[cal]=activeCount(g.bank.ammo,cal)+n;
  for(const [id,n] of Object.entries(r.longOriginalSupplies||{}))g.bank.supplies[id]=activeCount(g.bank.supplies,id)+n;
  // Return the unused secret-room key brought into this unfinished segment.
  if(r.secretKeyCarry&&!r.secretKeyUsed)g.bank.loot[r.secretKeyCarry]=activeCount(g.bank.loot,r.secretKeyCarry)+1;
 }
 run.active=false;
 run.stopped=true;
 run.reason='緊急離脱';
 if(run.originalMap&&g.unlocked[run.originalMap])g.settings.map=run.originalMap;
 g.raid=null;
 g.status='base';
 g.baseAt=Date.now();
 g.notice='緊急離脱しました。確保済みの戦利品は共通の戦利品に移されます。';
 run.reportSeen=false;tab='longReport';save();render();
}
function longEmergencyRequest(){
 if(!g.longRun?.active)return;
 longExitArmed=true;tab='long';render();
}
function longEmergencyCancel(){longExitArmed=false;render()}
function longBuy(id,qty){if(!['can','water'].includes(id)||![1,12].includes(qty))return;transact(L[id].price*qty,()=>{g.bank.loot[id]=activeCount(g.bank.loot,id)+qty})}
function longMove(key,id,qty){const v=longState();if(g.status!=='base'||g.longRun?.active)return;if(key==='gear'){const index=v.gear.findIndex(x=>x.id===id);if(index<0)return;const x=v.gear[index];if(!storageAvailable('gear',x)){alert('倉庫容量が不足しています');return}v.gear.splice(index,1);x.newItem=true;g.gear.push(x)}else{if(!['loot','ammo','supplies'].includes(key))return;const n=Math.min(Math.max(0,Math.floor(qty)),v[key][id]||0);if(!n)return;if(!storageAvailable(key,id,n)){alert('倉庫容量が不足しています');return}v[key][id]-=n;g.bank[key][id]=(g.bank[key][id]||0)+n}save();render()}
function longSell(key,id,qty){const v=longState();if(g.status!=='base'||g.longRun?.active)return;let price=0,n=1;if(key==='gear'){const index=v.gear.findIndex(x=>x.id===id);if(index<0)return;const x=v.gear.splice(index,1)[0];price=gearPrice(x)}else{if(!['loot','ammo','supplies'].includes(key)||key==='loot'&&['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id))return;n=Math.min(Math.max(0,Math.floor(qty)),v[key][id]||0);if(!n)return;v[key][id]-=n;price=Math.floor((key==='loot'?L[id]?.price:key==='ammo'?AM[id]?.price*.5:ITEMS[id]?.price*.5)||0)*n}g.money+=price;g.stats.earned+=price;save();render()}
function longBulk(kind){if(kind==='move'){const v=longState();for(const x of [...v.gear]){if(storageAvailable('gear',x)){v.gear.splice(v.gear.indexOf(x),1);g.gear.push(x)}}for(const key of ['loot','ammo','supplies'])for(const [id,n] of Object.entries({...v[key]})){if(n<=0)continue;const allowed=key==='ammo'?Math.max(0,Math.min(n,(storageCap()-storageUsed())*100+Math.ceil((g.bank.ammo[id]||0)/100)*100-(g.bank.ammo[id]||0))):Math.min(n,Math.max(0,storageCap()-storageUsed()));if(allowed){v[key][id]-=allowed;g.bank[key][id]=(g.bank[key][id]||0)+allowed}}save();render();return}const v=longState();if(g.status!=='base'||g.longRun?.active)return;for(const key of ['loot','ammo','supplies'])for(const [id,n] of Object.entries({...v[key]}))if(n>0){if(kind==='move'||key==='loot'&&['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id)) {g.bank[key][id]=(g.bank[key][id]||0)+n;v[key][id]=0}else{const price=Math.floor((key==='loot'?L[id]?.price:key==='ammo'?AM[id]?.price*.5:ITEMS[id]?.price*.5)||0);g.money+=price*n;g.stats.earned+=price*n;v[key][id]=0}}for(const x of v.gear){if(kind==='move'){x.newItem=true;g.gear.push(x)}else{const price=gearPrice(x);g.money+=price;g.stats.earned+=price}}v.gear=[];save();render()}
function longReportView(){
 const r=g.longRun;
 if(!r||r.active)return `<section class="panel"><h2>長期探索報告</h2><p>終了した長期探索はありません。</p>${b('拠点へ戻る','tab:base','primary')}</section>`;
 const hist=Array.isArray(r.history)?r.history:[];
 const sum=hist.reduce((n,x)=>n+(Number(x.loot)||0),0);
 const safe=x=>escapeHTML(String(x??''));
 return `<div class="tok-raid-result"><section class="panel"><h2>長期探索 結果報告</h2><p><strong>${safe(r.reason||'探索終了')}</strong></p><div class="tok-result-row"><span>探索方式</span><b>解放済み地区からランダム</b></div><div class="tok-result-row"><span>予定時間</span><b>${Number(r.hours)||0}時間</b></div><div class="tok-result-row"><span>完了区間</span><b>${Number(r.completed)||0} / ${Number(r.total)||0}</b></div><div class="tok-result-row"><span>生還 / 失敗</span><b>${Number(r.success)||0} / ${Number(r.failed)||0}</b></div><div class="tok-result-row"><span>記録戦利品評価額</span><b>${fmt(sum)}₽相当</b></div><p class="muted">各区間を開くと、戦闘・状態異常・撤退・死亡理由などの詳細ログを確認できます。</p></section><section class="panel"><h3>探索経過・詳細ログ</h3>${hist.length?hist.map((h,i)=>`<details class="item" style="margin:8px 0"><summary style="cursor:pointer">第${i+1}区間 ${safe(MAP[h.map]?.n||h.map||(h.healing?'療養':'不明'))} ／ ${h.healing?'療養 '+h.minutes+'分':h.win?'生還':'失敗'} ／ ${fmt(Number(h.loot)||0)}₽</summary>${h.healing?`<p>治療対象：${safe((h.injuries||[]).join('・')||'HP回復')} ／ ${h.paid?'有料・即時（'+fmt(h.cost||0)+'₽）':'自然回復'}</p>`:`<p>終了HP：${safe(h.hp??'不明')} ／ ${safe(h.maxHp??'不明')}</p><p>結果：${safe(h.reason|| (h.win?'生還':'戦死'))}</p>${h.retained?`<div class="item"><strong>確定獲得アイテム（実際に戦利品へ保管）</strong>${(()=>{
 const rows=[];
 for(const [key,items] of Object.entries(h.retained)){
  if(key==='gear'){for(const name of items||[])rows.push('装備：'+name);continue}
  for(const [id,n] of Object.entries(items||{}))rows.push((key==='loot'?(L[id]?.n||id):key==='ammo'?(AM[id]?.n||id):(ITEMS[id]?.n||id))+' ×'+n);
 }
 return '<p>'+safe(rows.join(' ／ ')||'なし')+'</p>';
})()}</div>`:''}<div style="max-height:55vh;overflow:auto;white-space:pre-wrap;font-size:12px;line-height:1.6;padding:10px;background:#101820;border-radius:8px">${(h.log||[]).length?(h.log||[]).map((line,j)=>`${j+1}. ${safe(line)}`).join('\n'):'この区間の詳細ログは保存されていません（旧バージョンの記録）。'}</div>`}</details>`).join(''):'<p class="muted">完了した区間はありません。</p>'}</section><section class="panel tok-result-actions">${b('拠点へ戻る','longReportClose','primary')}${b('戦利品を確認','longReportLoot')}</section></div>`;
}
function formatLongDuration(ms){const seconds=Math.floor(Math.max(0,ms)/1000);return `${String(Math.floor(seconds/3600)).padStart(2,'0')}:${String(Math.floor(seconds%3600/60)).padStart(2,'0')}:${String(seconds%60).padStart(2,'0')}`}
function longView(){const v=longState(),run=g.longRun,active=!!run?.active,remaining=run?Math.max(0,run.startedAt+run.hours*3600000-Date.now()):0;return `<div class="hero"><strong>長期探索 / LONG EXPEDITION</strong><p>15分単位の探索と一時帰還を繰り返します。帰還時は設定した治療方式でHP・状態異常を回復。弾薬50％補給・装備耐久20％修復。戦利品は探索終了後に共通の戦利品へ。</p>${active?`${tokDistrictScene(run.map)?`<img class="raid-art" alt="${escapeHTML(MAP[run.map]?.n||'探索地区')} の背景" src="${tokDistrictScene(run.map)}">`:''}<strong>長期探索進行中</strong><p>現在地：${escapeHTML(MAP[run.map]?.n||'探索地区')} ／ 次回はランダム抽選 ／ ${run.hours}時間探索</p><p>経過 ${formatLongDuration(Date.now()-run.startedAt)} ／ 残り ${formatLongDuration(remaining)}</p><p>全体進行：${Math.min(100,Math.floor(Math.max(0,Date.now()-run.startedAt)/(run.hours*3600000)*100))}% ／ 完了区間 ${run.completed}/${run.total}</p><div class="progress"><div style="width:${Math.min(100,Math.max(0,(Date.now()-run.startedAt)/(run.hours*3600000)*100))}%"></div></div><p>現在の探索区間：${Math.min(run.total,run.completed+1)} / ${run.total}（15分ごとに処理）</p><p>成功 ${run.success}回・失敗 ${run.failed}回</p><p>${run.healing?`療養中（残り ${formatLongDuration(run.healing.until-Date.now())}）`:`療養 ${run.healCount||0}回・計${run.healMinutes||0}分・医療費${fmt(run.healCost||0)}₽`}</p><p class="muted">探索終了後、各区間の戦闘・負傷・撤退ログを開いて確認できます。</p>${b('経過を更新','refresh','primary')}<p class="warn">緊急離脱すると未完了区間の戦利品は失われます。確保済みの戦利品は保持され、食料・飲料水は返却されません。</p><div class="btns">${longExitArmed?`<p class="warn">本当に緊急離脱しますか？ 未完了区間の戦利品は失われ、食料・飲料水は返却されません。</p>${b('緊急離脱を確定する','longEmergencyConfirm','danger')}${b('キャンセル','longEmergencyCancel')}`:b('緊急離脱（長期探索を終了）','longEmergency','danger')}</div>`:run?`<p>前回結果：${run.reason} ／ 成功 ${run.success}回 ／ ${run.completed}/${run.total}区間</p>${b('長期探索の結果報告を見る','longReportOpen','primary')}`:''}</div><section class="panel"><h2>探索準備</h2><p>出撃地区：解放済み地区から毎回ランダムに選択</p><h3>帰還時の治療方式</h3><div class="btns">${b((longHealMode==='economy'?'✓ ':'')+'節約探索（無料・最大10分）','longHealMode:economy',longHealMode==='economy'?'primary':'')}${b((longHealMode==='efficient'?'✓ ':'')+'効率探索（病院料金×1.25・即時）','longHealMode:efficient',longHealMode==='efficient'?'primary':'')}</div><p class="muted">HPと状態異常の治療は並行して進行。効率探索で資金が足りない場合は無料の自然回復に切り替えます。治療時間は選択した探索時間に含まれます。</p><p>食料 ${activeCount(g.bank.loot,'can')}個 ／ 飲料水 ${activeCount(g.bank.loot,'water')}個</p><div class="btns">${LONG_DURATIONS.map(h=>b(h+'時間（食料・水 各'+h+'）','longStart:'+h,'',active||g.status!=='base'||longCount()>0||activeCount(g.bank.loot,'can')<h||activeCount(g.bank.loot,'water')<h||!canEquip()||!!g.reportPending)).join('')}</div></section><section class="panel"><h2>戦利品の受取</h2><p>通常レイド・長期探索の戦利品は共通の「戦利品」に保管されます。</p>${b('戦利品を確認','tab:stash','primary')}</section>`} // v3.5.31: offline daily barter, saved in game state, no server dependency.
const BARTER_MATS=['parts','precision_parts','steel_ingot','abrasive','armor_parts','resin','textile','reinforcement'];
const BARTER_REGIONS=TOK_REGIONAL_COLLECTION_IDS;
const BARTER_STAPLES=[
 {title:'武器部品',need:{tools:1,battery:1},give:{parts:1}},
 {title:'研磨材',need:{tools:2,battery:2},give:{abrasive:3}},
 {title:'樹脂素材',need:{battery:2},give:{resin:1}},
 {title:'繊維素材',need:{tools:1,battery:1},give:{textile:2}},
 {title:'防具パーツ',need:{battery:3},give:{armor_parts:1}},
 {title:'精密部品',need:{tools:2,battery:1},give:{precision_parts:1}},
 {title:'補強パーツ',need:{electronics:1},give:{reinforcement:1}},
 {title:'金属インゴット',need:{tools:2,battery:2},give:{steel_ingot:1}}
];
function barterDay(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function barterHash(str){let h=2166136261;for(let i=0;i<str.length;i++){h=Math.imul(h^str.charCodeAt(i),16777619)}return h>>>0}
function barterRandom(seed){let x=seed>>>0;return ()=>{x=(Math.imul(x,1664525)+1013904223)>>>0;return x/4294967296}}
function barterDailyStock(day){const random=barterRandom(barterHash(day+'|tokyov-barter-v1'));const pickOne=a=>a[Math.floor(random()*a.length)];const result=[];
 const pools={weapon:[],defense:[],bag:[],attachment:[],accessory:[]};
 for(const [type,defs] of [['weapon',W],['armor',A],['helmet',H],['bag',B]])for(const [base,def] of Object.entries(defs)){
  if(!def||!Number.isFinite(def.price)||def.price<=0||base==='none'||def.fixed||isBossOnlyGear(BANKTYPE[type],base))continue;
  if(type==='weapon'&&def.melee)continue;
  pools[type==='armor'||type==='helmet'?'defense':type].push({type,base});
 }
 for(const base of Object.keys(TOK_ACCESSORIES).filter(x=>x!=='cult_seal'&&!isBossOnlyGear('accessories',x)))pools.accessory.push({type:'accessory',base});for(const base of Object.keys(ATTACH))pools.attachment.push({type:'attachment',base});
 for(const key of ['weapon','defense','bag','attachment']){
  if(!pools[key].length)continue;
  const chosen=pickOne(pools[key]);const rarity=random()<.7?'rare':'epic';
  const mat=pickOne(BARTER_MATS);
  // use a real region-specific high-value item, plus one repair material.
  const regionId=pickOne(Object.keys(MAP).filter(id=>L['regional_'+id+'_high']));
  result.push({kind:'gear',type:chosen.type,base:chosen.base,rarity,need:{[TOK_REGIONAL_COLLECTION_IDS.find(key=>L[key].regionalMap===regionId)]:1,[mat]:rarity==='epic'?3:1}});
 }
 const bonus=random()<.5;
 if(bonus){const type=pickOne(['weapon','defense','bag','attachment','accessory']);const c=pickOne(pools[type]);if(c){const regionId=pickOne(Object.keys(MAP).filter(id=>L['regional_'+id+'_high']));result.push({kind:'gear',type:c.type,base:c.base,rarity:random()<.7?'rare':'epic',need:{[TOK_REGIONAL_COLLECTION_IDS.find(key=>L[key].regionalMap===regionId)]:1,[pickOne(BARTER_MATS)]:2}})}}
 else {const mat=pickOne(BARTER_MATS);const regionId=pickOne(Object.keys(MAP).filter(id=>TOK_REGIONAL_COLLECTION_IDS.some(key=>L[key].regionalMap===id)));result.push({kind:'loot',title:'修理素材セット',give:{[mat]:3},need:{[TOK_REGIONAL_COLLECTION_IDS.find(key=>L[key].regionalMap===regionId)]:1}})}
 for(const entry of result){if(entry.kind==='gear'&&entry.type==='accessory'){const count=entry.rarity==='epic'?3:2;entry.affixes=Array.from({length:count},()=>({type:TOK_ACCESSORY_KEYS[Math.floor(random()*8)],value:3}));}}
 return result;
}
function ensureBarter(){const day=barterDay();if(!g.barter||g.barter.day!==day||!Array.isArray(g.barter.stock)){g.barter={day,stock:barterDailyStock(day),used:{}};save()}return g.barter}
function barterCount(id){return activeCount(g.bank.loot,id)}
function barterEnough(need){return Object.entries(need).every(([id,n])=>barterCount(id)>=n)}
function barterNeedText(need){return Object.entries(need).map(([id,n])=>`${escapeHTML(L[id]?.n||id)} ×${n}（所持${barterCount(id)}）`).join(' ／ ')}
function barterRewardText(x){if(x.kind!=='gear')return Object.entries(x.give).map(([id,n])=>`${L[id].n} ×${n}`).join('、');const def=GEARTYPE[x.type]?.[x.base]||ATTACH[x.base];return `${RN[x.rarity]} ${def?.n||x.base}${x.type==='accessory'&&x.affixes?' ／ '+x.affixes.map(a=>TOK_ACCESSORY_LABELS[a.type]+' +3').join('・'):''}`}
function barterExecute(group,index){if(g.status!=='base'||g.longRun?.active){alert('拠点でのみ交換できます。');return}const day=ensureBarter();const entry=group==='daily'?day.stock[index]:BARTER_STAPLES[index];if(!entry)return;if(group==='daily'&&day.used[index])return;if(!barterEnough(entry.need)){alert('必要な換金品・素材が不足しています。');return}
 if(!confirm(`${barterRewardText(entry)}と交換しますか？\n必要品：${Object.entries(entry.need).map(([id,n])=>L[id].n+'×'+n).join('、')}`))return;
 for(const [id,n] of Object.entries(entry.need))g.bank.loot[id]-=n;
 if(entry.kind==='gear'){
  const r={seed:Math.floor(Math.random()*4294967295)};
  const item=entry.type==='attachment'?attMake(r,entry.base,entry.rarity):makeGear(r,entry.type,entry.base,entry.rarity);if(entry.type==='accessory'&&entry.affixes)item.affixes=structuredCloneSafe(entry.affixes);
  item.newItem=true;item.acquiredAt=Date.now();g.gear.push(item);
 }else for(const [id,n] of Object.entries(entry.give))g.bank.loot[id]=(g.bank.loot[id]||0)+n;
 if(group==='daily')day.used[index]=true;
 g.notice=`物々交換：${barterRewardText(entry)}を入手しました。`;save();render();
}
let tokMarketSubtab="normal";
function barterView(){const day=ensureBarter();const allowed=g.status==='base'&&!g.longRun?.active;
 const draw=(x,i,group)=>{const used=group==='daily'&&day.used[i];const disabled=!allowed||used||!barterEnough(x.need);return `<div class="item"><div class="flex between"><b>${group==='daily'?`${i+1}枠目　`:''}${x.kind==='gear'?`<span class="tok-barter-rarity-label tok-barter-${x.rarity}">${RN[x.rarity]}</span> <span>${escapeHTML((GEARTYPE[x.type]?.[x.base]||ATTACH[x.base])?.n||x.base)}</span>`:`<span class="v3-rarity-badge common">素材</span> ${escapeHTML(barterRewardText(x))}`}</b><span class="pill">${used?'交換済み':group==='daily'?'本日1回':'常設'}</span></div><p class="muted">必要：${barterNeedText(x.need)}</p><button data-action="barter:${group}:${i}" ${disabled?'disabled':''}>${used?'交換済み':'交換する'}</button></div>`};
 return `<section class="panel"><h2>物々交換｜常設</h2><p class="muted">必要品は倉庫から消費。交換は回数制限なし。素材調達用の基本レシピです。</p>${BARTER_STAPLES.map((x,i)=>draw({...x,kind:'loot'},i,'staple')).join('')}</section><section class="panel"><h2>物々交換｜日替わり5枠</h2><p class="muted">端末の現地日付で毎日0時更新。同じ日付ならラインナップ固定。各商品1日1回。装備性能は交換時に抽選されます。</p><p>更新日：${day.day}</p>${day.stock.map((x,i)=>draw(x,i,'daily')).join('')}</section>`
}

function marketView(){const provisions=`<section class="panel"><h2>常設販売：食料・飲料水</h2><p>長期探索で消費します。12個まとめ買いも可能です。</p>${['can','water'].map(id=>`<div class="item"><b>${L[id].n}</b>　${fmt(L[id].price)}₽/個　所持${activeCount(g.bank.loot,id)}個<div class="btns">${b('1個購入','longBuy:'+id+':1','',g.status!=='base'||!!g.longRun?.active||g.money<L[id].price)}${b('12個購入','longBuy:'+id+':12','',g.status!=='base'||!!g.longRun?.active||g.money<L[id].price*12)}</div></div>`).join('')}</section>`;const m=ensureMarket();const allowed=g.status==='base';return `<div class="tok-market-switch" role="group" aria-label="マーケットの表示切替"><button type="button" class="${tokMarketSubtab==='normal'?'selected':''}" data-action="marketSubtab:normal" aria-pressed="${tokMarketSubtab==='normal'}">通常マーケット</button><button type="button" class="${tokMarketSubtab==='barter'?'selected':''}" data-action="marketSubtab:barter" aria-pressed="${tokMarketSubtab==='barter'}">物々交換</button></div>${tokMarketSubtab==='barter'?barterView():`${provisions}<div class="notice"><b>マーケット 第${m.cycle}期</b>　生還 ${m.progress}/10　${'■'.repeat(m.progress)}${'□'.repeat(10-m.progress)}<br>10レイド生還で全商品と相場が更新。購入した商品は次回更新まで売り切れです。</div><div class="grid"><section class="panel"><h2>出品商品（12件・武器3／アタッチメント2／アーマー2／ヘルメット2／バッグ2／アクセサリー1）</h2>${m.stock.map((item,i)=>{const x=item.gear;if(isBossOnlyGear(BANKTYPE[x.type],x.base))return '';return `<div class="item"><div class="flex between"><b>${gearLabel(x)}</b><span class="pill">${item.sold?'売り切れ':fmt(item.price)+'₽'}</span></div><p class="muted">${escapeHTML(MARKET_CATS[marketCategory(x)])} ／ ${affixText(x)||'追加能力なし'}</p><div class="btns"><button data-action="marketBuy:${i}" ${!allowed||item.sold||g.money<item.price?'disabled':''}>${item.sold?'売り切れ':'購入'}</button></div></div>`}).join('')}</section><section class="panel"><h2>現在の買取相場</h2><p class="muted">基準額は通常の装備売却価格です。高値と安値が10生還ごとに変動します。</p>${Object.entries(MARKET_CATS).map(([k,name])=>`<div class="item">${name}：<b>${m.rates[k].label}（${Math.round(m.rates[k].rate*100)}%）</b></div>`).join('')}</section><section class="panel"><h2>倉庫から売却</h2><p class="muted">装備中の品は売却できません。マーケット購入品は購入額を超えて転売できません。</p>${g.gear.filter(x=>!Object.values(g.eqIds).includes(x.id)).map(x=>{const normal=gearPrice(x),current=marketSellPrice(x);return `<div class="item"><b>${gearLabel(x)} ${x.favorite?'★':''}</b><p>通常 ${fmt(normal)}₽ → <b>市場 ${fmt(current)}₽</b>（${current>=normal?'+':''}${fmt(current-normal)}₽）</p><button data-action="marketSell:${encodeURIComponent(x.id)}" ${!allowed?'disabled':''}>市場で売却</button></div>`}).join('')||'<p>売却可能な装備がありません。</p>'}</section></div>`}` }

const v3OriginalBaseView=baseView;
baseView=function(){
 const raids=Number(g.stats?.raids)||0,wins=Number(g.stats?.wins)||0;
 return `${tok111EmergencyPlan()?`<section class="panel"><h2>緊急支給装備</h2><p>資金6,000₽未満で再出撃用の装備が不足している場合、不足分を無料支給（支給装備の売却価値なし）。</p>${b('緊急支給を受ける','tok111Emergency','primary')}</section>`:''}<div class="base-hero"><div class="base-hero-title"><strong>ESCAPE FROM TOKYOV</strong><small>${escapeHTML(g.notice||'隠れ家で待機中')}</small></div></div>
 <section class="panel"><h2>PMC 状況</h2><div class="base-quick"><div class="stat"><span>LEVEL</span><b>${g.level}</b><span>${fmt(g.xp)} XP</span></div><div class="stat"><span>HP</span><b>${g.hp}/${baseMaxHp()}</b></div><div class="stat"><span>所持金</span><b>${fmt(g.money)}₽</b></div><div class="stat"><span>出撃数</span><b>${raids}</b></div><div class="stat"><span>生還数</span><b>${wins}</b></div><div class="stat"><span>生還率</span><b>${raids?Math.round(wins/raids*100):0}%</b></div></div></section>

 ${(()=>{const holder=document.createElement("div");holder.innerHTML=v3OriginalBaseView();const setup=holder.querySelector(".raid-setup");return setup?setup.outerHTML:"<section class=\"panel\">出撃設定を読み込めませんでした。</section>";})()}
 <section class="panel"><h2>長期探索</h2>${longView()}</section><div class="base-bottom-spacer"></div>`;
};

const V3_FACILITY_ART={weaponShop:"data:image/jpeg;base64,",equipmentShop:"data:image/jpeg;base64,",market:"data:image/jpeg;base64,",heal:"data:image/jpeg;base64,"};
/* v3.0 section subnavigation: existing gameplay views are reused without changing game state. */
/* PMC appearance: independent from combat/save state */
const PMC_CHARACTER_OPTIONS=[
{id:'male01',gender:'male',label:'男性 01',src:'data:image/webp;base64,'},
{id:'male02',gender:'male',label:'男性 02',src:'data:image/webp;base64,'},
{id:'male03',gender:'male',label:'男性 03',src:'data:image/webp;base64,'},
{id:'male04',gender:'male',label:'男性 04',src:'data:image/webp;base64,'},
{id:'male05',gender:'male',label:'男性 05',src:'data:image/webp;base64,'},
{id:'male06',gender:'male',label:'男性 06',src:'data:image/webp;base64,'},
{id:'male07',gender:'male',label:'男性 07',src:'data:image/webp;base64,'},
{id:'male08',gender:'male',label:'男性 08',src:'data:image/webp;base64,'},
{id:'male09',gender:'male',label:'男性 09',src:'data:image/webp;base64,'},
{id:'male10',gender:'male',label:'男性 10',src:'data:image/webp;base64,'},
{id:'female01',gender:'female',label:'女性 01',src:'data:image/webp;base64,'},
{id:'female02',gender:'female',label:'女性 02',src:'data:image/webp;base64,'},
{id:'female03',gender:'female',label:'女性 03',src:'data:image/webp;base64,'},
{id:'female04',gender:'female',label:'女性 04',src:'data:image/webp;base64,'},
{id:'female05',gender:'female',label:'女性 05',src:'data:image/webp;base64,'},
{id:'female06',gender:'female',label:'女性 06',src:'data:image/webp;base64,'},
{id:'female07',gender:'female',label:'女性 07',src:'data:image/webp;base64,'},
{id:'female08',gender:'female',label:'女性 08',src:'data:image/webp;base64,'},
{id:'female09',gender:'female',label:'女性 09',src:'data:image/webp;base64,'},
{id:'female10',gender:'female',label:'女性 10',src:'data:image/webp;base64,'}
];
let pmcAppearance='male01';
let pmcName='';
try {
 const saved=localStorage.getItem('tokyov_pmc_character')||localStorage.getItem('tokyov_pmc_appearance');
 if(PMC_CHARACTER_OPTIONS.some(x=>x.id===saved))pmcAppearance=saved;
 else if(saved==='female')pmcAppearance='female01';
 pmcName=(localStorage.getItem('tokyov_pmc_name')||'').slice(0,24);
}catch(e){}
function pmcCurrentCharacter(){return PMC_CHARACTER_OPTIONS.find(x=>x.id===pmcAppearance)||PMC_CHARACTER_OPTIONS[0];}
function pmcSafeText(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function pmcPortraitView(){const c=pmcCurrentCharacter();return `<section class="panel"><h2>PMC キャラクター</h2><div style="max-width:420px;margin:12px auto"><img src="${c.src}" alt="${c.label}" style="width:100%;height:auto;display:block;border-radius:14px;border:1px solid #526459"></div><p style="text-align:center;font-weight:700;font-size:20px">${pmcSafeText(pmcName||'名前未設定')}</p><p class="muted" style="text-align:center">${c.label} ／ 外見・名前は設定から変更可能</p></section>`;}
function pmcCharacterSettings(){const selected=pmcCurrentCharacter();return `<section class="panel"><h2>キャラクター変更</h2><p class="muted">キャラクターの外見と名前を変更できます。装備・レベル・HP・戦績には影響しません。</p><div style="margin:14px 0 20px"><label for="pmc-name-input" style="display:block;margin-bottom:7px;font-weight:bold">キャラクター名（24文字以内）</label><div style="display:flex;gap:8px;flex-wrap:wrap"><input id="pmc-name-input" type="text" maxlength="24" value="${pmcSafeText(pmcName)}" placeholder="名前を入力" style="flex:1;min-width:140px;padding:12px;border-radius:8px;border:1px solid #697c72;background:#13211f;color:white;font-size:16px"><button type="button" data-action="pmcSaveName" style="padding:10px 16px">名前を保存</button></div></div><p class="muted">現在の選択：${selected.label}</p><div class="pmc-character-grid">${PMC_CHARACTER_OPTIONS.map(c=>`<button type="button" data-action="pmcCharacter:${c.id}" class="pmc-character-choice ${pmcAppearance===c.id?'selected':''}" aria-pressed="${pmcAppearance===c.id}"><img loading="lazy" src="${c.src}" alt="${c.label}"><span>${c.label}${pmcAppearance===c.id?' ✓':''}</span></button>`).join('')}</div></section>`;}
// v3.5.33: Information-room investigations. Persist only paid plans and raid snapshot.
let tokInvestKind='enemy',tokInvestCategory='weapon',tokInvestBoss='suburban',tokInvestEnemyMap=null,tokInvestRoamingBoss='machine',tokInvestRoamingMap=null,tokInvestCart={};
const TOK_INV_COST={boss:5000,enemy:8000,supply:15000,roaming:25000};
function tokInvestEligible(id){return !!L[id]&&L[id].price>0&&!L[id].repairMaterial&&!L[id].repairTool&&!['memory','research','secretkey',...SECRET_KEYS,...ROYAL_IDS].includes(id)&&!['bandage','medkit','can','water'].includes(id)&&!L[id].unique&&(!!L[id].valuableCategory||!!L[id].regionalMap||(!L[id].t||['common','uncommon','rare','valuable','junk'].includes(L[id].t)))}
function tokInvestInventory(){return Object.entries(g.bank.loot||{}).filter(([id,n])=>tokInvestEligible(id)&&n>0).sort((a,b)=>L[a[0]].n.localeCompare(L[b[0]].n,'ja'))}
function tokInvestCartValue(){return Object.entries(tokInvestCart).reduce((v,[id,n])=>v+(L[id]?.price||0)*n,0)}
function tokInvestAvailable(){return g.status==='base'&&!g.longRun?.active&&!g.raid}
function tokInvestResult(title,details){
 const previous=document.getElementById('tok-invest-result-overlay');if(previous)previous.remove();
 const overlay=document.createElement('div');overlay.id='tok-invest-result-overlay';
 overlay.style.cssText='position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.82);display:flex;align-items:center;justify-content:center;padding:20px';
 const panel=document.createElement('section');panel.setAttribute('role','dialog');panel.setAttribute('aria-modal','true');panel.setAttribute('aria-label','情報解析結果');
 panel.style.cssText='width:min(100%,480px);max-height:85vh;overflow:auto;background:#172530;color:#f0f3f5;border:1px solid #71949e;border-radius:14px;padding:24px;box-shadow:0 15px 55px #000a;text-align:left';
 const heading=document.createElement('h2');heading.textContent=title;heading.style.cssText='margin:0 0 16px;font-size:21px;color:#b6d9aa';panel.appendChild(heading);
 for(const detail of details){const p=document.createElement('p');p.textContent=detail;p.style.cssText='margin:10px 0;line-height:1.65;white-space:pre-wrap';panel.appendChild(p)}
 const close=document.createElement('button');close.type='button';close.textContent='確認';close.style.cssText='display:block;width:100%;margin-top:20px;padding:12px;background:#8bbd9c;color:#102016;font-size:16px;font-weight:bold;border:0;border-radius:8px';
 close.addEventListener('click',()=>overlay.remove());panel.appendChild(close);overlay.appendChild(panel);document.body.appendChild(overlay);close.focus();
}
function tokInvestigationView(){
 const pending=g.investigation?.pending,available=tokInvestAvailable();
 const kind=tokInvestKind,cost=TOK_INV_COST[kind];
 const boss=g.bosses?.[tokInvestBoss],full=BOSSES[tokInvestBoss]?.full||0;
 const current=tokInvestCartValue();
 const inventory=tokInvestInventory();
 const locked=!!pending;
 const enemyMap=(tokInvestEnemyMap&&g.unlocked[tokInvestEnemyMap]&&MAP[tokInvestEnemyMap])?tokInvestEnemyMap:g.settings.map;
 const roamingMaps=(ROAMING_AREAS[tokInvestRoamingBoss]||[]).filter(id=>g.unlocked[id]);
 const roamingMap=roamingMaps.includes(tokInvestRoamingMap)?tokInvestRoamingMap:roamingMaps[0];
 return `<section class="panel"><h2>事前調査</h2><p class="muted">換金品の売却価値で支払います。INTEL解析は独立。次回の通常レイド用調査は敵勢力・物資のいずれか1種類のみです。</p>
 ${pending?`<div class="item" style="border:2px solid #8bbd9c;background:#173b32;padding:14px;border-radius:10px"><b>予約完了・現在の予約：${pending.kind==='enemy'?'敵勢力調査':pending.kind==='roaming'?'徘徊型ボス追跡調査':'物資調査'}</b><p>${escapeHTML(MAP[pending.map]?.n||pending.map)}／${pending.kind==='supply'?`${escapeHTML({weapon:'武器',helmet:'頭防具',armor:'胴防具',bag:'バッグ'}[pending.category])}：${escapeHTML(gearName(pending.gear))}（${RN[pending.gear.rarity]}）`:pending.kind==='roaming'?`${escapeHTML(BOSSES[pending.boss]?.n||pending.boss)}と遭遇確定`:'敵遭遇率を相対10%・RAIDER/ELITEの抽選重みを相対20%軽減'}</p><p class="muted">${pending.kind==='roaming'?'次回の長期探索で発動。通常レイドでは消費されません。':'対象マップの次回通常レイドで発動します。'}</p><button data-action="invest:cancel" ${!available?'disabled':''}>予約を取り消す（素材は返却されません）</button></div>`:''}
 <div class="v3-subnav">${[['boss','ボス情報解析'],['enemy','敵勢力調査'],['supply','物資調査'],['roaming','徘徊型ボス追跡調査']].map(([k,n])=>`<button class="${kind===k?'on':''}" data-action="invest:kind:${k}">${n}</button>`).join('')}</div>
 ${kind==='boss'?`<p>対象ボス：<select data-invest="boss">${Object.entries(BOSSES).filter(([id])=>!!g.bosses?.[id]&&!ROAMING_BOSSES[id]).map(([id,b])=>`<option value="${id}" ${id===tokInvestBoss?'selected':''}>${escapeHTML(b.n)}（${g.bosses[id].intel}/${b.full} INTEL）</option>`).join('')}</select></p><p class="muted">INTEL +2（完全解析上限まで）。専用ボスレイド解放に利用できます。</p>`:kind==='enemy'?`<p>対象マップ：<select data-invest="enemy-map">${Object.entries(MAP).filter(([id])=>g.unlocked[id]).map(([id,m])=>`<option value="${id}" ${id===enemyMap?'selected':''}>${escapeHTML(m.n)}</option>`).join('')}</select></p><p class="muted">選択したマップの次回通常レイドで適用されます。出撃時にも同じマップを選択してください。</p><p class="muted">次回の通常レイドで通常敵遭遇率を相対10%減、RAIDER・ELITEの抽選重みを相対20%減。ボスの出現率は変更しません。</p>` :kind==='roaming'?`<p>対象ボス：<select data-invest="roaming-boss">${Object.entries(ROAMING_BOSSES).map(([id,b])=>`<option value="${id}" ${id===tokInvestRoamingBoss?'selected':''}>${escapeHTML(b.n)}</option>`).join('')}</select></p><p class="muted">次回の長期探索で対象ボスの出現地区5つから解放済み地区をランダム選択し、対象ボスとの遭遇を確定します。通常レイドでは予約を消費しません。</p>${!roamingMaps.length?'<p class="warn">この徘徊型ボスの対象地区が未解放です。対象地区を解放すると予約できます。</p>':''}`:`<p>対象マップ：<b>${escapeHTML(MAP[g.settings.map]?.n||g.settings.map)}</b></p><p>装備カテゴリ：<select data-invest="category">${[['weapon','武器'],['helmet','頭防具'],['armor','胴防具'],['bag','バッグ']].map(([k,n])=>`<option value="${k}" ${k===tokInvestCategory?'selected':''}>${n}</option>`).join('')}</select></p><p class="muted">RARE 75%／EPIC 20%／LEGENDARY 5%。設定した探索目標の半分（切り上げ）に到達すると発見。ボス固有装備は除外。生還が必要です。</p>`}
 <p><b>必要な換金品価値：${fmt(cost)}₽</b>　選択中：<b>${fmt(current)}₽</b> ${current>=cost?'<span class="ok">支払い可能</span>':'<span class="muted">不足 '+fmt(cost-current)+'₽</span>'}</p>
 <p class="muted">倉庫の換金品から数量を選択してください。必要額を超えた分は返金されません。</p>
 ${inventory.length?inventory.map(([id,n])=>`<div class="item"><div class="flex between"><span>${escapeHTML(L[id].n)} <small class="muted">所持${n}個／${fmt(L[id].price)}₽</small></span><span><button data-action="invest:minus:${id}" ${(tokInvestCart[id]||0)<1?'disabled':''}>−</button> ${tokInvestCart[id]||0} <button data-action="invest:plus:${id}" ${(tokInvestCart[id]||0)>=n?'disabled':''}>＋</button></span></div></div>`).join(''):'<p class="muted">支払いに使える換金品が倉庫にありません。</p>'}
 <div class="btns"><button data-action="invest:auto">必要額まで自動選択</button><button data-action="invest:clear">選択を解除</button><button type="button" class="primary" data-action="invest:pay" onclick="return tokInvestPayDirect(event)">${kind==='boss'?'INTEL解析を実行':'次回レイドの調査を予約'}</button></div>
 ${kind!=='boss'&&g.settings.raidType!=='normal'?'<p class="warn">通常レイドを選択すると予約できます。</p>':''}
 </section>`;
}
function tokInvestPayDirect(event){
 if(event){event.preventDefault();event.stopPropagation();}
 try{
  if(typeof tokInvestigationAction!=="function")throw new Error("予約処理が読み込まれていません");
  tokInvestigationAction('pay');
 }catch(err){
  console.error('Investigation direct payment failure',err);
  const msg='情報解析・予約の処理に失敗しました：'+(err&&err.message?err.message:String(err));
  try{tokInvestResult('操作エラー',[msg,'セーブデータは初期化しないでください。']);}catch(e){alert(msg);}
 }
 return false;
}
window.tokInvestPayDirect=tokInvestPayDirect;
let tokInvestPaymentConfirmed=false;
function tokInvestShowPaymentConfirmation(kind,total,over){
 const title=kind==='boss'?'ボス情報解析':kind==='enemy'?'敵勢力調査':kind==='roaming'?'徘徊型ボス追跡調査':'物資調査';
 let overlay=document.getElementById('tok-invest-payment-overlay');
 if(!overlay){overlay=document.createElement('div');overlay.id='tok-invest-payment-overlay';overlay.setAttribute('role','dialog');overlay.setAttribute('aria-modal','true');overlay.style.cssText='position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.82);display:flex;align-items:center;justify-content:center;padding:18px;box-sizing:border-box;';document.body.appendChild(overlay);}
 overlay.innerHTML='<div style="width:min(100%,460px);max-height:85vh;overflow:auto;background:#192923;color:#fff;border:2px solid #8d9b79;border-radius:16px;padding:22px;box-sizing:border-box;font-size:17px;line-height:1.7"><h2 style="margin:0 0 14px">支払い確認</h2><p>'+title+'を実行しますか？</p><p>選択した換金品：'+fmt(total)+'₽<br>超過分：'+fmt(over)+'₽（返金なし）</p><div style="display:flex;gap:12px;flex-wrap:wrap"><button type="button" id="tok-invest-confirm-yes" style="padding:14px 22px;font-size:17px;background:#4b735b;color:white;border:1px solid #9fbba2;border-radius:10px">支払って実行</button><button type="button" id="tok-invest-confirm-no" style="padding:14px 22px;font-size:17px;background:#293e49;color:white;border:1px solid #8d9b79;border-radius:10px">戻る</button></div></div>';
 overlay.style.display='flex';
 overlay.querySelector('#tok-invest-confirm-no').onclick=function(e){e.preventDefault();e.stopPropagation();overlay.remove();};
 overlay.querySelector('#tok-invest-confirm-yes').onclick=function(e){e.preventDefault();e.stopPropagation();overlay.remove();tokInvestPaymentConfirmed=true;try{tokInvestigationAction('pay')}finally{tokInvestPaymentConfirmed=false}};
}
function tokInvestigationAction(arg){const [op,id]=String(arg||'').split(':');
 if(op==='kind'&&TOK_INV_COST[id]){tokInvestKind=id;tokInvestCart={};render();return}
 if(op==='cancel'){if(!tokInvestAvailable())return;if(!g.investigation?.pending)return;if(!confirm('予約を取り消しますか？ 消費した換金品は戻りません。'))return;g.investigation.pending=null;save();render();return}
 if(op==='clear'){tokInvestCart={};render();return}
 if(op==='plus'||op==='minus'){if(!tokInvestEligible(id))return;const n=Math.max(0,Math.min(g.bank.loot[id]||0,(tokInvestCart[id]||0)+(op==='plus'?1:-1)));if(n)tokInvestCart[id]=n;else delete tokInvestCart[id];render();return}
 if(op==='auto'){tokInvestCart={};const cost=TOK_INV_COST[tokInvestKind];const arr=tokInvestInventory().sort((a,b)=>L[b[0]].price-L[a[0]].price);for(const [id,n] of arr){while((tokInvestCart[id]||0)<n&&tokInvestCartValue()<cost)tokInvestCart[id]=(tokInvestCart[id]||0)+1;if(tokInvestCartValue()>=cost)break}render();return}
 if(op!=='pay')return;
 if(!tokInvestAvailable()){tokInvestResult('予約できません',['レイド中または長期探索中は情報解析・予約を実行できません。']);return}
 const kind=tokInvestKind,cost=TOK_INV_COST[kind];if(tokInvestCartValue()<cost){tokInvestResult('必要額が不足しています',[`必要額：${fmt(cost)}₽`,`選択額：${fmt(tokInvestCartValue())}₽`,'換金品を選択するか「必要額まで自動選択」を押してください。']);return}
 if(Object.entries(tokInvestCart).some(([id,n])=>!tokInvestEligible(id)||n<1||n>(g.bank.loot[id]||0))){tokInvestResult('予約できません',['選択した換金品の所持数が不足しています。選択をやり直してください。']);return}
 if(kind==='roaming'&&!(ROAMING_AREAS[tokInvestRoamingBoss]||[]).some(id=>g.unlocked[id])){tokInvestResult('予約できません',['選択した徘徊ボスの対象地区が未解放です。']);return}
 if(kind==='boss'){if(!BOSSES[tokInvestBoss]||!g.bosses[tokInvestBoss]||g.bosses[tokInvestBoss].intel>=BOSSES[tokInvestBoss].full){tokInvestResult('解析できません',['対象ボスは未発見、または解析済みです。']);return}}
 else if(g.investigation?.pending||(kind!=='roaming'&&g.settings.raidType!=='normal')||!g.unlocked[kind==='enemy'?((tokInvestEnemyMap&&g.unlocked[tokInvestEnemyMap]&&MAP[tokInvestEnemyMap])?tokInvestEnemyMap:g.settings.map):kind==='roaming'?((ROAMING_AREAS[tokInvestRoamingBoss]||[]).filter(id=>g.unlocked[id]).includes(tokInvestRoamingMap)?tokInvestRoamingMap:(ROAMING_AREAS[tokInvestRoamingBoss]||[]).find(id=>g.unlocked[id])):g.settings.map]){tokInvestResult('予約できません',[g.investigation?.pending?'別の予約が進行中です。先に完了または取り消してください。':g.settings.raidType!=='normal'?'出撃設定を「通常レイド」に変更してください。':'対象地区が未解放です。']);return}
 const selected=Object.entries(tokInvestCart).filter(([,n])=>n>0),over=tokInvestCartValue()-cost;
 if(!tokInvestPaymentConfirmed){tokInvestShowPaymentConfirmation(kind,tokInvestCartValue(),over);return;}
 tokInvestPaymentConfirmed=false;
 let resultNotice=null;
 let gear=null;
 if(kind==='supply'){
  const r={seed:((Date.now()^Math.floor(Math.random()*4294967295))>>>0)||1};
  const ids=Object.keys(GEARTYPE[tokInvestCategory]||{}).filter(x=>x!=='none'&&!isBossOnlyGear(BANKTYPE[tokInvestCategory],x));
  if(!ids.length){alert('対象装備が見つかりません');return}
  const rollValue=rand(r),rarity=rollValue<.75?'rare':rollValue<.95?'epic':'legendary';
  gear=attAutoWeapon(r,makeGear(r,tokInvestCategory,pick(r,ids),rarity));
 }
 for(const [id,n] of selected){g.bank.loot[id]-=n;if(g.bank.loot[id]<=0)delete g.bank.loot[id]}
 if(kind==='boss'){const st=g.bosses[tokInvestBoss];st.intel=Math.min(BOSSES[tokInvestBoss].full,st.intel+2);g.notice=`ボス情報解析：${BOSSES[tokInvestBoss].n}のINTEL ${st.intel}/${BOSSES[tokInvestBoss].full}`;resultNotice=['ボス情報解析 完了',[`対象：${BOSSES[tokInvestBoss].n}`,`解析進捗：${st.intel} / ${BOSSES[tokInvestBoss].full} INTEL`,`消費した換金品：${fmt(tokInvestCartValue())}₽`]]}
 else{const targetMap=kind==='enemy'?((tokInvestEnemyMap&&g.unlocked[tokInvestEnemyMap]&&MAP[tokInvestEnemyMap])?tokInvestEnemyMap:g.settings.map):kind==='roaming'?((ROAMING_AREAS[tokInvestRoamingBoss]||[]).filter(id=>g.unlocked[id]).includes(tokInvestRoamingMap)?tokInvestRoamingMap:(ROAMING_AREAS[tokInvestRoamingBoss]||[]).find(id=>g.unlocked[id])):g.settings.map;g.investigation=g.investigation||{};g.investigation.pending={kind,map:targetMap,boss:kind==='roaming'?tokInvestRoamingBoss:null,category:kind==='supply'?tokInvestCategory:null,gear};g.notice=`${kind==='enemy'?'敵勢力調査':kind==='roaming'?'徘徊型ボス追跡調査':'物資調査'}を予約しました。対象：${kind==='roaming'?BOSSES[tokInvestRoamingBoss].n:MAP[targetMap].n}`;
 resultNotice=[kind==='roaming'?'徘徊型ボス追跡 予約完了':kind==='enemy'?'敵勢力調査 予約完了':'物資調査 予約完了',[
 `対象地区：${MAP[targetMap].n}`,
 kind==='roaming'?`追跡対象：${BOSSES[tokInvestRoamingBoss].n}（対象5地区からランダム）`:kind==='enemy'?'効果：通常敵との遭遇率を相対10%軽減、RAIDER・ELITEの抽選重みを相対20%軽減':`発見対象：${{weapon:'武器',helmet:'頭防具',armor:'胴防具',bag:'バッグ'}[tokInvestCategory]}`,
 kind==='roaming'?'発動条件：次回の長期探索':'発動条件：指定地区の次回通常レイド',
 kind==='roaming'?'次回長期探索で対象ボスと遭遇確定。通常レイドでは消費されません。':'調査効果は指定地区で適用されます。',
 `消費した換金品：${fmt(tokInvestCartValue())}₽`
 ]]}
 // Show the result independently of the game's re-render path.
 // The reservation and payment are already recorded; do not let a UI exception hide feedback.
 tokInvestCart={};
 try{save()}catch(err){console.error('Investigation save error',err)}
 if(resultNotice)tokInvestResult(...resultNotice);
 try{render()}catch(err){console.error('Investigation render error',err)}
 if(resultNotice&&!document.getElementById('tok-invest-result-overlay'))tokInvestResult(...resultNotice);

}
function tokInvestigatedFind(r){const plan=r.investigation;if(!plan||plan.kind!=='supply'||plan.found||r.phase!=='explore')return;
 const target=Math.max(5,Math.min(30,Number(r.settings?.exploreTarget)||15));if(r.explore<Math.ceil(target/2))return;
 plan.found=true;
 const x=plan.gear;if(!x)return;
 // The discovery is guaranteed; retrieval remains subject to the backpack's capacity.
 collectGear(r,x,'【物資調査・確定発見】');
}
document.addEventListener('change',e=>{const el=e.target;if(!el?.dataset?.invest)return;if(el.dataset.invest==='boss'&&BOSSES[el.value])tokInvestBoss=el.value;if(el.dataset.invest==='category'&&['weapon','helmet','armor','bag'].includes(el.value))tokInvestCategory=el.value;if(el.dataset.invest==='enemy-map'&&MAP[el.value]&&g.unlocked[el.value])tokInvestEnemyMap=el.value;if(el.dataset.invest==='roaming-boss'&&ROAMING_BOSSES[el.value]){tokInvestRoamingBoss=el.value;tokInvestRoamingMap=null;}if(el.dataset.invest==='roaming-map'&&(ROAMING_AREAS[tokInvestRoamingBoss]||[]).includes(el.value)&&g.unlocked[el.value])tokInvestRoamingMap=el.value;render();});
const V3_SECTIONS={
 stash:[['status','PMC状態'],['equipment','武器・防具・ヘルメット・バッグ']],
 warehouse:[['gear','装備品'],['ammo','弾薬'],['supplies','医療品・消耗品'],['loot','換金品'],['special','特殊アイテム']],
 facility:[['weaponShop','武器店'],['gunsmith','ガンスミス'],['equipmentShop','装備品店'],['market','マーケット'],['heal','病院']],
 intel:[['investigation','事前調査'],['boss','ボス情報'],['district','ワールドマップ・地区情報'],['history','レイド記録'],['report','戦闘報告'],['royal','収集品'],['titles','称号'],['trophy','トロフィールーム']],
 settings:[['character','キャラクター変更'],['game','ゲーム設定'],['backup','バックアップ'],['restore','データ復元'],['display','画面設定'],['prologue','プロローグ']]
};
const V3_DEFAULT={stash:'status',warehouse:'gear',facility:'weaponShop',intel:'boss',settings:'game'};
let v3Section={...V3_DEFAULT};
function v3Subnav(group){return `<div class="v3-subnav">${V3_SECTIONS[group].map(([id,label])=>`<button class="${v3Section[group]===id?'on':''}" data-action="v3sub:${group}:${id}">${label}</button>`).join('')}</div>`}
function tokLootFeature(){
 const c=storageInit().container;
 const used=containerUsed();
 const count=(c.gear||[]).length+['loot','ammo','supplies'].reduce((sum,k)=>sum+Object.values(c[k]||{}).reduce((n,v)=>n+(Number(v)>0?1:0),0),0);
 return `<div class="tok-loot-feature ${used?'has-loot':''}">
  <button type="button" data-action="v3sub:warehouse:temporary" class="tok-loot-feature-button" aria-label="戦利品を確認">
   <span class="tok-loot-feature-top"><strong>📦 戦利品</strong><span class="tok-loot-feature-badge">${used?'未整理あり':'整理済み'}</span></span>
   <span class="tok-loot-feature-count">${used?`未整理：${count}種類 ／ ${used} / 200マス`:'未整理の戦利品はありません'}</span>
   <span class="tok-loot-feature-link">戦利品を確認　›</span>
  </button>
 </div>`;
}


// v3.0 equipment character layout: presentation only; all gear actions reuse original handlers.
let tokCarryDetailsOpen=false;
let tokStatusDetailsOpen=false;
let v3SelectedGearSlot='weapon';
let v3GearSort='default';
const v3GearSortModes=[['default','装備中を先頭'],['name','名前順'],['rarity','レアリティ順'],['power','性能順'],['newest','新しい順']];
function v3EquipmentScreen(){
 const slotNames={accessory:'アクセサリー',weapon:'メイン武器',secondary:'サブ武器',melee:'近接武器',helmet:'ヘルメット',armor:'アーマー',bag:'バッグ',grenade:'グレネード',carry:'携行品'};
 const slot=(id)=>{const x=equippedGear(id),def=x?(x.type==='weapon'?W[x.base]:x.type==='armor'?A[x.base]:x.type==='helmet'?H[x.base]:x.type==='accessory'?TOK_ACCESSORIES[x.base]:B[x.base]):null;
 return `<button class="v3-slot ${v3SelectedGearSlot===id?'selected':''}" data-action="v3gearSlot:${id}"><small>${slotNames[id]}</small><strong>${x?escapeHTML(gearName(x)):'未装備'}</strong>${x?(x.type==='accessory'?tokAccessoryImage(x.base):x.type==='weapon'?tokWeaponImage(x.base):tokEquipmentImage(x.base,x.type)):''}<em>${x&&def?(x.type==='weapon'?`威力 ${def.d??'—'} / 貫通 ${def.p??'—'}`:x.type==='bag'?`容量 ${def.kg??0}`:`防御 ${def.def??0}`):'タップして選択'}</em></button>`};
 const options=(Array.isArray(g.gear)?g.gear:[]).filter(x=>v3SelectedGearSlot==='secondary'?(x.type==='weapon'&&!W[x.base]?.melee&&x.id!==g.eqIds.weapon):v3SelectedGearSlot==='melee'?(x.type==='weapon'&&!!W[x.base]?.melee&&x.base!=='chainsaw'):x.type===v3SelectedGearSlot&&(v3SelectedGearSlot!=='weapon'||!W[x.base]?.melee||x.base==='chainsaw'));
 const v3RarityRank={common:0,uncommon:1,rare:2,epic:3,legendary:4,boss:5};
 const v3Power=(x)=>{const d=(GEARTYPE[x.type]||{})[x.base]||{};return x.type==='weapon'?(d.d||0)*10+(d.p||0)+(d.hit||0):x.type==='bag'?(d.kg||0):((d.def||0)*10+(x.dur||0));};
 options.sort((a,b)=>{const equipped=Number(b.id===g.eqIds[v3SelectedGearSlot])-Number(a.id===g.eqIds[v3SelectedGearSlot]);if(equipped)return equipped;switch(v3GearSort){case 'name':return gearName(a).localeCompare(gearName(b),'ja')||String(a.id).localeCompare(String(b.id));case 'rarity':return (v3RarityRank[b.rarity]??0)-(v3RarityRank[a.rarity]??0)||gearName(a).localeCompare(gearName(b),'ja');case 'power':return v3Power(b)-v3Power(a)||gearName(a).localeCompare(gearName(b),'ja');case 'newest':return String(b.id).localeCompare(String(a.id),undefined,{numeric:true});default:return 0;}});
 const gearBonusDisplay=(x)=>{const bonuses=(x.affixes||[]).map(a=>{const def=(GC[x.type]||{})[a.type]||(typeof BOSS_POOL!=='undefined'?(BOSS_POOL[x.type]||{})[a.type]:null);const label=(x.type==='accessory'?TOK_ACCESSORY_LABELS[a.type]:null)||def?.[0]||a.type;const unit=['damage','saving','absorb','durprotect','repair','organize'].includes(a.type)?'%':(x.type==='accessory'&&['accuracy','evasion','loot','rare'].includes(a.type))||['accuracy','escape','load','loot','detect'].includes(a.type)?'pt':a.type==='capacity'?'kg':'';return `<span class="v3-bonus-chip">${escapeHTML(label)} +${escapeHTML(String(a.value))}${unit}</span>`;});const fixed=[];if(x.type==='weapon'&&WEAPON_FIXED[x.base])fixed.push(WEAPON_FIXED[x.base]);if(x.rarity==='legendary'&&SPECIAL[x.base])fixed.push(SPECIAL[x.base]);if(x.rarity==='boss'&&BOSS_FIXED[x.base])fixed.push(BOSS_FIXED[x.base]);return `<div class="v3-bonus-area"><small class="v3-bonus-caption">追加能力・補正</small><div class="v3-bonus-list">${bonuses.join('')||(fixed.length?'':'<span class="v3-base-only">追加補正なし（基本性能）</span>')}</div>${fixed.map(t=>`<div class="v3-fixed-ability">★ ${escapeHTML(String(t))}</div>`).join('')}</div>`;};
 const pick=(x)=>{const current=g.eqIds[v3SelectedGearSlot]===x.id;const action=v3SelectedGearSlot==='secondary'?`equipSecondary:${x.id}`:v3SelectedGearSlot==='melee'?`equipMelee:${x.id}`:`equip:${v3SelectedGearSlot}:${x.id}`;return `<div class="item v3-picker-card ${current?'v3-current-equipped':''} ${escapeHTML(x.rarity||'common')}"><div class="v3-picker-heading"><strong>${escapeHTML(gearName(x))}</strong><span class="v3-rarity-badge ${escapeHTML(x.rarity||'common')}">${escapeHTML(RN[x.rarity]||String(x.rarity||'COMMON').toUpperCase())}</span>${current?'<span class="v3-equipped-label">✓ 現在装備中</span>':''}</div>${x.type==='accessory'?tokAccessoryImage(x.base):x.type==='weapon'?tokWeaponImage(x.base):tokEquipmentImage(x.base,x.type)}<div>${gearQuickStats(x)}</div>${gearBonusDisplay(x)}<div class="btns">${b(current?'装備中':'装備する',action,'small',current||g.status!=='base')}${b('比較',`gearCompare:${x.id}`,'small')}${current&&x.type==='weapon'&&!W[x.base]?.melee&&attSlots(x.base).length?b(tokAttachmentOpenFor===x.id?'アタッチメントを閉じる':'アタッチメント',`toggleGearAttachments:${x.id}`,'small'):''}${b(x.favorite?'★保護解除':'☆保護',`gearFavorite:${x.id}`,'small',g.status!=='base')}${['armor','weapon','helmet','bag'].includes(x.type)?b('修理',`gearRepair:${x.id}`,'small',g.status!=='base'||(x.dur??repairMax(x))>=repairMax(x)):''}</div>${compareId===x.id?gearComparison(x):''}${current&&tokAttachmentOpenFor===x.id?tokAttCustomFor(x):''}</div>`};
 const grenadeVisual=`<div class="tok-pmc-grenades"><div class="tok-pmc-grenades-head"><strong>GRENADE EQUIPMENT — グレネード</strong><small>左から順に使用 ／ ${tokSlots(g).filter(Boolean).length}/6</small></div><div class="tok-pmc-grenade-grid">${tokSlots(g).map((id,i)=>`<div class="tok-pmc-grenade-card"><span class="tok-pmc-grenade-number">${i+1}</span><div class="tok-pmc-grenade-art">${id?tokConsumableImage(id):'<span class="tok-pmc-grenade-empty">＋</span>'}</div><select aria-label="グレネードスロット${i+1}" data-grenade-slot="${i}" ${g.status!=='base'?'disabled':''}><option value="none" ${!id?'selected':''}>空き</option>${TOK_GRENADES.map(k=>`<option value="${k}" ${id===k?'selected':''}>${ITEMS[k].n}（倉庫${activeCount(g.bank.supplies,k)}）</option>`).join('')}</select></div>`).join('')}</div><small class="muted">選択すると装備が更新されます。未使用分は生還後も保持されます。</small></div>`;
 const grenadeSettings=`<div class="tok-grenade-settings" style="margin-top:16px;padding-top:12px;border-top:1px solid var(--line,#45554c)"><h3>戦闘中の使用タイミング</h3><select data-setting="grenadeTiming">${TOK_GRENADE_TIMING.map(([id,name])=>`<option value="${id}" ${(g.settings.grenadeTiming||'start')===id?'selected':''}>${name}</option>`).join('')}</select><p class="muted">既存の使用方針と両方の条件を満たした場合、1攻撃機会に1個投擲。未使用分は生還時に装備維持。</p><h3>グレネード自動使用方針</h3><select data-setting="grenadePolicy">${[['save','温存（ボスのみ）'],['groups','複数敵優先'],['strong','強敵優先'],['all','無差別使用（SCAV1体でも）']].map(([id,name])=>`<option value="${id}" ${g.settings.grenadePolicy===id?'selected':''}>${name}</option>`).join('')}</select></div>`;
 const stats=`<div class="v3-pmc-summary"><div><small>LEVEL / XP</small><b>Lv.${g.level}</b><small>${fmt(g.xp)} XP</small></div><div><small>HP</small><b>${g.hp}/${baseMaxHp()}</b></div><div><small>所持金</small><b>${fmt(g.money)}₽</b></div></div>`;
 const figure=`<img class="v3-pmc-figure" alt="黄色い輪郭の人物シルエット" src="data:image/png;base64,">`;
 return `<section class="panel"><h2>PMC EQUIPMENT</h2><p class="muted">装備スロットをタップして変更できます。装備変更は拠点でのみ可能です。</p>${stats}<div class="v3-pmc-layout"><div class="v3-slot-column">${slot('helmet')}${slot('armor')}${slot('bag')}${slot('accessory')}</div>${figure}<div class="v3-slot-column">${slot('weapon')}${slot('secondary')}${slot('melee')}</div></div><div class="tok-grenade-category"><button class="v3-slot tok-grenade-category-button ${v3SelectedGearSlot==='grenade'?'selected':''}" data-action="v3gearSlot:grenade"><small>装備カテゴリー</small><strong>グレネード</strong><em>装備数 ${tokSlots(g).filter(Boolean).length} / 6　・　タップして設定</em></button><button class="v3-slot tok-grenade-category-button ${v3SelectedGearSlot==='carry'?'selected':''}" data-action="v3gearSlot:carry"><small>装備カテゴリー</small><strong>携行品</strong><em>弾薬・医療品など　・　タップして設定</em></button></div></section><div class="panel" style="margin:12px 0;background:#203029"><h3>弾薬補給</h3>${equippedAmmoSupplyButton()}</div><div class="panel" style="margin:12px 0;background:#203029"><h3>装備整備</h3>${equippedRepairButton()}</div>${v3SelectedGearSlot==='grenade'?tokSelectedEquippedPanel(grenadeVisual,grenadeSettings):''}${v3SelectedGearSlot==='carry'?supplyPanel():''}${['grenade','carry'].includes(v3SelectedGearSlot)?'':`<section class="panel v3-gear-picker"><h2>${slotNames[v3SelectedGearSlot]}を変更</h2>${g.status!=='base'?'<p class="warn">レイド中は変更できません。</p>':''}${g.eqIds[v3SelectedGearSlot]?b('装備を外す',`unequipSlot:${v3SelectedGearSlot}`,'small',g.status!=='base'):''}<div class="v3-gear-sort" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0"><label for="v3-gear-sort-select">倉庫内の並び順</label><select id="v3-gear-sort-select" data-gear-sort style="max-width:230px">${v3GearSortModes.map(([key,label])=>`<option value="${key}" ${v3GearSort===key?'selected':''}>${label}</option>`).join('')}</select><small class="muted">装備中のアイテムは常に先頭</small></div>${options.map(pick).join('')||'<p class="muted">対応する装備品が倉庫にありません。</p>'}</section>`}${['weapon','secondary'].includes(v3SelectedGearSlot)?`<section class="panel"><h3>倉庫のアタッチメント"</h3>${g.gear.filter(x=>x.type==='attachment').map(x=>`<div class="item gear-card ${x.rarity}">${gearLabel(x)}${tokAttachmentImage(x.base)}${escapeHTML(affixText(x))}</div>`).join('')}||'<p class="muted">未所持</p>'}</section>`:''}`;
}

// Warehouse tabs: show only the corresponding existing inventory controls.
function v3WarehouseView(selected){
 const previous=pmcPane;
 pmcPane='warehouse';
 let html;
 try { html=stashView(); } finally { pmcPane=previous; }
 const holder=document.createElement('div');holder.innerHTML=html;
 // Remove the legacy three-button PMC navigation and the royal collection from warehouse.
 for(const el of [...holder.querySelectorAll('section.panel')]){
   if(el.querySelector('[data-action^="pmcPane:"]'))el.remove();
 }
 const panels=[...holder.querySelectorAll('section.panel')];
 const heading=el=>(el.querySelector('h2,h3')?.textContent||'').trim();
 const take=(predicate)=>panels.filter(el=>predicate(heading(el),el)).map(el=>el.outerHTML).join('');
 const gear=take(h=>h==='装備品');
 const ammo=take(h=>h==='弾薬');
 const supplies=take(h=>h==='医療品'||h.includes('消耗品'));
 const loot=take(h=>h.includes('通常戦利品'));
 const special=take(h=>h.includes('秘密の部屋の鍵')||h.includes('マップ解放情報'));
 const sections={gear:gear,ammo:ammo,supplies:supplies,loot:loot,special:special};
 // Dedicated temporary container tab; preserve existing transfer/sell actions.
 const temporaryHolder=document.createElement('div');
 temporaryHolder.innerHTML=storagePanel();
 sections.temporary=[...temporaryHolder.querySelectorAll('section.panel')].filter(el=>(el.querySelector('h2')?.textContent||'').includes('戦利品')).map(el=>el.outerHTML).join('');
 // Include inventory capacity controls with equipment, while keeping all item handlers intact.
 // Capacity is shown below the warehouse item tabs for every category.
 if(selected==='supplies'){
   sections.supplies=warehouseSupplyPanel();
 }
 if(selected==='special')sections.special=special;
 const labels={gear:'装備品',ammo:'弾薬',supplies:'医療品・消耗品',loot:'換金品',special:'特殊アイテム',temporary:'戦利品'};
 const result=sections[selected]||'<section class="panel"><p class="muted">該当するアイテムはありません。</p></section>';
 const normalized=document.createElement('div');normalized.innerHTML=result;
 for(const panel of normalized.querySelectorAll('section.panel')){
   const h=panel.querySelector('h2');
   if(h && !h.textContent.includes('倉庫容量') && !h.textContent.includes('戦利品')) h.textContent=labels[selected]||h.textContent;
 }
 return normalized.innerHTML;
}

const V3_SECTION_ART={settings:'data:image/jpeg;base64,',equipment:"data:image/jpeg;base64,",warehouse:"data:image/jpeg;base64,",intel:"data:image/jpeg;base64,"};
function v3SectionView(group){
 const selected=v3Section[group]||V3_DEFAULT[group];
 let content='';
 if(group==='stash') {pmcPane=selected;try{content=selected==='equipment'?v3EquipmentScreen():pmcPortraitView()+pmcStatusView();}catch(error){console.error('Tokyov equipment screen:',error);content='<section class="panel"><h2>装備画面の読み込みエラー</h2><p>画面を開けませんでした。エラー: '+escapeHTML(String(error?.message||error))+'</p></section>';}}
 else if(group==='warehouse'){content=v3WarehouseView(selected);}
 else if(group==='facility'){const view=({weaponShop:weaponShopView,gunsmith:tokGunsmithView,equipmentShop:equipmentShopView,market:marketView,heal:healView}[selected]||weaponShopView)();content=view;}
 else if(group==='intel'){content=selected==='investigation'?tokInvestigationView():selected==='boss'?bossBattleScreen():selected==='district'?tokWorldMapView():selected==='history'?historyView():selected==='report'?reportView():tokRegionalCollectionView()+tokUltraRareCollectionView()+royalCollectionView();}
 else if(group==='settings'){content=selected==='prologue'?tokPrologueSettingsView():selected==='character'?pmcCharacterSettings():settingsView();}
 if(group==='intel'&&selected==='titles'){content=achievementBadgePanel();}
 if(group==='intel'&&selected==='trophy'){
  const defeated=Object.entries(BOSSES).filter(([id])=>g.bosses?.[id]?.first||Number(g.bosses?.[id]?.kills)>0);
  content=`<section class="panel"><h2>トロフィールーム</h2><p class="muted">ボス討伐で獲得したバッジ</p><div class="tok-trophy-badge-grid">${defeated.map(([id,boss])=>`<div class="tok-trophy-badge-item">${bossBadge(id,Number(g.bosses?.[id]?.kills)||1)}<div>${escapeHTML(boss.n)}</div></div>`).join('')||'<p class="muted">まだ獲得したボス討伐バッジはありません。</p>'}</div><h3>ボス討伐記録</h3>${defeated.map(([id,boss])=>`<div class="item"><b>${escapeHTML(boss.n)}</b> <span class="pill">討伐済み</span> <small>${Number(g.bosses?.[id]?.kills)||1}回</small></div>`).join('')||'<p class="muted">まだボスの討伐記録はありません。</p>'}<h3>王の肖像</h3><p class="muted">スペードの王などの画像は今後追加予定です。</p></section>`;
 }
 const artKey=group==='stash'?'equipment':group==='warehouse'?'warehouse':group==='intel'?'intel':group==='settings'?'settings':null;
 const art=artKey?`<img class="v3-section-image" src="${V3_SECTION_ART[artKey]}" alt="${group==='stash'?'装備室':group==='warehouse'?'倉庫':group==='settings'?'設定':'情報室'}の室内" loading="eager">`:'';
 const facilityArt=group==='facility'?`<img class="v3-facility-image" src="${V3_FACILITY_ART[selected]||V3_FACILITY_ART.weaponShop}" alt="施設" loading="eager">`:'';
 return `${art}${facilityArt}<section class="panel"><h2>${{stash:'装備',warehouse:'倉庫',facility:'施設',intel:'情報室',settings:'設定'}[group]}</h2>${group==='warehouse'?tokLootFeature():''}${group==='warehouse'?'<h3 class="tok-warehouse-label">倉庫内アイテム</h3>':''}${v3Subnav(group)}</section>${group==='warehouse'?(()=>{const h=document.createElement('div');h.innerHTML=storagePanel();return [...h.querySelectorAll('section.panel')].filter(x=>(x.querySelector('h2')?.textContent||'').includes('倉庫容量')).map(x=>x.outerHTML).join('')})():''}${content}`;
}
function tokMarkWarehouseGearSeen(){if(!g||!Array.isArray(g.gear))return;let changed=false;for(const x of g.gear){if(x.newItem){x.newItem=false;changed=true;}}if(changed)save();}
// v3.4.10: visible raid type selector directly above map tabs.
let tokRaidMode='normal';
const tokBaseViewOriginal=baseView;
baseView=function(){
 const root=document.createElement('div');
 root.innerHTML=tokBaseViewOriginal();
 // v3.5.52: The legacy base screen independently renders longView() below
 // the raid setup. Remove that standalone panel: longView() is mounted once
 // inside the selected long-expedition tab below.
 for(const panel of [...root.querySelectorAll('section.panel')]){
  if(panel.querySelector(':scope > h2')?.textContent.trim()==='長期探索')panel.remove();
 }
 const setup=root.querySelector('.raid-setup');
 if(!setup)return root.innerHTML;
 const tabs=document.createElement('div');
 tabs.className='tok-raid-mode-tabs';
 tabs.innerHTML='<button type="button" data-action="tokRaidMode:normal" class="'+(tokRaidMode==='normal'?'active':'')+'">通常レイド</button><button type="button" data-action="tokRaidMode:long" class="'+(tokRaidMode==='long'?'active':'')+'">長期探索</button>';
 const mapTabs=setup.querySelector('.raid-setup-tabs');
 if(mapTabs)setup.insertBefore(tabs,mapTabs);else setup.insertBefore(tabs,setup.firstChild);
 if(tokRaidMode==='long'){
  // Hide only normal raid's sub-tabs and content; retain the new mode selector.
  for(const child of [...setup.children])if(child!==tabs&&child.tagName!=='H2')child.style.display='none';
  const expedition=document.createElement('div');expedition.className='tok-long-launch';
  const longRoot=document.createElement('div');longRoot.innerHTML=longView();
  // Long expeditions select an unlocked district automatically for every segment.
  const hero=longRoot.querySelector('.hero');if(hero)expedition.appendChild(hero);
  const prep=[...longRoot.querySelectorAll('section.panel')].find(el=>el.querySelector('h2')?.textContent.trim()==='探索準備');
  if(prep)expedition.appendChild(prep);
  setup.appendChild(expedition);
 }
 return root.innerHTML;
};
function render(){
const tokCarryBefore=document.querySelector('#app details[data-pmc-details="carry"]');
const tokStatusBefore=document.querySelector('#app details[data-pmc-details="status"]');
if(tokCarryBefore)tokCarryDetailsOpen=tokCarryBefore.open;
if(tokStatusBefore)tokStatusDetailsOpen=tokStatusBefore.open;
if(g?.reportPending && g.status==='base' && !g.longRun?.active && tab==='raid')tab='report';
// Keep HP and the level-derived maximum consistent even after an interrupted raid.
if(g && g.status==='base'){
 const cap=baseMaxHp();
 if(!Number.isFinite(g.hp))g.hp=cap;
 g.hp=Math.max(0,Math.min(cap,g.hp));
}
const xpNext=g.level<LEVEL_CAP?xpThreshold(g.level+1):null;document.getElementById('stats').innerHTML=`<div class="stat"><span>資金</span><b>${fmt(g.money)}₽</b></div><div class="stat"><span>HP</span><b id="headerHpValue">${g.hp}/${baseMaxHp()}</b>${g.poisonTurns>0?'<span class="bad">毒：残'+g.poisonTurns+'T</span>':''}${g.bleed?'<span class="bad">出血中</span>':''}</div><div class="stat"><span>レベル / XP</span><b>Lv.${g.level}</b><span>${fmt(g.xp)} XP${xpNext?` / 次 ${fmt(xpNext)}`:' / MAX'}</span></div><div class="stat"><span>戦績</span><b>${g.stats.wins} / ${g.stats.raids}</b><span>生還 / 出撃</span></div>`;const hpLabel=document.getElementById('headerHpValue');if(hpLabel)hpLabel.textContent=String(g.hp)+'/'+String(baseMaxHp());const tabs=[['base','拠点'],['stash','装備'],['warehouse','倉庫'],['facility','施設'],['intel','情報室'],['settings','設定']];const nav=document.getElementById('tabs');
if(!nav.dataset.initialized){
  nav.innerHTML=tabs.map(([id,n])=>`<div role="button" tabindex="0" data-action="tab:${id}">${n}<span class="new-mark" data-nav-new="${id}" hidden></span></div>`).join('');
  nav.dataset.initialized='1';
}
tabs.forEach(([id])=>{
  const btn=nav.querySelector(`[data-action="tab:${id}"]`);
  if(!btn)return;
  btn.classList.toggle('on',tab===id);
  const badge=btn.querySelector('[data-nav-new]');
  if(badge){const count=id==='warehouse'?newCount():0;badge.hidden=!count;badge.textContent=count?` ${count}`:'';}
});document.body.classList.toggle('hide-base-header',tab==='base');document.body.classList.toggle('v3-hide-overview', ['stash','warehouse','facility','intel','settings'].includes(tab));const app=document.getElementById('app');app.innerHTML=({warehouse:()=>v3SectionView('warehouse'),facility:()=>v3SectionView('facility'),intel:()=>v3SectionView('intel'),base:()=>g.longRun?.active?longView():g.status==='raid'?raidView():baseView(),boss:bossBattleScreen,raid:raidView,long:longView,longReport:longReportView,stash:()=>v3SectionView('stash'),weaponShop:weaponShopView,equipmentShop:equipmentShopView,market:marketView,shop:weaponShopView,heal:healView,report:reportView,history:historyView,settings:()=>v3SectionView('settings')}[tab]||baseView)();/* レイド設定はbaseView内のPMC状況直後に配置済み。先頭へ移動しない。 */}
// v3.2.2: Keep the selected raid panel in view during DOM replacement.
function tokRenderKeepRaidPosition(){
 const panel=document.querySelector('#app .raid-setup');
 const oldTop=panel?panel.getBoundingClientRect().top:null;
 const oldScroll=(window.tokScrollSurface?.scrollTop??window.scrollY);
 render();
 const next=document.querySelector('#app .raid-setup');
 if(next&&oldTop!==null){
   const delta=next.getBoundingClientRect().top-oldTop;
   (window.tokScrollSurface||window).scrollTo({top:Math.max(0,oldScroll+delta),behavior:'instant'});
 }
}
function backupPayload(){return JSON.stringify(g,null,2)}
function backupFilename(){return `tokyov-backup-${new Date().toISOString().slice(0,10)}.json`}
function backupStatus(message){const el=document.getElementById('backup-status');if(el){el.style.display='block';el.textContent=message}}
function backupText(){const box=document.getElementById('backup-text-panel'),area=document.getElementById('backup-text');if(!box||!area)return;area.value=backupPayload();box.style.display='block';backupStatus('バックアップデータを表示しました。全文をコピーして安全な場所に保存してください。')}
function downloadBackup(){try{const blob=new Blob([backupPayload()],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=backupFilename();document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);backupStatus('ダウンロードを要求しました。保存先が表示されない場合は「共有して保存」または「テキストで保存」をお試しください。※実際の保存完了は検出できません。')}catch(err){backupStatus('ダウンロード処理に失敗しました：'+err.message+'。テキスト保存をお試しください。')}}
async function shareBackup(){try{const file=new File([backupPayload()],backupFilename(),{type:'application/json'});if(!navigator.share||!navigator.canShare||!navigator.canShare({files:[file]})){backupStatus('このビューアはファイル共有に対応していません。「テキストで保存」をお試しください。');return}await navigator.share({files:[file],title:'Escape from Tokyov バックアップ'});backupStatus('共有画面を閉じました。実際に保存できたかは「ファイル」アプリ等で確認してください。')}catch(err){backupStatus(err.name==='AbortError'?'共有をキャンセルしました。':'共有に失敗しました：'+err.message+'。「テキストで保存」をお試しください。')}}
async function copyBackup(){const area=document.getElementById('backup-text');if(!area)return;try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(area.value);backupStatus('全文をコピーしました。メモ等に貼り付けて保存してください。');return}area.focus();area.select();const ok=document.execCommand('copy');backupStatus(ok?'全文をコピーしました。メモ等に貼り付けて保存してください。':'テキストを選択しました。iPhoneの「コピー」操作で保存してください。')}catch(err){area.focus();area.select();backupStatus('自動コピーが使えません。選択された全文を手動でコピーしてください。')}}
let pendingRestore=null;
function restoreBackupObject(x){
 if(!x||![2,3,4,5].includes(x.version)||!x.bank||!x.equipped||!x.settings||!Number.isFinite(x.money)||!['base','raid','cleared'].includes(x.status))throw Error('バックアップの形式が異なります');
 pendingRestore=x;
 const el=document.getElementById('restore-review'),info=document.getElementById('restore-review-info');
 if(!el||!info)throw Error('確認画面が見つかりません');
 info.textContent=`【読み込んだバックアップ】\n資金：${fmt(x.money)}₽\nレベル：${x.level}\n出撃回数：${x.stats?.raids??'不明'}\nリビジョン：${x.revision??'不明'}\n\n【現在のデータ】\n資金：${fmt(g.money)}₽\nレベル：${g.level}\n出撃回数：${g.stats?.raids??'不明'}`;
 el.style.display='block';backupStatus('バックアップを読み込みました。下の確認欄で内容を確認してください。');el.scrollIntoView({block:'center',behavior:'smooth'});return true;
}
function applyRestore(){
 if(!pendingRestore){backupStatus('復元対象のバックアップがありません');return}
 try{
  const x=pendingRestore;
  const restored=ensureBossState(x.version===2?migrate(x):{...x,version:5});
  if(restored.status==='cleared'){restored.status='base';restored.cleared=true}
  const previous=g;g=restored;window.__tokyovSaveReadError=false;
  // Preserve the backed-up game state while restarting the offline clock.
  if(g.status==='base')g.baseAt=Date.now();
  if(g.status==='raid'&&g.raid)g.raid.startedAt=Date.now()-(g.raid.processed||0)*STEP;
  if(!save()){g=previous;throw Error('端末への保存に失敗しました')}
  pendingRestore=null;tab='settings';render();backupStatus(`復元処理完了：資金 ${fmt(g.money)}₽ / Lv.${g.level} / 出撃 ${g.stats?.raids??'不明'}回。端末の保存領域は永続性を保証できません。バックアップを外部保存してください。`);
 }catch(err){backupStatus('復元に失敗しました：'+err.message)}
}
function cancelRestore(){pendingRestore=null;const el=document.getElementById('restore-review');if(el)el.style.display='none';backupStatus('復元を中止しました。現在のデータは変更していません。')}
function restoreTextBackup(){try{const area=document.getElementById('backup-text');if(!area||!area.value.trim())throw Error('データが空です');restoreBackupObject(JSON.parse(area.value))}catch(err){backupStatus('復元に失敗しました：'+err.message)}}
function tok111EmergencyPlan(){if(g.status!=='base'||g.longRun?.active||g.reportPending||containerHasItems()||g.money>=6000)return null;const usable=x=>x&&(x.dur??repairMax(x))>0;const gear=g.gear||[];const gun=gear.find(x=>x.type==='weapon'&&usable(x)&&W[x.base]&&!W[x.base].melee&&(W[x.base].ammoFree||activeCount(g.bank.ammo,W[x.base].ammo)>0));const melee=gear.find(x=>x.type==='weapon'&&usable(x)&&W[x.base]?.melee);const bag=gear.find(x=>x.type==='bag'&&usable(x));if((gun||melee)&&bag)return null;return {gun,melee,bag}}
function tok111Emergency(){advance();const plan=tok111EmergencyPlan();if(!plan)return;const issue=(type,base)=>{const x=makeGear({seed:Date.now()>>>0},type,base,'common');x.dur=repairOriginalMax(x);x.emergencyIssued=true;g.gear.push(x);return x};for(const [type,base] of [['helmet','light'],['armor','light'],['bag','small']]){const item=g.gear.find(x=>x.type===type&&(x.dur??repairMax(x))>0)||issue(type,base);g.eqIds[type]=item.id}if(plan.gun)g.eqIds.weapon=plan.gun.id;else if(plan.melee)g.eqIds.melee=plan.melee.id;else{const pm=g.gear.find(x=>x.type==='weapon'&&x.base==='pm'&&(x.dur??100)>0)||issue('weapon','pm');g.eqIds.weapon=pm.id;g.bank.ammo['9x18']=Math.max(30,activeCount(g.bank.ammo,'9x18'));g.ammoCarry['9x18']=30;}reconcileEquipment();g.notice='緊急支給を受けました。';save();render()}
function handleAction(action){if(action==='tok111Emergency'){tok111Emergency();return}if(!action)return;if(action==='tokRaidMode:normal'||action==='tokRaidMode:long'){tokRaidMode=action.endsWith(':long')?'long':'normal';render();return;}const parts=action.split(':');const [verb,type,id,qty]=parts;switch(verb){case 'gunsmithSelect':{const w=findGear(type);if(w?.type==='weapon'&&g.status==='base'&&!g.longRun?.active){tokGunsmithWeaponId=w.id;render()}return}case 'attShop':{if(g.status!=='base'||!ATTACH[type]||g.money<ATTACH[type].prices[0])return;g.money-=ATTACH[type].prices[0];g.gear.push(attMake(null,type,'common'));save();render();return}case 'attEquip':attEquip(type,id,qty);return;case 'attRemove':attRemove(type,id);return;case 'pmcCharacter':if(PMC_CHARACTER_OPTIONS.some(c=>c.id===type)){pmcAppearance=type;try{localStorage.setItem('tokyov_pmc_character',type)}catch(e){}render()}return;case 'pmcSaveName':{const field=document.getElementById('pmc-name-input');if(field){pmcName=field.value.trim().slice(0,24);try{localStorage.setItem('tokyov_pmc_name',pmcName)}catch(e){}render()}return;}case 'v3gearSlot':if(['weapon','secondary','melee','helmet','armor','bag','accessory','grenade','carry'].includes(type)){v3SelectedGearSlot=type;detailId=null;render()}return;case 'v3sub':if((type==='warehouse'&&id==='temporary')||V3_SECTIONS[type]?.some(([k])=>k===id)){v3Section[type]=id;if(type==='warehouse'&&id==='gear')tokMarkWarehouseGearSeen();render();}return;case 'v3prepare':tab='base';document.querySelector('#app details')?.setAttribute('open','');document.querySelector('#app details')?.scrollIntoView({behavior:'smooth'});return;case 'storageExpand':storageExpand();return;case 'containerMoveAll':containerMoveAll();return;case 'containerMove':containerMove(type,id,Number(qty));return;case 'containerSell':containerSell(type,id,Number(qty));return;case 'secretKeyToggle':secretKeyToggle(type);return;case 'longEmergency':longEmergencyRequest();return;case 'longReportOpen':tab='longReport';render();return;case 'longEmergencyConfirm':longEmergencyExit();return;case 'longEmergencyCancel':longEmergencyCancel();return;case 'longStart':longStart(Number(type));return;case 'longBuy':longBuy(type,Number(id));return;case 'longMove':longMove(type,id,Number(qty));return;case 'longSell':longSell(type,id,Number(qty));return;case 'longBulk':longBulk(type);return;case 'pmcPane':if(['status','equipment','warehouse'].includes(type)){pmcPane=type;tab='stash';render()}return;case 'reportOpen':tab='report';render();return;case 'resultWarehouse':g.reportPending=false;save();tab='warehouse';v3Section.warehouse='temporary';render();return;case 'resultLog':{const d=document.querySelector('.tok-raid-result details');if(d){d.open=true;d.scrollIntoView({behavior:'smooth',block:'start'})}return;}case 'longReportClose':if(g.longRun)g.longRun.reportSeen=true;save();tab='base';render();return;case 'longReportLoot':if(g.longRun)g.longRun.reportSeen=true;save();tab='warehouse';render();return;case 'returnBase':g.reportPending=false;save();tab='base';render();return;case 'raidHistory':raidPane='history';tab='raid';render();return;case 'raidCurrent':raidPane='current';tab='raid';render();return;case 'gearDetail':markGearRead(type);detailId=detailId===type?null:type;compareId=null;render();return;case 'bulkSelect':selectedBulk=new Set(g.gear.filter(unreadyGear).map(x=>x.id));render();return;case 'bulkClear':selectedBulk.clear();render();return;case 'bulkSell':sellBulk();return;case 'historyId':{const h=g.history.find(y=>String(y.id)===type);if(!h)return;historyDetailId=h.id;raidPane='history';tab='raid';render();document.getElementById('history-detail')?.scrollIntoView({block:'start'});return}case 'historyClose':historyDetailId=null;render();return;case 'marketSubtab':{if(type==='normal'||type==='barter'){tokMarketSubtab=type;render();}return;}case 'invest':tokInvestigationAction(type+(id?':'+id:''));return;case 'barter':{const [group,index]=type.split(':');barterExecute(group,Number(index));return;}case 'marketBuy':marketBuy(Number(type));return;case 'marketSell':marketSell(decodeURIComponent(type));return;case 'tab':{
  if(type==='shop')type='weaponShop';
  if(g.reportPending && g.status==='base' && type==='base'){tab='report';render();return;}
  // Keep the bottom navigation DOM intact; release the clicked button focus
  // before replacing the main content to avoid iOS Safari focus scrolling.
  if(document.activeElement instanceof HTMLElement)document.activeElement.blur();
  tab=type;
  if(type==='warehouse'&&(v3Section.warehouse||V3_DEFAULT.warehouse)==='gear')tokMarkWarehouseGearSeen();
  (window.tokScrollSurface||window).scrollTo({top:0,left:0,behavior:'instant'});
  render();
  (window.tokScrollSurface||window).scrollTo({top:0,left:0,behavior:'instant'});
  return;
}case 'bossSelect':if(BOSSES[type]||type==='pursuer'){selectedBoss=type;render()}return;case 'bossPrepare':if(BOSSES[type]&&g.unlocked[type]&&g.status==='base'){g.settings.map=type;g.settings.raidType=bossKnown(type)?'boss':'normal';save();tab='base';render()}return;case 'start':startRaid();return;case 'gearEquip':{const x=findGear(type);if(x)equip(x.type,x.id);return}case 'equipSecondary':equip('secondary',type);return;case 'equipMelee':equip('melee',type);return;case 'unequipSlot':{if(g.status!=='base'||!['helmet','armor','bag','weapon','secondary','melee','accessory'].includes(type)||!g.eqIds[type])return;if(type==='accessory')g.hp=Math.max(0,g.hp-tokAccessoryValue(equippedGear('accessory'),'maxhp'));g.eqIds[type]=null;reconcileEquipment();save();render();return;}case 'unequipSecondary':if(g.status==='base'){g.eqIds.secondary=null;save();render()}return;case 'unequipMelee':if(g.status==='base'){g.eqIds.melee=null;save();render()}return;case 'toggleGearAttachments':{const x=findGear(type);if(x&&g.eqIds[v3SelectedGearSlot]===x.id&&x.type==='weapon'){tokAttachmentOpenFor=tokAttachmentOpenFor===x.id?null:x.id;render()}return;}case 'gearCompare':gearCompare(type);return;case 'gearFavorite':{const x=findGear(type);if(x&&g.status==='base'){x.favorite=!x.favorite;save();render()}return}case 'gearSell':gearSell(type);return;case 'supplyEquippedAmmo':supplyEquippedAmmo();return;case 'repairEquippedAll':repairEquippedAll();return;case 'gearRepair':repair(type);return;case 'completeRepair':completeRepair(type);return;case 'grenadeSlot':tokGrenadeSlotChange(Number(type),id);return;case 'carry':setCarry(type,Number(id));return;case 'ammoCarry':setAmmoCarry(type,id);return;case 'gearUnequipArmor':equip('armor','none');return;case 'refresh':advance();render();return;case 'buyShopAccessory':buyShopAccessory(type);return;case 'buy':buy(type,id,Number(qty));return;case 'supplySell':sellWarehouseSupply(type,Number(id));return;case 'sell':sell(type,id,Number(qty));return;case 'equip':equip(type==='weapons'?'weapon':type==='armors'?'armor':type==='bags'?'bag':type,id);return;case 'repair':repair();return;case 'heal':instantHeal();return;case 'treat':treatStatus(type);return;case 'longHealMode':if(type==='economy'||type==='efficient'){longHealMode=type;render()}return;case 'history':{const index=Number(type),h=g.history[index];if(!h)return;const html=`${h.log.map(x=>escapeHTML(x)).join('\n')}`;alert(`${h.win?'生還':'敗北'} #${h.id}\n${html}`);return}case 'export':downloadBackup();return;case 'shareBackup':shareBackup();return;case 'textBackup':backupText();return;case 'copyBackup':copyBackup();return;case 'restoreTextBackup':restoreTextBackup();return;case 'applyRestore':applyRestore();return;case 'cancelRestore':cancelRestore();return;case 'closeBackupText':{const el=document.getElementById('backup-text-panel');if(el)el.style.display='none';return}case 'import':{const picker=document.getElementById('importfile');if(picker){picker.value='';picker.click()}return;}case 'manualsave':if(save()){tokSaveQueue.then(()=>{g.notice=tokPersistentWarning||'保存状態をバックアップ画面で確認できます';render()})}else{g.notice='保存できません';render()}return;case 'reset':tokShowResetDialog();return;case 'resetCancel':tokHideResetDialog();return;case 'resetNext':tokResetNext();return;case 'resetExecute':tokResetExecute();return}}

// In-page confirmation instead of window.confirm: some iOS Documents WebViews suppress native dialogs.
let tokResetBusy=false;
function tokHideResetDialog(){const el=document.getElementById('tok-reset-dialog');if(el)el.remove()}
function tokResetDialogHtml(stage){
 const second=stage===2;
 return `<div id="tok-reset-dialog" role="dialog" aria-modal="true" aria-label="ゲーム初期化の確認" style="position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:2147483647;display:flex;align-items:center;justify-content:center;padding:16px;box-sizing:border-box">
 <div style="background:#252c34;color:#fff;border:2px solid #d27b6c;border-radius:12px;max-width:440px;width:100%;padding:20px;box-sizing:border-box">
 <h2 style="margin-top:0">${second?'最終確認（2/2）':'最初からプレイする（1/2）'}</h2>
 <p>${second?'レベル・資金・装備・倉庫・討伐記録など、現在のゲーム進行を初期化します。元には戻せません。':'現在のセーブデータを初期状態に戻します。必要な場合は、先に設定画面からバックアップを保存してください。'}</p>
 <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px">
 <button type="button" data-action="resetCancel" style="flex:1;min-width:100px;padding:14px">キャンセル</button>
 <button type="button" data-action="${second?'resetExecute':'resetNext'}" style="flex:1;min-width:130px;padding:14px;background:#9c3028;color:white;border:1px solid #e69b8b">${second?'初期化を実行する':'次へ進む'}</button>
 </div><p id="tok-reset-status" style="font-size:12px"></p></div></div>`;
}
function tokShowResetDialog(){if(tokResetBusy)return;tokHideResetDialog();document.body.insertAdjacentHTML('beforeend',tokResetDialogHtml(1))}
function tokResetNext(){tokHideResetDialog();document.body.insertAdjacentHTML('beforeend',tokResetDialogHtml(2))}
async function tokResetExecute(){
 if(tokResetBusy)return;tokResetBusy=true;tokResetting=true;
 const status=document.getElementById('tok-reset-status');if(status)status.textContent='初期化データを保存しています…';
 try{await tokSaveQueue.catch(()=>{});const fresh=ensureBossState(initial());fresh.revision=Math.max(tokMaxRevision+1,tokRevision(g)+1,Date.now());fresh.savedAt=Date.now();const payload=JSON.stringify(fresh);tokLatestPayload=payload;if(!await tokWriteAll(payload))throw Error('保存先に書き込めませんでした。');tokWrittenPayload=payload;g=fresh;tokMaxRevision=fresh.revision;window.__tokyovSaveReadError=false;tokBootPending=false;tab='base';tokHideResetDialog();render();tokOpenPrologue(true)}catch(e){if(status)status.textContent='初期化できませんでした：'+e.message}finally{tokResetBusy=false;tokResetting=false}
}
// Direct raid launch: avoids delegated click handlers silently swallowing launch taps.
window.tokRaidLaunchDirect=function(event){
 event.preventDefault();event.stopPropagation();
 try{
  if(typeof startRaid!=='function')throw new Error('出撃処理が読み込まれていません');
  startRaid();
 }catch(err){
  console.error('Raid launch error',err);
  alert('出撃処理エラー：'+(err&&err.message?err.message:String(err))+'\nセーブデータは削除しないでください。');
 }
};
document.addEventListener('click',e=>{const t=e.target.closest('[data-raid-setup]');if(t){raidSetupTab=t.dataset.raidSetup;tokRenderKeepRaidPosition();return;}});/* v3.4.27 iOS native button focus-scroll isolation experiment.
   Handle touch-derived pointerup directly, cancel pointer default actions, and
   swallow the synthetic click so the old delegated handler cannot run twice.
   Keyboard / assistive-technology clicks continue through the original handler. */
let tokNavPointerHandledAt=-1;
let tokNavPointerHandledTarget=null;
function tokNavButtonForEvent(e){
  const target=e.target instanceof Element?e.target:null;
  const btn=target?.closest('#tabs [role="button"][data-action^="tab:"]');
  return btn&&!btn.disabled?btn:null;
}
document.addEventListener('pointerdown',e=>{
  const btn=tokNavButtonForEvent(e);
  if(!btn||e.pointerType!=='touch')return;
  if(e.cancelable)e.preventDefault();
},true);
document.addEventListener('pointerup',e=>{
  const btn=tokNavButtonForEvent(e);
  if(!btn||e.pointerType!=='touch')return;
  if(e.cancelable)e.preventDefault();
  e.stopImmediatePropagation();
  tokNavPointerHandledAt=performance.now();
  tokNavPointerHandledTarget=btn;
  try{handleAction(btn.dataset.action)}catch(err){
    console.error('Tokyov nav pointer action failed:',btn.dataset.action,err);
    alert('操作中にエラーが発生しました：'+(err?.message||String(err))+'\nセーブデータは初期化しないでください。');
  }
},true);
document.addEventListener('click',e=>{
  const btn=tokNavButtonForEvent(e);
  if(btn && btn===tokNavPointerHandledTarget && performance.now()-tokNavPointerHandledAt<1100){
    if(e.cancelable)e.preventDefault();
    e.stopImmediatePropagation();
  }
},true);
document.addEventListener('keydown',e=>{
  const btn=tokNavButtonForEvent(e);
  if(!btn || (e.key!=='Enter' && e.key!==' '))return;
  e.preventDefault();
  handleAction(btn.dataset.action);
},true);
document.addEventListener('click',e=>{const btn=e.target.closest('[data-action]');if(btn&&!btn.disabled){try{handleAction(btn.dataset.action)}catch(err){console.error('Tokyov action failed:',btn.dataset.action,err);alert('操作中にエラーが発生しました：'+(err?.message||String(err))+'\\nセーブデータは初期化しないでください。')}}});document.addEventListener('change',async e=>{if(e.target.dataset.pmcStyle!==undefined){if(g.status==='base'&&TOK_PMC_STYLES[e.target.value]){g.pmcStyle=e.target.value;save()}render();return}if(e.target.dataset.gearSort!==undefined){v3GearSort=e.target.value;render();return}if(e.target.dataset.bulkId){if(e.target.checked)selectedBulk.add(e.target.dataset.bulkId);else selectedBulk.delete(e.target.dataset.bulkId);render();return}if(e.target.dataset.ui){const val=e.target.value;if(e.target.dataset.ui==='stashFilter')stashFilter=val;if(e.target.dataset.ui==='stashSort')stashSort=val;if(e.target.dataset.ui==='historyFilter')historyFilter=val;render();return}if(e.target.dataset.grenadeSlot!==undefined){tokGrenadeSlotChange(Number(e.target.dataset.grenadeSlot),e.target.value);return}if(e.target.dataset.setting){changeSetting(e.target.dataset.setting,e.target.value);return}if(e.target.dataset.gearSetting){if(g.status==='base'){g.settingsGear[e.target.dataset.gearSetting]=e.target.value;save();render()}return}if(e.target.id==='importfile'&&e.target.files?.[0]){try{const f=e.target.files[0];const x=JSON.parse(await f.text());restoreBackupObject(x)}catch(err){alert('バックアップの読み込みに失敗しました：'+err.message)}}});
window.addEventListener('focus',()=>{if(tokBootPending||window.__tokyovSaveReadError)return;advance();if(!document.getElementById('importfile')?.files?.length)render()});document.addEventListener('visibilitychange',()=>{if(!document.hidden){if(!tokBootPending&&!window.__tokyovSaveReadError){advance();render();tokPersistRequest()}}else save()});window.addEventListener('pagehide',save);tokBoot();
// iOS Safari: never replace focused select controls during periodic updates.
function refreshStatsOnly(){
 const cells=document.querySelectorAll('#stats .stat');
 if(cells.length!==4)return;
 const xpNext=g.level<LEVEL_CAP?xpThreshold(g.level+1):null;
 cells[0].querySelector('b').textContent=fmt(g.money)+'₽';
 cells[1].querySelector('b').textContent=g.hp+'/'+baseMaxHp();
 cells[2].querySelector('b').textContent='Lv.'+g.level;
 const xpLabel=cells[2].querySelectorAll('span')[1];
 if(xpLabel)xpLabel.textContent=fmt(g.xp)+' XP'+(xpNext?' / 次 '+fmt(xpNext):' / MAX');
 cells[3].querySelector('b').textContent=g.stats.wins+' / '+g.stats.raids;
}
// v3.5.16: avoid rebuilding the entire image-heavy raid screen every second.
// Rebuild only when the 30-second simulation step, phase, or status changes.
let tokLastRaidPaintSecond=-1;
function tokRaidHeartbeat(){
 if(tokBootPending||!g||window.__tokyovSaveReadError)return;
 try{
  const previousStatus=g.status;
  const previousRaid=g.raid;
  const previousProcessed=previousRaid?.processed;
  const previousPhase=previousRaid?.phase;
  const previousProgress=previousRaid?.progress;
  const previousLongCompleted=g.longRun?.completed;
  advance();
  const onProgressScreen=tab==='base'||tab==='raid'||tab==='long';
  const changed=g.status!==previousStatus||g.raid!==previousRaid||
    g.raid?.processed!==previousProcessed||g.raid?.phase!==previousPhase||
    g.raid?.progress!==previousProgress||g.longRun?.completed!==previousLongCompleted;
  if(onProgressScreen){
   if(changed){render();tokLastRaidPaintSecond=-1;}
   else if(g.status==='raid'&&g.raid){
    // Update only elapsed-time text; preserve large scene images and scroll position.
    const seconds=Math.max(0,Math.min(1020,Math.floor((Date.now()-g.raid.startedAt)/1000)));
    if(seconds!==tokLastRaidPaintSecond){
     const hero=document.querySelector('#app .raid-pane + .hero, #app .hero');
     const elapsedLine=hero?.querySelector('p');
     if(elapsedLine){
      const current=elapsedLine.textContent;
      elapsedLine.textContent=current.replace(/経過\s*\d+分\d+秒/,`経過 ${Math.floor(seconds/60)}分${String(seconds%60).padStart(2,'0')}秒`);
     }
     tokLastRaidPaintSecond=seconds;
    }
   }else if(g.status==='base')refreshStatsOnly();
  }else if(g.status==='base'||g.status==='raid')refreshStatsOnly();
 }catch(err){console.error('Raid automatic progress failed',err);}
}
/* Escape from Tokyov 3.5.60 — 7th Independent Combat Group */
const TOK_MIL_MAP_IMAGE='data:image/jpeg;base64,';
const TOK_MIL_FACTION='第零七独立戦闘群';
const TOK_MIL_FACTION_SHORT='第7戦闘群';
const TOK_MIL_FACTION_EN='7th Independent Combat Group (7th ICG)';
const TOK_MIL_ENEMY_NAMES={scav:'一般歩兵',raider:'機動歩兵',elite:'特殊作戦隊員'};
const TOK_MIL_FACTION_LORE='かつて首都圏防衛を担っていた正規軍の混成戦闘部隊。東京の秩序崩壊に伴い上級司令部の命令を拒否し、軍事施設を占拠した。現在は施設司令官を頂点に独自の指揮系統と軍紀を維持し、外部からの侵入者を敵性勢力として排除している。所属兵士は旧軍の階級章と部隊章を使用し、自分たちこそ正統な軍の後継者だと主張している。';
/* Escape from Tokyov 3.5.58 — military facility extension */
const TOK_MIL_FLOORS=[
 ['正門警備所','警備兵長',70,14,15,55,10,15,'pm',[90,5,5]],
 ['外周監視塔','哨戒隊長',80,16,20,62,18,20,'pp19',[85,10,5]],
 ['兵舎','分隊長',95,19,30,68,15,25,'aks',[75,20,5]],
 ['補給倉庫','補給部隊長',105,21,40,70,12,30,'sks',[65,25,10]],
 ['射撃訓練場','鬼教官',120,24,50,82,20,40,'m4a1',[55,30,15]],
 ['武器保管庫','重装警備兵',125,23,85,68,5,45,'rpk74',[45,35,20]],
 ['通信管制室','通信士官',115,27,45,85,25,50,'mp5',[35,40,25]],
 ['特殊作戦区画','特殊部隊長',135,29,65,82,30,60,'m4a1',[25,40,35]],
 ['地下防衛区画','親衛隊長',150,30,90,88,20,65,'scarh',[20,40,40]],
 ['中央司令室','施設司令官',175,33,100,90,25,70,'aug',[15,40,45]]
];
const TOK_MIL_GEAR={
 mil_drill_helmet:['helmet','教官の戦闘ヘルメット',{def:30,max:70,price:55000}],
 mil_drill_armor:['armor','教官の戦闘装甲',{def:45,max:100,price:95000,repair:150}],
 mil_drill_bag:['bag','教官の戦術バッグ',{kg:35,max:80,price:65000}],
 mil_command_helmet:['helmet','司令官の重装ヘルメット',{def:55,max:110,price:110000}],
 mil_command_armor:['armor','司令官の重装甲',{def:75,max:150,price:180000,repair:250}],
 mil_command_bag:['bag','司令官の軍用バッグ',{kg:45,max:120,price:120000}]
};
for(const [id,[type,name,stats]] of Object.entries(TOK_MIL_GEAR))Object.assign(GEARTYPE[type],{[id]:{n:name,...stats,militaryUnique:true}});
const tokMilOldBossOnly=isBossOnlyGear;
isBossOnlyGear=function(type,id){return id?.startsWith('mil_drill_')||id?.startsWith('mil_command_')||tokMilOldBossOnly(type,id)};
function tokMilState(){if(!g.military||typeof g.military!=='object')g.military={};const m=g.military;m.cleared=Array.isArray(m.cleared)?m.cleared.filter(n=>Number.isInteger(n)&&n>=1&&n<=10):[];m.floor=Math.max(1,Math.min(10,Math.floor(Number(m.floor)||1)));if(!['normal','long','military'].includes(m.mode))m.mode='normal';m.kills=m.kills||{};return m}
function tokMilSetCount(r,series){const eq=r?r.equipment:Object.fromEntries(['armor','helmet','bag'].map(t=>[t,equippedGear(t)]));return ['armor','helmet','bag'].filter(t=>eq?.[t]?.base?.startsWith(series)&&(t==='bag'||!r||(t==='armor'?r.dur>0:r.helmetDur>0))).length}
const tokMilOldBonuses=tokSetBonuses;
tokSetBonuses=function(r){const b=tokMilOldBonuses(r),drill=tokMilSetCount(r,'mil_drill_'),command=tokMilSetCount(r,'mil_command_');return {...b,militaryReturn:drill>=3?2:drill>=2?1:0,militaryEscape:command>=3?10:command>=2?5:0,militaryDrill:drill,militaryCommand:command}}
const tokMilOldSetPanel=tokSetPanel;
tokSetPanel=function(r){const b=tokSetBonuses(r);return tokMilOldSetPanel(r)+(b.militaryDrill>=2?`<section class="panel"><b>鬼教官セット ${b.militaryDrill}/3</b><p>帰還ターン −${b.militaryReturn}</p></section>`:'')+(b.militaryCommand>=2?`<section class="panel"><b>司令官セット ${b.militaryCommand}/3</b><p>離脱 ＋${b.militaryEscape}pt</p></section>`:'')};
const tokMilOldExtraction=startExtraction;
startExtraction=function(r,why){const before=r.phase;tokMilOldExtraction(r,why);if(before!=='extract'&&r.phase==='extract'){const reduction=tokSetBonuses(r).militaryReturn||0;if(reduction){r.required=Math.max(1,r.required-reduction);log(r,`【鬼教官セット】帰還に必要なイベント −${reduction}（残り${r.required}）`)}}};
const tokMilOldEscape=escapeCombat;
escapeCombat=function(r,e){const bonus=tokSetBonuses(r).militaryEscape||0;return tokMilOldEscape(r,bonus?{...e,pursuit:(e.pursuit||0)-bonus}:e)};
function tokMilEquipmentDrop(r,floor){const prefix=floor===5?'mil_drill_':'mil_command_';const pool=Object.entries(TOK_MIL_GEAR).filter(([id])=>id.startsWith(prefix));const [id,[type]]=pool[Math.floor(rand(r)*pool.length)];const item=makeGear(r,type,id,'boss');item.affixes=[];item.dur=GEARTYPE[type][id].max;item.sourceBoss='military-'+floor;return item}
function tokMilBossBattle(r){tokPrepareEncounterReload(r);const floor=r.militaryFloor,info=TOK_MIL_FLOORS[floor-1];const [place,name,hp,d,def,hit,ev,pen,weapon]=info;const rarityRoll=rand(r),rarity=rarityRoll<.70?'rare':rarityRoll<.95?'epic':'legendary';const rarityPower={rare:0,epic:2,legendary:4}[rarity];const e={n:name,kind:'boss',hp,maxHp:hp,def,d:d+rarityPower,hit:hit+rarityPower,ev,pen:pen+rarityPower,pursuit:15,enemyWeapon:W[weapon]?weapon:({pm:'pm',pp19:'pp19',aks74u:'aks',m4:'m4a1',rpk:'rpk74',scar:'scarh'}[weapon]||weapon),actions:0,magActions:0,flashTurns:0};r.militaryBossRarity=rarity;r.bossEncountered=true;log(r,`【軍事施設 ${floor}F 中ボス】${name} HP${hp}／武器${W[e.enemyWeapon]?.n||weapon} [${RN[rarity]}]`);
 const maxRounds=12;
 for(let turn=1;turn<=maxRounds;turn++){
  if(!hasCombatWeapon(r))break;
  turnCare(r);if(r.hp<=0)return 'dead';
  let attack={...e};
  if(floor===2&&turn%3===0)attack.ev+=10;
  if(floor===6&&turn%3===0)attack.def=Math.floor(attack.def*1.25);
  if(floor===7&&turn%3===0)r.perfumeAccuracyDebuff=Math.max(r.perfumeAccuracyDebuff||0,1);
  if(floor===10&&turn%3===0){attack.hit+=10;attack.pen+=10}
  if((floor===9||floor===10)&&e.hp<=hp*.5){attack.d=Math.floor(attack.d*(floor===10?1.20:1.15));attack.hit+=floor===9?5:0;attack.ev+=floor===10?10:0}
  const thrown=throwGrenade(r,[e],'boss');if(!thrown)e.hp-=playerAttack(r,attack,e.hp);
  if(e.hp<=0){r.kills++;r.xp+=45+floor*12;r.militaryBossWon=true;log(r,`【階層制覇】${name}を撃破！ ${floor}Fクリア・自動帰還`);return 'won'}
  if(floor===4&&e.hp<=hp*.5&&!e.healed){e.hp=Math.min(hp,e.hp+20);e.healed=true;log(r,'【応急処置】HP+20')}
  if(floor===3&&turn%3===0)attack.d=Math.floor(attack.d*1.15);
  if(floor===5&&turn%3===0){attack.hit+=10;attack.d=Math.floor(attack.d*1.15)}
  if(floor===8&&turn%3===0){attack.hit+=8;log(r,'【集中連射】命中低下を軽減')}
  enemyStrike(r,{...attack,_weaponState:e});e.actions++;if(r.hp<=0)return 'dead';
  if(!hasCombatWeapon(r)||r.hp<=Math.max(8,Math.floor((r.maxHp||baseMaxHp())*.2)))break;
 }
 log(r,`【中ボス未撃破】${name}から撤退を試みる`);
 const result=escapeCombat(r,e);
 return result==='dead'||result==='final'?'dead':'escaped';
}
// Military encounters keep the existing SCAV/RAIDER/ELITE stats and loot tables,
 // but their visible combatant names reflect the occupying regular-army detachment.
const tokMilOldBattle=battle;
battle=function(r,eid){
 if(!r?.militaryFloor)return tokMilOldBattle(r,eid);
 const original=drawNormalProfile;
 try{
  drawNormalProfile=function(...args){
   const profile=original(...args);
   return {...profile,n:TOK_MIL_ENEMY_NAMES[eid]||profile.n};
  };
  return tokMilOldBattle(r,eid);
 }finally{drawNormalProfile=original}
};
const tokMilOldDraw=drawEnemy;
drawEnemy=function(r){if(!r?.militaryFloor)return tokMilOldDraw(r);const weights=TOK_MIL_FLOORS[r.militaryFloor-1][9];const n=rand(r)*100;return n<weights[0]?'scav':n<weights[0]+weights[1]?'raider':'elite'};
const tokMilOldExplorePlan=explorePlan;
explorePlan=function(r){return r?.militaryFloor?{mode:'normal',target:30,limit:30}:tokMilOldExplorePlan(r)};
const tokMilOldThreshold=threshold;
threshold=function(r){if(r?.militaryFloor)return r.explore>=30?'軍事施設・探索30回完了':null;return tokMilOldThreshold(r)};
// Military facility does not award general saleable loot. Other reward inventories remain intact.
function tokMilExcludeGeneralLoot(r){
 if(!r?.militaryFloor)return;
 if(r.loot && typeof r.loot==='object'){
  for(const id of Object.keys(r.loot))delete r.loot[id];
 }
 r.lootAcquired=false;
}
const tokMilOldStep=stepRaid;
stepRaid=function(){const r=g.raid;if(!r?.militaryFloor)return tokMilOldStep();if(r.phase==='explore'&&r.explore>=19&&r.explore<30&&!r.militaryBossAttempted){if(roll(r,.20)){r.militaryBossAttempted=true;const result=tokMilBossBattle(r);if(result==='won'){finishRaid(true);return}if(result==='dead'){finishRaid(false);return}startExtraction(r,'中ボスから離脱');return}}
 const originalSpawn=BOSSES[r.map].spawn,originalRoaming=roamingEncounter,originalDrawLoot=drawLoot;
 try{
  BOSSES[r.map].spawn=0;
  roamingEncounter=function(){return null};
  drawLoot=function(){return null};
  tokMilOldStep();
 }finally{
  tokMilExcludeGeneralLoot(r);
  BOSSES[r.map].spawn=originalSpawn;
  roamingEncounter=originalRoaming;
  drawLoot=originalDrawLoot;
}
};
const tokMilOldFinish=finishRaidCore;
finishRaidCore=function(win){const r=g.raid;if(!r?.militaryFloor)return tokMilOldFinish(win);tokMilExcludeGeneralLoot(r);const floor=r.militaryFloor,success=win&&!!r.militaryBossWon,m=tokMilState();if(success){if(!m.cleared.includes(floor))m.cleared.push(floor);m.kills[floor]=(m.kills[floor]||0)+1;if(!r.exVersion&&(floor===5||floor===10)){if(m.kills[floor]===1||roll(r,.20)){const item=tokMilEquipmentDrop(r,floor);r.gearLoot.push(item);log(r,`【軍事施設固有防具】${gearName(item)}を獲得`)}else log(r,'【軍事施設固有防具】今回はドロップなし')}}
 tokMilOldFinish(win);if(g.history?.[0]?.id===r.id){g.history[0].militaryFloor=floor;g.history[0].militaryCleared=success;g.history[0].militaryBossRarity=r.militaryBossRarity;}
};
function tokMilFloorPanel(){const m=tokMilState(),floor=m.floor,info=TOK_MIL_FLOORS[floor-1],unlocked=floor===1||m.cleared.includes(floor-1)||m.cleared.includes(floor);return `<section class="panel tok-military-panel"><h2>軍事施設 — 階層攻略</h2><img class="tok-military-map-art" src="${TOK_MIL_MAP_IMAGE}" alt="軍事施設の正門・A-01" loading="lazy"><div class="item"><b>占拠勢力：${TOK_MIL_FACTION_SHORT}</b><p class="muted">${TOK_MIL_FACTION} ／ ${TOK_MIL_FACTION_EN}</p><p>${TOK_MIL_FACTION_LORE}</p><p><b>所属兵種：</b>一般歩兵（SCAV相当） ／ 機動歩兵（RAIDER相当） ／ 特殊作戦隊員（ELITE相当）</p></div><p class="muted">攻略状況 ${m.cleared.length}/10　／　各階層30探索固定</p><div class="raid-setup-tabs">${[['normal','通常'],['long','長期'],['military','軍事施設']].map(([id,n])=>`<button type="button" data-mil-mode="${id}" class="${m.mode===id?'active':''}">${n}</button>`).join('')}</div>${m.mode==='military'?`<div class="raid-choice-grid" style="display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px;margin:12px 0">${TOK_MIL_FLOORS.map((f,i)=>{const n=i+1,open=n===1||m.cleared.includes(n-1)||m.cleared.includes(n);return `<button type="button" data-mil-floor="${n}" class="${floor===n?'active':''}" style="padding:12px 3px;min-width:0">${m.cleared.includes(n)?'✓':open?'◆':'🔒'} ${n}F</button>`}).join('')}</div><div class="item"><b>${floor}F：${info[0]}</b><p>中ボス：${info[1]}</p><p>探索30回 ／ 20〜30回目に各20%で中ボス出現判定</p><p>${m.cleared.includes(floor)?'クリア済み・再挑戦可能':unlocked?'出撃可能':'未解放：前の階層の中ボス撃破が必要'}</p>${b('この階層に出撃','milStart','primary',!unlocked||g.status!=='base')}</div>`:'<p class="muted">通常・長期の出撃設定は従来の画面から行えます。</p>'}</section>`}
const tokMilOldBase=baseView;
baseView=function(){
 const root=document.createElement('div');
 root.innerHTML=tokMilOldBase();
 const setup=root.querySelector('.raid-setup');
 if(!setup)return root.innerHTML;
 const tabs=setup.querySelector('.tok-raid-mode-tabs');
 if(!tabs)return root.innerHTML;
 const m=tokMilState();
 const military=m.mode==='military';
 tabs.insertAdjacentHTML('beforeend',`<button type="button" data-action="tokRaidMode:military" class="${military?'active':''}">軍事施設</button>`);
 for(const btn of tabs.querySelectorAll('button:not([data-action="tokRaidMode:military"])'))btn.classList.toggle('active',!military&&btn.dataset.action==='tokRaidMode:'+tokRaidMode);
 if(military){
  for(const child of [...setup.children])if(child!==tabs&&child.tagName!=='H2')child.style.display='none';
  const floor=m.floor,info=TOK_MIL_FLOORS[floor-1],unlocked=floor===1||m.cleared.includes(floor-1)||m.cleared.includes(floor);
  const panel=document.createElement('div');panel.className='tok-military-launch';
  panel.innerHTML=`<p>軍事施設・出撃階層の選択</p><div class="tok-mil-floor-list">${TOK_MIL_FLOORS.map((f,i)=>{const n=i+1,open=n===1||m.cleared.includes(n-1)||m.cleared.includes(n);return `<button type="button" data-mil-floor="${n}" class="${floor===n?'selected':''}" ${open?'':'disabled'}>${m.cleared.includes(n)?'✓':open?'◆':'🔒'} ${n}F</button>`}).join('')}</div><div class="item"><b>${floor}F：${info[0]}</b><p>${m.cleared.includes(floor)?'クリア済み':unlocked?'出撃可能':'未解放'}</p>${b('軍事施設へ出撃','milStart','primary',!unlocked||g.status!=='base')}</div>`;
  setup.appendChild(panel);
 }
 return root.innerHTML;
};
const tokMilOldStart=startRaid;
startRaid=function(){const m=tokMilState();if(m.mode!=='military'||longBusy)return tokMilOldStart();const f=m.floor;if(f!==1&&!m.cleared.includes(f-1)&&!m.cleared.includes(f)){alert('前の階層を攻略してください');return}const savedType=g.settings.raidType;g.settings.raidType='normal';try{tokMilOldStart();if(g.status==='raid'&&g.raid&&!g.raid.longMode){g.raid.militaryFloor=f;g.raid.militaryBossAttempted=false;g.raid.militaryBossWon=false;g.raid.raidType='military';g.raid.settings.raidType='military';g.raid.log.push(`【軍事施設／${TOK_MIL_FACTION_SHORT}】${f}F ${TOK_MIL_FLOORS[f-1][0]}／探索30回固定`);save();render()}}finally{g.settings.raidType=savedType}};
const tokMilOldRaidView=raidView;
const tokMilOldExploreLocation=exploreLocation;
exploreLocation=function(r){
 if(r?.militaryFloor){
  const area=TOK_MIL_FLOORS[r.militaryFloor-1][0];
  return pick(r,[area+'・警戒通路',area+'・資材置場',area+'・警備区画',area+'・設備室']);
 }
 return tokMilOldExploreLocation(r);
};
raidView=function(){const r=g.raid;if(!r?.militaryFloor)return tokMilOldRaidView();{
 const floorInfo=TOK_MIL_FLOORS[r.militaryFloor-1];
 const oldHtml=tokMilOldRaidView();
 // The base raid view uses the selected normal-map ID as a compatibility proxy.
 // Never display that proxy map's art, name or exploration depth as military content.
 const host=document.createElement('div');host.innerHTML=oldHtml;
 const hero=host.querySelector('.hero');
 if(hero){
  const oldArt=hero.querySelector('img.raid-art');if(oldArt)oldArt.remove();
  const heading=hero.querySelector('strong');if(heading)heading.textContent='軍事施設・探索進行中';
  const paras=hero.querySelectorAll('p');
  if(paras[0])paras[0].textContent='第7戦闘群 占拠区域 ／ '+r.militaryFloor+'F '+floorInfo[0]+' ／ 経過 '+Math.floor(Math.max(0,(Date.now()-r.startedAt)/1000)/60)+'分';
  if(paras[1]&&r.phase==='explore')paras[1].textContent='探索フェーズ（探索 '+r.explore+'/30）';
  const scene=document.createElement('div');
  scene.className='tok-military-scene';
  scene.innerHTML='<img class="tok-military-map-art" src="'+TOK_MIL_MAP_IMAGE+'" alt="軍事施設の正門・A-01">'+'<div class="tok-military-scene-tag">7th ICG / RESTRICTED MILITARY AREA</div><div class="tok-military-scene-title">'+escapeHTML(floorInfo[0])+'</div><div class="tok-military-scene-sub">第零七独立戦闘群・占拠区画</div>';
  hero.insertBefore(scene,hero.firstChild);
 }
 return `<section class="panel"><h2>軍事施設 ${r.militaryFloor}F — ${floorInfo[0]}</h2><p class="muted">占拠勢力：${TOK_MIL_FACTION_SHORT} ／ 一般歩兵・機動歩兵・特殊作戦隊員</p><p>探索 ${r.explore}/30 ／ 中ボス：${floorInfo[1]} ／ 25〜30回目 各15%</p></section>`+host.innerHTML;
 }};
const tokMilOldReport=reportView;
reportView=function(){
 const h=g.history?.[0];
 if(!h?.militaryFloor)return tokMilOldReport();
 const floor=TOK_MIL_FLOORS[h.militaryFloor-1];
 const name=`軍事施設 ${h.militaryFloor}F — ${floor[0]}`;
 const oldMapName=MAP[h.map]?.n||h.map||'不明な地区';
 // The report is generated by the normal-raid renderer, whose map ID is only
 // an internal compatibility proxy. Replace it everywhere in the report.
 let html=tokMilOldReport();
 html=html.split(escapeHTML(String(oldMapName))).join(escapeHTML(name));
 html=html.split(String(oldMapName)).join(name);
 const host=document.createElement('div');host.innerHTML=html;
 const hero=host.querySelector('.tok-result-hero');
 if(hero){
  const display=hero.querySelectorAll('div');
  if(display.length)display[display.length-1].textContent=name;
 }
 const rows=host.querySelectorAll('.tok-result-stats > *');
 for(const row of rows){
  if(row.textContent.includes('探索地区')){
   const parts=row.querySelectorAll('*');
   if(parts.length)parts[parts.length-1].textContent=name;
  }
 }
 return `<section class="panel"><h2>${name}</h2><p>占拠勢力：${TOK_MIL_FACTION_SHORT}</p><p>${h.militaryCleared?'中ボス撃破・階層クリア！':'中ボス未撃破・再挑戦可能'}</p></section>`+host.innerHTML;
};
const tokMilOldRender=render;
render=function(){tokMilOldRender()};
document.addEventListener('click',function(ev){
 const btn=ev.target.closest('[data-action="tokRaidMode:military"]');
 if(!btn)return;
 ev.preventDefault();ev.stopImmediatePropagation();
 tokMilState().mode='military';save();render();
},true);
document.addEventListener('click',function(ev){
 const btn=ev.target.closest('[data-action="tokRaidMode:normal"],[data-action="tokRaidMode:long"]');
 if(!btn)return;
 tokMilState().mode=btn.dataset.action.endsWith(':long')?'long':'normal';
},true);
document.addEventListener('click',function(ev){const btn=ev.target.closest('[data-mil-mode],[data-mil-floor],[data-action="milStart"]');if(!btn)return;if(btn.dataset.milMode){ev.preventDefault();ev.stopPropagation();tokMilState().mode=btn.dataset.milMode;save();render()}else if(btn.dataset.milFloor){ev.preventDefault();ev.stopPropagation();tokMilState().floor=Number(btn.dataset.milFloor);save();render();if(tab==='intel')tokSelectMilitaryFacility()}else if(btn.dataset.action==='milStart'){ev.preventDefault();ev.stopPropagation();startRaid()}},true);


// PMC SERVICE RECORD v3.6.35: saved cumulative counters + capped lightweight raid entries.
let pmcRecordMode='all',pmcRecordTab='overview';
const PMC_MODES={normal:'通常レイド',long:'長期探索',military:'軍事施設'};
function pmcNewTotals(){return {sorties:0,wins:0,deaths:0,kills:0,xp:0,enemy:{scav:0,raider:0,elite:0,boss:0},weapons:{},armor:{},helmet:{},bag:{},deathCauses:{},districts:{},floors:{}}}
function pmcRecords(){if(!g.pmcRecords||typeof g.pmcRecords!=='object')g.pmcRecords={version:1,modes:{},recent:[]};const p=g.pmcRecords;p.modes=p.modes||{};for(const k of Object.keys(PMC_MODES))p.modes[k]=p.modes[k]||pmcNewTotals();p.recent=Array.isArray(p.recent)?p.recent:[];return p}
function pmcRaidMode(r){return r.militaryFloor||r.raidType==='military'?'military':r.longMode?'long':'normal'}
function pmcGearLabel(x){if(!x)return null;try{return gearName(x)}catch(e){return String(x.base||'不明')}}
function pmcInc(obj,key,n=1){if(!key)return;obj[key]=(Number(obj[key])||0)+n}
function pmcDeathCause(r){const lines=(r.log||[]).slice(-24).map(String);const joined=lines.join(' ');if(/毒|中毒/.test(joined)&&r.poisonTurns>0)return '毒';if(/出血/.test(joined)&&r.bleed)return '出血';if(/火傷|炎上/.test(joined)&&r.burnTurns>0)return '火傷';const hit=lines.reverse().find(x=>/攻撃|被弾|ダメージ|射撃|銃撃|撃たれ|爆発|自爆/.test(x));return hit?(hit.match(/(?:SCAV|RAIDER|ELITE|追跡者|教祖|ボス)/i)||[])[0]||'戦闘による死亡':'原因不明'}
function pmcRecordFinish(r,win){
 const p=pmcRecords(),mode=pmcRaidMode(r),t=p.modes[mode],eq=r.equipment||{},floor=mode==='military'?Number(r.militaryFloor)||0:0;
 const enemy={scav:0,raider:0,elite:0,boss:0,...(r.pmcEnemyKills||{})};
 // Boss eliminations are recorded independently of regular enemy eliminations.
 if(r.bossKilled||r.militaryBossWon||r.pursuerKilled)enemy.boss=Math.max(enemy.boss,1);
 const cause=win?'':pmcDeathCause(r);
 t.sorties++;if(win)t.wins++;else {t.deaths++;pmcInc(t.deathCauses,cause)}
 t.kills+=Number(r.kills)||0;t.xp+=Number(r.xp)||0;
 for(const key of Object.keys(t.enemy))t.enemy[key]+=Number(enemy[key])||0;
 for(const [field,slot] of [['weapons','weapon'],['armor','armor'],['helmet','helmet'],['bag','bag']])pmcInc(t[field],pmcGearLabel(eq[slot]));
 const district=String(r.map||'unknown');if(!t.districts[district])t.districts[district]={sorties:0,wins:0};t.districts[district].sorties++;if(win)t.districts[district].wins++;
 if(floor){const f=String(floor);if(!t.floors[f])t.floors[f]={sorties:0,wins:0};t.floors[f].sorties++;if(win)t.floors[f].wins++}
 p.recent.unshift({id:r.id,at:r.startedAt||Date.now(),mode,map:district,floor,win,rounds:r.processed||0,kills:r.kills||0,enemy,cause,weapon:pmcGearLabel(eq.weapon),armor:pmcGearLabel(eq.armor),helmet:pmcGearLabel(eq.helmet),bag:pmcGearLabel(eq.bag),xp:r.xp||0});
 p.recent.length=Math.min(200,p.recent.length);
}
const pmcOldNormalKillReward=normalKillReward;
normalKillReward=function(r,u,eid){r.pmcEnemyKills=r.pmcEnemyKills||{};let kind=String(u.kind||u.type||u.rank||u.tier||'').toLowerCase();if(!['scav','raider','elite'].includes(kind)){const n=String(u.n||'').toLowerCase();kind=/elite|エリート/.test(n)?'elite':/raider|レイダー/.test(n)?'raider':/scav|スカブ/.test(n)?'scav':'';}if(kind)pmcInc(r.pmcEnemyKills,kind);return pmcOldNormalKillReward(r,u,eid)};
const pmcOldFinishRaidCore=finishRaidCore;
finishRaidCore=function(win){const r=g.raid;if(!r)return pmcOldFinishRaidCore(win);const prev=g.pmcRecords?structuredCloneSafe(g.pmcRecords):null;try{pmcRecordFinish(r,win);return pmcOldFinishRaidCore(win)}catch(e){if(prev)g.pmcRecords=prev;else delete g.pmcRecords;throw e}};
function pmcRecordRows(t){return [['出撃回数',t.sorties+'回'],['生還回数',t.wins+'回'],['死亡回数',t.deaths+'回'],['生還率',t.sorties?Math.round(t.wins/t.sorties*100)+'%':'—'],['敵撃破数',t.kills+'体'],['獲得XP',fmt(t.xp)]]}
function pmcSumTotals(){const t=pmcNewTotals();for(const m of Object.values(pmcRecords().modes)){for(const k of ['sorties','wins','deaths','kills','xp'])t[k]+=Number(m[k])||0;for(const k of Object.keys(t.enemy))t.enemy[k]+=Number(m.enemy?.[k])||0;for(const k of ['weapons','armor','helmet','bag','deathCauses'])for(const [name,n] of Object.entries(m[k]||{}))pmcInc(t[k],name,n);for(const key of ['districts','floors'])for(const [id,d] of Object.entries(m[key]||{})){t[key][id]=t[key][id]||{sorties:0,wins:0};t[key][id].sorties+=d.sorties||0;t[key][id].wins+=d.wins||0}}return t}
function pmcRank(obj){const entries=Object.entries(obj||{}).sort((a,b)=>b[1]-a[1]).slice(0,10);return entries.length?entries.map(([name,n],i)=>`<div class="pmc-rank"><span>${i+1}. ${escapeHTML(name)}</span><b>${fmt(n)}回</b></div>`).join(''):'<p class="muted">まだ記録がありません。</p>'}
function pmcStatCards(rows){return `<div class="pmc-record-grid">${rows.map(([name,v])=>`<div class="pmc-record-stat"><small>${escapeHTML(name)}</small><strong>${escapeHTML(String(v))}</strong></div>`).join('')}</div>`}
function pmcRecordView(){
 const p=pmcRecords(),t=pmcRecordMode==='all'?pmcSumTotals():p.modes[pmcRecordMode];
 const tabs=[['overview','総合'],['gear','装備'],['kills','撃破'],['deaths','死亡原因'],['districts','地区・階層'],['history','履歴']];
 const nav=(items,selected,action)=>`<div class="pmc-record-nav">${items.map(([id,label])=>`<button type="button" class="${id===selected?'on':''}" data-action="${action}:${id}">${label}</button>`).join('')}</div>`;
 let detail='';
 if(pmcRecordTab==='overview')detail=pmcStatCards(pmcRecordRows(t))+`<h3>敵種別の撃破数</h3>`+pmcStatCards([['SCAV',t.enemy.scav],['RAIDER',t.enemy.raider],['ELITE',t.enemy.elite],['ボス',t.enemy.boss]]);
 if(pmcRecordTab==='gear')detail=[['武器','weapons'],['アーマー','armor'],['ヘルメット','helmet'],['バッグ','bag']].map(([name,key])=>`<h3>${name} 使用回数</h3>${pmcRank(t[key])}`).join('');
 if(pmcRecordTab==='kills')detail=pmcStatCards([['SCAV',t.enemy.scav],['RAIDER',t.enemy.raider],['ELITE',t.enemy.elite],['ボス',t.enemy.boss],['総撃破数',t.kills]]);
 if(pmcRecordTab==='deaths')detail=`<h3>死亡原因ランキング</h3>${pmcRank(t.deathCauses)}`;
 if(pmcRecordTab==='districts')detail=`<h3>地区別戦績</h3>${Object.entries(t.districts).sort((a,b)=>b[1].sorties-a[1].sorties).map(([id,v])=>`<div class="pmc-rank"><span>${escapeHTML(MAP[id]?.n||id)}</span><b>${v.sorties}回 / 生還${v.wins}回 (${Math.round(v.wins/v.sorties*100)}%)</b></div>`).join('')||'<p class="muted">記録なし</p>'}`+(pmcRecordMode==='military'||pmcRecordMode==='all'?`<h3>軍事施設・階層別</h3>${Object.entries(t.floors).sort((a,b)=>Number(a[0])-Number(b[0])).map(([f,v])=>`<div class="pmc-rank"><span>${f}F</span><b>出撃${v.sorties}回 / 生還${v.wins}回 (${Math.round(v.wins/v.sorties*100)}%)</b></div>`).join('')||'<p class="muted">記録なし</p>'}`:'');
 if(pmcRecordTab==='history'){const rows=p.recent.filter(x=>pmcRecordMode==='all'||x.mode===pmcRecordMode);detail=`<p class="muted">直近最大200レイドを保存（全モード合計）。</p>${rows.map(x=>`<details class="item"><summary>${x.win?'生還':'戦死'}｜${escapeHTML(PMC_MODES[x.mode]||x.mode)}｜${escapeHTML(MAP[x.map]?.n||x.map)}${x.floor?' '+x.floor+'F':''}｜${new Date(x.at).toLocaleString('ja-JP')}</summary><p>撃破 ${x.kills}体 / XP ${x.xp} / 死因 ${escapeHTML(x.cause||'—')}</p><p>武器：${escapeHTML(x.weapon||'なし')}<br>アーマー：${escapeHTML(x.armor||'なし')}<br>ヘルメット：${escapeHTML(x.helmet||'なし')}<br>バッグ：${escapeHTML(x.bag||'なし')}</p></details>`).join('')||'<p class="muted">詳細履歴は今後の出撃から蓄積されます。</p>'}`}
 const legacy=Number(g.stats?.raids)||0;
 return `<section class="panel pmc-record-screen"><h2>PMC戦績・レイド履歴</h2><p class="muted">情報室で記録する戦績。モードを切り替えて比較できます。</p>${nav([['all','全モード'],['normal','通常レイド'],['long','長期探索'],['military','軍事施設']],pmcRecordMode,'pmcMode')}${nav(tabs,pmcRecordTab,'pmcTab')}${detail}<p class="muted">※モード別・装備別などの詳細統計は本バージョン導入後のレイドから記録します。過去の出撃${fmt(legacy)}回分の詳細な内訳は復元できません。拠点の累計戦績は従来どおり保持されます。</p></section>`;
}
document.addEventListener('click',function(ev){const button=ev.target.closest('[data-action]');if(!button)return;const a=button.dataset.action||'';if(a.startsWith('pmcMode:')){ev.preventDefault();ev.stopImmediatePropagation();pmcRecordMode=a.slice(8);render()}else if(a.startsWith('pmcTab:')){ev.preventDefault();ev.stopImmediatePropagation();pmcRecordTab=a.slice(7);render()}},true);
V3_SECTIONS.intel.splice(3,0,['pmcRecord','PMC戦績']);
const pmcOldV3SectionView=v3SectionView;
v3SectionView=function(group){if(group==='intel'&&v3Section.intel==='pmcRecord'){const previous=v3Section.intel;v3Section.intel='history';try{const originalHistory=historyView();let html=pmcOldV3SectionView(group);html=html.replace(originalHistory,pmcRecordView());v3Section.intel=previous;const oldNav=v3Subnav('intel');v3Section.intel='history';const historyNav=v3Subnav('intel');return html.replace(historyNav,oldNav)}finally{v3Section.intel=previous}}return pmcOldV3SectionView(group)};

/* Escape from Tokyov v3.6.44 — Ex military facility 20F survival rework */
const EX_NAMES=['ハリネズミ','ドローン使い','両手斧使い','地雷＋グレネード','LMG二丁持ち','ハンドガン＋スモーク','軍事シェフ','パワーアーム整備兵','SMGの二人組','軍事教官','電磁砲実験兵','サイキック兵','時限タイマーつき高回避兵','遠距離固定SR','連携抜群の兄弟','極低温実験兵','ドーピング軍医','CQC特化兵','バトルスーツ','総司令官'];
// Reuse the existing enemy battle engine with temporary boss parameters until individual bosses are designed.
const EX_ZONES=['正門警備所','無人機管制区画','工兵倉庫','爆発物保管庫','火力防衛線','煙幕訓練区画','軍用厨房','機械整備区画','近接戦闘訓練場','教官指揮所','電磁兵器試験場','特殊研究区画','機動戦闘試験場','遠距離射撃区画','精鋭部隊駐屯地','低温実験室','軍医研究区画','近接制圧区画','強化装甲格納庫','中央司令室'];
TOK_MIL_FLOORS.splice(0,TOK_MIL_FLOORS.length,...EX_NAMES.map((name,i)=>{const f=i+1;return [EX_ZONES[i],name,65+f*12,13+f*2,12+f*5,55+Math.min(35,f*2),Math.min(35,8+f),15+f*3,['rpk74','mp5','aks','sks','rpk74','pm','knife','rpk74','mp5','m4a1','svd','aug','mp5','svd','scarh','aug','m4a1','mp5','rpk74','scarh'][i],[Math.max(10,90-f*4),Math.min(50,5+f*2),Math.min(50,5+f*2)]]}));
const EX_RANGES=[[5,10],[8,15],[10,20],[15,25]];
const EX_CHECKPOINTS=[1,5,10,15];
function exRange(f){return EX_RANGES[Math.min(3,Math.floor((f-1)/5))]}
function exUnlocked(m,f){return EX_CHECKPOINTS.includes(f)&&(f===1||m.cleared.includes(f))}
function exFloorName(f){return EX_NAMES[f-1]||'未登録'}
function exRunState(){const m=tokMilState();m.exRun=m.exRun||null;return m}
function exSaveItem(r,key){
 const m=exRunState();if(!r||!(r.militaryBossWon||r.exBossSkipped)||r.exSelected)return;
 if(key.startsWith('gear:')){const i=Number(key.slice(5)),item=r.gearLoot?.[i];if(!item||i<(r.exFloorGearStart||0))return;r.gearLoot.splice(i,1);item.newItem=true;item.acquiredAt=Date.now();g.gear.push(item);g.collection[item.base]=true;g.gearStats.returned++;log(r,'【安全転送】'+gearName(item)+'を倉庫へ転送');}
 else if(key.startsWith('loot:')){const id=key.slice(5);if(!L[id]||!(r.loot?.[id]>0)||r.loot[id]<=(r.exFloorLootStart?.[id]||0))return;r.loot[id]--;g.bank.loot[id]=(g.bank.loot[id]||0)+1;log(r,'【安全転送】'+L[id].n+'を倉庫へ転送');}
 else if(key!=='skip')return;
 r.exSelected=true;r.exBanked=key!=='skip';save();render();
}
function exBankChoices(r){const opts=[];for(let i=r.exFloorGearStart||0;i<(r.gearLoot||[]).length;i++)opts.push(['gear:'+i,gearName(r.gearLoot[i])]);for(const [id,n] of Object.entries(r.loot||{}))if(n>(r.exFloorLootStart?.[id]||0))opts.push(['loot:'+id,L[id]?.n||id]);return opts}
tokMilState=function(){if(!g.military||typeof g.military!=='object')g.military={};const m=g.military;if(!['normal','long','military'].includes(m.mode))m.mode='normal';m.cleared=Array.isArray(m.cleared)?m.cleared.filter(n=>Number.isInteger(n)&&n>=1&&n<=20):[];m.floor=Math.max(1,Math.min(20,Number(m.floor)||1));m.kills=m.kills||{};return m};
const exOriginalFloorPanel=tokMilFloorPanel;
tokMilFloorPanel=function(){const m=tokMilState();return `<section class="panel tok-military-panel"><h2>Ex軍事施設 — 20階層サバイバル</h2><img class="tok-military-map-art" src="${TOK_MIL_MAP_IMAGE}" alt="軍事施設"><p>攻略状況 ${m.cleared.length}/20階層 ／ ボスは各階層の最終戦に必ず出現</p><p class="muted">探索回数は非公開。階層ごとにランダム決定。5F・10F・15Fのボス撃破でチェックポイント恒久解放。</p><div class="raid-setup-tabs">${[['normal','通常'],['long','長期'],['military','軍事施設']].map(([id,n])=>`<button type="button" data-mil-mode="${id}" class="${m.mode===id?'active':''}">${n}</button>`).join('')}</div>${m.mode==='military'?exLaunchHtml(m):''}</section>`};
function exLaunchHtml(m){const f=m.floor;return `<div class="tok-mil-floor-list">${EX_NAMES.map((n,i)=>{const k=i+1,open=exUnlocked(m,k);return `<button type="button" data-mil-floor="${k}" class="${k===f?'selected':''}" ${open?'':'disabled'}>${m.cleared.includes(k)?'✓':open?'◆':'🔒'} ${k}F</button>`}).join('')}</div><div class="item"><b>${f}F：${exFloorName(f)}</b><p>${exUnlocked(m,f)?'出撃可能':'チェックポイント未解放'}</p><p>探索回数：非公開 ／ 最終戦：ボス確定</p>${b('軍事施設へ出撃','milStart','primary',!exUnlocked(m,f)||g.status!=='base'||!!m.exRun)}</div>${m.exRun?`<div class="item"><b>連続進軍中：${m.exRun.lastFloor}Fクリア</b><p>HP・弾薬・装備耐久・戦利品を引き継ぎます。</p>${m.exRun.lastFloor<20?`<button type="button" data-ex-action="advance">${m.exRun.lastFloor+1}Fへ進軍</button>`:''} <button type="button" data-ex-action="withdraw">撤退・戦利品を確保</button></div>`:''}`}
const exOldBaseView=baseView;
baseView=function(){const host=document.createElement('div');host.innerHTML=exOldBaseView();const setup=host.querySelector('.raid-setup');if(!setup)return host.innerHTML;const old=setup.querySelector('.tok-military-launch');if(old)old.remove();if(tokMilState().mode==='military'){const panel=document.createElement('div');panel.className='tok-military-launch';panel.innerHTML=exLaunchHtml(tokMilState());setup.appendChild(panel)}return host.innerHTML};
const exOldStart=startRaid;
startRaid=function(){const m=tokMilState();if(m.mode!=='military')return exOldStart();if(!exUnlocked(m,m.floor)&&!(m.exRun&&m.floor===m.exRun.lastFloor+1)){alert('チェックポイントが未解放です');return}const carrying=!!m.exRun;const carry=carrying?structuredCloneSafe(m.exRun):null;if(carry&&m.floor!==carry.lastFloor+1){alert('連続進軍先の階層を選択してください');return}const previousFloor=m.floor-1;const bypass=previousFloor>0&&!m.cleared.includes(previousFloor);if(bypass)m.cleared.push(previousFloor);const oldAmmoCarry=structuredCloneSafe(g.ammoCarry||{});
 if(carry){g.ammoCarry=g.ammoCarry||{};for(const [cal,n] of Object.entries(carry.ammoByCaliber||{})){g.bank.ammo[cal]=(g.bank.ammo[cal]||0)+n;g.ammoCarry[cal]=n;}}
 exOldStart();if(carry){for(const [cal,n] of Object.entries(carry.ammoByCaliber||{}))g.bank.ammo[cal]=Math.max(0,(g.bank.ammo[cal]||0)-Math.max(0,n-(g.raid?.ammoByCaliber?.[cal]||0)));g.ammoCarry=oldAmmoCarry;}
 if(bypass)m.cleared=m.cleared.filter(n=>n!==previousFloor);const r=g.raid;if(!r?.militaryFloor)return;const [lo,hi]=exRange(m.floor);r.exMaxAmmo=carry?.maxAmmo||r.initialAmmo||0;r.exTarget=lo+Math.floor(rand(r)*(hi-lo+1));r.exFloorLootStart=structuredCloneSafe(carry?.loot||{});r.exFloorGearStart=carry?.gearLoot?.length||0;r.exSelected=false;r.exBanked=false;r.militaryBossAttempted=false;r.militaryBossWon=false;r.exVersion=2;if(carry){r.hp=Math.min(r.maxHp||baseMaxHp(),carry.hp+Math.ceil((r.maxHp||baseMaxHp())*.20));r.bleed=!!carry.bleed;r.poisonTurns=carry.poisonTurns||0;r.armBroken=!!carry.armBroken;r.legBroken=!!carry.legBroken;r.burnTurns=carry.burnTurns||0;r.loot=carry.loot||{};r.gearLoot=carry.gearLoot||[];r.dur=carry.dur;r.helmetDur=carry.helmetDur;r.ammoByCaliber=carry.ammoByCaliber||{};
 const cal=W[r.weapon]?.ammo;const refill=Math.ceil((r.exMaxAmmo||0)*.25);if(cal){r.ammoByCaliber[cal]=Math.min(r.exMaxAmmo||9999,(r.ammoByCaliber[cal]||0)+refill)}r.ammo=cal?(r.ammoByCaliber[cal]||0):(carry.ammo||0);r.equipment=carry.equipment||r.equipment;r.supplies=carry.supplies||r.supplies;r.grenadeSlots=carry.grenadeSlots||r.grenadeSlots;m.exRun=null;}log(r,`【Ex軍事施設】${m.floor}F／探索目標非公開／最終戦ボス確定`);save();render()};
const exOldStep=stepRaid;
stepRaid=function(){const r=g.raid;if(!r?.exVersion)return exOldStep();if(r.exAwaitingChoice)return;
 if(r.phase!=='explore')r.phase='explore';
 if(r.explore>=r.exTarget){r.militaryBossAttempted=true;
  if(!roll(r,.50)){r.exBossSkipped=true;r.exAwaitingChoice=true;log(r,'【軍事施設】ボス非出現（50%抽選）。階層クリア。安全転送を選択してください');save();render();return}
  const result=tokMilBossBattle(r);if(result==='won'){r.exAwaitingChoice=true;log(r,'【階層制覇】安全転送する戦利品を選択してください');save();render();return}finishRaid(false);return}
 const floor=r.militaryFloor;const chance=Math.min(.40,.25+floor*.0075);if(roll(r,chance)){const result=battle(r,drawEnemy(r));if(result==='dead'){finishRaid(false);return}if(result==='escaped'){r.exBattleRetreated=true;log(r,'【敗走】敵からの離脱成功。装備を保持して軍事施設から撤退');finishRaid(true);return}if(result==='finalwon'){log(r,'【戦闘勝利】最終抵抗で敵を撃破。探索を継続');}}
 r.explore++;log(r,`【軍事施設】${floor}F・探索${r.explore}回目`);
 if(roll(r,.35)){const id=drawLoot(r);if(id&&L[id]&&bagLoad(r)+L[id].g<=bagCapacity(r)){r.loot[id]=(r.loot[id]||0)+1;log(r,`【戦利品】${L[id].n}`)}}
 if(roll(r,.12))gearRoll(r,.35,`軍事施設${floor}F`);
 outsideCare(r,'探索');if(r.hp<=0){finishRaid(false);return}save();
};
const exOldRaidView=raidView;
raidView=function(){const r=g.raid;if(!r?.exVersion)return exOldRaidView();const host=document.createElement('div');host.innerHTML=exOldRaidView();for(const p of host.querySelectorAll('p'))if(/探索\s*\d+\/30|探索30回|中ボス|25〜30回目/.test(p.textContent))p.textContent=`探索 ${r.explore}回完了 ／ 残り探索回数：非公開 ／ ボス遭遇率50％：${exFloorName(r.militaryFloor)}`;const choice=r.exAwaitingChoice?`<section class="panel"><h2>${r.militaryFloor}F 制覇 — 戦利品の安全転送</h2><p>この階層で獲得したアイテムを1個だけ選択できます。転送品は後の死亡でも失いません。</p>${!r.exSelected?`${exBankChoices(r).map(([id,n])=>`<button class="tok-ex-choice" type="button" data-ex-bank="${escapeHTML(id)}">${escapeHTML(n)}を転送</button>`).join('')||'<p>転送できる戦利品がありません。</p>'}<button type="button" data-ex-bank="skip">転送せずに進む</button>`:`<p>転送選択完了。</p><button type="button" data-ex-action="finishfloor">階層クリアを確定</button>`}</section>`:'';return `<section class="panel"><h2>Ex軍事施設 ${r.militaryFloor}F — ${exFloorName(r.militaryFloor)}</h2><p>探索 ${r.explore}回 ／ 目標回数：非公開</p><p>探索終了後：ボス遭遇率50％</p></section>${choice}${host.innerHTML}`};
const exOldFinish=finishRaidCore;
finishRaidCore=function(win){const r=g.raid;if(!r?.exVersion)return exOldFinish(win);const m=tokMilState(),floor=r.militaryFloor,success=!!win&&(!!r.militaryBossWon||!!r.exBossSkipped);
 if(success){const carry={lastFloor:floor,hp:r.hp,maxAmmo:r.exMaxAmmo||r.initialAmmo||0,ammo:r.ammo,ammoByCaliber:structuredCloneSafe(r.ammoByCaliber||{}),dur:r.dur,helmetDur:r.helmetDur,equipment:structuredCloneSafe(r.equipment),supplies:structuredCloneSafe(r.supplies||{}),grenadeSlots:structuredCloneSafe(r.grenadeSlots||[]),bleed:r.bleed,poisonTurns:r.poisonTurns,armBroken:r.armBroken,legBroken:r.legBroken,burnTurns:r.burnTurns,loot:structuredCloneSafe(r.loot||{}),gearLoot:structuredCloneSafe(r.gearLoot||[])};
  r.loot={};r.gearLoot=[];exOldFinish(true);
  if(r.exBossSkipped){if(!m.cleared.includes(floor))m.cleared.push(floor);if(g.history?.[0]?.id===r.id)g.history[0].militaryCleared=true;}
  if(floor===20){m.completed=true;g.notice='称号 Call of Duty を獲得！ 軍事施設20Fクリア';}
 for(const [cal,n] of Object.entries(carry.ammoByCaliber||{}))g.bank.ammo[cal]=Math.max(0,(g.bank.ammo[cal]||0)-n);
 m.exRun=carry;m.floor=Math.min(20,floor+1);if([5,10,15].includes(floor))m.cleared=[...new Set([...m.cleared,floor])];save();return;
 }
 if(r.exBattleRetreated){
  // A successful combat escape is a safe retreat, not a death or a floor clear.
  // Normal raid success settlement preserves worn equipment and surviving HP.
  // Unsecured exploration loot is forfeited; no floor-clear or boss reward.
  r.loot={};r.gearLoot=[];r.bossKilled=false;r.militaryBossWon=false;
  exOldFinish(true);
  const h=g.history?.[0];if(h?.id===r.id){h.safeRetreat=true;h.win=false;h.loot={};h.gearLoot=[];h.lootVal=0;h.gearValue=0;h.gearCount=0;h.lostEquipment=[];h.lostAmmo={};h.lostLoot={};}
  g.stats.wins=Math.max(0,(g.stats.wins||0)-1);
  g.stats.losses=(g.stats.losses||0)+1;
  g.notice='敗走：敵からの離脱に成功。装備は失われませんでした。';
  save();return;
 }
 m.exRun=null;return exOldFinish(false)
};
const exOldReport=reportView;
reportView=function(){const h=g.history?.[0],m=tokMilState();const html=exOldReport();if(!h?.militaryFloor||!h.militaryCleared||!m.exRun)return html;return `<section class="panel"><h2>${h.militaryFloor}F クリア — 次の行動</h2><p>倉庫転送済みの戦利品は安全です。連続進軍ではHP20%・弾薬25%を補給し、その他の消耗を引き継ぎます。</p>${h.militaryFloor<20?'<button type="button" data-ex-action="advance">次の階層へ進軍</button>':''} <button type="button" data-ex-action="withdraw">撤退して戦利品を持ち帰る</button></section>`+html};
function exWithdraw(){const m=tokMilState(),run=m.exRun;if(!run)return;for(const [id,n] of Object.entries(run.loot||{}))g.bank.loot[id]=(g.bank.loot[id]||0)+n;for(const item of run.gearLoot||[]){item.newItem=true;item.acquiredAt=Date.now();g.gear.push(item);g.collection[item.base]=true;g.gearStats.returned++}m.exRun=null;g.reportPending=false;g.notice='軍事施設から帰還しました。戦利品を倉庫へ収容しました。';tab='base';save();render()}
document.addEventListener('click',function(ev){const bank=ev.target.closest('[data-ex-bank]'),action=ev.target.closest('[data-ex-action]');if(!bank&&!action)return;ev.preventDefault();ev.stopImmediatePropagation();if(bank){exSaveItem(g.raid,bank.dataset.exBank);return}if(action.dataset.exAction==='finishfloor'){if(g.raid?.exSelected&&(g.raid.militaryBossWon||g.raid.exBossSkipped))finishRaid(true);return}if(action.dataset.exAction==='withdraw'){exWithdraw();return}if(action.dataset.exAction==='advance'){const m=tokMilState();if(!m.exRun)return;m.floor=Math.min(20,m.exRun.lastFloor+1);g.reportPending=false;g.status='base';tab='base';save();startRaid();}},true);

/* v3.6.88 — Military boss 50% and permanent titles. */
const tokMilOldTitlePanel=achievementBadgePanel;
achievementBadgePanel=function(){
 const html=tokMilOldTitlePanel();const m=tokMilState();
 const completed=!!m.completed||!!(g.history||[]).find(h=>Number(h.militaryFloor)===20&&h.militaryCleared);
 const count=Array.from({length:20},(_,i)=>i+1).filter(f=>Number(m.kills?.[f]||0)>0).length;
 if(completed&&!m.completed)m.completed=true;
 const titles=`<div class="item"><strong>${completed?'★':'🔒'} Call of Duty</strong> <span class="pill">${completed?'獲得済み':'未獲得'}</span><p class="muted">軍事施設20Fをクリアする（ボス非出現でも達成）。</p></div><div class="item"><strong>${count===20?'★':'🔒'} One Man Army</strong> <span class="pill">${count===20?'獲得済み':'未獲得'}</span><p class="muted">軍事施設の全20体のボスを累積で各1回以上撃破する（${count}/20）。</p></div>`;
 return html.replace('</section>',titles+'</section>');
};
ticker=setInterval(tokRaidHeartbeat,1000);
// iOS may suspend background timers. Resume all due steps immediately on return.
window.addEventListener('pageshow',tokRaidHeartbeat);

</script><style>
.tok-military-map-art{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin:10px 0 16px}.tok-military-scene .tok-military-map-art{margin:0 0 12px;border-radius:8px}
.tok-military-scene{box-sizing:border-box;min-height:170px;margin:0 0 20px;padding:22px 20px;border:1px solid #657b73;border-radius:13px;background:linear-gradient(125deg,#14201c,#25372e 55%,#111c1c);display:flex;flex-direction:column;justify-content:center;gap:10px;text-align:left;color:#e3e8de}
