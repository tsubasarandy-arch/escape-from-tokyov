#tokOpening .tokOpeningControls{gap:9px;bottom:max(5vh,calc(env(safe-area-inset-bottom) + 22px))}
#tokOpening .tokTitleBtn{display:block;width:min(390px,92%);padding:12px 18px;border:1px solid #8e987e;border-radius:8px;background:rgba(13,24,26,.88);color:#f6f5ec;font-size:clamp(18px,4.4vw,23px);font-weight:800;letter-spacing:.09em;text-align:center;text-shadow:0 1px 3px #000;cursor:pointer}
